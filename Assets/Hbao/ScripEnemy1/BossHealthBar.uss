/* Container chính nằm trên cao chính giữa màn hình */
.boss-hud-container {
    display: none;
    position: absolute;
    top: 20px;
    left: 50%;
    translate: -50% 0;
    width: 540px;
    height: 76px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    background-color: rgba(15, 8, 8, 0.85);
    border-width: 2px;
    border-color: rgb(215, 35, 35); /* Viền màu đỏ nổi bật kiểu Boss Fight */
    border-radius: 12px;
    padding: 8px 14px;
    box-shadow: 0px 8px 24px rgba(0, 0, 0, 0.85), inset 0px 0px 12px rgba(255, 0, 0, 0.25);
}

/* Khung viền avatar của Boss */
.boss-avatar-frame {
    width: 54px;
    height: 54px;
    border-width: 2px;
    border-color: rgb(220, 185, 45); /* Viền vàng kim loại cổ điển */
    border-radius: 27px; /* Bo tròn hoàn hảo thành hình tròn */
    overflow: hidden;
    background-color: rgb(25, 25, 25);
    margin-right: 12px;
    box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.6);
    flex-shrink: 0;
}

/* Ảnh chân dung Boss bên trong khung */
.boss-avatar {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-and-crop;
    background-image: url("project://database/Assets/Hbao/Image/boss_avatar.png");
}

/* Cụm tên và thanh máu */
.boss-hp-wrapper {
    flex-grow: 1;
    justify-content: center;
}

/* Tên hiển thị của Boss */
.boss-name {
    color: rgb(255, 235, 235);
    font-size: 16px;
    -unity-font-style: bold;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.95);
    margin-bottom: 3px;
    letter-spacing: 1px;
}

/* Container bọc ngoài thanh máu */
.boss-health-bar-container {
    width: 100%;
    height: 22px;
}

/* Nền tối của thanh máu */
.boss-hp-background {
    width: 100%;
    height: 100%;
    background-color: rgba(25, 12, 12, 0.9);
    border-width: 2px;
    border-color: rgb(160, 25, 25);
    border-radius: 6px;
    overflow: hidden;
    position: relative;
}

/* Thanh máu giảm chậm vệt vàng (Lag Bar) */
.boss-hp-yellow-bar {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(235, 190, 30);
    border-radius: 4px;
    transition-property: width;
    transition-duration: 0.65s;
    transition-timing-function: ease-in-out;
}

/* Thanh máu chính màu đỏ */
.boss-hp-progress-bar {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(220, 20, 20); /* Màu đỏ chiến đấu rực rỡ */
    border-radius: 4px;
    transition-property: width;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
    background-image: linear-gradient(to bottom, rgba(255, 255, 255, 0.38), rgba(0, 0, 0, 0.28));
}

/* Số máu hiển thị dạng text */
.boss-hp-text {
    position: absolute;
    width: 100%;
    height: 100%;
    color: rgb(255, 255, 255);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.95);
}

/* ─── Hiệu ứng Rung Lắc và Nhấp Nháy khi Mất Máu ─── */
@keyframes shake-anim {
    0% { margin-left: 0px; margin-top: 0px; }
    20% { margin-left: -8px; margin-top: -3px; }
    40% { margin-left: 8px; margin-top: 3px; }
    60% { margin-left: -5px; margin-top: 1px; }
    80% { margin-left: 5px; margin-top: -1px; }
    100% { margin-left: 0px; margin-top: 0px; }
}

.boss-hud-container.shake {
    animation-name: shake-anim;
    animation-duration: 0.22s;
}

@keyframes flash-anim {
    0% { background-color: rgb(255, 220, 220); }
    100% { background-color: rgb(220, 20, 20); }
}

.boss-hp-progress-bar.flash {
    animation-name: flash-anim;
    animation-duration: 0.2s;
}
