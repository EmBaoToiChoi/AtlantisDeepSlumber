/* Container chính nằm trên cao chính giữa màn hình */
.boss-hud-container {
    display: none;
    position: absolute;
    top: 20px;
    left: 50%;
    translate: -50% 0;
    width: 750px;
    height: auto;
    min-height: 100px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    background-color: rgba(14, 9, 5, 0.92);
    border-width: 0;
    padding: 16px 36px;
    box-shadow: 0px 8px 24px rgba(0, 0, 0, 0.9);
}

/* Khung ngoài Frame_Box_Medium_02 phóng to và kéo dài ôm trọn toàn bộ nền đen */
.boss-hud-outer-frame {
    position: absolute;
    top: -32px;
    left: -58px;
    right: -58px;
    bottom: -32px;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Box_Medium_02.png?fileID=1537655665&guid=4c83811485b435e4a93a37b73758d514&type=3#SPR_FantasyMenus_Frame_Box_Medium_02");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 80;
    -unity-slice-top: 80;
    -unity-slice-right: 80;
    -unity-slice-bottom: 80;
    pointer-events: none;
}

/* Khung viền avatar của Boss (80x80px hình vuông hoàng kim) */
.boss-avatar-frame {
    width: 80px;
    height: 80px;
    position: relative;
    overflow: hidden;
    background-color: rgb(20, 15, 12);
    border-radius: 6px;
    margin-right: 14px;
    box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.7);
    flex-shrink: 0;
}

/* Ảnh chân dung Boss bên trong khung */
.boss-avatar {
    position: absolute;
    top: 4px;
    left: 4px;
    right: 4px;
    bottom: 4px;
    border-radius: 4px;
    -unity-background-scale-mode: scale-and-crop;
    background-image: url("project://database/Assets/Hbao/Image/boss_avatar.png");
}

/* Khung Frame_Box_Small_01 bọc ngoài Avatar */
.boss-avatar-frame-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Box_Small_01.png?fileID=1537655665&guid=6c8d2d6feaeef2049b4c0e66ec33c393&type=3#SPR_FantasyMenus_Frame_Box_Small_01");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 100;
    -unity-slice-top: 100;
    -unity-slice-right: 100;
    -unity-slice-bottom: 100;
    pointer-events: none;
}

/* Cụm tên và thanh máu */
.boss-hp-wrapper {
    flex-grow: 1;
    justify-content: center;
}

/* Tên hiển thị của Boss */
.boss-name {
    color: rgb(255, 235, 235);
    font-size: 16px;
    -unity-font-style: bold;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.95);
    margin-bottom: 4px;
    letter-spacing: 1px;
}

/* Container bọc ngoài thanh máu */
.boss-health-bar-container {
    width: 100%;
    height: 28px;
    position: relative;
    justify-content: center;
}

/* Nền tối của thanh máu - Inset gọn gàng bên trong khung frame_powerup */
.boss-hp-background {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 10px;
    right: 32px;
    background-color: rgba(18, 10, 6, 0.95);
    border-radius: 2px;
    border-width: 0;
    overflow: hidden;
}

/* Thanh máu giảm chậm vệt vàng (Lag Bar) */
.boss-hp-yellow-bar {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(235, 190, 30);
    border-radius: 2px;
    transition-property: width;
    transition-duration: 0.65s;
    transition-timing-function: ease-in-out;
}

/* Thanh máu chính màu đỏ */
.boss-hp-progress-bar {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(220, 20, 20); /* Màu đỏ chiến đấu rực rỡ */
    border-radius: 2px;
    transition-property: width;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
    background-image: linear-gradient(to bottom, rgba(255, 255, 255, 0.38), rgba(0, 0, 0, 0.28));
}

/* Số máu hiển thị dạng text */
.boss-hp-text {
    position: absolute;
    width: 100%;
    height: 100%;
    color: rgb(255, 255, 255);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.95);
}

/* Khung frame_powerup bọc chuẩn bên ngoài thanh máu chính */
.boss-hp-frame-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url("project://database/Assets/Artsystack - Fantasy RPG GUI/Resources/Sprites/components/frame_powerup.png?fileID=1537655665&guid=47d595e42a1be9f438e7034c86ce73ef&type=3#frame_powerup");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 80;
    -unity-slice-top: 0;
    -unity-slice-right: 80;
    -unity-slice-bottom: 0;
    pointer-events: none;
}

/* ─── Hiệu ứng Rung Lắc và Nhấp Nháy khi Mất Máu ─── */
@keyframes shake-anim {
    0% { margin-left: 0px; margin-top: 0px; }
    20% { margin-left: -8px; margin-top: -3px; }
    40% { margin-left: 8px; margin-top: 3px; }
    60% { margin-left: -5px; margin-top: 1px; }
    80% { margin-left: 5px; margin-top: -1px; }
    100% { margin-left: 0px; margin-top: 0px; }
}

.boss-hud-container.shake {
    animation-name: shake-anim;
    animation-duration: 0.22s;
}

@keyframes flash-anim {
    0% { background-color: rgb(255, 220, 220); }
    100% { background-color: rgb(220, 20, 20); }
}

.boss-hp-progress-bar.flash {
    animation-name: flash-anim;
    animation-duration: 0.2s;
}
