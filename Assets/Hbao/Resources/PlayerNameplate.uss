.nameplate-container {
    position: absolute;
    width: 0;
    height: 0;
    align-items: center;
    justify-content: center;
    overflow: visible;
}

.nameplate-wrapper {
    position: absolute;
    bottom: 0;
    align-items: center;
    justify-content: flex-end;
}

.nameplate-box {
    position: relative;
    min-width: 200px;
    height: 48px;
    padding-left: 36px;
    padding-right: 36px;
    align-items: center;
    justify-content: center;
}

.nameplate-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Menu_Button_12_Background.png?fileID=2800000&guid=387518e5d920c4b4c9219d74a5729311&type=3#SPR_FantasyMenus_Menu_Button_12_Background");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(8, 14, 26, 0.9);
    z-index: 1;
}

.nameplate-frame {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Menu_Button_12_Frame.png?fileID=2800000&guid=36d4bec83f61f134bbd04c1619e97c33&type=3#SPR_FantasyMenus_Menu_Button_12_Frame");
    -unity-background-scale-mode: stretch-to-fill;
    z-index: 3;
}

.player-name-label {
    color: rgb(255, 255, 255);
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
    white-space: nowrap;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.9);
    margin: 0;
    padding: 0;
    z-index: 2;
}

.nameplate-arrow {
    color: rgb(255, 215, 0);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: -4px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
    text-shadow: 0 0 6px rgba(255, 215, 0, 0.6);
    padding: 0;
    margin-bottom: 4px;
}
