.nameplate-container {
    position: absolute;
    width: 0;
    height: 0;
    align-items: center;
    justify-content: center;
    overflow: visible;
}

.player-name-label {
    color: rgb(255, 255, 255);
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
    
    /* Nền tối kính mờ (dark glassmorphism) giúp tương phản mạnh với chữ trắng */
    background-color: rgba(10, 10, 12, 0.65);
    
    /* Padding bo tròn dạng badge sang trọng (Explicit properties for compatibility) */
    padding-top: 4.0px;
    padding-bottom: 4.0px;
    padding-left: 12.0px;
    padding-right: 12.0px;
    
    border-top-left-radius: 10.0px;
    border-top-right-radius: 10.0px;
    border-bottom-left-radius: 10.0px;
    border-bottom-right-radius: 10.0px;
    
    white-space: nowrap;
    
    /* Viền mỏng sáng nhẹ tạo hiệu ứng nổi khối */
    border-left-width: 1.0px;
    border-right-width: 1.0px;
    border-top-width: 1.0px;
    border-bottom-width: 1.0px;
    
    border-left-color: rgba(255, 255, 255, 0.15);
    border-right-color: rgba(255, 255, 255, 0.15);
    border-top-color: rgba(255, 255, 255, 0.15);
    border-bottom-color: rgba(255, 255, 255, 0.15);
    
    /* Text outline đen sắc nét để chữ cực dễ đọc trên mọi địa hình sáng/tối */
    -unity-text-outline-width: 1.0px;
    -unity-text-outline-color: rgb(0, 0, 0);
    
    /* Text shadow mềm giống tên enemy */
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.8);
}

.nameplate-wrapper {
    position: absolute;
    bottom: 0;
    align-items: center;
    justify-content: flex-end;
}

.nameplate-arrow {
    color: rgb(255, 255, 255);
    font-size: 10px;
    margin-top: -3px; /* Đè nhẹ lên viền của nhãn tên để liền mạch */
    -unity-text-outline-width: 1.0px;
    -unity-text-outline-color: rgb(0, 0, 0); /* Viền đen giúp mũi tên rõ nét trên mọi nền */
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.8);
    padding: 0;
    margin-bottom: 5px; /* Tạo khoảng trống nhẹ dưới mũi tên trước khi chỉ vào đầu nhân vật */
}
