/* Khung bọc tổng thể */
.hud-main-wrapper {
    flex-direction: row;
    position: absolute;
    top: 25px;
    left: 25px;
    padding: 12px 16px;
    background-color: rgba(10, 10, 14, 0.65);
    border-radius: 16px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    align-items: center;
}

/* Ảnh Player: Giảm khoảng cách margin-right để gần 3 thanh hơn */
.raw-player-image {
    width: 80px;
    height: 80px;
    margin-right: 10px; /* Cũ là 16px, đã giảm để gom gần lại */
    -unity-background-scale-mode: scale-to-fit;
}

/* Khu vực cột thông số */
.stats-wrapper {
    justify-content: center;
    flex-direction: column;
}

/* Chữ Level */
.level-label {
    color: rgb(255, 255, 255);
    font-size: 16px;
    font-weight: bold;
    margin-bottom: 6px; /* Gom gần lại với thanh máu */
    padding: 0;
    letter-spacing: 1px;
}

/* Style chung cho các rãnh nền */
.track-bg {
    background-color: rgba(0, 0, 0, 0.7);
    margin-bottom: 4px; /* Cũ là 6px, đã giảm để 3 thanh sát nhau hơn */
    position: relative; /* Để căn chỉnh lớp vạch chia overlay bên trong */
}

/* 1. Thanh Máu: Khung vuông vức hoàn toàn */
.hp-track {
    width: 260px;
    height: 14px;
    border-radius: 0; /* Khung vuông */
}

/* 2. Thanh Mana: Khung vuông để đồng bộ, hoặc bạn có thể bo nhẹ tùy ý */
.mp-track {
    width: 200px;
    height: 10px;
    border-radius: 0; 
}

/* 3. Thanh EXP */
.exp-track {
    width: 150px;
    height: 6px;
    border-radius: 0;
    margin-bottom: 0;
}

/* Style chung cho lõi Fill */
.fill-core {
    height: 100%;
    width: 100%;
    transition-property: width;
    transition-duration: 0.2s;
    transition-timing-function: ease-out-cubic;
}

/* --- LỚP PHỦ VẠCH CHIA KHÚC (OVERLAY DIVIDERS) --- */

/* Lớp phủ nằm trên cùng, không ảnh hưởng đến thanh fill ở dưới */
.segments-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

/* Đường vạch chia khúc: Dùng màu nền trùng với màu background rãnh (đen) */
.divider {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px; /* Độ dày của vạch cắt */
    background-color: rgb(0, 0, 0); /* Trùng màu rãnh nền tạo cảm giác bị cắt rời */
}

/* --- MÀU SẮC FILL --- */

.hp-fill {
    background-color: rgb(255, 255, 255); /* Trắng */
}

.mp-fill {
    background-color: rgb(24, 144, 255); /* Xanh dương */
}

.exp-fill {
    background-color: rgb(255, 204, 0); /* Vàng */
}