.hud-main-wrapper {
    flex-direction: row;
    position: absolute;
    bottom: 30px;
    left: 30px;
    padding: 10px 16px;
    background-color: rgba(0, 0, 0, 0.15);
    border-radius: 40px;
    align-items: center;
    border-width: 0;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.6);
}

.player-avatar-container {
    width: 80px;
    height: 80px;
    border-radius: 40px;
    background-color: rgba(0, 0, 0, 0.4);
    justify-content: center;
    align-items: center;
    margin-right: 8px;
    border-width: 2px;
    border-color: rgba(40, 160, 255, 0.9);
    box-shadow: 0 0 12px rgba(40, 160, 255, 0.6);
}

.raw-player-image {
    width: 72px;
    height: 72px;
    border-radius: 36px;
    -unity-background-scale-mode: scale-to-fit;
}

.stats-wrapper {
    flex-direction: column;
    justify-content: center;
}

.level-label {
    color: rgb(255, 255, 255);
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 2px;
    padding: 0;
    letter-spacing: 1px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.5);
}

.track-bg {
    background-color: rgba(0, 0, 0, 0.45);
    margin-bottom: 1px;
    position: relative;
    overflow: hidden;
    border-width: 0;
}

.hp-track {
    width: 250px;
    height: 16px;
    border-radius: 0;
}

.mp-track {
    width: 200px;
    height: 10px;
    border-radius: 5px;
}

.exp-track {
    width: 160px;
    height: 6px;
    border-radius: 3px;
    margin-bottom: 0;
}

.fill-core {
    height: 100%;
    width: 100%;
    transition-property: width;
    transition-duration: 0.15s;
    transition-timing-function: ease-out-quad;
}

.segments-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

.divider {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background-color: rgba(0, 0, 0, 0.25);
}

.hp-fill {
    background-color: rgb(240, 245, 255);
    border-radius: 0;
}

.mp-fill {
    background-color: rgb(40, 160, 255);
    border-radius: 5px;
}

.exp-fill {
    background-color: rgb(75, 225, 100);
    border-radius: 3px;
}

.mic-icon-base {
    position: absolute;
    right: 0;
    bottom: -12px;
    width: 28px;
    height: 28px;
    -unity-background-scale-mode: scale-to-fit;
    transition-property: opacity, scale;
    transition-duration: 0.3s;
    transition-timing-function: ease-in-out;
}

.mic-off {
    background-image: url("project://database/Assets/Hbao/Image/Mic%20-%20Copy.png?fileID=2800000&guid=c224a90ad5cf9ad41a4c9076f3490624&type=3#Mic - Copy");
    opacity: 1;
    scale: 1 1;
}

.mic-on {
    background-image: url("project://database/Assets/Hbao/Image/Mic%201.png?fileID=2800000&guid=8315893ae6402734cab54940b270a236&type=3#Mic 1");
    opacity: 1;
    scale: 1.15 1.15;
}

.minimap-wrapper {
    position: absolute;
    top: 40px;
    right: 35px;
    width: 200px;
    height: 200px;
    border-radius: 100px;
    justify-content: center;
    align-items: center;
}

.minimap-mask {
    width: 192px;
    height: 192px;
    border-radius: 96px;
    overflow: hidden;
    background-color: rgba(10, 15, 25, 0.65);
    box-shadow: inset 0 0 35px rgba(0, 0, 0, 0.9);
}

.minimap-content {
    width: 100%;
    height: 100%;
}

.minimap-grid-x {
    position: absolute;
    top: 95px;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: rgba(40, 160, 255, 0.2);
}

.minimap-grid-y {
    position: absolute;
    top: 0;
    left: 95px;
    width: 2px;
    height: 100%;
    background-color: rgba(40, 160, 255, 0.2);
}

.minimap-border {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: 100px;
    border-width: 4px;
    border-color: rgb(192, 192, 192);
    box-shadow: 0 0 30px rgba(0, 100, 255, 0.9);
}

.minimap-inner-ring {
    position: absolute;
    top: 8px;
    left: 8px;
    width: 184px;
    height: 184px;
    border-radius: 92px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.3);
}

.minimap-deco-dot {
    position: absolute;
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: rgb(255, 255, 255);
    box-shadow: 0 0 10px rgb(0, 200, 255);
}

.minimap-compass-n {
    position: absolute;
    top: -36px;
    color: rgb(255, 255, 255);
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 0 0 10px rgb(0, 150, 255);
}

.hud-weapons-wrapper {
    flex-direction: column;
    align-items: flex-end;
    position: absolute;
    bottom: 40px;
    right: 30px;
    background-color: transparent;
    box-shadow: none;
    padding: 0;
    border-radius: 0;
}

.weapon-slot {
    width: 300px;
    height: 90px;
    border-radius: 12px;
    background-color: rgba(15, 25, 40, 0.35);
    border-width: 2px;
    border-color: rgba(150, 150, 150, 0.8);
    margin-top: 15px;
    position: relative;
    overflow: hidden;
    transition-property: scale, opacity, border-color, box-shadow, background-color;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
}

.weapon-hotkey-wrapper {
    position: absolute;
    top: 8px;
    left: 10px;
    width: 32px;
    height: 32px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    justify-content: center;
    align-items: center;
}

.weapon-hotkey-container {
    position: relative;
    width: 32px;
    height: 32px;
    background-color: rgba(255, 255, 255, 0.18);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.95);
    justify-content: center;
    align-items: center;
    box-shadow: 0 0 10px rgba(255, 255, 255, 0.6), 0 0 20px rgba(255, 255, 255, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.4);
}

.weapon-hotkey {
    color: rgb(10, 10, 10);
    -unity-font-style: bold;
    font-size: 15px;
    -unity-text-outline-width: 0;
    padding: 0;
    margin: 0;
}

.weapon-ammo-text {
    position: absolute;
    bottom: 12px;
    left: 15px;
    color: rgba(255, 255, 255, 0.85);
    font-size: 26px;
    -unity-font-style: bold;
    padding: 0;
    margin: 0;
    text-shadow: 0 0 10px rgba(0, 0, 0, 0.8);
}

.weapon-durability-bar {
    position: absolute;
    bottom: 8px;
    left: 110px;
    right: 15px;
    height: 4px;
    flex-direction: row;
}

.durability-segment {
    flex-grow: 1;
    height: 100%;
    background-color: rgba(192, 192, 192, 0.5);
    margin-right: 4px;
}

.weapon-image {
    position: absolute;
    top: 5px;
    right: 15px;
    width: 180px;
    height: 80px;
    -unity-background-scale-mode: scale-to-fit;
}

.weapon-active {
    scale: 1.15 1.15;
    opacity: 1;
    background-color: rgba(20, 35, 55, 0.5);
    border-color: rgba(170, 170, 170, 0.9);
    box-shadow: 0 0 25px rgba(150, 150, 150, 0.3), inset 0 0 20px rgba(255, 255, 255, 0.05);
}

.weapon-inactive {
    scale: 0.85 0.85;
    opacity: 0.35;
    border-color: rgba(100, 100, 100, 0.3);
    box-shadow: none;
}

.hud-skills-wrapper {
    position: absolute;
    bottom: 40px;
    left: 50%;
    translate: -50% 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.skill-slot {
    width: 70px;
    height: 70px;
    margin: 0 15px;
    background-color: rgba(20, 20, 20, 0.4);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.85);
    position: relative;
    overflow: hidden;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.6), inset 0 0 25px rgba(0, 0, 0, 0.95);
}

.skill-image {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
    background-color: transparent;
}

.skill-cooldown-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 0%;
    background-color: rgba(0, 0, 0, 0.75);
}

.skill-cooldown-text {
    position: absolute;
    width: 100%;
    height: 100%;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    font-size: 28px;
    text-shadow: 0 0 10px rgb(0, 0, 0), 0 0 5px rgb(0, 0, 0);
    padding: 0;
    margin: 0;
    display: none;
}

.skill-lock-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.8);
    justify-content: center;
    align-items: center;
    transition-property: background-color;
    transition-duration: 0.6s;
    transition-timing-function: ease-out;
}

.skill-lock-overlay.unlocked-anim {
    background-color: rgba(0, 0, 0, 0); /* Bóng mờ đen từ từ biến mất */
}

/* Ổ khóa */
.skill-lock-icon {
    width: 80px;
    height: 75px;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/Hbao/Image/Okhoa.png?fileID=2800000&guid=a6762048aa50f61429b3f9b9877b5028&type=3#Okhoa");
    transition-property: translate, opacity, rotate;
    transition-duration: 0.6s, 0.5s, 0.6s;
    transition-timing-function: ease-in-back, ease-out, ease-in-out;
    transform-origin: center top;
}

/* Chỉ có ổ khóa rớt xuống khi mở */
.skill-lock-overlay.unlocked-anim .skill-lock-icon {
    translate: 0 60px;
    opacity: 0;
    rotate: 15deg;
}
