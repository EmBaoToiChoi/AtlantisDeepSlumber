.hud-main-wrapper {
    flex-direction: row;
    position: absolute;
    bottom: 30px;
    left: 30px;
    padding: 10px 16px;
    background-color: rgba(0, 0, 0, 0.15); /* Cực kỳ trong suốt, gần như vô hình để chỉ lấy bóng */
    border-radius: 40px;
    align-items: center;
    border-width: 0; /* Không dùng viền */
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.6); /* Bóng mờ mềm mại và tự nhiên hơn */
}

.player-avatar-container {
    width: 80px;
    height: 80px;
    border-radius: 40px;
    background-color: rgba(0, 0, 0, 0.4); /* Sáng hơn một chút */
    justify-content: center;
    align-items: center;
    margin-right: 8px; /* Đưa level và 3 thanh lại gần avatar hơn */
    border-width: 2px;
    border-color: rgba(40, 160, 255, 0.9); /* Đổi sang màu xanh dương */
    box-shadow: 0 0 12px rgba(40, 160, 255, 0.6); /* Đổ bóng màu xanh dương nhẹ nhàng */
}

.raw-player-image {
    width: 72px;
    height: 72px;
    border-radius: 36px;
    -unity-background-scale-mode: scale-to-fit;
}

.stats-wrapper {
    flex-direction: column;
    justify-content: center;
}

.level-label {
    color: rgb(255, 255, 255); /* Đổi sang màu trắng tinh khiết để trông thanh lịch và hài hòa hơn */
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 2px;
    padding: 0;
    letter-spacing: 1px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.5); /* Viền mờ màng hơn */
}

.track-bg {
    background-color: rgba(0, 0, 0, 0.45); /* Nền track tối giản mờ mờ */
    margin-bottom: 1px;
    position: relative;
    overflow: hidden;
    border-width: 0; /* Xóa viền track để trông hiện đại và gọn gàng hơn */
}

.hp-track {
    width: 250px;
    height: 16px;
    border-radius: 0;
}

.mp-track {
    width: 200px;
    height: 10px;
    border-radius: 5px;
}

.exp-track {
    width: 160px;
    height: 6px;
    border-radius: 3px;
    margin-bottom: 0;
}

.fill-core {
    height: 100%;
    width: 100%;
    transition-property: width;
    transition-duration: 0.15s;
    transition-timing-function: ease-out-quad;
}

.segments-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

.divider {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px; /* Mỏng lại */
    background-color: rgba(0, 0, 0, 0.25); /* Mờ màng hơn rất nhiều để không chia cắt thanh quá thô */
}

.hp-fill {
    background-color: rgb(240, 245, 255);
    border-radius: 0;
}

.mp-fill {
    background-color: rgb(40, 160, 255);
    border-radius: 5px;
}

.exp-fill {
    background-color: rgb(75, 225, 100);
    border-radius: 3px;
}

.mic-icon-base {
    position: absolute;
    right: 0; /* Canh lề phải theo cụm stats */
    bottom: -12px; /* Chỉnh lại vị trí cho cân đối */
    width: 28px; /* Thu nhỏ kích thước lại cho vừa vặn */
    height: 28px;
    -unity-background-scale-mode: scale-to-fit;
    transition-property: opacity, scale;
    transition-duration: 0.3s;
    transition-timing-function: ease-in-out;
}

.mic-off {
    background-image: url("project://database/Assets/Hbao/Image/Mic%20-%20Copy.png?fileID=2800000&guid=c224a90ad5cf9ad41a4c9076f3490624&type=3#Mic - Copy");
    opacity: 1; /* Đặt 1 để rõ nét hoàn toàn, không bị mờ */
    scale: 1 1;
}

.mic-on {
    background-image: url("project://database/Assets/Hbao/Image/Mic%201.png?fileID=2800000&guid=8315893ae6402734cab54940b270a236&type=3#Mic 1");
    opacity: 1; /* Sáng rõ khi bật */
    scale: 1.15 1.15; /* Hơi phóng to nhẹ tạo điểm nhấn */
}

/* --- Mini Map (Bản nâng cấp Cao cấp) --- */
.minimap-wrapper {
    position: absolute;
    top: 40px; /* Nhích xuống một chút để nhường chỗ cho chữ N */
    right: 35px;
    width: 200px;
    height: 200px;
    border-radius: 100px;
    justify-content: center;
    align-items: center;
}

.minimap-mask {
    width: 192px;
    height: 192px;
    border-radius: 96px;
    overflow: hidden;
    background-color: rgba(10, 15, 25, 0.65); /* Nền xanh đen sâu thẳm */
    box-shadow: inset 0 0 35px rgba(0, 0, 0, 0.9); /* Đổ bóng sâu bên trong tạo cảm giác như khối cầu lõm */
}

.minimap-content {
    width: 100%;
    height: 100%;
    /* Chỗ gán Map Image / RenderTexture */
}

/* Lưới Radar (Trục X và Y) mờ ảo */
.minimap-grid-x {
    position: absolute;
    top: 95px;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: rgba(40, 160, 255, 0.2); /* Sáng nhẹ xanh dương */
}

.minimap-grid-y {
    position: absolute;
    top: 0;
    left: 95px;
    width: 2px;
    height: 100%;
    background-color: rgba(40, 160, 255, 0.2);
}

.minimap-border {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: 100px;
    border-width: 4px;
    border-color: rgb(192, 192, 192); /* Bạc chuẩn kim loại */
    box-shadow: 0 0 30px rgba(0, 100, 255, 0.9); /* Bóng xanh dương tỏa đều */
}

/* Nhẫn kim loại mỏng bên trong tăng độ phức tạp cơ khí/viễn tưởng */
.minimap-inner-ring {
    position: absolute;
    top: 8px;
    left: 8px;
    width: 184px;
    height: 184px;
    border-radius: 92px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.3);
}

/* 4 điểm sáng / ốc vít chốt trên viền Bạc */
.minimap-deco-dot {
    position: absolute;
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: rgb(255, 255, 255);
    box-shadow: 0 0 10px rgb(0, 200, 255); /* Điểm phát sáng xanh ngọc */
}

/* Chữ N (North - Hướng Bắc) phong cách La bàn */
.minimap-compass-n {
    position: absolute;
    top: -36px; /* Kéo lên cao hơn một chút so với khung */
    color: rgb(255, 255, 255);
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 0 0 10px rgba(0, 150, 255, 1); /* Chữ phát sáng xanh */
}

/* === KHUNG VŨ KHÍ GÓC DƯỚI BÊN PHẢI === */
.hud-weapons-wrapper {
    flex-direction: column; /* Xếp dọc các ô vũ khí */
    align-items: flex-end; /* Canh lề phải cho các ô */
    position: absolute;
    bottom: 40px;
    right: 30px;
    background-color: transparent;
    box-shadow: none;
    padding: 0;
    border-radius: 0;
}

.weapon-slot {
    width: 300px;
    height: 90px;
    border-radius: 12px;
    background-color: rgba(15, 25, 40, 0.35); /* Nền mờ mờ trong suốt (Glassmorphism) cực đẹp */
    border-width: 2px;
    border-color: rgba(192, 192, 192, 0.3); /* Viền bạc mờ mờ */
    margin-top: 15px; /* Cách ô trên một khoảng */
    position: relative;
    overflow: hidden;
    /* Hiệu ứng chuyển đổi mềm mại */
    transition-property: scale, opacity, border-color, box-shadow, background-color;
    transition-duration: 0.3s;
    transition-timing-function: ease-out; 
}

/* Nền bọc phím 1 và 2 */
.weapon-hotkey-container {
    position: absolute;
    top: 10px; /* Thụt hẳn vào bên trong khung */
    left: 10px;
    width: 28px;
    height: 28px;
    background-color: rgba(0, 0, 0, 0.35); /* Nền mờ tối bọc lấy số */
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15); /* Viền kính rất nhạt */
    justify-content: center;
    align-items: center;
    box-shadow: 0 0 15px rgba(0, 0, 0, 0.8); /* Đổ bóng mờ bọc quanh số */
}

.weapon-hotkey {
    color: rgba(255, 255, 255, 0.9); /* Chữ trắng dịu */
    -unity-font-style: bold;
    font-size: 16px;
    padding: 0;
    margin: 0;
}

/* Dòng chữ đạn 41/45 */
.weapon-ammo-text {
    position: absolute;
    bottom: 12px;
    left: 15px;
    color: rgba(255, 255, 255, 0.85);
    font-size: 26px;
    -unity-font-style: bold;
    padding: 0;
    margin: 0;
    text-shadow: 0 0 10px rgba(0, 0, 0, 0.8); /* Bóng đen để nổi chữ */
}

/* Thanh độ bền / băng đạn gạch gạch */
.weapon-durability-bar {
    position: absolute;
    bottom: 8px;
    left: 110px; /* Đẩy sang phải để tránh đè lên chữ */
    right: 15px;
    height: 4px;
    flex-direction: row;
}

.durability-segment {
    flex-grow: 1;
    height: 100%;
    background-color: rgba(192, 192, 192, 0.5); /* Nấc đạn màu bạc mờ */
    margin-right: 4px;
}

/* Khu vực hiển thị kiếm/vũ khí to nằm ngang */
.weapon-image {
    position: absolute;
    top: 5px;
    right: 15px;
    width: 180px;
    height: 80px;
    -unity-background-scale-mode: scale-to-fit;
}

/* Trạng thái Đang Chọn (Sáng bạc, Mờ ảo sang trọng) */
.weapon-active {
    scale: 1.15 1.15;
    opacity: 1;
    background-color: rgba(20, 35, 55, 0.5); /* Nền sáng lên một chút xíu nhưng vẫn mờ mờ */
    border-color: rgba(192, 192, 192, 0.8); /* Viền bạc sáng lên */
    box-shadow: 0 0 30px rgba(192, 192, 192, 0.25), inset 0 0 20px rgba(255, 255, 255, 0.05); /* Đổ bóng tỏa bạc xung quanh thay vì xanh chóe */
}

/* Trạng thái Tắt */
.weapon-inactive {
    scale: 0.85 0.85; /* Thu nhỏ lùi về sau */
    opacity: 0.35; /* Mờ hơn nữa */
    border-color: rgba(192, 192, 192, 0.15); /* Viền nhạt gần như biến mất */
    box-shadow: none; /* Tắt bóng */
}
