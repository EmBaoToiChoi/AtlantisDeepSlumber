<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Hbao/ScripUIPlayer/PlayerHUD.uss?fileID=7433441132597879392&amp;guid=70193741e3d26714d859986fce3cd4df&amp;type=3#PlayerHUD" />
    <ui:VisualElement class="hud-main-wrapper" style="-unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&amp;guid=8dcf67e479d58bd47908bf0d5e1cc1d0&amp;type=3#NotInter-Regular&quot;);">
        <ui:VisualElement class="stats-wrapper">
            <ui:Label name="hud-level-label" text="Lv. 15" class="level-label" />
            <ui:VisualElement class="stat-bar-container hp-bar-container">
                <ui:VisualElement class="track-bg hp-track">
                    <ui:VisualElement name="hp-fill" class="fill-core hp-fill" />
                </ui:VisualElement>
                <ui:VisualElement class="stat-bar-frame" style="background-image: url(&quot;project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Menu_Button_16_Frame.png?fileID=2800000&amp;guid=30899411b4447044da0027e0c416bba6&amp;type=3#SPR_FantasyMenus_Menu_Button_16_Frame&quot;);" />
            </ui:VisualElement>
            <ui:VisualElement class="stat-bar-container mp-bar-container">
                <ui:VisualElement class="track-bg mp-track">
                    <ui:VisualElement name="mp-fill" class="fill-core mp-fill" />
                    <ui:VisualElement class="segments-overlay">
                        <ui:VisualElement class="divider" style="left: 33.33%;" />
                        <ui:VisualElement class="divider" style="left: 66.66%;" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="stat-bar-frame" style="background-image: url(&quot;project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Menu_Button_16_Frame.png?fileID=2800000&amp;guid=30899411b4447044da0027e0c416bba6&amp;type=3#SPR_FantasyMenus_Menu_Button_16_Frame&quot;);" />
            </ui:VisualElement>
            <ui:VisualElement class="stat-bar-container exp-bar-container">
                <ui:VisualElement class="track-bg exp-track">
                    <ui:VisualElement name="exp-fill" class="fill-core exp-fill" />
                    <ui:VisualElement class="segments-overlay">
                        <ui:VisualElement class="divider" style="left: 10%;" />
                        <ui:VisualElement class="divider" style="left: 20%;" />
                        <ui:VisualElement class="divider" style="left: 30%;" />
                        <ui:VisualElement class="divider" style="left: 40%;" />
                        <ui:VisualElement class="divider" style="left: 50%;" />
                        <ui:VisualElement class="divider" style="left: 60%;" />
                        <ui:VisualElement class="divider" style="left: 70%;" />
                        <ui:VisualElement class="divider" style="left: 80%;" />
                        <ui:VisualElement class="divider" style="left: 90%;" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="stat-bar-frame" style="background-image: url(&quot;project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Menu_Button_16_Frame.png?fileID=2800000&amp;guid=30899411b4447044da0027e0c416bba6&amp;type=3#SPR_FantasyMenus_Menu_Button_16_Frame&quot;);" />
