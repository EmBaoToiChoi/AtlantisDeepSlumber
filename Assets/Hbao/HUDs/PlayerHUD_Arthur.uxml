                    <ui:Label name="hint-idle-attack-text" text="Đấm" class="hint-text" />
                </ui:VisualElement>
                <ui:VisualElement name="hint-idle-block" class="hint-row" style="display: none;">
                    <ui:VisualElement class="key-icon-combo">
                        <ui:VisualElement class="key-icon key-icon-mouse-r" />
                    </ui:VisualElement>
                    <ui:Label name="hint-idle-block-text" text="Giữ Chuột phải để đỡ khiên" class="hint-text" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="action-hints-group" class="hints-group" style="display: none;">
                <ui:VisualElement class="hint-row">
                    <ui:VisualElement class="key-icon key-icon-ctrl" />
                    <ui:Label text="Lộn tránh" class="hint-text" />
                </ui:VisualElement>
                <ui:VisualElement class="hint-row">
                    <ui:VisualElement class="key-icon key-icon-tab" />
