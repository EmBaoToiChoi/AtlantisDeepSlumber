                                <ui:Label name="mp-level-text" text="Lv. 0" class="upgrade-value" />
                                <ui:Button name="btn-upgrade-mp" text="+" class="upgrade-button" />
                            </ui:VisualElement>
                            <ui:VisualElement class="upgrade-row">
