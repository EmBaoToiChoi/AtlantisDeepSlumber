                        <ui:VisualElement class="key-icon key-icon-a" />
                        <ui:VisualElement class="key-icon key-icon-s" />
                        <ui:VisualElement class="key-icon key-icon-d" />
                    </ui:VisualElement>
                    <ui:Label text="Chạy nhanh" class="hint-text" />
