            <ui:VisualElement class="player-avatar-border" style="background-image: url(&quot;project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Hexagon_01.png?fileID=2800000&amp;guid=3a8ac9a83f434884fb081391eb919721&amp;type=3#SPR_FantasyMenus_Frame_Hexagon_01&quot;);" />
        </ui:VisualElement>
