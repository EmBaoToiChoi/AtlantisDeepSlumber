.main-container {
    align-items: center;
    justify-content: center;
    padding: 10px;
}

.enemy-name {
    color: rgb(220, 180, 255); /* Màu tím lavender sáng rực rỡ */
    font-size: 17px;
    -unity-font-style: bold;
    text-shadow: 2px 2px 4px rgba(138, 43, 226, 0.95); /* Hào quang tím ma mị quyến rũ đặc trưng của Bóng Tối */
    margin-bottom: 5px;
    letter-spacing: 1.8px;
}

.container {
    width: 220px; 
    height: 24px;
}

.background {
    width: 100%;
    height: 100%;
    background-color: rgba(10, 5, 20, 0.85); /* Nền đen pha tím thẫm */
    border-width: 2px;
    border-color: rgb(186, 85, 211); /* Viền màu tím Orchid neon cực đẹp */
    border-radius: 7px;
    overflow: hidden;
    padding: 2.5px;
    box-shadow: 0px 0px 10px rgba(186, 85, 211, 0.65); /* Hào quang tím tỏa lan toát lên vẻ bí ẩn */
}

.progress-bar {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(220, 20, 60); /* Đỏ Crimson rực cháy */
    border-radius: 4px;
    transition-property: width;
    transition-duration: 0.15s; /* Máu tụt nhanh phản hồi ngay lập tức */
    transition-timing-function: ease-out;
    background-image: linear-gradient(to bottom, rgba(255, 255, 255, 0.45), rgba(0, 0, 0, 0.35));
}

.yellow-bar {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(255, 215, 0); /* Thanh vàng gold tụt chậm nghệ thuật để thấy máu giảm */
    border-radius: 4px;
    transition-property: width;
    transition-duration: 0.75s; /* Trễ chậm nhịp để thấy rõ lượng HP đã mất */
    transition-timing-function: ease-in-out;
}
