/* ═══════════════════════════════════════════════════════
   INTRO DIALOGUE STYLE SHEET (USS)
   White Border, Black Background, White Text
   ═══════════════════════════════════════════════════════ */

.intro-dialogue-wrapper {
    position: absolute;
    width: 100%;
    height: 100%;
    justify-content: flex-end;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    pointer-events: none;
    z-index: 15000; /* Hiển thị đè lên trên tất cả HUD của người chơi */
    
    transition-property: background-color;
    transition-duration: 0.35s;
    transition-timing-function: ease-out;
}

.intro-dialogue-wrapper.show-wrapper {
    background-color: rgba(0, 0, 0, 0.65);
    pointer-events: auto;
}

/* Khung đối thoại: Nền trong suốt, loại bỏ viền cũ để dùng khung ảnh TalkNPC */
.intro-dialogue-box {
    top: 200px;
    width: 1300px;
    height: 700px;
    background-color: transparent;
    border-width: 0;
    flex-direction: row;
    padding: 20px 24px;
    align-items: stretch;
    margin-bottom: 60px;
    position: relative;
    
    transition-property: opacity, scale;
    transition-duration: 0.3s;
    transition-timing-function: ease-out-back;
    opacity: 0;
    scale: 0.9;
}

.intro-dialogue-box.show-dialogue {
    opacity: 1;
    scale: 1;
}

/* Avatar của NPC nằm chính xác trong khung tròn bên trái */
.intro-avatar {
    position: absolute;
    top: 230px;
    left: 150px;
    width: 220px;
    height: 220px;
    border-radius: 110px;
    overflow: hidden;
    -unity-background-scale-mode: scale-and-crop;
}

/* Vùng chứa text đối thoại: căn chỉnh tuyệt đối nằm gọn trong khung chữ nhật bên phải */
.intro-text-container {
    position: absolute;
    top: 200px;
    left: 470px;
    width: 750px;
    height: 300px;
    justify-content: space-between;
    padding: 30px 10px 15px 10px;
}

/* Ẩn tên nhân vật theo yêu cầu */
.intro-speaker-name {
    display: none;
}

/* Nội dung hội thoại: phóng to chữ và tăng độ giãn dòng cho cân đối với khung lớn */
.intro-dialogue-text {
    color: #ffffff;
    font-size: 24px;
    line-height: 38px;
    -unity-font-style: normal;
    white-space: normal;
    flex-grow: 1;
}

/* Nút Next ở góc dưới bên phải: đổi màu viền vàng kim */
.intro-next-btn {
    align-self: flex-end;
    background-color: rgba(10, 15, 25, 0.85);
    color: #ffffff;
    border-width: 1.5px;
    border-color: rgba(212, 175, 55, 0.8);
    border-radius: 6px;
    font-size: 11px;
    -unity-font-style: bold;
    padding: 6px 16px;
    margin: 0;
    letter-spacing: 0.5px;
    cursor: pointer;
    left: -30px;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.15s;
}

.intro-next-btn:hover {
    background-color: rgba(255, 255, 255, 0.15);
    border-color: #ffffff;
    scale: 1.05;
}

.intro-next-btn:active {
    background-color: rgba(255, 255, 255, 0.3);
    scale: 0.95;
}

/* Nút SKIP (Bỏ qua toàn bộ) ở góc trên bên phải khung thoại: đổi màu viền vàng kim */
.intro-skip-btn {
    position: absolute;
    top: 200px;
    right: 140px;
    background-color: rgba(10, 15, 25, 0.85);
    color: #ffffff;
    border-width: 1.5px;
    border-color: rgba(212, 175, 55, 0.8);
    border-radius: 8px;
    font-size: 12px;
    -unity-font-style: bold;
    padding: 6px 18px;
    margin: 0;
    letter-spacing: 1px;
    cursor: pointer;
    
    transition-property: background-color, scale, border-color;
    transition-duration: 0.15s;
}

.intro-skip-btn:hover {
    background-color: rgba(255, 0, 0, 0.8);
    border-color: #ffffff;
    scale: 1.03;
}

.intro-skip-btn:active {
    background-color: rgba(255, 0, 0, 1);
    scale: 0.96;
}
