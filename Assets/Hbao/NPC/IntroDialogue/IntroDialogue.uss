/* ═══════════════════════════════════════════════════════
   INTRO DIALOGUE STYLE SHEET (USS)
   White Border, Black Background, White Text
   ═══════════════════════════════════════════════════════ */

.intro-dialogue-wrapper {
    position: absolute;
    width: 100%;
    height: 100%;
    justify-content: flex-end;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    pointer-events: none;
    
    transition-property: background-color;
    transition-duration: 0.35s;
    transition-timing-function: ease-out;
}

.intro-dialogue-wrapper.show-wrapper {
    background-color: rgba(0, 0, 0, 0.65);
    pointer-events: auto;
}

/* Khung đối thoại: Nền đen tuyền, viền trắng tinh tế */
.intro-dialogue-box {
    width: 850px;
    height: 200px;
    background-color: rgba(0, 0, 0, 0.95);
    border-width: 2.5px;
    border-color: #ffffff;
    border-radius: 14px;
    flex-direction: row;
    padding: 20px 24px;
    align-items: stretch;
    margin-bottom: 60px;
    position: relative;
    
    /* Hiệu ứng đổ bóng và viền sáng mờ */
    box-shadow: 0 15px 45px rgba(0, 0, 0, 0.95), 0 0 20px rgba(255, 255, 255, 0.05);
    
    transition-property: opacity, scale;
    transition-duration: 0.3s;
    transition-timing-function: ease-out-back;
    opacity: 0;
    scale: 0.9;
}

.intro-dialogue-box.show-dialogue {
    opacity: 1;
    scale: 1;
}

/* Avatar container */
.intro-avatar-container {
    width: 140px;
    height: 100%;
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.4);
    border-radius: 8px;
    overflow: hidden;
    margin-right: 20px;
    flex-shrink: 0;
}

.intro-avatar-image {
    width: 100%;
    height: 100%;
    background-color: #000000;
    -unity-background-scale-mode: scale-and-crop;
}

/* Vùng chứa text đối thoại */
.intro-text-container {
    flex-grow: 1;
    justify-content: space-between;
    position: relative;
}

/* Tên nhân vật nói */
.intro-speaker-name {
    color: #ffffff;
    font-size: 19px;
    -unity-font-style: bold;
    margin-bottom: 8px;
    letter-spacing: 0.5px;
}

/* Nội dung hội thoại */
.intro-dialogue-text {
    color: #ffffff;
    font-size: 15.5px;
    line-height: 24px;
    -unity-font-style: normal;
    white-space: normal;
    flex-grow: 1;
}

/* Nút Next ở góc dưới bên phải */
.intro-next-btn {
    align-self: flex-end;
    background-color: transparent;
    color: #ffffff;
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.6);
    border-radius: 6px;
    font-size: 11px;
    -unity-font-style: bold;
    padding: 6px 16px;
    margin: 0;
    letter-spacing: 0.5px;
    cursor: pointer;
    
    transition-property: background-color, border-color, scale;
    transition-duration: 0.15s;
}

.intro-next-btn:hover {
    background-color: rgba(255, 255, 255, 0.15);
    border-color: #ffffff;
    scale: 1.05;
}

.intro-next-btn:active {
    background-color: rgba(255, 255, 255, 0.3);
    scale: 0.95;
}

/* Nút SKIP (Bỏ qua toàn bộ) ở góc trên bên phải khung thoại */
.intro-skip-btn {
    position: absolute;
    top: 15px;
    right: 20px;
    background-color: rgba(0, 0, 0, 0.85);
    color: #ffffff;
    border-width: 2px;
    border-color: #ffffff;
    border-radius: 8px;
    font-size: 11px;
    -unity-font-style: bold;
    padding: 6px 18px;
    margin: 0;
    letter-spacing: 1px;
    cursor: pointer;
    
    transition-property: background-color, scale, border-color;
    transition-duration: 0.15s;
}

.intro-skip-btn:hover {
    background-color: rgba(255, 0, 0, 0.8);
    border-color: #ffffff;
    scale: 1.03;
}

.intro-skip-btn:active {
    background-color: rgba(255, 0, 0, 1);
    scale: 0.96;
}
