.dialogue-wrapper {
    position: absolute;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    pointer-events: none;
    
    transition-property: background-color;
    transition-duration: 0.35s;
    transition-timing-function: ease-out;
}

.dialogue-wrapper.show-wrapper {
    background-color: rgba(0, 0, 0, 0.78);
    pointer-events: auto;
}

/* ═══════════════════════════════════════════════════════
   GỢI Ý TƯƠNG TÁC PHÍM G (CHÍNH GIỮA SÁT TRÁI)
   ═══════════════════════════════════════════════════════ */
.silas-interaction-prompt {
    position: absolute;
    top: 50%;
    left: 2%; /* Sát mép trái */
    translate: -20px -50%;
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0); /* Trong suốt hoàn toàn */
    border-width: 0px; /* Xóa bỏ viền trắng */
    border-color: rgba(0, 0, 0, 0);
    border-radius: 0px;
    padding: 10px 18px;
    opacity: 0;
    scale: 0.8;
    
    transition-property: opacity, scale, translate;
    transition-duration: 0.35s;
    transition-timing-function: ease-out-back;
    pointer-events: none;
    z-index: 1005;
}

.silas-interaction-prompt.show-prompt {
    opacity: 1;
    scale: 1;
    translate: 0 -50%;
}

.key-badge-g {
    width: 28px;
    height: 28px;
    background-color: #ffffff;
    border-radius: 6px;
    border-width: 1px;
    border-color: #c8c8c8;
    justify-content: center;
    align-items: center;
    margin-right: 12px;
    box-shadow: 0 3px 0 #b4b4b4;
}

.key-badge-g-text {
    color: #0f0f0f;
    -unity-font-style: bold;
    font-size: 15px;
    padding: 0;
    margin: 0;
}

.silas-interaction-text {
    color: #ffffff;
    -unity-font-style: bold;
    font-size: 16px;
    letter-spacing: 0.5px;
    padding: 0;
    margin: 0;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.95);
}

/* ═══════════════════════════════════════════════════════
   KHUNG HỘI THOẠI CHÍNH (VIỀN TRẮNG, NỀN ĐEN ĐỔ BÓNG)
   ═══════════════════════════════════════════════════════ */
.dialogue-box {
    width: 950px;
    height: 320px;
    background-color: rgba(0, 0, 0, 0.96); /* Đen tuyền huyền bí */
    border-width: 2.5px;
    border-color: #ffffff; /* Viền trắng sang trọng */
    border-radius: 20px;
    flex-direction: row;
    padding: 0;
    align-items: stretch;
    overflow: hidden;
    position: relative;
    
    /* Đổ bóng đen siêu sâu + viền sáng nhẹ xung quanh */
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.98), 0 0 30px rgba(255, 255, 255, 0.08), inset 0 0 40px rgba(0, 0, 0, 0.85);
    
    transition-property: opacity, scale;
    transition-duration: 0.35s;
    transition-timing-function: ease-out-back;
    opacity: 0;
    scale: 0.88;
}

.dialogue-box.show-dialogue {
    opacity: 1;
    scale: 1;
}

/* ═══════════════════════════════════════════════════════
   CHI TIẾT TRANG TRÍ RONG RÊU XANH LÁ (CORNER MOSS)
   ═══════════════════════════════════════════════════════ */
.corner-deco {
    position: absolute;
    width: 42px;
    height: 42px;
    border-width: 3.5px;
    border-color: rgba(34, 197, 94, 0.75); /* Rong rêu màu xanh lá phát sáng */
    pointer-events: none;
    
    /* Đổ bóng rêu ma thuật phát sáng xanh lá */
    box-shadow: 0 0 14px rgba(34, 197, 94, 0.5);
    
    transition-property: opacity, border-color;
    transition-duration: 0.8s;
}

.corner-tl {
    top: -2.5px;
    left: -2.5px;
    border-right-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 18px;
}

.corner-tr {
    top: -2.5px;
    right: -2.5px;
    border-left-width: 0;
    border-bottom-width: 0;
    border-top-right-radius: 18px;
}

.corner-bl {
    bottom: -2.5px;
    left: -2.5px;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-left-radius: 18px;
}

.corner-br {
    bottom: -2.5px;
    right: -2.5px;
    border-left-width: 0;
    border-top-width: 0;
    border-bottom-right-radius: 18px;
}

/* Hào quang rong rêu ma thuật chạy ngang viền trên/dưới */
.moss-top {
    position: absolute;
    top: -1.5px;
    left: 60px;
    right: 60px;
    height: 3px;
    background-image: linear-gradient(to right, rgba(34, 197, 94, 0), rgba(34, 197, 94, 0.85), rgba(74, 222, 128, 1), rgba(34, 197, 94, 0.85), rgba(34, 197, 94, 0));
    border-radius: 1.5px;
    pointer-events: none;
    box-shadow: 0 0 12px rgba(34, 197, 94, 0.75), 0 0 20px rgba(34, 197, 94, 0.35);
}

.moss-bottom {
    position: absolute;
    bottom: -1.5px;
    left: 60px;
    right: 60px;
    height: 3px;
    background-image: linear-gradient(to right, rgba(34, 197, 94, 0), rgba(34, 197, 94, 0.85), rgba(74, 222, 128, 1), rgba(34, 197, 94, 0.85), rgba(34, 197, 94, 0));
    border-radius: 1.5px;
    pointer-events: none;
    box-shadow: 0 0 12px rgba(34, 197, 94, 0.75), 0 0 20px rgba(34, 197, 94, 0.35);
}

/* ═══════════════════════════════════════════════════════
   AVATAR - CHIẾM TRỌN BÊN TRÁI
   ═══════════════════════════════════════════════════════ */
.dialogue-avatar-container {
    width: 240px;
    height: 100%;
    position: relative;
    flex-shrink: 0;
    overflow: hidden;
}

.dialogue-avatar-image {
    width: 100%;
    height: 100%;
    background-color: #000000;
    -unity-background-scale-mode: scale-and-crop;
}

/* Gradient hòa quyện mềm mại từ avatar sang vùng text */
.avatar-fade-right {
    position: absolute;
    top: 0;
    right: 0;
    width: 60px;
    height: 100%;
    background-image: linear-gradient(to right, rgba(0, 0, 0, 0), rgba(0, 0, 0, 1));
    pointer-events: none;
}

/* ═══════════════════════════════════════════════════════
   PHẦN NỘI DUNG CHỮ (CHỈ CHẠY TEXT THOẠI)
   ═══════════════════════════════════════════════════════ */
.dialogue-text-container {
    flex-grow: 1;
    height: 100%;
    padding-left: 28px;
    padding-right: 28px;
    padding-top: 32px;
    padding-bottom: 24px;
    justify-content: flex-start; /* Sắp xếp sát lại gần nhau thay vì đẩy xa */
}

.dialogue-text-inner-wrapper {
    flex-grow: 0; /* Không kéo giãn chiều cao nữa để tránh đẩy các nút lựa chọn ra quá xa */
    margin-bottom: 16px; /* Khoảng cách 16px cực đẹp giữa lời thoại và ô lựa chọn */
}

.dialogue-text-content {
    color: #e8ecf1;
    font-size: 17px;
    line-height: 26px;
    -unity-font-style: normal;
    white-space: normal;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.95);
}

/* ═══════════════════════════════════════════════════════
   BUTTON TIẾP TỤC (MÀU VIỀN TRẮNG / CHỮ TRẮNG PHÙ HỢP KHUNG)
   ═══════════════════════════════════════════════════════ */
.dialogue-next-button {
    align-self: flex-end;
    background-color: rgba(0, 0, 0, 0.85);
    color: #ffffff;
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.7);
    border-radius: 6px;
    font-size: 11px;
    -unity-font-style: bold;
    padding: 9px 20px;
    margin-bottom: 0;
    margin-right: 0;
    letter-spacing: 1px;
    
    transition-property: background-color, color, scale, border-color, box-shadow;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.dialogue-next-button:hover {
    background-color: rgba(255, 255, 255, 0.2);
    color: #ffffff;
    border-color: #ffffff;
    scale: 1.04;
    box-shadow: 0 0 15px rgba(255, 255, 255, 0.25);
}

.dialogue-next-button:active {
    background-color: rgba(255, 255, 255, 0.35);
    color: #ffffff;
    scale: 0.96;
    box-shadow: 0 0 6px rgba(255, 255, 255, 0.15);
}

.dialogue-choices-container {
    flex-direction: column;
    align-self: stretch;
    margin-top: 10px;
    margin-bottom: 2px;
}
.dialogue-choice-button {
    background-color: rgba(0, 0, 0, 0); /* Mặc định trong suốt hoàn toàn */
    color: #e8ecf1;
    border-width: 1.5px;
    border-color: rgba(0, 0, 0, 0); /* Không có viền mặc định */
    border-radius: 8px;
    font-size: 14px;
    -unity-font-style: normal;
    padding: 8px 16px;
    margin-bottom: 6px;
    margin-left: 0;
    -unity-text-align: middle-left;
    transition-property: background-color, border-color, margin-left, scale, box-shadow;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}
.dialogue-choice-button:hover {
    background-color: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.95);
    margin-left: 6px;
    scale: 1.01;
    color: #ffffff;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.8), 0 0 16px rgba(255, 255, 255, 0.1);
}
.dialogue-choice-button:active {
    background-color: rgba(255, 255, 255, 0.25);
    border-color: #ffffff;
    scale: 0.98;
}
