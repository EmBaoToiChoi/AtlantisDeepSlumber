<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Hbao/NPC/SilasDialogue.uss" />
    <ui:VisualElement name="silas-dialogue-wrapper" class="dialogue-wrapper">
        
        <!-- Ô gợi ý tương tác phím G nằm bên chính giữa sát trái màn hình -->
        <ui:VisualElement name="silas-interaction-prompt" class="silas-interaction-prompt">
            <ui:VisualElement class="key-badge-g">
                <ui:Label text="G" class="key-badge-g-text" />
            </ui:VisualElement>
            <ui:Label text="Ấn [G] để trò chuyện" class="silas-interaction-text" />
        </ui:VisualElement>

        <!-- Khung đối thoại chính -->
        <ui:VisualElement name="silas-dialogue-box" class="dialogue-box">

            <!-- Các chi tiết rong rêu trang trí 4 góc -->
            <ui:VisualElement class="corner-deco corner-tl" />
            <ui:VisualElement class="corner-deco corner-tr" />
            <ui:VisualElement class="corner-deco corner-bl" />
            <ui:VisualElement class="corner-deco corner-br" />

            <!-- Rong rêu ma thuật / Hào quang xanh lá chạy dọc viền -->
            <ui:VisualElement class="moss-top" />
            <ui:VisualElement class="moss-bottom" />

            <!-- Avatar chiếm toàn bộ chiều cao bên trái, không padding -->
            <ui:VisualElement name="avatar-container" class="dialogue-avatar-container">
                <ui:VisualElement name="avatar-image" class="dialogue-avatar-image" />
                <!-- Gradient chuyển mờ dần từ ảnh sang nội dung text -->
                <ui:VisualElement class="avatar-fade-right" />
            </ui:VisualElement>

            <!-- Nội dung text (chỉ chạy nội dung thoại, không hiện tên Silas) -->
            <ui:VisualElement name="dialogue-text-container" class="dialogue-text-container">
                <ui:VisualElement class="dialogue-text-inner-wrapper">
                    <ui:Label name="dialogue-text" text="Rakan vừa gửi mấy 'con cừu' tới đây sao?..." class="dialogue-text-content" />
                </ui:VisualElement>
                <ui:Button name="next-btn" text="CLICK HOẶC ẤN [F] ĐỂ TIẾP TỤC ▶" class="dialogue-next-button" />
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
