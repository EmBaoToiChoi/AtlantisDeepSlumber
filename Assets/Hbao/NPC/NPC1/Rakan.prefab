--- !u!114 &2116312669897932810
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1394542076506809148}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 637aa8360cafa1341b1145066c882da3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  ShowTopMostFoldoutHeaderGroup: 1
  dialogueLines:
  - speakerName: Rakan
    text: "\"Arthur... v\xE0 nh\u1EEFng k\u1EBB ngo\u1EA1i t\u1ED9c. Ta nghe ti\u1EBFng
      b\u01B0\u1EDBc ch\xE2n c\xE1c ng\u01B0\u01A1i t\u1EEB xa. C\xE1c ng\u01B0\u01A1i
      t\u1EDBi \u0111\xE2y t\xECm ki\u1EBFm c\xE1i ch\u1EBFt hay vinh quang?\""
    customAvatar: {fileID: 0}
  - speakerName: Arthur
    text: "\"Ch\xFAng t\xF4i t\xECm \u0111\u01B0\u1EDDng \u0111\u1EBFn Cung \u0111i\u1EC7n
      Ho\xE0ng gia!\""
    customAvatar: {fileID: 0}
  - speakerName: Rakan
    text: "\"Cung \u0111i\u1EC7n Ho\xE0ng gia? L\u1ED1i \u0111i ph\xEDa tr\u01B0\u1EDBc
      \u0111\xE3 b\u1ECB kh\xF3a ch\u1EB7t r\u1ED3i. Silas l\u1EA9m c\u1EA9m canh
      g\xE1c ngo\xE0i kia ch\u1EAFc c\u0169ng k\u1EC3 cho c\xE1c ng\u01B0\u01A1i
      v\u1EC1 nh\u1EEFng vi\xEAn ng\u1ECDc r\u1ED3i \u0111\xFAng kh\xF4ng?\""
    customAvatar: {fileID: 0}
  triggerRadius: 3
