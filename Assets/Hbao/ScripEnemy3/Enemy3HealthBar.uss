.main-container {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    padding: 20px;
}

.enemy-name {
    color: rgb(255, 215, 0); /* Màu vàng Gold rực rỡ */
    font-size: 70px;
    -unity-font-style: bold;
    text-shadow: 4px 4px 6px rgba(230, 90, 0, 0.95); /* Hào quang cam vàng ma mị quyền lực */
    margin-bottom: 20px;
    letter-spacing: 2px;
}

.container {
    width: 90%;
    height: 120px;
}

.background {
    width: 100%;
    height: 100%;
    background-color: rgba(12, 6, 2, 0.85); /* Nền đen pha hổ phách thẫm */
    border-width: 8px;
    border-color: rgb(255, 140, 0); /* Viền màu vàng cam neon cực đẹp */
    border-radius: 24px;
    overflow: hidden;
    padding: 8px;
    box-shadow: 0px 0px 30px rgba(255, 140, 0, 0.65); /* Hào quang cam dạ quang toát lên vẻ hung hãn */
}

.progress-bar {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(255, 40, 0); /* Đỏ cam rực cháy */
    border-radius: 12px;
    transition-property: width;
    transition-duration: 0.15s; /* Máu tụt nhanh phản hồi ngay lập tức */
    transition-timing-function: ease-out;
    background-image: linear-gradient(to bottom, rgba(255, 255, 255, 0.45), rgba(0, 0, 0, 0.35));
}

.yellow-bar {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(255, 215, 0); /* Thanh vàng gold tụt chậm nghệ thuật */
    border-radius: 12px;
    transition-property: width;
    transition-duration: 0.75s; /* Trễ chậm nhịp để thấy rõ lượng HP đã mất */
    transition-timing-function: ease-in-out;
}
