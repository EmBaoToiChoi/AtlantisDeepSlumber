.main-container {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    padding: 10px;
}

.enemy-name {
    color: rgb(255, 245, 220);
    font-size: 84px;
    -unity-font-style: bold;
    text-shadow: 4px 4px 8px rgba(0, 0, 0, 0.95);
    margin-bottom: 16px;
    letter-spacing: 2px;
}

.container {
    width: 95%;
    height: 200px;
    position: relative;
    align-items: center;
    justify-content: center;
}

/* Nền tối và ruột máu nằm lọt 100% bên trong lòng khung viền vàng, bóp góc vát 2 bên */
.background {
    position: absolute;
    top: 44px;
    bottom: 44px;
    left: 88px;
    right: 88px;
    background-color: rgba(14, 8, 6, 0.95);
    border-radius: 36px;
    border-width: 0;
    overflow: hidden;
    padding: 0;
}

/* Thanh máu đỏ chiến đấu tươi sáng, bo góc vát khít mép khung */
.progress-bar {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgb(230, 20, 20);
    border-radius: 36px;
    transition-property: width;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
    background-image: linear-gradient(to bottom, rgba(255, 255, 255, 0.45), rgba(0, 0, 0, 0.25));
}

/* Khung SPR_FantasyMenus_Menu_Button_03_Frame nằm đè lên trên thanh fill máu */
.health-bar-frame-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Menu_Button_03_Frame.png?fileID=1537655665&guid=9edb3fd596a99454e80f70bfecfa5769&type=3#SPR_FantasyMenus_Menu_Button_03_Frame");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 360;
    -unity-slice-top: 0;
    -unity-slice-right: 360;
    -unity-slice-bottom: 0;
    pointer-events: none;
}
