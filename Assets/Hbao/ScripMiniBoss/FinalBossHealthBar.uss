/* Premium Final Boss HUD Container at top center */
.finalboss-hud-container {
    display: none;
    position: absolute;
    top: 20px;
    left: 50%;
    translate: -50% 0;
    width: 750px;
    height: auto;
    min-height: 100px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    background-color: rgba(14, 9, 5, 0.92);
    border-width: 0;
    padding: 16px 36px;
    box-shadow: 0px 8px 24px rgba(0, 0, 0, 0.9);
}

/* Khung ngoài Frame_Box_Medium_02 phóng to và kéo dài ôm trọn toàn bộ nền đen */
.finalboss-hud-outer-frame {
    position: absolute;
    top: -32px;
    left: -58px;
    right: -58px;
    bottom: -32px;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Box_Medium_02.png?fileID=1537655665&guid=4c83811485b435e4a93a37b73758d514&type=3#SPR_FantasyMenus_Frame_Box_Medium_02");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 80;
    -unity-slice-top: 80;
    -unity-slice-right: 80;
    -unity-slice-bottom: 80;
    pointer-events: none;
}

/* Khung viền avatar của Boss (80x80px hình vuông hoàng kim) */
.finalboss-avatar-frame {
    width: 80px;
    height: 80px;
    position: relative;
    overflow: hidden;
    background-color: rgb(20, 15, 12);
    border-radius: 6px;
    margin-right: 14px;
    box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.7);
    flex-shrink: 0;
}

/* Avatar Image */
.finalboss-avatar {
    position: absolute;
    top: 4px;
    left: 4px;
    right: 4px;
    bottom: 4px;
    border-radius: 4px;
    -unity-background-scale-mode: scale-and-crop;
    background-image: url("project://database/Assets/Hbao/Image/finalboss_avatar.png");
}

/* Khung Frame_Box_Small_01 bọc ngoài Avatar */
.finalboss-avatar-frame-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Box_Small_01.png?fileID=1537655665&guid=de8d5504716fd5e49b71bc5dd31b1238&type=3#SPR_FantasyMenus_Frame_Box_Small_01");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 100;
    -unity-slice-top: 100;
    -unity-slice-right: 100;
    -unity-slice-bottom: 100;
    pointer-events: none;
}

/* HP bar details and headers */
.finalboss-hp-wrapper {
    flex-grow: 1;
    justify-content: center;
}

/* Header layout holding Title and Name */
.finalboss-header {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 3px;
}

/* Small gothic flavor title above the name */
.finalboss-title {
    color: rgba(255, 180, 100, 0.85);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    text-transform: uppercase;
}

/* Final Boss Name */
.finalboss-name {
    color: rgb(255, 255, 255);
    font-size: 16px;
    -unity-font-style: bold;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.95);
    letter-spacing: 1px;
    text-transform: uppercase;
}

/* Health Bar container */
.finalboss-health-bar-container {
    width: 100%;
    height: 28px;
    position: relative;
    justify-content: center;
}

/* Background of progress bar - Inset gọn gàng bên trong khung frame_powerup */
.finalboss-hp-background {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 10px;
    right: 32px;
    background-color: rgba(18, 10, 6, 0.95);
    border-radius: 2px;
    border-width: 0;
    overflow: hidden;
}

/* Draining yellow bar (glowing amber) */
.finalboss-hp-yellow-bar {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(235, 190, 30);
    border-radius: 2px;
    transition-property: width;
    transition-duration: 0.65s;
    transition-timing-function: ease-in-out;
}

/* Main vibrant red health progress bar */
.finalboss-hp-progress-bar {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(215, 30, 20);
    border-radius: 2px;
    transition-property: width;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
    background-image: linear-gradient(to bottom, rgba(255, 255, 255, 0.38), rgba(0, 0, 0, 0.28));
}

/* Health text overlay */
.finalboss-hp-text {
    position: absolute;
    width: 100%;
    height: 100%;
    color: rgb(255, 255, 255);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.95);
}

/* Khung frame_powerup bọc chuẩn bên ngoài thanh máu chính */
.finalboss-hp-frame-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url("project://database/Assets/Artsystack - Fantasy RPG GUI/Resources/Sprites/components/frame_powerup.png?fileID=1537655665&guid=47d595e42a1be9f438e7034c86ce73ef&type=3#frame_powerup");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 80;
    -unity-slice-top: 0;
    -unity-slice-right: 80;
    -unity-slice-bottom: 0;
    pointer-events: none;
}

/* Hit Shake Animation */
@keyframes finalboss-shake-anim {
    0% { margin-left: 0px; margin-top: 0px; }
    15% { margin-left: -12px; margin-top: -4px; }
    30% { margin-left: 12px; margin-top: 4px; }
    45% { margin-left: -8px; margin-top: 2px; }
    60% { margin-left: 8px; margin-top: -2px; }
    75% { margin-left: -4px; margin-top: 1px; }
    90% { margin-left: 4px; margin-top: -1px; }
    100% { margin-left: 0px; margin-top: 0px; }
}

.finalboss-hud-container.shake {
    animation-name: finalboss-shake-anim;
    animation-duration: 0.25s;
}

/* Hit Flash Animation */
@keyframes finalboss-flash-anim {
    0% { background-color: rgb(255, 255, 255); }
    100% { background-color: rgb(215, 30, 20); }
}

.finalboss-hp-progress-bar.flash {
    animation-name: finalboss-flash-anim;
    animation-duration: 0.18s;
}

/* Hit Shake Animation */
@keyframes finalboss-shake-anim {
    0% { margin-left: 0px; margin-top: 0px; }
    15% { margin-left: -12px; margin-top: -4px; }
    30% { margin-left: 12px; margin-top: 4px; }
    45% { margin-left: -8px; margin-top: 2px; }
    60% { margin-left: 8px; margin-top: -2px; }
    75% { margin-left: -4px; margin-top: 1px; }
    90% { margin-left: 4px; margin-top: -1px; }
    100% { margin-left: 0px; margin-top: 0px; }
}

.finalboss-hud-container.shake {
    animation-name: finalboss-shake-anim;
    animation-duration: 0.25s;
}

/* Hit Flash Animation */
@keyframes finalboss-flash-anim {
    0% { background-color: rgb(255, 255, 255); }
    100% { background-color: rgb(230, 20, 20); }
}

.finalboss-hp-progress-bar.flash {
    animation-name: finalboss-flash-anim;
    animation-duration: 0.18s;
}
