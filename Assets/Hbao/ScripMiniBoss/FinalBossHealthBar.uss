/* Premium Final Boss HUD Container at top center */
.finalboss-hud-container {
    display: none;
    position: absolute;
    top: 25px;
    left: 50%;
    translate: -50% 0;
    width: 600px;
    height: 84px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    background-color: rgba(6, 6, 8, 0.92);
    border-width: 2px;
    border-color: rgb(230, 20, 20); /* Neon Crimson Cyber red */
    border-radius: 14px;
    padding: 8px 16px;
    box-shadow: 0px 12px 36px rgba(0, 0, 0, 0.95), 0px 0px 25px rgba(230, 20, 20, 0.4), inset 0px 0px 16px rgba(255, 0, 0, 0.18);
    transition-property: all;
    transition-duration: 0.15s;
}

/* Cybernetic Gold/Metal Avatar Frame */
.finalboss-avatar-frame {
    width: 60px;
    height: 60px;
    border-width: 2px;
    border-color: rgb(255, 45, 45); /* Crimson red glowing frame */
    border-radius: 30px;
    overflow: hidden;
    background-color: rgb(15, 15, 18);
    margin-right: 14px;
    box-shadow: 0px 6px 12px rgba(0, 0, 0, 0.8), 0px 0px 15px rgba(255, 30, 0, 0.55);
    flex-shrink: 0;
}

/* Avatar Image */
.finalboss-avatar {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-and-crop;
    background-image: url("project://database/Assets/Hbao/Image/finalboss_avatar.png");
}

/* HP bar details and headers */
.finalboss-hp-wrapper {
    flex-grow: 1;
    justify-content: center;
}

/* Header layout holding Title and Name */
.finalboss-header {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 4px;
}

/* Small gothic flavor title above the name */
.finalboss-title {
    color: rgba(255, 80, 80, 0.7);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    text-transform: uppercase;
}

/* Final Boss Name */
.finalboss-name {
    color: rgb(255, 255, 255);
    font-size: 18px;
    -unity-font-style: bold;
    text-shadow: 0px 4px 8px rgba(0, 0, 0, 0.95);
    letter-spacing: 1.5px;
    text-transform: uppercase;
}

/* Health Bar container */
.finalboss-health-bar-container {
    width: 100%;
    height: 24px;
}

/* Background of progress bar */
.finalboss-hp-background {
    width: 100%;
    height: 100%;
    background-color: rgba(12, 10, 10, 0.95);
    border-width: 2px;
    border-color: rgb(180, 20, 20);
    border-radius: 6px;
    overflow: hidden;
    position: relative;
    box-shadow: inset 0px 4px 10px rgba(0, 0, 0, 0.85);
}

/* Draining yellow bar (glowing amber) */
.finalboss-hp-yellow-bar {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(255, 140, 0); /* Darker gold/orange transition */
    border-radius: 4px;
    transition-property: width;
    transition-duration: 0.65s;
    transition-timing-function: ease-in-out;
}

/* Main vibrant red health progress bar */
.finalboss-hp-progress-bar {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(230, 20, 20); /* Pure crimson red */
    border-radius: 4px;
    transition-property: width;
    transition-duration: 0.1s;
    transition-timing-function: ease-out;
    background-image: linear-gradient(to bottom, rgba(255, 60, 60, 0.55), rgba(120, 0, 0, 0.6));
    box-shadow: 0px 0px 10px rgba(255, 30, 30, 0.65);
}

/* Health text overlay */
.finalboss-hp-text {
    position: absolute;
    width: 100%;
    height: 100%;
    color: rgb(255, 240, 240);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.95);
    letter-spacing: 1px;
}

/* Hit Shake Animation */
@keyframes finalboss-shake-anim {
    0% { margin-left: 0px; margin-top: 0px; }
    15% { margin-left: -12px; margin-top: -4px; }
    30% { margin-left: 12px; margin-top: 4px; }
    45% { margin-left: -8px; margin-top: 2px; }
    60% { margin-left: 8px; margin-top: -2px; }
    75% { margin-left: -4px; margin-top: 1px; }
    90% { margin-left: 4px; margin-top: -1px; }
    100% { margin-left: 0px; margin-top: 0px; }
}

.finalboss-hud-container.shake {
    animation-name: finalboss-shake-anim;
    animation-duration: 0.25s;
    border-color: rgb(255, 80, 80);
    box-shadow: 0px 12px 36px rgba(0, 0, 0, 0.95), 0px 0px 35px rgba(255, 0, 0, 0.7);
}

/* Hit Flash Animation */
@keyframes finalboss-flash-anim {
    0% { background-color: rgb(255, 255, 255); }
    100% { background-color: rgb(230, 20, 20); }
}

.finalboss-hp-progress-bar.flash {
    animation-name: finalboss-flash-anim;
    animation-duration: 0.18s;
}
