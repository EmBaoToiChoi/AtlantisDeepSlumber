/* Main container at the top center of the screen */
.miniboss-hud-container {
    display: none;
    position: absolute;
    top: 20px;
    left: 50%;
    translate: -50% 0;
    width: 750px;
    height: auto;
    min-height: 100px;
    align-items: center;
    justify-content: center;
    background-color: rgba(14, 9, 5, 0.92);
    border-width: 0;
    padding: 16px 36px 18px 36px;
    box-shadow: 0px 8px 24px rgba(0, 0, 0, 0.9);
    overflow: visible;
}

/* Ẩn miniboss-hud-bg vì màu nền tối và đổ bóng đã áp trực tiếp trên container chính */
.miniboss-hud-bg {
    display: none;
}

/* Khung ngoài Frame_Box_Medium_02 phóng to ôm trọn bên ngoài HUD mà không đè vào chữ, avatar hay thanh máu */
.miniboss-hud-outer-frame {
    position: absolute;
    top: -32px;
    left: -58px;
    right: -58px;
    bottom: -32px;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Box_Medium_02.png?fileID=1537655665&guid=4c83811485b435e4a93a37b73758d514&type=3#SPR_FantasyMenus_Frame_Box_Medium_02");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 80;
    -unity-slice-top: 80;
    -unity-slice-right: 80;
    -unity-slice-bottom: 80;
    pointer-events: none;
}

/* Nội dung bên trong căn chỉnh hàng ngang gọn gàng, thoáng đãng */
.miniboss-hud-content {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
}

/* Khung viền avatar của MiniBoss (80x80px hình vuông hoàng kim) */
.miniboss-avatar-frame {
    width: 80px;
    height: 80px;
    position: relative;
    overflow: hidden;
    background-color: rgb(20, 15, 12);
    border-radius: 6px;
    margin-right: 14px;
    box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.7);
    flex-shrink: 0;
}

.miniboss-avatar {
    position: absolute;
    top: 4px;
    left: 4px;
    right: 4px;
    bottom: 4px;
    border-radius: 4px;
    -unity-background-scale-mode: scale-and-crop;
    background-image: url("project://database/Assets/Hbao/Image/miniboss_avatar.png");
}

.miniboss-avatar-frame-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Box_Small_01.png?fileID=1537655665&guid=de8d5504716fd5e49b71bc5dd31b1238&type=3#SPR_FantasyMenus_Frame_Box_Small_01");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 100;
    -unity-slice-top: 100;
    -unity-slice-right: 100;
    -unity-slice-bottom: 100;
    pointer-events: none;
}

.miniboss-hp-wrapper {
    flex-grow: 1;
    justify-content: center;
}

.miniboss-name {
    color: rgb(255, 255, 255);
    font-size: 16px;
    -unity-font-style: bold;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.95);
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 4px;
}

.miniboss-health-bar-container {
    width: 100%;
    height: 28px;
    position: relative;
    justify-content: center;
}

/* Background of progress bar - Inset gọn gàng bên trong khung frame_powerup (right: 32px để cắt trước góc vát) */
.miniboss-hp-background {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 10px;
    right: 32px;
    background-color: rgba(18, 10, 6, 0.95);
    border-radius: 2px;
    border-width: 0;
    overflow: hidden;
}

.miniboss-hp-yellow-bar {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(235, 190, 30);
    border-radius: 2px;
    transition-property: width;
    transition-duration: 0.65s;
    transition-timing-function: ease-in-out;
}

.miniboss-hp-progress-bar {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(215, 30, 20);
    border-radius: 2px;
    transition-property: width;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
    background-image: linear-gradient(to bottom, rgba(255, 255, 255, 0.38), rgba(0, 0, 0, 0.28));
}

.miniboss-hp-text {
    position: absolute;
    width: 100%;
    height: 100%;
    color: rgb(255, 255, 255);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.95);
}

.miniboss-hp-frame-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url("project://database/Assets/Artsystack - Fantasy RPG GUI/Resources/Sprites/components/frame_powerup.png?fileID=1537655665&guid=47d595e42a1be9f438e7034c86ce73ef&type=3#frame_powerup");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 80;
    -unity-slice-top: 0;
    -unity-slice-right: 80;
    -unity-slice-bottom: 0;
    pointer-events: none;
}

/* ══════════════════════════════════════════════════════════ */
/*  2 SUB-HEALTH BARS FOR MINI BOSS CLONES                    */
/* ══════════════════════════════════════════════════════════ */
.clones-sub-container {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    margin-top: 10px;
    display: none;
}

.clone-hp-wrapper {
    width: 48.5%;
    flex-direction: column;
}

.clone-name {
    color: rgb(255, 200, 110);
    font-size: 11px;
    -unity-font-style: bold;
    margin-bottom: 3px;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
}

.clone-health-bar-container {
    width: 100%;
    height: 20px;
    position: relative;
    justify-content: center;
}

/* Inset chuẩn cho thanh máu phân thân, không bị lòi ra góc vát bên phải (right: 25px) */
.clone-hp-background {
    position: absolute;
    top: 3px;
    bottom: 3px;
    left: 8px;
    right: 25px;
    background-color: rgba(18, 10, 6, 0.95);
    border-radius: 2px;
    border-width: 0;
    overflow: hidden;
}

.clone-hp-yellow-bar {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(235, 190, 30);
    border-radius: 2px;
    transition-property: width;
    transition-duration: 0.5s;
    transition-timing-function: ease-in-out;
}

.clone-hp-progress-bar {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(215, 30, 20);
    border-radius: 2px;
    transition-property: width;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
    background-image: linear-gradient(to bottom, rgba(255, 255, 255, 0.35), rgba(0, 0, 0, 0.25));
}

.clone-hp-text {
    position: absolute;
    width: 100%;
    height: 100%;
    color: rgb(255, 255, 255);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.95);
}

/* Khung frame_powerup bọc quanh thanh máu phân thân */
.clone-hp-frame-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url("project://database/Assets/Artsystack - Fantasy RPG GUI/Resources/Sprites/components/frame_powerup.png?fileID=1537655665&guid=47d595e42a1be9f438e7034c86ce73ef&type=3#frame_powerup");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 60;
    -unity-slice-top: 0;
    -unity-slice-right: 60;
    -unity-slice-bottom: 0;
    pointer-events: none;
}

/* Shake and Flash Animation Effects */
@keyframes miniboss-shake-anim {
    0% { margin-left: 0px; margin-top: 0px; }
    15% { margin-left: -12px; margin-top: -4px; }
    30% { margin-left: 12px; margin-top: 4px; }
    45% { margin-left: -8px; margin-top: 2px; }
    60% { margin-left: 8px; margin-top: -2px; }
    75% { margin-left: -4px; margin-top: 1px; }
    90% { margin-left: 4px; margin-top: -1px; }
    100% { margin-left: 0px; margin-top: 0px; }
}

.miniboss-hud-container.shake {
    animation-name: miniboss-shake-anim;
    animation-duration: 0.25s;
}

@keyframes miniboss-flash-anim {
    0% { background-color: rgb(255, 255, 255); }
    100% { background-color: rgb(215, 30, 20); }
}

.miniboss-hp-progress-bar.flash {
    animation-name: miniboss-flash-anim;
    animation-duration: 0.18s;
}
