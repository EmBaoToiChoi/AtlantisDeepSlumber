/* Main container at the top center of the screen */
.miniboss-hud-container {
    display: none;
    position: absolute;
    top: 20px;
    left: 50%;
    translate: -50% 0;
    width: 750px;
    height: auto;
    min-height: 100px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    background-color: rgba(14, 9, 5, 0.92);
    border-width: 0;
    padding: 16px 36px;
    box-shadow: 0px 8px 24px rgba(0, 0, 0, 0.9);
}

/* Khung ngoài Frame_Box_Medium_02 phóng to và kéo dài ôm trọn toàn bộ nền đen */
.miniboss-hud-outer-frame {
    position: absolute;
    top: -32px;
    left: -58px;
    right: -58px;
    bottom: -32px;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Box_Medium_02.png?fileID=1537655665&guid=4c83811485b435e4a93a37b73758d514&type=3#SPR_FantasyMenus_Frame_Box_Medium_02");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 80;
    -unity-slice-top: 80;
    -unity-slice-right: 80;
    -unity-slice-bottom: 80;
    pointer-events: none;
}

/* Avatar Frame container */
.miniboss-avatar-frame {
    width: 80px;
    height: 80px;
    position: relative;
    overflow: hidden;
    background-color: rgb(20, 15, 12);
    border-radius: 6px;
    margin-right: 14px;
    box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.7);
    flex-shrink: 0;
    margin-top: 0px;
}

/* Avatar image - To rộng mở toàn bộ khung 68x68px */
.miniboss-avatar {
    position: absolute;
    top: 4px;
    left: 4px;
    right: 4px;
    bottom: 4px;
    border-radius: 4px;
    -unity-background-scale-mode: scale-and-crop;
    background-image: url("project://database/Assets/Hbao/Image/miniboss_avatar.png");
}

/* Khung viền Frame_Box_Small_01 bọc quanh toàn bộ Avatar */
.miniboss-avatar-frame-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Box_Small_01.png?fileID=1537655665&guid=de8d5504716fd5e49b71bc5dd31b1238&type=3#SPR_FantasyMenus_Frame_Box_Small_01");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 100;
    -unity-slice-top: 100;
    -unity-slice-right: 100;
    -unity-slice-bottom: 100;
    pointer-events: none;
}

/* Name and Health bar layout */
.miniboss-hp-wrapper {
    flex-grow: 1;
    justify-content: center;
}

/* Mini Boss Name label */
.miniboss-name {
    color: rgb(255, 235, 205); /* Light golden yellow */
    font-size: 16px;
    -unity-font-style: bold;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.95);
    margin-bottom: 3px;
    letter-spacing: 1px;
}

/* Container bounding the progress bar */
.miniboss-health-bar-container {
    width: 100%;
    height: 28px;
    position: relative;
    justify-content: center;
}

/* Dark background of the health bar - Inset triệt để bên trong khung */
.miniboss-hp-background {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 10px;
    right: 32px; /* Dừng trước góc vát xéo 32px để triệt để không bị lòi máu */
    background-color: rgba(18, 10, 6, 0.95);
    border-radius: 2px;
    border-width: 0;
    overflow: hidden;
}

/* Slowly draining yellow lag bar */
.miniboss-hp-yellow-bar {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(235, 190, 30); /* Draining yellow color */
    border-radius: 2px;
    transition-property: width;
    transition-duration: 0.65s;
    transition-timing-function: ease-in-out;
}

/* Main red health bar */
.miniboss-hp-progress-bar {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(215, 30, 20); /* Vibrant Crimson combat red */
    border-radius: 2px;
    transition-property: width;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
    background-image: linear-gradient(to bottom, rgba(255, 255, 255, 0.38), rgba(0, 0, 0, 0.28));
}

/* Numeric HP overlay text */
.miniboss-hp-text {
    position: absolute;
    width: 100%;
    height: 100%;
    color: rgb(255, 255, 255);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.95);
}

/* Khung frame_powerup bọc chuẩn bên ngoài thanh máu chính */
.miniboss-hp-frame-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url("project://database/Assets/Artsystack - Fantasy RPG GUI/Resources/Sprites/components/frame_powerup.png?fileID=1537655665&guid=47d595e42a1be9f438e7034c86ce73ef&type=3#frame_powerup");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 80;
    -unity-slice-top: 0;
    -unity-slice-right: 80;
    -unity-slice-bottom: 0;
    pointer-events: none;
}

/* Shake and Flash Animation Effects */
@keyframes miniboss-shake-anim {
    0% { margin-left: 0px; margin-top: 0px; }
    20% { margin-left: -8px; margin-top: -3px; }
    40% { margin-left: 8px; margin-top: 3px; }
    60% { margin-left: -5px; margin-top: 1px; }
    80% { margin-left: 5px; margin-top: -1px; }
    100% { margin-left: 0px; margin-top: 0px; }
}

.miniboss-hud-container.shake {
    animation-name: miniboss-shake-anim;
    animation-duration: 0.22s;
}

@keyframes miniboss-flash-anim {
    0% { background-color: rgb(255, 220, 200); }
    100% { background-color: rgb(215, 30, 20); }
}

.miniboss-hp-progress-bar.flash {
    animation-name: miniboss-flash-anim;
    animation-duration: 0.2s;
}

/* ══════════════════════════════════════════════════════════ */
/*  2 SUB-HEALTH BARS FOR MINI BOSS CLONES                    */
/* ══════════════════════════════════════════════════════════ */
.clones-sub-container {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    margin-top: 12px;
    display: none;
}

.clone-hp-wrapper {
    width: 48.5%;
    flex-direction: column;
}

.clone-name {
    color: rgb(255, 185, 100);
    font-size: 13px;
    -unity-font-style: bold;
    margin-bottom: 3px;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
}

.clone-health-bar-container {
    width: 100%;
    height: 22px;
    position: relative;
    justify-content: center;
}

.clone-hp-background {
    position: absolute;
    top: 3px;
    bottom: 3px;
    left: 8px;
    right: 36px; /* Dừng trước góc vát xéo 36px */
    background-color: rgba(18, 10, 6, 0.95);
    border-radius: 2px;
    border-width: 0;
    overflow: hidden;
}

.clone-hp-yellow-bar {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(235, 190, 30);
    border-radius: 2px;
    transition-property: width;
    transition-duration: 0.5s;
}

.clone-hp-progress-bar {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(190, 35, 30);
    border-radius: 2px;
    transition-property: width;
    transition-duration: 0.12s;
}

.clone-hp-text {
    position: absolute;
    width: 100%;
    height: 100%;
    color: rgb(255, 255, 255);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.95);
}

/* Khung frame_powerup bọc quanh thanh máu phân thân */
.clone-hp-frame-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url("project://database/Assets/Artsystack - Fantasy RPG GUI/Resources/Sprites/components/frame_powerup.png?fileID=1537655665&guid=47d595e42a1be9f438e7034c86ce73ef&type=3#frame_powerup");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 80;
    -unity-slice-top: 0;
    -unity-slice-right: 80;
    -unity-slice-bottom: 0;
    pointer-events: none;
}




