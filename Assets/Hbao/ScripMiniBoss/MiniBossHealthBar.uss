/* ══════════════════════════════════════════════════════════ */
/*  MINIBOSS HUD - COMPLETE FANTASY UI THEME                  */
/* ══════════════════════════════════════════════════════════ */

/* Main container at the top center of the screen */
.miniboss-hud-container {
    position: absolute;
    top: 15px;
    left: 50%;
    translate: -50% 0;
    width: 660px;
    min-height: 120px;
    height: auto;
    background-color: transparent;
    border-width: 0;
    padding: 32px 44px 24px 44px; /* Padding lớn để tránh vòm trên và tai quai 2 bên của Popup_08 */
    transition-property: all;
    transition-duration: 0.15s;
}

/* Semi-transparent dark backing plate behind the frame */
.miniboss-hud-backdrop {
    position: absolute;
    top: 20px;
    left: 24px;
    right: 24px;
    bottom: 14px;
    background-color: rgba(10, 8, 6, 0.88);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(180, 130, 40, 0.35);
    box-shadow: 0px 8px 24px rgba(0, 0, 0, 0.9), inset 0px 0px 14px rgba(0, 0, 0, 0.8);
    pointer-events: none;
}

/* ─── Hình 4 & Hình 5: Gộp Frame_Popup_08 Left + Right thành khung lớn bọc ngoài ─── */
.miniboss-hud-bg-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
    pointer-events: none;
}

.miniboss-hud-bg-left {
    width: 50%;
    height: 100%;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Popup_08_Left.png?fileID=1537655665&guid=abb86b4045d2e5640969852dd80f5c52&type=3#SPR_FantasyMenus_Frame_Popup_08_Left");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 80;
    -unity-slice-top: 80;
    -unity-slice-right: 0;
    -unity-slice-bottom: 80;
}

.miniboss-hud-bg-right {
    width: 50%;
    height: 100%;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Popup_08_Right.png?fileID=1537655665&guid=8f35cdb960b21e54eb753349807d1462&type=3#SPR_FantasyMenus_Frame_Popup_08_Right");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 0;
    -unity-slice-top: 80;
    -unity-slice-right: 80;
    -unity-slice-bottom: 80;
}

/* Content layout inside the HUD frame */
.miniboss-hud-content {
    width: 100%;
    height: 100%;
    flex-direction: row;
    align-items: flex-start;
    justify-content: flex-start;
}

/* ══════════════════════════════════════════════════════════ */
/*  Hình 2: Khung Frame_Box_Small_01 bọc hoàn toàn Avatar     */
/* ══════════════════════════════════════════════════════════ */
.miniboss-avatar-frame {
    width: 72px;
    height: 72px;
    position: relative;
    margin-right: 14px;
    flex-shrink: 0;
    margin-top: 0px;
}

/* MiniBoss Avatar image sits cleanly inside the frame */
.miniboss-avatar {
    position: absolute;
    top: 7px;
    left: 7px;
    right: 7px;
    bottom: 7px;
    background-color: rgb(20, 15, 12);
    border-radius: 4px;
    -unity-background-scale-mode: scale-and-crop;
    background-image: url("project://database/Assets/Hbao/Image/miniboss_avatar.png");
}

/* Ornate Frame Box Small 01 overlay */
.miniboss-avatar-frame-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Box_Small_01.png?fileID=1537655665&guid=de8d5504716fd5e49b71bc5dd31b1238&type=3#SPR_FantasyMenus_Frame_Box_Small_01");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 22;
    -unity-slice-top: 22;
    -unity-slice-right: 22;
    -unity-slice-bottom: 22;
    pointer-events: none;
}

/* ══════════════════════════════════════════════════════════ */
/*  MAIN BOSS HEALTH BAR & INFO                               */
/* ══════════════════════════════════════════════════════════ */
.miniboss-hp-wrapper {
    flex-grow: 1;
    justify-content: flex-start;
}

/* Mini Boss Name label */
.miniboss-name {
    color: rgb(255, 230, 160);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/PLuan/MainMenu/Font/Cinzel-Vietnamese.ttf");
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 1);
    margin-bottom: 4px;
    letter-spacing: 1.5px;
}

/* ─── Hình 3: Khung Menu_Button_03_Frame bọc thanh máu chính ─── */
.miniboss-health-bar-container {
    width: 100%;
    height: 24px;
    position: relative;
    justify-content: center;
    background-color: rgba(15, 10, 8, 0.95);
    border-radius: 4px;
}

/* Background texture of the button 03 frame */
.miniboss-hp-frame-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Menu_Button_03_Background.png?fileID=1537655665&guid=14dc3860d501b70489527d3f3358cec8&type=3#SPR_FantasyMenus_Menu_Button_03_Background");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 35;
    -unity-slice-top: 0;
    -unity-slice-right: 35;
    -unity-slice-bottom: 0;
}

/* Inner health fill container: Inset sâu 28px từ 2 đầu để KHÔNG bị lòi ra khỏi đầu kiếm của khung */
.miniboss-hp-background {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 28px;
    right: 28px;
    background-color: rgba(22, 10, 8, 0.9);
    border-radius: 2px;
    overflow: hidden;
}

/* Slowly draining yellow lag bar */
.miniboss-hp-yellow-bar {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgb(230, 175, 25);
    border-radius: 2px;
    transition-property: width;
    transition-duration: 0.65s;
    transition-timing-function: ease-in-out;
}

/* Main red health bar */
.miniboss-hp-progress-bar {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgb(215, 28, 20);
    border-radius: 2px;
    transition-property: width;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
    background-image: linear-gradient(to bottom, rgba(255, 255, 255, 0.35), rgba(0, 0, 0, 0.3));
}

/* Numeric HP overlay text */
.miniboss-hp-text {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    color: rgb(255, 255, 255);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 1);
}

/* Frame overlay wrapping on top of the health bar */
.miniboss-hp-frame-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Menu_Button_03_Frame.png?fileID=1537655665&guid=9edb3fd596a99454e80f70bfecfa5769&type=3#SPR_FantasyMenus_Menu_Button_03_Frame");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 35;
    -unity-slice-top: 0;
    -unity-slice-right: 35;
    -unity-slice-bottom: 0;
    pointer-events: none;
}

/* ══════════════════════════════════════════════════════════ */
/*  2 SUB-HEALTH BARS FOR MINI BOSS CLONES                    */
/* ══════════════════════════════════════════════════════════ */
.clones-sub-container {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    margin-top: 10px;
    display: none;
}

.clone-hp-wrapper {
    width: 48.5%;
    flex-direction: column;
}

.clone-name {
    color: rgb(255, 195, 110);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/PLuan/MainMenu/Font/Cinzel-Vietnamese.ttf");
    margin-bottom: 3px;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 1);
}

.clone-health-bar-container {
    width: 100%;
    height: 20px;
    position: relative;
    justify-content: center;
    background-color: rgba(15, 10, 8, 0.95);
    border-radius: 3px;
}

.clone-hp-frame-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Menu_Button_03_Background.png?fileID=1537655665&guid=14dc3860d501b70489527d3f3358cec8&type=3#SPR_FantasyMenus_Menu_Button_03_Background");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 25;
    -unity-slice-top: 0;
    -unity-slice-right: 25;
    -unity-slice-bottom: 0;
}

.clone-hp-background {
    position: absolute;
    top: 3px;
    bottom: 3px;
    left: 20px;
    right: 20px;
    background-color: rgba(22, 10, 8, 0.9);
    border-radius: 2px;
    overflow: hidden;
}

.clone-hp-yellow-bar {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgb(230, 175, 25);
    border-radius: 2px;
    transition-property: width;
    transition-duration: 0.5s;
}

.clone-hp-progress-bar {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgb(195, 32, 25);
    border-radius: 2px;
    transition-property: width;
    transition-duration: 0.12s;
    background-image: linear-gradient(to bottom, rgba(255, 255, 255, 0.3), rgba(0, 0, 0, 0.3));
}

.clone-hp-text {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    color: rgb(255, 255, 255);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 1);
}

.clone-hp-frame-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Menu_Button_03_Frame.png?fileID=1537655665&guid=9edb3fd596a99454e80f70bfecfa5769&type=3#SPR_FantasyMenus_Menu_Button_03_Frame");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 25;
    -unity-slice-top: 0;
    -unity-slice-right: 25;
    -unity-slice-bottom: 0;
    pointer-events: none;
}

/* ══════════════════════════════════════════════════════════ */
/*  HIT SHAKE & FLASH ANIMATION EFFECTS                       */
/* ══════════════════════════════════════════════════════════ */
@keyframes miniboss-shake-anim {
    0% { margin-left: 0px; margin-top: 0px; }
    20% { margin-left: -8px; margin-top: -3px; }
    40% { margin-left: 8px; margin-top: 3px; }
    60% { margin-left: -5px; margin-top: 1px; }
    80% { margin-left: 5px; margin-top: -1px; }
    100% { margin-left: 0px; margin-top: 0px; }
}

.miniboss-hud-container.shake {
    animation-name: miniboss-shake-anim;
    animation-duration: 0.22s;
}

@keyframes miniboss-flash-anim {
    0% { background-color: rgb(255, 220, 200); }
    100% { background-color: rgb(215, 30, 20); }
}

.miniboss-hp-progress-bar.flash {
    animation-name: miniboss-flash-anim;
    animation-duration: 0.2s;
}


