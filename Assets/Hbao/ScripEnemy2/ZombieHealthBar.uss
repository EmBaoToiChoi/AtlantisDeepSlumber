.main-container {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    padding: 20px;
}

.enemy-name {
    color: rgb(255, 255, 255);
    font-size: 70px;
    -unity-font-style: bold;
    text-shadow: 4px 4px 6px rgba(0, 0, 0, 0.9);
    margin-bottom: 20px;
    letter-spacing: 2px;
}

.container {
    width: 90%;
    height: 120px;
}

.background {
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.7);
    border-width: 8px;
    border-color: rgb(255, 255, 255); /* White border */
    border-radius: 24px;
    overflow: hidden;
    padding: 8px;
}

.progress-bar {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(255, 0, 0); /* Vibrant red */
    border-radius: 12px;
    transition-property: width;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
    background-image: linear-gradient(to bottom, rgba(255, 255, 255, 0.4), rgba(0, 0, 0, 0.2));
}

.yellow-bar {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(255, 200, 0); /* Smooth transition yellow bar */
    border-radius: 12px;
    transition-property: width;
    transition-duration: 0.8s;
    transition-timing-function: ease-in-out;
}
