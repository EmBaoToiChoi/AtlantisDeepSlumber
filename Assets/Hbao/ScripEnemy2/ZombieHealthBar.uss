.main-container {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    padding: 10px;
}

.enemy-name {
    color: rgb(255, 240, 210);
    font-size: 68px;
    -unity-font-style: bold;
    text-shadow: 4px 4px 8px rgba(0, 0, 0, 0.95);
    margin-bottom: 12px;
    letter-spacing: 2px;
}

.container {
    width: 90%;
    height: 110px;
    position: relative;
    align-items: center;
    justify-content: center;
}

/* Nền tối của thanh máu nằm lọt chuẩn bên trong khung viền */
.background {
    position: absolute;
    top: 14px;
    bottom: 14px;
    left: 20px;
    right: 20px;
    background-color: rgba(14, 8, 6, 0.95);
    border-radius: 6px;
    border-width: 0;
    overflow: hidden;
    padding: 0;
}

/* Vệt máu vàng tụt chậm (Lag Bar) */
.yellow-bar {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgb(235, 190, 30);
    border-radius: 4px;
    transition-property: width;
    transition-duration: 0.65s;
    transition-timing-function: ease-in-out;
}

/* Thanh máu đỏ chiến đấu full khung */
.progress-bar {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgb(220, 20, 20);
    border-radius: 4px;
    transition-property: width;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
    background-image: linear-gradient(to bottom, rgba(255, 255, 255, 0.4), rgba(0, 0, 0, 0.25));
}

/* Khung SPR_FantasyMenus_Menu_Button_03_Frame bọc chuẩn bên ngoài thanh máu */
.health-bar-frame-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Menu_Button_03_Frame.png?fileID=1537655665&guid=9edb3fd596a99454e80f70bfecfa5769&type=3#SPR_FantasyMenus_Menu_Button_03_Frame");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 360;
    -unity-slice-top: 0;
    -unity-slice-right: 360;
    -unity-slice-bottom: 0;
    pointer-events: none;
}
