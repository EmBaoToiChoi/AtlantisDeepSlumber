.main-container {
    align-items: center;
    justify-content: center;
    padding: 10px;
}

.enemy-name {
    color: rgb(255, 220, 220);
    font-size: 16px;
    -unity-font-style: bold;
    text-shadow: 2px 2px 4px rgba(150, 0, 0, 0.9); /* Bóng mờ màu đỏ đậm kinh dị */
    margin-bottom: 4px;
    letter-spacing: 1.5px;
}

.container {
    width: 200px;
    height: 22px;
}

.background {
    width: 100%;
    height: 100%;
    background-color: rgba(15, 5, 5, 0.75); /* Đen thẫm pha đỏ */
    border-width: 2px;
    border-color: rgb(220, 30, 30); /* Viền màu đỏ neon dạ quang */
    border-radius: 6px;
    overflow: hidden;
    padding: 2px;
    box-shadow: 0px 0px 8px rgba(255, 0, 0, 0.5); /* Hào quang đỏ mờ */
}

.progress-bar {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(240, 10, 40); /* Đỏ tươi neon cực đẹp */
    border-radius: 3px;
    transition-property: width;
    transition-duration: 0.15s; /* Tuột nhanh dứt khoát */
    transition-timing-function: ease-out;
    background-image: linear-gradient(to bottom, rgba(255, 255, 255, 0.4), rgba(0, 0, 0, 0.3));
}

.yellow-bar {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(255, 140, 0); /* Thanh vàng/cam chậm nhịp để thấy lượng máu bị mất */
    border-radius: 3px;
    transition-property: width;
    transition-duration: 0.7s; /* Tuột chậm nghệ thuật */
    transition-timing-function: ease-in-out;
}
