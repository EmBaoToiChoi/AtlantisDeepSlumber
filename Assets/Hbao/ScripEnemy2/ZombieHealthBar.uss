.main-container {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    padding: 10px;
}

.enemy-name {
    color: rgb(255, 245, 220);
    font-size: 84px;
    -unity-font-style: bold;
    text-shadow: 4px 4px 8px rgba(0, 0, 0, 0.95);
    margin-bottom: 16px;
    letter-spacing: 2px;
}

.container {
    width: 95%;
    height: 200px;
    position: relative;
    align-items: center;
    justify-content: center;
}

/* Nền tối Obsidian chính xác theo dáng ruột của khung */
.background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Menu_Button_03_Background.png?fileID=1537655665&guid=14dc3860d501b70489527d3f3358cec8&type=3#SPR_FantasyMenus_Menu_Button_03_Background");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 360;
    -unity-slice-top: 0;
    -unity-slice-right: 360;
    -unity-slice-bottom: 0;
    -unity-background-image-tint-color: rgba(14, 8, 6, 0.95);
    overflow: hidden;
    padding: 0;
}

/* Thanh máu đỏ rực rỡ lấp đầy full 100% chuẩn xác bên trong khung */
.progress-bar {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Menu_Button_03_Background.png?fileID=1537655665&guid=14dc3860d501b70489527d3f3358cec8&type=3#SPR_FantasyMenus_Menu_Button_03_Background");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 360;
    -unity-slice-top: 0;
    -unity-slice-right: 360;
    -unity-slice-bottom: 0;
    -unity-background-image-tint-color: rgb(230, 20, 20);
    transition-property: width;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
    overflow: hidden;
}

/* Khung SPR_FantasyMenus_Menu_Button_03_Frame nằm đè lên trên thanh fill máu */
.health-bar-frame-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Menu_Button_03_Frame.png?fileID=1537655665&guid=9edb3fd596a99454e80f70bfecfa5769&type=3#SPR_FantasyMenus_Menu_Button_03_Frame");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 360;
    -unity-slice-top: 0;
    -unity-slice-right: 360;
    -unity-slice-bottom: 0;
    pointer-events: none;
}
