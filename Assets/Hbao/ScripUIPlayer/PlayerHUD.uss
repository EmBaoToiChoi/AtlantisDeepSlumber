.f1-toggle-hint {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
    opacity: 0.95;
    transition-property: opacity, translate;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
}

.tutorial-details-container {
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
}

/* Fallback / legacy badge styles */
.key-badge {
    min-width: 36px;
    height: 36px;
    padding: 0 8px;
    background-color: transparent;
    justify-content: center;
    align-items: center;
    margin-right: 12px;
}

.large-key {
    min-width: 72px;
}

.key-badge-text {
    display: none;
}

.hint-text {
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    font-size: 16.5px;
    letter-spacing: 0.5px;
    padding: 0;
    margin: 0;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.95);
}

/* ========================================================================= */
/* --- Quest Panel Redesign (Fantasy Box Frame & Divider Theme) ---          */
/* ========================================================================= */
/* --- Quest Spotlight Backdrop (Đã gỡ bỏ hoàn toàn nền tối mờ màn hình) --- */
.quest-spotlight-backdrop {
    display: none;
    background-color: transparent;
    pointer-events: none;
    opacity: 0;
}

.quest-spotlight-backdrop.active {
    display: none;
    opacity: 0;
}

.quest-panel {
    position: absolute;
    top: 245px;
    right: 25px;
    left: auto;
    width: 430px;
    min-height: 215px;
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
    padding: 40px 34px 34px 34px;
    flex-direction: column;
    justify-content: center;
    z-index: 100;
    overflow: visible;
    
    /* Animation states */
    opacity: 0;
    scale: 0.8 0.8;
    translate: 50px 0;
    display: none;
    
    transition-property: opacity, scale, translate, display;
    transition-duration: 0.4s;
    transition-timing-function: ease-out-back;
}

.quest-panel.show-quest {
    display: flex;
    opacity: 1;
    scale: 1 1;
    translate: 0 0;
}

.quest-panel.spotlight-glow {
    scale: 1.03 1.03;
}

.quest-panel.spotlight-pulse-high {
    scale: 1.05 1.05;
}

.quest-panel.spotlight-pulse-low {
    scale: 1.01 1.01;
}

/* --- Quest Glowing Aura Effect (Soft Golden Drop-Shadow Bloom) --- */
.quest-glow-aura {
    position: absolute;
    top: -16px;
    left: -16px;
    right: -16px;
    bottom: -16px;
    pointer-events: none;
    background-image: url("project://database/Assets/Hbao/Image/SPR_FantasyMenus_Quest_Glow_Bloom.png?fileID=2800000&guid=8a4f129d3c509811ab910248c18f5901&type=3#SPR_FantasyMenus_Quest_Glow_Bloom");
    -unity-background-scale-mode: stretch-to-fill;
    z-index: 0;
    opacity: 0;
    scale: 0.98 0.98;
    transition-property: opacity, scale;
    transition-duration: 0.3s;
    transition-timing-function: ease-in-out;
}

.quest-glow-aura.active {
    opacity: 0.95;
    scale: 1 1;
}

.quest-glow-aura.pulse-high {
    opacity: 1;
    scale: 1.05 1.05;
}

.quest-glow-aura.pulse-low {
    opacity: 0.45;
    scale: 0.98 0.98;
}

/* --- 2-Location Pointer Indicators (Left pointing RIGHT > and Bottom pointing UP ^) --- */
.quest-pointer-left {
    position: absolute;
    top: 50%;
    left: -96px;
    margin-top: -15px;
    width: 58px;
    height: 30px;
    pointer-events: none;
    background-image: url("project://database/Assets/Hbao/Image/SPR_FantasyMenus_Menu_Item_06_Right.png?fileID=2800000&guid=e5c039d6a9456100b6ac03948c13f413&type=3#SPR_FantasyMenus_Menu_Item_06_Right");
    -unity-background-scale-mode: scale-to-fit;
    z-index: 20;
    opacity: 0;
    translate: -20px 0;
    display: none;
    transition-property: opacity, translate, scale, display;
    transition-duration: 0.3s;
    transition-timing-function: ease-out-back;
}

.quest-pointer-left.active {
    display: flex;
    opacity: 1;
    translate: 0 0;
}

.quest-pointer-left.pulse-pointing {
    translate: 18px 0;
    scale: 1.25 1.25;
}

.quest-pointer-bottom {
    position: absolute;
    bottom: -88px;
    left: 50%;
    margin-left: -15px;
    width: 30px;
    height: 58px;
    pointer-events: none;
    background-image: url("project://database/Assets/Hbao/Image/SPR_FantasyMenus_Menu_Item_06_Up.png?fileID=2800000&guid=f7d140e8b0567211c7bd14059d24e524&type=3#SPR_FantasyMenus_Menu_Item_06_Up");
    -unity-background-scale-mode: scale-to-fit;
    z-index: 20;
    opacity: 0;
    translate: 0 20px;
    display: none;
    transition-property: opacity, translate, scale, display;
    transition-duration: 0.3s;
    transition-timing-function: ease-out-back;
}

.quest-pointer-bottom.active {
    display: flex;
    opacity: 1;
    translate: 0 0;
}

.quest-pointer-bottom.pulse-pointing {
    translate: 0 -18px;
    scale: 1.25 1.25;
}

.quest-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
    background-image: url("project://database/Assets/Hbao/Image/SPR_FantasyMenus_Frame_Popup_03_Stitched_Bg.png?fileID=2800000&guid=d4b928c5f8345099a5fb92837b02e302&type=3#SPR_FantasyMenus_Frame_Popup_03_Stitched_Bg");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(6, 12, 24, 0.94);
    z-index: 1;
}

.quest-frame-border {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
    background-image: url("project://database/Assets/Hbao/Image/SPR_FantasyMenus_Frame_Popup_03_Stitched.png?fileID=2800000&guid=c3a819b4e723498894fa81726a91d201&type=3#SPR_FantasyMenus_Frame_Popup_03_Stitched");
    -unity-background-scale-mode: stretch-to-fill;
    z-index: 10;
}

.quest-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
    z-index: 2;
}

.quest-icon {
    width: 36px;
    height: 36px;
    margin-right: 10px;
    background-image: url("project://database/Assets/Hbao/Image/Go.png");
    -unity-background-scale-mode: scale-to-fit;
}

.quest-title {
    color: rgb(255, 215, 0);
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    text-shadow: 0 0 10px rgba(255, 215, 0, 0.5);
    padding: 0;
    margin: 0;
    white-space: normal;
    overflow: hidden;
    -unity-text-overflow-position: end;
    text-overflow: ellipsis;
    max-height: 40px;
    flex-shrink: 1;
    flex-grow: 1;
}

.quest-divider {
    height: 18px;
    width: 100%;
    margin: 2px 0 6px 0;
    background-image: url("project://database/Assets/Hbao/Image/SPR_FantasyMenus_Menu_Item_03_Divider.png?fileID=2800000&guid=6f8b91a2e3456789ab0123456789cd03&type=3#SPR_FantasyMenus_Menu_Item_03_Divider");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: transparent;
    border-width: 0;
    z-index: 2;
}

.quest-details {
    flex-direction: column;
    z-index: 2;
}

.quest-desc {
    color: rgb(245, 245, 245);
    font-size: 14px;
    -unity-font-style: bold;
    white-space: normal;
    overflow: hidden;
    -unity-text-overflow-position: end;
    text-overflow: ellipsis;
    max-height: 56px;
    margin-bottom: 6px;
    padding: 0;
    line-height: 18px;
}

.quest-progress-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 4px;
}

.quest-progress-text {
    color: rgb(255, 255, 255);
    font-size: 14px;
    -unity-font-style: bold;
    padding: 0;
    margin: 0;
}

.quest-progress-bg {
    width: 170px;
    height: 10px;
    background-color: rgba(0, 0, 0, 0.7);
    border-radius: 5px;
    overflow: hidden;
}

.quest-progress-fill {
    height: 100%;
    background-color: rgb(255, 180, 20);
    border-radius: 5px;
    width: 0%;
    transition-property: width;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
}

/* --- Minimap Player Icons & Indicators --- */
.minimap-player-icon {
    position: absolute;
    width: 24px;
    height: 24px;
    border-radius: 12px;
    border-width: 2px;
    border-color: rgb(255, 255, 255);
    background-color: rgb(11, 15, 25);
    justify-content: center;
    align-items: center;
}

.minimap-player-avatar {
    width: 18px;
    height: 100%;
    width: 100%;
}

/* ========================================================================= */
/* --- Hotkeys Hint System (Bảng hướng dẫn phím nóng bên trái) --- */
/* ========================================================================= */

.hotkeys-hint-panel {
    position: absolute;
    top: 25%;
    left: 30px;
    flex-direction: column;
    align-items: flex-start;
    z-index: 1000;
    pointer-events: none;
}

.hints-group {
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
}

.hint-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
    opacity: 0.9;
    transition-property: opacity, translate;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
}

.key-badge {
    min-width: 26px;
    height: 26px;
    padding: 0 8px;
    background-color: rgb(255, 255, 255);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(200, 200, 200);
    justify-content: center;
    align-items: center;
    margin-right: 12px;
    box-shadow: 0 3px 0 rgb(180, 180, 180);
}

.large-key {
    min-width: 48px;
}

.key-badge-text {
    color: rgb(15, 15, 15);
    -unity-font-style: bold;
    font-size: 14px;
    padding: 0;
    margin: 0;
    -unity-text-align: middle-center;
}

.hint-text {
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    font-size: 15px;
    letter-spacing: 0.5px;
    padding: 0;
    margin: 0;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.85);
}



/* --- Minimap Player Icons & Indicators --- */
.minimap-player-icon {
    position: absolute;
    width: 24px;
    height: 24px;
    border-radius: 12px;
    border-width: 2px;
    border-color: rgb(255, 255, 255);
    background-color: rgb(11, 15, 25);
    justify-content: center;
    align-items: center;
}

.minimap-player-avatar {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    background-size: cover;
}

.minimap-player-arrow {
    position: absolute;
    top: -4px;
    left: 9px;
    width: 6px;
    height: 6px;
    background-color: rgb(255, 255, 255);
}

/* --- World Map Player Icons & Indicators --- */
.world-map-player-icon {
    position: absolute;
    width: 32px;
    height: 32px;
    border-radius: 16px;
    border-width: 2.5px;
    border-color: rgb(255, 255, 255);
    background-color: rgb(11, 15, 25);
    justify-content: center;
    align-items: center;
}

.world-map-player-avatar {
    width: 24px;
    height: 24px;
    border-radius: 12px;
    background-size: cover;
}

.world-map-player-arrow {
    position: absolute;
    top: -5px;
    left: 12px;
    width: 8px;
    height: 8px;
    background-color: rgb(255, 255, 255);
}

.world-map-border-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
}

/* ========================================================================= */
/* --- Active Skill Cooldown / Duration Banner (Menu_Button_05 Frame) --- */
/* ========================================================================= */

.invisibility-indicator {
    display: none;
}

.speedboost-indicator,
.qskill-indicator {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 320px;
    height: 52px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-bottom: 6px;
    align-self: flex-end;
    background-image: url("project://database/Assets/Hbao/Image/SPR_FantasyMenus_Menu_Button_05_Composite.png?fileID=2800000&guid=e05a0123bc456789de0123456789ef05&type=3#SPR_FantasyMenus_Menu_Button_05_Composite");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: transparent;
    border-width: 0;
    display: none;
    z-index: 100;
}

.speedboost-indicator Label,
.qskill-indicator Label {
    color: rgb(255, 255, 255);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.95);
    padding: 0;
    margin: 0;
}

#speedboost-text,
#qskill-text {
    color: rgb(255, 255, 255);
    font-size: 12px;
    -unity-font-style: bold;
    margin-right: 12px;
}

#speedboost-timer,
#qskill-timer {
    color: rgb(255, 255, 255);
    font-size: 13px;
    -unity-font-style: bold;
}
