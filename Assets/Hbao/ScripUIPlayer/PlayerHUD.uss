.hud-main-wrapper {
    flex-direction: row;
    position: absolute;
    bottom: 30px;
    left: 30px;
    padding: 10px 16px;
    background-color: rgba(0, 0, 0, 0.15);
    border-radius: 40px;
    align-items: center;
    border-width: 0;
}

.player-avatar-container {
    width: 80px;
    height: 80px;
    border-radius: 40px;
    background-color: rgba(0, 0, 0, 0.4);
    justify-content: center;
    align-items: center;
    margin-right: 8px;
    border-width: 2px;
    border-color: rgba(40, 160, 255, 0.9);
}

.raw-player-image {
    width: 76px;
    height: 76px;
    border-radius: 38px;
    -unity-background-scale-mode: scale-and-crop;
}

.stats-wrapper {
    flex-direction: column;
    justify-content: center;
}

.level-label {
    color: rgb(255, 255, 255);
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 2px;
    padding: 0;
    letter-spacing: 1px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.5);
}

.track-bg {
    background-color: rgba(0, 0, 0, 0.45);
    margin-bottom: 1px;
    position: relative;
    overflow: hidden;
    border-width: 0;
}

.hp-track {
    width: 250px;
    height: 16px;
    border-radius: 0;
}

.mp-track {
    width: 200px;
    height: 10px;
    border-radius: 5px;
}

.exp-track {
    width: 160px;
    height: 6px;
    border-radius: 3px;
    margin-bottom: 0;
}

.fill-core {
    height: 100%;
    width: 100%;
    transition-property: width;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.segments-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

.divider {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background-color: rgba(0, 0, 0, 0.25);
}

.hp-fill {
    background-color: rgb(240, 245, 255);
    border-radius: 0;
}

.mp-fill {
    background-color: rgb(40, 160, 255);
    border-radius: 5px;
}

.exp-fill {
    background-color: rgb(75, 225, 100);
    border-radius: 3px;
}

.mic-icon-base {
    position: absolute;
    right: 0;
    bottom: -12px;
    width: 28px;
    height: 28px;
    -unity-background-scale-mode: scale-to-fit;
    transition-property: opacity, scale;
    transition-duration: 0.3s;
    transition-timing-function: ease-in-out;
}

.mic-off {
    background-image: url("project://database/Assets/Hbao/Image/Mic%20-%20Copy.png?fileID=2800000&guid=c224a90ad5cf9ad41a4c9076f3490624&type=3#Mic - Copy");
    opacity: 1;
    scale: 1 1;
}

.mic-on {
    background-image: url("project://database/Assets/Hbao/Image/Mic%201.png?fileID=2800000&guid=8315893ae6402734cab54940b270a236&type=3#Mic 1");
    opacity: 1;
    scale: 1.15 1.15;
}

.minimap-wrapper {
    position: absolute;
    top: 30px;
    right: 30px;
    width: 250px;
    height: 250px;
    border-radius: 125px;
    justify-content: center;
    align-items: center;
}

.minimap-mask {
    width: 196px;
    height: 196px;
    border-radius: 98px;
    overflow: hidden;
    background-color: rgba(10, 15, 25, 0.85);
    justify-content: center;
    align-items: center;
}

.minimap-content {
    width: 100%;
    height: 100%;
}

.minimap-grid-x {
    display: none;
    position: absolute;
    top: 98px;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: rgba(40, 160, 255, 0.2);
}

.minimap-grid-y {
    display: none;
    position: absolute;
    top: 0;
    left: 98px;
    width: 2px;
    height: 100%;
    background-color: rgba(40, 160, 255, 0.2);
}

.minimap-border {
    position: absolute;
    top: 0;
    left: 0;
    width: 250px;
    height: 250px;
    border-width: 0;
    pointer-events: none;
}

.minimap-inner-ring {
    display: none;
    position: absolute;
    top: 8px;
    left: 8px;
    width: 184px;
    height: 184px;
    border-radius: 92px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.3);
}

.minimap-deco-dot {
    display: none;
    position: absolute;
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: rgb(255, 255, 255);
}

.minimap-compass-n {
    display: none;
    position: absolute;
    top: -36px;
    color: rgb(255, 255, 255);
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.hud-weapons-wrapper {
    flex-direction: column;
    align-items: flex-end;
    position: absolute;
    bottom: 40px;
    right: 30px;
    background-color: transparent;
    padding: 0;
    border-radius: 0;
}

.weapon-slot {
    width: 210px;
    height: 63px;
    border-radius: 9px;
    background-color: rgba(15, 25, 40, 0.35);
    border-width: 1.5px;
    border-color: rgba(150, 150, 150, 0.8);
    margin-top: 10px;
    position: relative;
    overflow: hidden;
    transition-property: scale, opacity, border-color, box-shadow, background-color;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
}

.weapon-hotkey-wrapper {
    position: absolute;
    top: 6px;
    left: 8px;
    width: 22px;
    height: 22px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    justify-content: center;
    align-items: center;
}

.weapon-hotkey-container {
    position: relative;
    width: 22px;
    height: 22px;
    background-color: rgba(255, 255, 255, 0.18);
    border-radius: 6px;
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.95);
    justify-content: center;
    align-items: center;
}

.weapon-hotkey {
    color: rgb(10, 10, 10);
    -unity-font-style: bold;
    font-size: 11px;
    -unity-text-outline-width: 0;
    padding: 0;
    margin: 0;
}

.weapon-ammo-text {
    position: absolute;
    bottom: 12px;
    left: 15px;
    color: rgba(255, 255, 255, 0.85);
    font-size: 26px;
    -unity-font-style: bold;
    padding: 0;
    margin: 0;
}

.weapon-durability-bar {
    position: absolute;
    bottom: 8px;
    left: 110px;
    right: 15px;
    height: 4px;
    flex-direction: row;
}

.durability-segment {
    flex-grow: 1;
    height: 100%;
    background-color: rgba(192, 192, 192, 0.5);
    margin-right: 4px;
}

.weapon-image {
    position: absolute;
    top: 5px;
    right: 15px;
    width: 180px;
    height: 80px;
    -unity-background-scale-mode: scale-to-fit;
}

.weapon-active {
    scale: 1.15 1.15;
    opacity: 1;
    background-color: rgba(20, 35, 55, 0.5);
    border-color: rgba(170, 170, 170, 0.9);
}

.weapon-inactive {
    scale: 0.85 0.85;
    opacity: 0.35;
    border-color: rgba(100, 100, 100, 0.3);
}

.hud-skills-wrapper {
    position: absolute;
    bottom: 40px;
    left: 50%;
    translate: -50% 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.skill-slot {
    width: 70px;
    height: 70px;
    margin: 0 10px;
    background-color: rgba(20, 20, 20, 0.4);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.85);
    position: relative;
    overflow: hidden;
}

.skill-slot-center {
    width: 85px;
    height: 85px;
    margin: 0 12px;
    background-color: rgba(25, 25, 25, 0.5);
    border-radius: 16px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.85);
    position: relative;
    overflow: hidden;
}

.skill-image {
    width: 100%;
    height: 100%;
    margin: 0%;
    -unity-background-scale-mode: scale-and-crop;
    background-color: transparent;
}

.skill-img-q-maya {
    -unity-background-scale-mode: stretch-to-fill;
}

.skill-img-q-elena {
    -unity-background-scale-mode: stretch-to-fill;
}

.skill-slot .skill-image {
    border-radius: 10px;
}

.skill-slot-center .skill-image {
    border-radius: 14px;
}

.skill-cooldown-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 0%;
    background-color: rgba(0, 0, 0, 0.75);
}

.skill-cooldown-text {
    position: absolute;
    width: 100%;
    height: 100%;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    font-size: 18px; /* Tăng size text cooldown */
    text-shadow: 0 0 10px rgb(0, 0, 0);
    padding: 0;
    margin: 0;
    display: none;
}

.skill-lock-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(15, 15, 15); /* Che hoàn toàn skill khi chưa mở */
    justify-content: center;
    align-items: center;
    transition-property: background-color;
    transition-duration: 0.6s;
    transition-timing-function: ease-out;
}

.skill-lock-overlay.unlocked-anim {
    background-color: rgba(0, 0, 0, 0); /* Bóng mờ đen từ từ biến mất */
}

/* Ổ khóa */
.skill-lock-icon {
    width: 55%;
    height: 55%;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/Hbao/Image/Okhoa.png?fileID=2800000&guid=a6762048aa50f61429b3f9b9877b5028&type=3#Okhoa");
    transition-property: translate, opacity, rotate;
    transition-duration: 0.6s, 0.5s, 0.05s; /* Rotate nhanh để shake */
    transition-timing-function: ease-in-back, ease-out, ease-out;
    transform-origin: center top;
}

/* Ổ khóa lớn hơn cho slot R */
.skill-slot-main .skill-lock-icon {
    width: 48px;
    height: 45px;
}

.skill-lock-icon.shake-left {
    rotate: -12deg;
}

.skill-lock-icon.shake-right {
    rotate: 12deg;
}

/* Chỉ có ổ khóa rớt xuống khi mở */
.skill-lock-overlay.unlocked-anim .skill-lock-icon {
    translate: 0 60px;
    opacity: 0;
    rotate: 15deg;
}
/* --- Weapon Lock Styles --- */
.weapon-lock-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(15, 15, 15);
    justify-content: center;
    align-items: center;
    border-radius: 9px;
}

.weapon-lock-overlay .weapon-lock-icon {
    width: 45px;
    height: 45px;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/Hbao/Image/Okhoa.png?fileID=2800000&guid=a6762048aa50f61429b3f9b9877b5028&type=3#Okhoa");
    transition-property: scale, rotate, translate, opacity;
    transition-duration: 0.15s, 0.05s, 0.6s, 0.5s; 
    transition-timing-function: ease-out-back, ease-out, ease-in-back, ease-out;
}

.weapon-lock-overlay:hover .weapon-lock-icon {
    scale: 1.15;
}

.weapon-lock-icon.shake-left {
    rotate: -12deg;
}

.weapon-lock-icon.shake-right {
    rotate: 12deg;
}

.weapon-lock-overlay.unlocked-anim {
    background-color: rgba(0, 0, 0, 0);
    transition-property: background-color;
    transition-duration: 0.6s;
    transition-timing-function: ease-out;
}

.weapon-lock-overlay.unlocked-anim .weapon-lock-icon {
    translate: 0 80px;
    opacity: 0;
    rotate: 15deg;
}

/* --- Warning Notification Styles --- */
.weapon-warning-label {
    position: absolute;
    top: 25%;
    left: 50%;
    translate: -50% 0;
    color: rgb(255, 255, 255); /* Chữ trắng cho dễ đọc */
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(255, 0, 0); /* Viền đỏ tạo cảm giác cảnh báo */
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 12px 40px;
    background-color: rgba(15, 20, 30, 0.92); /* Nền xanh đen sâu */
    border-radius: 20px;
    border-width: 2px;
    border-color: rgba(255, 0, 0, 0.7); /* Viền đỏ rực */
    opacity: 0;
    transition-property: opacity, translate, scale;
    transition-duration: 0.4s;
    transition-timing-function: ease-out-back;
    scale: 0.8;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Examples%20&%20Extras/Fonts/Electronic%20Highway%20Sign.TTF?fileID=12800000&guid=8a2b9e2a607dd2143b58c44bc32410b4&type=3#Electronic Highway Sign");
}

.weapon-warning-label.show-warning {
    opacity: 1;
    translate: -50% -20px;
    scale: 1;
}

/* --- Skill Hotkey Indicators (Final Style) --- */
.skill-hotkey-container {
    position: absolute;
    bottom: 2px; /* Sát mép dưới hơn */
    right: 2px;  /* Sát mép phải hơn */
    width: 16px;
    height: 16px;
    background-color: rgba(10, 10, 10, 0.65); /* Nền tối đổ bóng */
    border-radius: 4px;
    border-width: 1.2px;
    border-color: rgba(255, 255, 255, 0.95); /* Viền trắng nổi bật */
    justify-content: center;
    align-items: center;
    z-index: 10;
}

.skill-hotkey {
    color: white;
    -unity-font-style: bold;
    font-size: 9px;
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
    text-shadow: 0 0 5px rgba(0, 0, 0, 0.8);
}

/* --- Skill Name Label (Tên kỹ năng phía trên ô Cooldown) --- */
.skill-name-label {
    position: absolute;
    top: -20px;
    left: -30px;
    right: -30px;
    color: #ffd700;
    -unity-font-style: bold;
    font-size: 11px;
    -unity-text-align: middle-center;
    text-shadow: 0px 1px 3px rgba(0, 0, 0, 0.95);
    white-space: nowrap;
    z-index: 12;
}

/* --- World Map Overlay (Animated) --- */
.world-map-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.75);
    justify-content: center;
    align-items: center;
    z-index: 1000;
    opacity: 0;
    visibility: hidden;
    transition-property: opacity, visibility;
    transition-duration: 0.3s; /* Nhanh hơn một chút để mượt hơn */
    transition-timing-function: ease-in-out;
}

.world-map-overlay.show-map {
    opacity: 1;
    visibility: visible;
}

.world-map-frame {
    width: 1040px;
    height: 520px;
    background-color: transparent;
    border-radius: 0;
    border-width: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    overflow: visible;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&guid=8dcf67e479d58bd47908bf0d5e1cc1d0&type=3#NotInter-Regular");
    
    /* Trạng thái ẩn: Thu nhỏ mượt mà về phía Minimap */
    scale: 0 0;
    opacity: 0;
    transform-origin: 92% 8%; /* Căn chỉnh đúng vị trí Minimap */
    
    transition-property: scale, opacity;
    transition-duration: 0.4s;
    transition-timing-function: ease-out-circ; /* Hiệu ứng mượt mà, tự nhiên */
}

.world-map-viewport {
    position: absolute;
    top: 118px;
    left: 60px;
    right: 60px;
    bottom: 52px;
    background-color: rgb(8, 12, 22);
    overflow: hidden;
    border-radius: 4px;
}

.world-map-overlay.show-map .world-map-frame {
    scale: 1 1;
    opacity: 1;
}

/* ========================================================================= */
/* --- Inventory System Styles (TAB) — Premium White Border Redesign ---     */
/* ========================================================================= */

.inventory-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.78);
    justify-content: center;
    align-items: center;
    z-index: 999;
    
    opacity: 0;
    visibility: hidden;
    transition-property: opacity, visibility;
    transition-duration: 0.3s;
    transition-timing-function: ease-in-out;
}

.inventory-overlay.show-inventory {
    opacity: 1;
    visibility: visible;
}

/* Khung chính — viền trắng, nền đen sâu tạo bóng đổ bên trong */
.inventory-frame {
    width: 820px;
    height: 520px;
    background-color: rgba(5, 8, 18, 0.96);
    border-radius: 22px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.88);
    padding: 24px;
    flex-direction: column;
    
    scale: 0.85 0.85;
    opacity: 0;
    transition-property: scale, opacity;
    transition-duration: 0.35s;
    transition-timing-function: ease-out-back;
}

.inventory-overlay.show-inventory .inventory-frame {
    scale: 1 1;
    opacity: 1;
}

/* Header styling */
.inventory-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.inventory-title {
    color: rgb(255, 255, 255);
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    -unity-text-outline-width: 0;
    text-shadow: 0 0 14px rgba(0, 0, 0, 0.95);
}

.inventory-subtitle {
    color: rgba(220, 220, 220, 0.6);
    font-size: 13px;
    -unity-font-style: italic;
}

/* Divider — white thin line */
.inventory-divider {
    height: 1px;
    background-color: rgba(255, 255, 255, 0.25);
    margin-bottom: 18px;
}

/* Main Layout Grid & Panel styling */
.inventory-content {
    flex-direction: row;
    flex-grow: 1;
}

/* Left panel */
.inventory-left-panel {
    width: 440px;
    flex-direction: column;
    justify-content: flex-start;
}

.inventory-slots-container {
    width: 440px;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    align-content: flex-start;
}

/* Ô inventory — viền trắng mờ, nền đen, hover sáng lên */
.inventory-slot {
    width: 80px;
    height: 80px;
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: 13px;
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.35);
    margin: 4px;
    position: relative;
    justify-content: center;
    align-items: center;
    transition-property: border-color, background-color, scale;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
}

.inventory-slot:hover {
    border-color: rgba(255, 255, 255, 0.95);
    background-color: rgba(20, 25, 40, 0.85);
    scale: 1.06 1.06;
}

.inventory-slot-index {
    position: absolute;
    top: 4px;
    left: 6px;
    color: rgba(255, 255, 255, 0.22);
    font-size: 11px;
    -unity-font-style: bold;
}

/* Right panel: Character Preview */
.inventory-preview-container {
    flex-grow: 1;
    margin-left: 22px;
    justify-content: center;
    align-items: stretch;
}

/* Preview card — viền trắng + nền đen tạo cảm giác đổ bóng vào trong */
.inventory-preview-card {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: 18px;
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.6);
    padding: 16px;
    align-items: center;
    justify-content: space-between;
}

.inventory-preview-title {
    color: rgba(255, 255, 255, 0.0);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
}

.character-preview-viewport {
    width: 160px;
    height: 180px;
    position: relative;
    justify-content: center;
    align-items: center;
    margin: 12px 0;
}

/* Pedestal/stand on the ground for character */
.character-preview-stand {
    position: absolute;
    bottom: 0px;
    width: 120px;
    height: 16px;
    border-radius: 60px;
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.5);
    scale: 1 0.4;
}

.character-preview-model-container {
    width: 100%;
    height: 100%;
    background-color: transparent;
}

/* Preview stat rows — viền trắng mờ */
.preview-stats-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: 10px;
    padding: 6px 14px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.3);
}

.preview-stat-badge {
    color: rgb(255, 255, 255);
    background-color: rgba(255, 255, 255, 0.15);
    border-radius: 5px;
    font-size: 11px;
    -unity-font-style: bold;
    padding: 2px 6px;
    margin-right: 8px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.5);
}

.preview-stat-name {
    color: rgba(255, 255, 255, 0.85);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
}

/* ========================================================================= */
/* --- Stats Upgrades Panel CSS — White Border Theme ---                      */
/* ========================================================================= */

.upgrades-container {
    margin-top: 14px;
    padding: 12px 16px;
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: 18px;
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.55);
}

.upgrades-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.upgrades-title {
    color: rgba(255, 255, 255, 0.95);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    text-shadow: 0 0 8px rgba(0, 0, 0, 0.9);
}

.upgrades-points {
    color: rgb(255, 255, 255);
    font-size: 13px;
    -unity-font-style: bold;
    text-shadow: 0 0 10px rgba(255, 255, 255, 0.5);
}

.upgrade-row-container {
    flex-direction: column;
}

.upgrade-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 7px 0;
}

.upgrades-header-left {
    flex-direction: row;
    align-items: center;
}

.character-level-badge {
    margin-left: 8px;
    margin-top: 0;
    margin-bottom: 0;
}

.upgrade-value {
    color: rgba(255, 255, 255, 0.55);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    flex-grow: 1;
    -unity-text-align: middle-left;
    padding: 0;
}

.upgrade-name {
    color: rgba(255, 255, 255, 0.9);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    padding: 0;
    width: 120px;
}

/* Nút upgrade — viền trắng, nền đen, click → trắng */
.upgrade-button {
    width: 26px;
    height: 26px;
    border-radius: 7px;
    background-color: rgba(0, 0, 0, 0.6);
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.8);
    color: rgb(255, 255, 255);
    font-size: 14px;
    -unity-font-style: bold;
    justify-content: center;
    align-items: center;
    padding: 0;
    margin: 0;
    transition-property: scale, background-color, border-color;
    transition-duration: 0.15s;
    text-shadow: 0 0 6px rgba(0, 0, 0, 0.8);
}

.upgrade-button:hover {
    background-color: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 1.0);
    scale: 1.12 1.12;
}

.upgrade-button:active {
    background-color: rgba(255, 255, 255, 0.9);
    color: rgb(0, 0, 0);
    scale: 0.95 0.95;
}

/* ========================================================================= */
/* --- Weapon Durability & Durability Repair Item System Redesign Styles --- */
/* ========================================================================= */

.weapon-durability-container {
    position: absolute;
    bottom: 4px;
    left: 14px;
    right: 14px;
    height: 4px;
    background-color: rgba(255, 255, 255, 0.15);
    border-radius: 2px;
    overflow: hidden;
}

#weapon-durability-slot-1 {
    display: none;
}

.weapon-durability-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(255, 255, 255);
    border-radius: 2px;
    transition-property: width;
    transition-duration: 0.25s;
    transition-timing-function: ease-out-sine;
}

/* Interaction Prompt (Press F to Collect) */
.interaction-prompt {
    position: absolute;
    top: 50%;
    left: 0.5%;
    translate: -10px -50%;
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0); /* Xóa bóng đen đổ */
    border-width: 0px; /* Xóa viền trắng bọc ngoài */
    padding: 8px 18px;
    opacity: 0;
    scale: 0.8 0.8;
    transition-property: opacity, scale, translate;
    transition-duration: 0.35s;
    transition-timing-function: ease-out-back;
    z-index: 1001;
    display: none; /* Sẽ đổi thành Flex bằng C# khi ở trong vùng tương tác */
}

.interaction-prompt.show-prompt {
    display: flex;
    opacity: 1;
    scale: 1 1;
    translate: 0 -50%;
}

.key-badge-f {
    width: 26px;
    height: 26px;
    background-color: rgb(255, 255, 255);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(200, 200, 200);
    justify-content: center;
    align-items: center;
    margin-right: 10px;
    box-shadow: 0 3px 0 rgb(180, 180, 180);
}

.key-badge-f-text {
    color: rgb(15, 15, 15);
    -unity-font-style: bold;
    font-size: 14px;
    padding: 0;
    margin: 0;
}

.interaction-text {
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    font-size: 15px;
    letter-spacing: 0.5px;
    padding: 0;
    margin: 0;
}

/* Inventory Tooltip (Hover Description Card) */
.inventory-tooltip {
    position: absolute;
    background-color: rgba(5, 8, 18, 0.98);
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.9);
    border-radius: 12px;
    padding: 10px 14px;
    z-index: 1050;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
    width: 230px;
    pointer-events: none;
}

.inventory-tooltip-title {
    color: rgb(255, 255, 255);
    font-size: 13px;
    -unity-font-style: bold;
    margin-bottom: 4px;
    letter-spacing: 1px;
}

.inventory-tooltip-desc {
    color: rgba(235, 235, 235, 0.8);
    font-size: 11px;
    -unity-font-style: italic;
    white-space: normal;
}

/* Inventory Slot Cooldown Overlay */
.slot-cooldown-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.75);
    border-radius: 11px;
    justify-content: center;
    align-items: center;
    z-index: 25;
}

.slot-cooldown-text {
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    font-size: 16px;
    padding: 0;
    margin: 0;
}

/* Drag-and-drop Visual Helpers */
.dragged-item-ghost {
    position: absolute;
    width: 64px;
    height: 64px;
    opacity: 0.75;
    z-index: 9999;
    pointer-events: none;
    -unity-background-scale-mode: scale-to-fit;
}

.slot-dragging-source {
    opacity: 0.3;
}

/* Badge số lượng cộng dồn ở góc ô hòm đồ */
.inventory-item-stack-count {
    position: absolute;
    bottom: 2px;
    right: 4px;
    color: #ffffff;
    font-size: 11px;
    -unity-font-style: bold;
    background-color: rgba(10, 15, 25, 0.85);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.25);
    border-radius: 4px;
    padding: 1px 4px;
    z-index: 10;
}

/* ========================================================================= */
/* --- Teammates HUD Styles (Top-Left Stack) ---                             */
/* ========================================================================= */

/* ========================================================================= */
/* --- Teammates HUD Styles (Top-Left Stack near main HUD) ---               */
/* ========================================================================= */

.teammates-container {
    position: absolute;
    bottom: 145px;
    left: 30px;
    flex-direction: column;
    align-items: flex-start;
    z-index: 50;
}

.teammate-card {
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.25);
    border-radius: 32px;
    padding: 6px 12px;
    margin-bottom: 12px;
    border-width: 0;
    width: 240px;
    transition-property: scale;
    transition-duration: 0.2s;
}

.teammate-card:hover {
    scale: 1.02 1.02;
}

.teammate-avatar-container {
    width: 52px;
    height: 52px;
    border-radius: 26px;
    background-color: rgba(0, 0, 0, 0.4);
    border-width: 1.5px;
    border-color: rgba(40, 160, 255, 0.9);
    justify-content: center;
    align-items: center;
    margin-right: 8px;
}

.teammate-avatar-image {
    width: 48px;
    height: 48px;
    border-radius: 24px;
    -unity-background-scale-mode: scale-and-crop;
}

.teammate-stats-wrapper {
    flex-direction: column;
    justify-content: center;
    flex-grow: 1;
}

.teammate-name-level-row {
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    margin-bottom: 3px;
}

.teammate-name-label {
    color: rgb(255, 255, 255);
    font-size: 12px;
    -unity-font-style: bold;
    max-width: 110px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin-right: 6px;
}

.teammate-level-label {
    color: rgba(255, 255, 255, 0.85);
    font-size: 11px;
    -unity-font-style: bold;
}

.teammate-track-bg {
    background-color: rgba(0, 0, 0, 0.45);
    margin-bottom: 2.5px;
    border-radius: 3px;
    overflow: hidden;
    position: relative;
}

.teammate-hp-track {
    width: 150px;
    height: 10px;
}

.teammate-mp-track {
    width: 120px;
    height: 7px;
}

.teammate-exp-track {
    width: 90px;
    height: 4px;
    margin-bottom: 0;
}

.teammate-hp-fill {
    background-color: rgb(240, 245, 255);
    height: 100%;
    width: 100%;
}

.teammate-mp-fill {
    background-color: rgb(40, 160, 255);
    height: 100%;
    width: 100%;
}

.teammate-exp-fill {
    background-color: rgb(75, 225, 100);
    height: 100%;
    width: 100%;
}

/* ========================================================================= */
/* --- Hotkeys Hint System (Bảng hướng dẫn phím nóng bên trái) --- */
/* ========================================================================= */

.hotkeys-hint-panel {
    position: absolute;
    top: 25%;
    left: 30px;
    flex-direction: column;
    align-items: flex-start;
    z-index: 1000;
    pointer-events: none;
}

.hints-group {
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
}

.hint-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
    opacity: 0.9;
    transition-property: opacity, translate;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
}

.key-badge {
    min-width: 26px;
    height: 26px;
    padding: 0 8px;
    background-color: rgb(255, 255, 255);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(200, 200, 200);
    justify-content: center;
    align-items: center;
    margin-right: 12px;
    box-shadow: 0 3px 0 rgb(180, 180, 180);
}

.large-key {
    min-width: 48px;
}

.key-badge-text {
    color: rgb(15, 15, 15);
    -unity-font-style: bold;
    font-size: 14px;
    padding: 0;
    margin: 0;
    -unity-text-align: middle-center;
}

.hint-text {
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    font-size: 15px;
    letter-spacing: 0.5px;
    padding: 0;
    margin: 0;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.85);
}

/* ========================================================================= */
/* --- Quest Panel Redesign (Premium Amber/Gold Glassmorphism Theme) ---     */
/* ========================================================================= */
.quest-panel {
    position: absolute;
    top: 255px;
    right: 35px;
    left: auto;
    width: 280px;
    background-color: rgba(6, 12, 24, 0.92);
    border-width: 1.8px;
    border-color: rgba(255, 255, 255, 0.95);
    border-radius: 14px;
    padding: 16px 20px;
    flex-direction: column;
    z-index: 100;
    
    /* Animation states */
    opacity: 0;
    scale: 0.8 0.8;
    translate: 50px 0;
    display: none;
    
    transition-property: opacity, scale, translate, display;
    transition-duration: 0.4s;
    transition-timing-function: ease-out-back;
}

.quest-panel.show-quest {
    display: flex;
    opacity: 1;
    scale: 1 1;
    translate: 0 0;
}

.quest-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.quest-icon {
    width: 44px;
    height: 44px;
    margin-right: 12px;
    background-image: url("project://database/Assets/Hbao/Image/Go.png");
    -unity-background-scale-mode: scale-to-fit;
}

.quest-title {
    color: rgb(255, 215, 0);
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    text-shadow: 0 0 10px rgba(255, 215, 0, 0.5);
    padding: 0;
    margin: 0;
    white-space: normal;
    flex-shrink: 1;
    flex-grow: 1;
}

.quest-divider {
    height: 1.5px;
    background-color: rgba(255, 255, 255, 0.4);
    margin: 8px 0 12px 0;
}

.quest-details {
    flex-direction: column;
}

.quest-desc {
    color: rgb(245, 245, 245);
    font-size: 15px;
    -unity-font-style: bold;
    white-space: normal;
    margin-bottom: 12px;
    padding: 0;
    line-height: 20px;
}

.quest-progress-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 6px;
}

.quest-progress-text {
    color: rgb(255, 255, 255);
    font-size: 15px;
    -unity-font-style: bold;
    padding: 0;
    margin: 0;
}

.quest-progress-bg {
    width: 150px;
    height: 10px;
    background-color: rgba(0, 0, 0, 0.65);
    border-radius: 5px;
    overflow: hidden;
}

.quest-progress-fill {
    height: 100%;
    background-color: rgb(255, 180, 20);
    border-radius: 5px;
    width: 0%;
    transition-property: width;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
}

/* --- Minimap Player Icons & Indicators --- */
.minimap-player-icon {
    position: absolute;
    width: 24px;
    height: 24px;
    border-radius: 12px;
    border-width: 2px;
    border-color: rgb(255, 255, 255);
    background-color: rgb(11, 15, 25);
    justify-content: center;
    align-items: center;
}

.minimap-player-avatar {
    width: 18px;
    height: 100%;
    width: 100%;
}

