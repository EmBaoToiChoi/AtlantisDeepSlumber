/* --- Minimap Player Icons & Indicators --- */
.minimap-player-icon {
    position: absolute;
    width: 24px;
    height: 24px;
    border-radius: 12px;
    border-width: 2px;
    border-color: rgb(255, 255, 255);
    background-color: rgb(11, 15, 25);
    justify-content: center;
    align-items: center;
}

.minimap-player-avatar {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    background-size: cover;
}

.minimap-player-arrow {
    position: absolute;
    top: -4px;
    left: 9px;
    width: 6px;
    height: 6px;
    background-color: rgb(255, 255, 255);
}

/* --- World Map Player Icons & Indicators --- */
.world-map-player-icon {
    position: absolute;
    width: 32px;
    height: 32px;
    border-radius: 16px;
    border-width: 2.5px;
    border-color: rgb(255, 255, 255);
    background-color: rgb(11, 15, 25);
    justify-content: center;
    align-items: center;
}

.world-map-player-avatar {
    width: 24px;
    height: 24px;
    border-radius: 12px;
    background-size: cover;
}

.world-map-player-arrow {
    position: absolute;
    top: -5px;
    left: 12px;
    width: 8px;
    height: 8px;
    background-color: rgb(255, 255, 255);
}

.world-map-border-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
}
