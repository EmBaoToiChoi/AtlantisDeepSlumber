.hud-main-wrapper {
    flex-direction: row;
    position: absolute;
    bottom: 30px;
    left: 30px;
    padding: 10px 16px;
    background-color: rgba(0, 0, 0, 0.15);
    border-radius: 40px;
    align-items: center;
    border-width: 0;
}

.stats-wrapper {
    flex-direction: column;
    justify-content: center;
    margin-left: 74px;
}

.player-avatar-container {
    position: absolute;
    left: 16px;
    top: 50%;
    margin-top: -60px;
    width: 120px;
    height: 120px;
    background-color: transparent;
    justify-content: center;
    align-items: center;
    border-width: 0;
    pointer-events: none;
}

.raw-player-image {
    width: 88px;
    height: 88px;
    border-radius: 44px;
    background-color: rgb(15, 20, 30);
    -unity-background-scale-mode: scale-and-crop;
    overflow: hidden;
}

.player-avatar-border {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Hexagon_01.png?fileID=2800000&guid=3a8ac9a83f434884fb081391eb919721&type=3#SPR_FantasyMenus_Frame_Hexagon_01");
}

.level-label {
    color: rgb(255, 255, 255);
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 2px;
    margin-left: 58px;
    padding: 0;
    letter-spacing: 1px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.5);
}

.stat-bar-container {
    position: relative;
    justify-content: center;
    margin-bottom: 0;
}

.stat-bar-frame {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Menu_Button_16_Frame.png?fileID=2800000&guid=30899411b4447044da0027e0c416bba6&type=3#SPR_FantasyMenus_Menu_Button_16_Frame");
}

.track-bg {
    background-color: rgba(6, 10, 18, 0.85);
    border-radius: 2px;
    position: absolute;
    overflow: hidden;
    border-width: 0;
}

.hp-bar-container {
    width: 320px;
    height: 30px;
    margin-bottom: -3px;
}

.hp-track {
    top: 8px;
    bottom: 8px;
    left: 36px;
    right: 36px;
}

.mp-bar-container {
    width: 270px;
    height: 26px;
    margin-bottom: -3px;
}

.mp-track {
    top: 7px;
    bottom: 7px;
    left: 32px;
    right: 32px;
}

.exp-bar-container {
    width: 230px;
    height: 22px;
    margin-bottom: 0;
}

.exp-track {
    top: 6px;
    bottom: 6px;
    left: 28px;
    right: 28px;
}

.fill-core {
    height: 100%;
    width: 100%;
    transition-property: width;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.segments-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

.divider {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background-color: rgba(0, 0, 0, 0.25);
}

.hp-fill {
    background-color: rgb(235, 45, 45);
    border-radius: 0;
}

.mp-fill {
    background-color: rgb(40, 160, 255);
    border-radius: 0;
}

.exp-fill {
    background-color: rgb(75, 225, 100);
    border-radius: 0;
}

.mic-icon-base {
    position: absolute;
    left: 236px;
    right: auto;
    bottom: -2px;
    width: 26px;
    height: 26px;
    -unity-background-scale-mode: scale-to-fit;
    transition-property: opacity, scale;
    transition-duration: 0.3s;
    transition-timing-function: ease-in-out;
}

.mic-off {
    background-image: url("project://database/Assets/Hbao/Image/Mic%20-%20Copy.png?fileID=2800000&guid=c224a90ad5cf9ad41a4c9076f3490624&type=3#Mic - Copy");
    opacity: 1;
    scale: 1 1;
}

.mic-on {
    background-image: url("project://database/Assets/Hbao/Image/Mic%201.png?fileID=2800000&guid=8315893ae6402734cab54940b270a236&type=3#Mic 1");
    opacity: 1;
    scale: 1.15 1.15;
}

.minimap-wrapper {
    position: absolute;
    top: 30px;
    right: 30px;
    width: 250px;
    height: 250px;
    border-radius: 125px;
    justify-content: center;
    align-items: center;
}

.minimap-mask {
    width: 196px;
    height: 196px;
    border-radius: 98px;
    overflow: hidden;
    background-color: rgba(10, 15, 25, 0.85);
    justify-content: center;
    align-items: center;
}

.minimap-content {
    width: 100%;
    height: 100%;
}

.minimap-grid-x {
    display: none;
    position: absolute;
    top: 98px;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: rgba(40, 160, 255, 0.2);
}

.minimap-grid-y {
    display: none;
    position: absolute;
    top: 0;
    left: 98px;
    width: 2px;
    height: 100%;
    background-color: rgba(40, 160, 255, 0.2);
}

.minimap-border {
    position: absolute;
    top: 0;
    left: 0;
    width: 250px;
    height: 250px;
    border-width: 0;
    pointer-events: none;
}

.minimap-inner-ring {
    display: none;
    position: absolute;
    top: 8px;
    left: 8px;
    width: 184px;
    height: 184px;
    border-radius: 92px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.3);
}

.minimap-deco-dot {
    display: none;
    position: absolute;
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: rgb(255, 255, 255);
}

.minimap-compass-n {
    display: none;
    position: absolute;
    top: -36px;
    color: rgb(255, 255, 255);
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.hud-weapons-wrapper {
    position: absolute;
    bottom: 25px;
    right: 20px;
    flex-direction: column;
    align-items: flex-end;
    background-color: transparent;
    border-width: 0;
    padding: 0;
}

.weapon-slot {
    width: 320px;
    height: 112px;
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
    margin-top: 0;
    position: relative;
    overflow: visible;
    transition-property: scale, opacity;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
}

.weapon-slot-bg {
    display: none;
}

.weapon-slot-frame {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: url("project://database/Assets/Hbao/Image/SPR_FantasyMenus_Menu_Button_14_Frame_Stitched.png?fileID=2800000&guid=e14a0123bc456789de0123456789ef14&type=3#SPR_FantasyMenus_Menu_Button_14_Frame_Stitched");
    -unity-background-scale-mode: stretch-to-fill;
    pointer-events: none;
    z-index: 5;
}

.weapon-active {
    scale: 1.05 1.05;
    opacity: 1;
}

.weapon-inactive {
    scale: 0.88 0.88;
    opacity: 0.45;
}

.weapon-hotkey-wrapper {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    left: 26px;
    width: 30px;
    height: 30px;
    background-color: transparent;
    border-width: 0;
    justify-content: center;
    align-items: center;
    z-index: 10;
}

.weapon-hotkey-container {
    width: 30px;
    height: 30px;
    background-color: rgba(10, 14, 24, 0.88);
    border-radius: 4px;
    border-width: 1.5px;
    border-color: rgba(255, 215, 120, 0.95);
    justify-content: center;
    align-items: center;
}

.weapon-hotkey {
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    font-size: 15px;
    padding: 0;
    margin: 0;
    text-shadow: 0 0 4px rgba(0, 0, 0, 0.9);
}

.weapon-image {
    position: absolute;
    top: 46%;
    left: 54%;
    translate: -50% -50%;
    width: 160px;
    height: 62px;
    -unity-background-scale-mode: scale-to-fit;
    z-index: 3;
}

.hud-skills-wrapper {
    position: absolute;
    bottom: 40px;
    left: 50%;
    translate: -50% 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-image: none;
    background-color: transparent;
    padding: 0;
}

.skill-slot {
    width: 86px;
    height: 86px;
    margin-left: 8px;
    margin-right: 8px;
    margin-top: 0;
    margin-bottom: 0;
    background-color: transparent;
    border-radius: 0;
    border-width: 0;
    position: relative;
    overflow: visible;
    justify-content: center;
    align-items: center;
}

.skill-slot-center {
    width: 104px;
    height: 104px;
    margin-left: 12px;
    margin-right: 12px;
    margin-top: 0;
    margin-bottom: 0;
    background-color: transparent;
    border-radius: 0;
    border-width: 0;
    position: relative;
    overflow: visible;
    justify-content: center;
    align-items: center;
}

.skill-frame-border {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Box_Medium_05.png?fileID=2800000&guid=3521608170d7a034ebd94526251b585b&type=3#SPR_FantasyMenus_Frame_Box_Medium_05");
    z-index: 10;
}

.skill-image {
    width: 78%;
    height: 78%;
    -unity-background-scale-mode: scale-and-crop;
    background-color: rgba(8, 12, 20, 0.95);
    border-radius: 4px;
}

.skill-img-q-maya {
    -unity-background-scale-mode: stretch-to-fill;
}

.skill-img-q-elena {
    -unity-background-scale-mode: stretch-to-fill;
}

.skill-slot .skill-image {
    width: 78%;
    height: 78%;
    border-radius: 4px;
}

.skill-slot-center .skill-image {
    width: 78%;
    height: 78%;
    border-radius: 6px;
}

/* --- Khi không đủ 30 Năng lượng: Chỉ làm trong suốt/mờ Image Kỹ Năng, giữ nguyên Khung & Phím tắt --- */
.skill-slot-no-mana .skill-image,
.skill-image.skill-no-mana {
    opacity: 0.35;
    -unity-background-image-tint-color: rgba(100, 100, 100, 0.95);
}

.skill-cooldown-overlay {
    position: absolute;
    bottom: 11%;
    left: 11%;
    width: 78%;
    height: 0%;
    background-color: rgba(0, 0, 0, 0.75);
    border-radius: 4px;
    z-index: 5;
}

.skill-cooldown-text {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
    z-index: 8;
    display: none;
}

.skill-lock-overlay {
    position: absolute;
    top: 11%;
    left: 11%;
    right: 11%;
    bottom: 11%;
    background-color: rgb(15, 15, 15);
    border-radius: 4px;
    justify-content: center;
    align-items: center;
    z-index: 6;
}

.skill-lock-overlay.unlocked-anim {
    background-color: rgba(0, 0, 0, 0); /* Bóng mờ đen từ từ biến mất */
}

/* Ổ khóa */
.skill-lock-icon {
    width: 55%;
    height: 55%;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/Hbao/Image/Okhoa.png?fileID=2800000&guid=a6762048aa50f61429b3f9b9877b5028&type=3#Okhoa");
    transition-property: translate, opacity, rotate;
    transition-duration: 0.6s, 0.5s, 0.05s; /* Rotate nhanh để shake */
    transition-timing-function: ease-in-back, ease-out, ease-out;
    transform-origin: center top;
}

/* Ổ khóa lớn hơn cho slot R */
.skill-slot-main .skill-lock-icon {
    width: 48px;
    height: 45px;
}

.skill-lock-icon.shake-left {
    rotate: -12deg;
}

.skill-lock-icon.shake-right {
    rotate: 12deg;
}

/* Chỉ có ổ khóa rớt xuống khi mở */
.skill-lock-overlay.unlocked-anim .skill-lock-icon {
    translate: 0 60px;
    opacity: 0;
    rotate: 15deg;
}
/* --- Weapon Lock Styles --- */
.weapon-lock-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(15, 15, 15);
    justify-content: center;
    align-items: center;
    border-radius: 9px;
}

.weapon-lock-overlay .weapon-lock-icon {
    width: 45px;
    height: 45px;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/Hbao/Image/Okhoa.png?fileID=2800000&guid=a6762048aa50f61429b3f9b9877b5028&type=3#Okhoa");
    transition-property: scale, rotate, translate, opacity;
    transition-duration: 0.15s, 0.05s, 0.6s, 0.5s; 
    transition-timing-function: ease-out-back, ease-out, ease-in-back, ease-out;
}

.weapon-lock-overlay:hover .weapon-lock-icon {
    scale: 1.15;
}

.weapon-lock-icon.shake-left {
    rotate: -12deg;
}

.weapon-lock-icon.shake-right {
    rotate: 12deg;
}

.weapon-lock-overlay.unlocked-anim {
    background-color: rgba(0, 0, 0, 0);
    transition-property: background-color;
    transition-duration: 0.6s;
    transition-timing-function: ease-out;
}

.weapon-lock-overlay.unlocked-anim .weapon-lock-icon {
    translate: 0 80px;
    opacity: 0;
    rotate: 15deg;
}

/* --- Fantasy Notification Popup --- */
.notification-popup {
    position: absolute;
    top: 90px;
    left: 50%;
    translate: -50% -25px;
    min-width: 480px;
    max-width: 820px;
    min-height: 64px;
    height: auto;
    align-items: center;
    justify-content: center;
    opacity: 0;
    scale: 0.85;
    pointer-events: none;
    transition-property: opacity, translate, scale;
    transition-duration: 0.35s;
    transition-timing-function: ease-out-back;
    z-index: 1000;
}

.notification-popup.show-notification {
    opacity: 1;
    translate: -50% 0;
    scale: 1;
}

.notification-popup.pop-bump {
    scale: 1.06;
}

/* Nền tối sâu huyền ảo màu Obsidian với đổ bóng */
.notification-popup-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(14, 10, 18, 0.95);
    border-radius: 8px;
    box-shadow: 0px 8px 28px rgba(0, 0, 0, 0.92);
}

/* Khung viền hoa văn vàng Fantasy ôm trọn toàn bộ nội dung */
.notification-popup-frame {
    position: absolute;
    top: -12px;
    left: -16px;
    right: -16px;
    bottom: -12px;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Box_Medium_02.png?fileID=1537655665&guid=4c83811485b435e4a93a37b73758d514&type=3#SPR_FantasyMenus_Frame_Box_Medium_02");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 80;
    -unity-slice-top: 80;
    -unity-slice-right: 80;
    -unity-slice-bottom: 80;
    pointer-events: none;
}

/* Tương thích ngược cho frame-wrapper cũ nếu có */
.notification-popup-frame-wrapper {
    position: absolute;
    top: -12px;
    left: -16px;
    right: -16px;
    bottom: -12px;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Box_Medium_02.png?fileID=1537655665&guid=4c83811485b435e4a93a37b73758d514&type=3#SPR_FantasyMenus_Frame_Box_Medium_02");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 80;
    -unity-slice-top: 80;
    -unity-slice-right: 80;
    -unity-slice-bottom: 80;
    pointer-events: none;
}

.notification-popup-frame-left,
.notification-popup-frame-right {
    display: none;
}

/* Nội dung thông báo */
.notification-popup-content {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 16px 48px;
    position: relative;
    z-index: 2;
}

.notification-popup-icon {
    width: 30px;
    height: 30px;
    margin-right: 14px;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/Hbao/ScripUIPlayer/lightning_icon_transparent.png?fileID=2800000&guid=ea89cff6ada1da84e818e87424696d88&type=3#lightning_icon_transparent");
    -unity-background-image-tint-color: rgb(255, 225, 120);
}

.notification-popup-icon.icon-energy {
    background-image: url("project://database/Assets/Hbao/ScripUIPlayer/lightning_icon_transparent.png?fileID=2800000&guid=ea89cff6ada1da84e818e87424696d88&type=3#lightning_icon_transparent");
    -unity-background-image-tint-color: rgb(100, 225, 255);
}

.notification-popup-icon.icon-quest {
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/Icons_FantasyMenus/SPR_FantasyMenus_Icon_Scroll_01.png?fileID=1537655665&guid=2a6f2ee92dea22c4d80dfc1bc736599d&type=3#SPR_FantasyMenus_Icon_Scroll_01");
    -unity-background-image-tint-color: rgb(255, 215, 110);
}

.notification-popup-icon.icon-warning {
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/Icons_FantasyMenus/SPR_FantasyMenus_Icon_Swords_01.png?fileID=1537655665&guid=0e0b23e39d92e3c45b6ac1a70c2b6b84&type=3#SPR_FantasyMenus_Icon_Swords_01");
    -unity-background-image-tint-color: rgb(255, 130, 110);
}

.notification-popup-text {
    color: rgb(255, 238, 195);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 0px 2px 6px rgba(0, 0, 0, 0.95);
    white-space: normal;
    letter-spacing: 0.5px;
}

/* --- Warning Notification Styles (Legacy & Compatibility) --- */
.weapon-warning-label {
    position: absolute;
    top: 95px;
    left: 50%;
    translate: -50% -25px;
    color: rgb(255, 242, 210);
    text-shadow: 0px 2px 5px rgba(0, 0, 0, 0.95);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 14px 44px;
    background-color: rgba(12, 9, 16, 0.88);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgba(255, 215, 120, 0.85);
    opacity: 0;
    transition-property: opacity, translate, scale;
    transition-duration: 0.35s;
    transition-timing-function: ease-out-back;
    scale: 0.85;
}

.weapon-warning-label.show-warning {
    opacity: 1;
    translate: -50% 0;
    scale: 1;
}

/* --- Skill Hotkey Indicators (Final Style) --- */
.skill-hotkey-container {
    position: absolute;
    bottom: 10px;
    left: 50%;
    translate: -50% 0;
    width: 24px;
    height: 22px;
    background-color: rgba(10, 14, 24, 0.88);
    border-radius: 4px;
    border-width: 1.5px;
    border-color: rgba(255, 215, 120, 0.95);
    justify-content: center;
    align-items: center;
    z-index: 15;
}

.skill-hotkey {
    color: white;
    -unity-font-style: bold;
    font-size: 13px;
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
    text-shadow: 0 0 4px rgba(0, 0, 0, 0.9);
}

/* --- Skill Name Label (Tên kỹ năng phía trên ô Cooldown) --- */
.skill-name-label {
    position: absolute;
    top: -24px;
    left: -40px;
    right: -40px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    font-size: 13px;
    -unity-text-align: middle-center;
    text-shadow: 0px 1px 4px rgba(0, 0, 0, 0.95);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.9);
    white-space: nowrap;
    z-index: 12;
}

/* --- World Map Overlay (Animated) --- */
.world-map-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.75);
    justify-content: center;
    align-items: center;
    z-index: 1000;
    opacity: 0;
    visibility: hidden;
    transition-property: opacity, visibility;
    transition-duration: 0.3s; /* Nhanh hơn một chút để mượt hơn */
    transition-timing-function: ease-in-out;
}

.world-map-overlay.show-map {
    opacity: 1;
    visibility: visible;
}

.world-map-frame {
    width: 1040px;
    height: 520px;
    background-color: transparent;
    border-radius: 0;
    border-width: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    overflow: visible;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&guid=8dcf67e479d58bd47908bf0d5e1cc1d0&type=3#NotInter-Regular");
    
    /* Trạng thái ẩn: Thu nhỏ mượt mà về phía Minimap */
    scale: 0 0;
    opacity: 0;
    transform-origin: 92% 8%; /* Căn chỉnh đúng vị trí Minimap */
    
    transition-property: scale, opacity;
    transition-duration: 0.4s;
    transition-timing-function: ease-out-circ; /* Hiệu ứng mượt mà, tự nhiên */
}

.world-map-viewport {
    position: absolute;
    top: 118px;
    left: 60px;
    right: 60px;
    bottom: 52px;
    background-color: rgb(8, 12, 22);
    overflow: hidden;
    border-radius: 4px;
}

.world-map-overlay.show-map .world-map-frame {
    scale: 1 1;
    opacity: 1;
}

/* ========================================================================= */
/* --- Inventory System Styles (TAB) — Premium White Border Redesign ---     */
/* ========================================================================= */

.inventory-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.78);
    justify-content: center;
    align-items: center;
    z-index: 999;
    
    opacity: 0;
    visibility: hidden;
    transition-property: opacity, visibility;
    transition-duration: 0.3s;
    transition-timing-function: ease-in-out;
}

.inventory-overlay.show-inventory {
    opacity: 1;
    visibility: visible;
}

/* Khung chính — viền trắng, nền đen sâu tạo bóng đổ bên trong */
.inventory-frame {
    width: 820px;
    height: 520px;
    background-color: rgba(5, 8, 18, 0.96);
    border-radius: 22px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.88);
    padding: 24px;
    flex-direction: column;
    
    scale: 0.85 0.85;
    opacity: 0;
    transition-property: scale, opacity;
    transition-duration: 0.35s;
    transition-timing-function: ease-out-back;
}

.inventory-overlay.show-inventory .inventory-frame {
    scale: 1 1;
    opacity: 1;
}

/* Header styling */
.inventory-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.inventory-title {
    color: rgb(255, 255, 255);
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    -unity-text-outline-width: 0;
    text-shadow: 0 0 14px rgba(0, 0, 0, 0.95);
}

.inventory-subtitle {
    color: rgba(220, 220, 220, 0.6);
    font-size: 13px;
    -unity-font-style: italic;
}

/* Divider — white thin line */
.inventory-divider {
    height: 1px;
    background-color: rgba(255, 255, 255, 0.25);
    margin-bottom: 18px;
}

/* Main Layout Grid & Panel styling */
.inventory-content {
    flex-direction: row;
    flex-grow: 1;
}

/* Left panel */
.inventory-left-panel {
    width: 440px;
    flex-direction: column;
    justify-content: flex-start;
}

.inventory-slots-container {
    width: 440px;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    align-content: flex-start;
}

/* Ô inventory — viền trắng mờ, nền đen, hover sáng lên */
.inventory-slot {
    width: 80px;
    height: 80px;
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: 13px;
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.35);
    margin: 4px;
    position: relative;
    justify-content: center;
    align-items: center;
    transition-property: border-color, background-color, scale;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
}

.inventory-slot:hover {
    border-color: rgba(255, 255, 255, 0.95);
    background-color: rgba(20, 25, 40, 0.85);
    scale: 1.06 1.06;
}

.inventory-slot-index {
    position: absolute;
    top: 4px;
    left: 6px;
    color: rgba(255, 255, 255, 0.22);
    font-size: 11px;
    -unity-font-style: bold;
}

/* Right panel: Character Preview */
.inventory-preview-container {
    flex-grow: 1;
    margin-left: 22px;
    justify-content: center;
    align-items: stretch;
}

/* Preview card — viền trắng + nền đen tạo cảm giác đổ bóng vào trong */
.inventory-preview-card {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: 18px;
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.6);
    padding: 16px;
    align-items: center;
    justify-content: space-between;
}

.inventory-preview-title {
    color: rgba(255, 255, 255, 0.0);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
}

.character-preview-viewport {
    width: 160px;
    height: 180px;
    position: relative;
    justify-content: center;
    align-items: center;
    margin: 12px 0;
}

/* Pedestal/stand on the ground for character */
.character-preview-stand {
    position: absolute;
    bottom: 0px;
    width: 120px;
    height: 16px;
    border-radius: 60px;
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.5);
    scale: 1 0.4;
}

.character-preview-model-container {
    width: 100%;
    height: 100%;
    background-color: transparent;
}

/* Preview stat rows — viền trắng mờ */
.preview-stats-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: 10px;
    padding: 6px 14px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.3);
}

.preview-stat-badge {
    color: rgb(255, 255, 255);
    background-color: rgba(255, 255, 255, 0.15);
    border-radius: 5px;
    font-size: 11px;
    -unity-font-style: bold;
    padding: 2px 6px;
    margin-right: 8px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.5);
}

.preview-stat-name {
    color: rgba(255, 255, 255, 0.85);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
}

/* ========================================================================= */
/* --- Stats Upgrades Panel CSS — White Border Theme ---                      */
/* ========================================================================= */

.upgrades-container {
    margin-top: 10px;
    padding: 10px 16px;
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: 18px;
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.55);
}

.upgrades-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
}

.upgrades-title {
    color: rgba(255, 255, 255, 0.95);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    text-shadow: 0 0 8px rgba(0, 0, 0, 0.9);
}

.upgrades-points {
    color: rgb(255, 255, 255);
    font-size: 13px;
    -unity-font-style: bold;
    text-shadow: 0 0 10px rgba(255, 255, 255, 0.5);
}

.upgrade-row-container {
    flex-direction: column;
}

.upgrade-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 4.5px 0;
}

.upgrades-header-left {
    flex-direction: row;
    align-items: center;
}

.character-level-badge {
    margin-left: 8px;
    margin-top: 0;
    margin-bottom: 0;
}

.upgrade-value {
    color: rgba(255, 255, 255, 0.55);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    flex-grow: 1;
    -unity-text-align: middle-left;
    padding: 0;
}

.upgrade-name {
    color: rgba(255, 255, 255, 0.9);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    padding: 0;
    width: 120px;
}

/* Nút upgrade — viền trắng, nền đen, click → trắng */
.upgrade-button {
    width: 26px;
    height: 26px;
    border-radius: 7px;
    background-color: rgba(0, 0, 0, 0.6);
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.8);
    color: rgb(255, 255, 255);
    font-size: 14px;
    -unity-font-style: bold;
    justify-content: center;
    align-items: center;
    padding: 0;
    margin: 0;
    transition-property: scale, background-color, border-color;
    transition-duration: 0.15s;
    text-shadow: 0 0 6px rgba(0, 0, 0, 0.8);
}

.upgrade-button:hover {
    background-color: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 1.0);
    scale: 1.12 1.12;
}

.upgrade-button:active {
    background-color: rgba(255, 255, 255, 0.9);
    color: rgb(0, 0, 0);
    scale: 0.95 0.95;
}

/* ========================================================================= */
/* --- Weapon Durability & Durability Repair Item System Redesign Styles --- */
/* ========================================================================= */

.weapon-durability-container {
    position: absolute;
    bottom: 37px;
    left: 75px;
    right: 55px;
    height: 4.5px;
    background-color: rgba(255, 255, 255, 0.2);
    border-radius: 2px;
    overflow: hidden;
    z-index: 15;
}

#weapon-durability-slot-1 {
    display: none;
}

.weapon-durability-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(255, 255, 255);
    border-radius: 2px;
    transition-property: width;
    transition-duration: 0.25s;
    transition-timing-function: ease-out-sine;
}

/* --- Interaction Prompt (Fantasy Golden Frame) --- */
.interaction-prompt {
    position: absolute;
    bottom: 215px;
    left: 50%;
    translate: -50% 8px;
    min-width: 320px;
    max-width: 780px;
    min-height: 64px;
    width: auto;
    height: auto;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    border-width: 0;
    padding: 0;
    opacity: 0;
    scale: 0.92 0.92;
    transition-property: opacity, scale, translate;
    transition-duration: 0.22s;
    transition-timing-function: ease-out-back;
    z-index: 1001;
    display: none;
    overflow: visible;
}

.interaction-prompt.show-prompt {
    display: flex;
    opacity: 1;
    scale: 1 1;
    translate: -50% 0;
}

/* Lớp nền tối màu Obsidian sâu thẳm với đổ bóng đen */
.interaction-prompt-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(12, 10, 16, 0.95);
    border-radius: 8px;
    box-shadow: 0px 8px 30px rgba(0, 0, 0, 0.96);
}

/* Khung viền hoa văn vàng Fantasy bọc lại hoàn toàn xung quanh */
.interaction-prompt-frame {
    position: absolute;
    top: -10px;
    left: -14px;
    right: -14px;
    bottom: -10px;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Box_Medium_02.png?fileID=1537655665&guid=4c83811485b435e4a93a37b73758d514&type=3#SPR_FantasyMenus_Frame_Box_Medium_02");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 80;
    -unity-slice-top: 80;
    -unity-slice-right: 80;
    -unity-slice-bottom: 80;
    pointer-events: none;
}

/* Tương thích ngược nếu còn frame-wrapper cũ */
.interaction-prompt-frame-wrapper {
    position: absolute;
    top: -10px;
    left: -14px;
    right: -14px;
    bottom: -10px;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Box_Medium_02.png?fileID=1537655665&guid=4c83811485b435e4a93a37b73758d514&type=3#SPR_FantasyMenus_Frame_Box_Medium_02");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 80;
    -unity-slice-top: 80;
    -unity-slice-right: 80;
    -unity-slice-bottom: 80;
    pointer-events: none;
}

.interaction-prompt-frame-left,
.interaction-prompt-frame-right {
    display: none;
}

/* Nội dung bên trong: Căn giữa theo hàng ngang gọn gàng */
.interaction-prompt-content {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 16px 48px;
    position: relative;
    z-index: 2;
    width: 100%;
}

.interaction-key-icon {
    width: 36px;
    height: 36px;
    -unity-background-scale-mode: scale-to-fit;
    background-color: transparent;
    border-width: 0;
    margin-right: 14px;
    margin-bottom: 0;
    flex-shrink: 0;
}

.key-badge-f {
    width: 36px;
    height: 36px;
    background-image: url("project://database/Assets/Artsystack - Fantasy RPG GUI/Resources/Sprites/controller icons/keyboard_mouse/F.png?fileID=2800000&guid=66976df651142c9499726864796f67c7&type=3#F");
    -unity-background-scale-mode: scale-to-fit;
    background-color: transparent;
    border-width: 0;
    justify-content: center;
    align-items: center;
    margin-right: 14px;
    margin-bottom: 0;
    flex-shrink: 0;
}

.key-badge-f-text {
    display: none;
}

.interaction-text {
    color: rgb(255, 238, 195);
    -unity-font-style: bold;
    font-size: 16px;
    letter-spacing: 0.4px;
    padding: 0;
    margin: 0;
    -unity-text-align: middle-center;
    white-space: normal;
    text-shadow: 0px 2px 8px rgba(0, 0, 0, 1);
    flex-shrink: 1;
}

/* Inventory Tooltip (Hover Description Card) */
.inventory-tooltip {
    position: absolute;
    background-color: rgba(5, 8, 18, 0.98);
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.9);
    border-radius: 12px;
    padding: 10px 14px;
    z-index: 1050;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
    width: 230px;
    pointer-events: none;
}

.inventory-tooltip-title {
    color: rgb(255, 255, 255);
    font-size: 13px;
    -unity-font-style: bold;
    margin-bottom: 4px;
    letter-spacing: 1px;
}

.inventory-tooltip-desc {
    color: rgba(235, 235, 235, 0.8);
    font-size: 11px;
    -unity-font-style: italic;
    white-space: normal;
}

/* Inventory Slot Cooldown Overlay */
.slot-cooldown-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.75);
    border-radius: 11px;
    justify-content: center;
    align-items: center;
    z-index: 25;
}

.slot-cooldown-text {
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    font-size: 16px;
    padding: 0;
    margin: 0;
}

/* Drag-and-drop Visual Helpers */
.dragged-item-ghost {
    position: absolute;
    width: 64px;
    height: 64px;
    opacity: 0.75;
    z-index: 9999;
    pointer-events: none;
    -unity-background-scale-mode: scale-to-fit;
}

.slot-dragging-source {
    opacity: 0.3;
}

/* Badge số lượng cộng dồn ở góc ô hòm đồ */
.inventory-item-stack-count {
    position: absolute;
    bottom: 2px;
    right: 4px;
    color: #ffffff;
    font-size: 11px;
    -unity-font-style: bold;
    background-color: rgba(10, 15, 25, 0.85);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.25);
    border-radius: 4px;
    padding: 1px 4px;
    z-index: 10;
}

/* ========================================================================= */
/* --- Teammates HUD Styles (Top-Left Stack) ---                             */
/* ========================================================================= */

/* ========================================================================= */
/* --- Teammates HUD Styles (Top-Left Stack near main HUD) ---               */
/* ========================================================================= */

.teammates-container {
    position: absolute;
    bottom: 175px;
    left: 30px;
    flex-direction: column;
    align-items: flex-start;
    z-index: 50;
}

.teammate-card {
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 30px;
    padding: 6px 12px;
    margin-bottom: 10px;
    border-width: 0;
    position: relative;
    transition-property: scale;
    transition-duration: 0.2s;
}

.teammate-card:hover {
    scale: 1.02 1.02;
}

.teammate-stats-wrapper {
    flex-direction: column;
    justify-content: center;
    margin-left: 50px;
}

.teammate-avatar-container {
    position: absolute;
    left: 10px;
    top: 50%;
    margin-top: -40px;
    width: 80px;
    height: 80px;
    background-color: transparent;
    border-width: 0;
    justify-content: center;
    align-items: center;
    pointer-events: none;
    z-index: 5;
}

.teammate-avatar-image {
    width: 58px;
    height: 58px;
    border-radius: 29px;
    background-color: rgb(15, 20, 30);
    -unity-background-scale-mode: scale-and-crop;
    overflow: hidden;
}

.teammate-avatar-border {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Hexagon_01.png?fileID=2800000&guid=3a8ac9a83f434884fb081391eb919721&type=3#SPR_FantasyMenus_Frame_Hexagon_01");
}

.teammate-name-level-row {
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    margin-bottom: 2px;
    margin-left: 36px;
}

.teammate-name-label {
    color: rgb(255, 255, 255);
    font-size: 13px;
    -unity-font-style: bold;
    max-width: 110px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin-right: 6px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.5);
}

.teammate-level-label {
    color: rgba(255, 255, 255, 0.85);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.5);
}

.teammate-stat-bar-container {
    position: relative;
    justify-content: center;
    margin-bottom: 0;
}

.teammate-stat-bar-frame {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Menu_Button_16_Frame.png?fileID=2800000&guid=30899411b4447044da0027e0c416bba6&type=3#SPR_FantasyMenus_Menu_Button_16_Frame");
}

.teammate-track-bg {
    background-color: rgba(6, 10, 18, 0.85);
    border-radius: 2px;
    position: absolute;
    overflow: hidden;
    border-width: 0;
}

.teammate-hp-bar-container {
    width: 210px;
    height: 20px;
    margin-bottom: -2px;
}

.teammate-hp-track {
    top: 5px;
    bottom: 5px;
    left: 24px;
    right: 24px;
}

.teammate-mp-bar-container {
    width: 178px;
    height: 17px;
    margin-bottom: -2px;
}

.teammate-mp-track {
    top: 4px;
    bottom: 4px;
    left: 21px;
    right: 21px;
}

.teammate-exp-bar-container {
    width: 150px;
    height: 14px;
    margin-bottom: 0;
}

.teammate-exp-track {
    top: 3px;
    bottom: 3px;
    left: 18px;
    right: 18px;
}

/* ========================================================================= */
/* --- Hotkeys Hint System (Bảng hướng dẫn phím nóng bên trái) --- */
/* ========================================================================= */

.hotkeys-hint-panel {
    position: absolute;
    top: 25%;
    left: 30px;
    flex-direction: column;
    align-items: flex-start;
    z-index: 1000;
    pointer-events: none;
}

.hints-group {
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
}

.hint-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
    opacity: 0.95;
    transition-property: opacity, translate;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
}

/* ========================================================================= */
/* --- Controller & Keyboard Icons Theme ---                                 */
/* ========================================================================= */

.key-icon {
    width: 36px;
    height: 36px;
    -unity-background-scale-mode: scale-to-fit;
    background-color: transparent;
    margin-right: 4px;
}

.key-icon-combo {
    flex-direction: row;
    align-items: center;
    margin-right: 12px;
}

.key-combo-plus {
    color: rgb(255, 255, 255);
    font-size: 16px;
    -unity-font-style: bold;
    margin-left: 3px;
    margin-right: 6px;
    padding: 0;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9);
}

.key-icon-w { background-image: url("project://database/Assets/Artsystack - Fantasy RPG GUI/Resources/Sprites/controller icons/keyboard_mouse/W.png?fileID=2800000&guid=9c7b02915cdd9f64286d6afa370744e2&type=3#W"); }
