.nameplate-container {
    position: absolute;
    width: 0;
    height: 0;
    align-items: center;
    justify-content: center;
    overflow: visible;
}
.player-name-label {
    position: absolute;
    bottom: 0;
    color: rgb(255, 255, 255);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    
    /* Nền kính tối (dark glassmorphism) giúp tương phản mạnh với chữ trắng */
    background-color: rgba(10, 10, 12, 0.85);
    
    /* Padding bo tròn dạng badge sang trọng */
    padding: 5px 14px;
    border-radius: 12px;
    white-space: nowrap;
    
    /* Viền mỏng sáng nhẹ tạo hiệu ứng nổi khối */
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.3);
    
    /* Tăng độ đậm và nét của viền chữ đen (Text Outline) để chữ cực kỳ dễ nhìn */
    -unity-text-outline-width: 1.2px;
    -unity-text-outline-color: rgb(0, 0, 0);
}
