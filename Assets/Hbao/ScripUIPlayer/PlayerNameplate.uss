.nameplate-container {
    position: absolute;
    width: 0;
    height: 0;
    align-items: center;
    justify-content: center;
    overflow: visible;
}
.player-name-label {
    position: absolute;
    bottom: 0;
    color: rgb(255, 255, 255);
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: rgba(0, 0, 0, 0.55);
    padding: 4px 12px;
    border-radius: 14px;
    white-space: nowrap;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.85);
}
