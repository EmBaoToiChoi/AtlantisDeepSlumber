.nameplate-container {
    position: absolute;
    width: 0;
    height: 0;
    align-items: center;
    justify-content: center;
    overflow: visible;
}

.player-name-label {
    position: absolute;
    bottom: 0;
    color: rgb(255, 255, 255);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: rgba(0, 0, 0, 0.45);
    padding: 3px 8px;
    border-radius: 4px;
    white-space: nowrap;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.8);
}
