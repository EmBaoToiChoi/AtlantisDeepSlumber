<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Hbao/Scrip/PlayerHUD.uss?fileID=7433441132597879392&amp;guid=70193741e3d26714d859986fce3cd4df&amp;type=3#PlayerHUD" />
    <ui:VisualElement class="hud-main-wrapper" style="-unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&amp;guid=8dcf67e479d58bd47908bf0d5e1cc1d0&amp;type=3#NotInter-Regular&quot;);">
        <ui:VisualElement class="player-avatar-container">
            <ui:VisualElement class="raw-player-image" style="background-image: url(&quot;project://database/Assets/Hbao/Image/AvaST.png?fileID=1013639804&amp;guid=d74474e1ade5e1a438e24f8f7417dae9&amp;type=3#AvaST_0&quot;);" />
        </ui:VisualElement>
        <ui:VisualElement class="stats-wrapper">
            <ui:Label text="Lv. 15" class="level-label" />
            <ui:VisualElement class="track-bg hp-track">
                <ui:VisualElement name="hp-fill" class="fill-core hp-fill" />
            </ui:VisualElement>
            <ui:VisualElement class="track-bg mp-track">
                <ui:VisualElement name="mp-fill" class="fill-core mp-fill" />
                <ui:VisualElement class="segments-overlay">
                    <ui:VisualElement class="divider" style="left: 33.33%;" />
                    <ui:VisualElement class="divider" style="left: 66.66%;" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="track-bg exp-track">
                <ui:VisualElement name="exp-fill" class="fill-core exp-fill" />
                <ui:VisualElement class="segments-overlay">
                    <ui:VisualElement class="divider" style="left: 10%;" />
                    <ui:VisualElement class="divider" style="left: 20%;" />
                    <ui:VisualElement class="divider" style="left: 30%;" />
                    <ui:VisualElement class="divider" style="left: 40%;" />
                    <ui:VisualElement class="divider" style="left: 50%;" />
                    <ui:VisualElement class="divider" style="left: 60%;" />
                    <ui:VisualElement class="divider" style="left: 70%;" />
                    <ui:VisualElement class="divider" style="left: 80%;" />
                    <ui:VisualElement class="divider" style="left: 90%;" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="mic-icon" class="mic-icon-base mic-off" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="minimap-container" class="minimap-wrapper">
        <ui:VisualElement class="minimap-mask">
            <ui:VisualElement name="minimap-content" class="minimap-content" />
            <ui:VisualElement class="minimap-grid-x" />
            <ui:VisualElement class="minimap-grid-y" />
        </ui:VisualElement>
        <ui:VisualElement class="minimap-border" />
        <ui:VisualElement class="minimap-inner-ring" />
        <ui:VisualElement class="minimap-deco-dot" style="top: -2px; left: 95px;" />
        <ui:VisualElement class="minimap-deco-dot" style="bottom: -2px; left: 95px;" />
        <ui:VisualElement class="minimap-deco-dot" style="top: 95px; left: -2px;" />
        <ui:VisualElement class="minimap-deco-dot" style="top: 95px; right: -2px;" />
        <ui:Label text="N" class="minimap-compass-n" />
        <ui:VisualElement class="minimap-hotkey-container">
            <ui:Label text="M" class="minimap-hotkey" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement class="hud-weapons-wrapper" style="-unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&amp;guid=8dcf67e479d58bd47908bf0d5e1cc1d0&amp;type=3#NotInter-Regular&quot;);">
        <ui:VisualElement name="weapon-slot-1" class="weapon-slot weapon-active">
            <ui:VisualElement class="weapon-hotkey-wrapper">
                <ui:VisualElement class="weapon-hotkey-container">
                    <ui:Label text="1" class="weapon-hotkey" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="weapon-img-1" class="weapon-image" style="background-image: url(&quot;project://database/Assets/Hbao/Image/N%E1%BA%A5m%20%C4%91%E1%BA%A5m.png?fileID=2800000&amp;guid=14531db39fa39224290fb66a20930bcc&amp;type=3#Nấm đấm&quot;); width: 240px; height: 107px; top: -16px; right: 28px;" />
        </ui:VisualElement>
        <ui:VisualElement name="weapon-slot-2" class="weapon-slot weapon-inactive">
            <ui:VisualElement class="weapon-hotkey-wrapper">
                <ui:VisualElement class="weapon-hotkey-container">
                    <ui:Label text="2" class="weapon-hotkey" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="weapon-img-2" class="weapon-image" style="background-image: url(&quot;project://database/Assets/Hbao/Image/VukhiPLayer1.png?fileID=2800000&amp;guid=e5e54aaec41889f4383d000dfe69d050&amp;type=3#VukhiPLayer1&quot;); height: 139px; width: 296px; top: -22px; right: -24px;" />
            <ui:VisualElement name="weapon-lock-2" class="weapon-lock-overlay">
                <ui:VisualElement class="weapon-lock-icon" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement class="hud-skills-wrapper" style="-unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&amp;guid=8dcf67e479d58bd47908bf0d5e1cc1d0&amp;type=3#NotInter-Regular&quot;);">


        <ui:VisualElement class="skill-slot">
            <ui:VisualElement class="skill-hotkey-container">
                <ui:Label text="F" class="skill-hotkey" />
            </ui:VisualElement>
            <ui:VisualElement name="skill-img-f" class="skill-image" style="background-image: url(&quot;project://database/Assets/Hbao/Image/Skill%201,.png?fileID=2800000&amp;guid=aa0fb8d4832b5c04289b5050bec3c919&amp;type=3#Skill 1,&quot;);" />
            <ui:VisualElement name="skill-cooldown-f" class="skill-cooldown-overlay" style="height: 0%;" />
            <ui:Label name="skill-cooldown-text-f" class="skill-cooldown-text" />
            <ui:VisualElement name="skill-lock-f" class="skill-lock-overlay">
                <ui:VisualElement class="skill-lock-icon" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="skill-slot">
            <ui:VisualElement class="skill-hotkey-container">
                <ui:Label text="R" class="skill-hotkey" />
            </ui:VisualElement>
            <ui:VisualElement name="skill-img-r" class="skill-image" style="background-image: url(&quot;project://database/Assets/Hbao/Image/Skill%202.png?fileID=2800000&amp;guid=a78801096338d0f47b5d2b17270fdd15&amp;type=3#Skill 2&quot;);" />
            <ui:VisualElement name="skill-cooldown-r" class="skill-cooldown-overlay" style="height: 0%;" />
            <ui:Label name="skill-cooldown-text-r" class="skill-cooldown-text" />
            <ui:VisualElement name="skill-lock-r" class="skill-lock-overlay">
                <ui:VisualElement class="skill-lock-icon" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:Label name="weapon-warning" text="Kỹ Năng Đang Bị Khóa" parse-escape-sequences="false" class="weapon-warning-label" style="-unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&amp;guid=8dcf67e479d58bd47908bf0d5e1cc1d0&amp;type=3#NotInter-Regular&quot;);" />
    <ui:VisualElement name="world-map-overlay" class="world-map-overlay">
        <ui:VisualElement class="world-map-frame" />
    </ui:VisualElement>

</ui:UXML>
