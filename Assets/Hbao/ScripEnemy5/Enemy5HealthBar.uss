.main-container {
    align-items: center;
    justify-content: center;
    padding: 10px;
}

.enemy-name {
    color: rgb(255, 150, 230); /* Màu hồng cánh sen ma thuật sáng rực rỡ */
    font-size: 17px;
    -unity-font-style: bold;
    text-shadow: 2px 2px 4px rgba(255, 0, 128, 0.95); /* Hào quang hồng cánh sen đặc trưng phép thuật */
    margin-bottom: 5px;
    letter-spacing: 1.8px;
}

.container {
    width: 220px; 
    height: 24px;
}

.background {
    width: 100%;
    height: 100%;
    background-color: rgba(15, 2, 20, 0.85); /* Nền đen thẫm pha tím đậm */
    border-width: 2px;
    border-color: rgb(255, 20, 147); /* Viền hồng Neon rực sáng tinh xảo */
    border-radius: 7px;
    overflow: hidden;
    padding: 2.5px;
    box-shadow: 0px 0px 10px rgba(255, 20, 147, 0.65); /* Hào quang phép thuật huyền bí */
}

.progress-bar {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(255, 0, 128); /* Hồng Sen Đậm Neon cực đẹp */
    border-radius: 4px;
    transition-property: width;
    transition-duration: 0.15s; /* Phản hồi giảm máu lập tức */
    transition-timing-function: ease-out;
    background-image: linear-gradient(to bottom, rgba(255, 255, 255, 0.45), rgba(0, 0, 0, 0.35));
}

.yellow-bar {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(255, 215, 0); /* Vàng Gold rực rỡ */
    border-radius: 4px;
    transition-property: width;
    transition-duration: 0.75s; /* Trễ chậm nhịp để thấy rõ lượng HP đã mất */
    transition-timing-function: ease-in-out;
}
