/* =========================================================================
   ATLANTIS: DEEP SLUMBER - ENDING & ROLLING CREDITS UI TOOLKIT STYLES
   ========================================================================= */

.ending-root-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(0, 0, 0);
    justify-content: center;
    align-items: center;
    overflow: hidden;
    opacity: 1;
    transition: opacity 0.6s ease-in-out;
}

/* NỀN ĐEN ĐẶC TUYỆT ĐỐI (ĐỂ DÒNG CHỮ EPILOGUE KHÔNG BỊ LỘ ẢNH NỀN) */
.dark-background {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(0, 0, 0);
}

/* =========================================================================
   GIAI ĐOẠN 1: EPILOGUE PANEL (CHỈ NỀN ĐEN + DÒNG CHỮ LẮNG ĐỌNG)
   ========================================================================= */
.epilogue-panel {
    position: absolute;
    width: 80%;
    max-width: 1200px;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 1.2s ease-in-out;
}

.epilogue-quote-text {
    color: rgb(226, 183, 85);
    font-size: 38px;
    -unity-font-style: italic;
    -unity-text-align: middle-center;
    letter-spacing: 2px;
    white-space: normal;
    text-shadow: 0 0 20px rgba(226, 183, 85, 0.6), 0 4px 10px rgba(0, 0, 0, 0.95);
    margin-top: 24px;
    margin-bottom: 24px;
    line-height: 52px;
}

.quote-ornament {
    width: 280px;
    height: 2px;
    background-color: rgba(226, 183, 85, 0.45);
    border-radius: 1px;
}

/* =========================================================================
   GIAI ĐOẠN 2: CREDITS VIEWPORT (CÓ ẢNH NỀN MAINMENU & NÚT BỎ QUA)
   ========================================================================= */
.credits-viewport {
    position: absolute;
    width: 100%;
    height: 100%;
    overflow: hidden;
    justify-content: center;
    align-items: center;
}

/* Ảnh nền MainMenu chỉ hiển thị trong credits */
.credits-bg-image {
    position: absolute;
    width: 100%;
    height: 100%;
    background-image: url("project://database/Assets/PLuan/MainMenu/IMG/background1 1.jpg?fileID=2800000&guid=f6d4a2e15e1310e4c98f33fb088b9575&type=3#background1 1");
    -unity-background-scale-mode: scale-and-crop;
    -unity-background-image-tint-color: rgba(120, 150, 180, 0.45);
    background-color: rgb(2, 5, 10);
}

/* Màng tối scrim để chữ cuộn luôn rõ ràng */
.credits-scrim {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(1, 4, 8, 0.55);
}

.credits-scroll-container {
    position: absolute;
    width: 85%;
    max-width: 1000px;
    align-items: center;
    justify-content: flex-start;
    top: 100%;
}

/* Các kiểu chữ trong Credit */
.credit-title {
    color: rgb(93, 230, 255);
    font-size: 58px;
    -unity-font-style: bold;
    letter-spacing: 6px;
    -unity-text-align: middle-center;
    margin-bottom: 12px;
    text-shadow: 0 0 25px rgba(93, 230, 255, 0.9), 0 4px 12px rgba(0, 0, 0, 0.95);
}

.credit-project-type {
    color: rgb(226, 183, 85);
    font-size: 26px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    -unity-text-align: middle-center;
    margin-bottom: 6px;
    text-shadow: 0 0 15px rgba(226, 183, 85, 0.7);
}

.credit-school-name {
    color: rgb(170, 190, 210);
    font-size: 20px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    margin-bottom: 20px;
}

.credit-divider {
    width: 380px;
    height: 2px;
    background-color: rgba(93, 230, 255, 0.35);
    margin-top: 25px;
    margin-bottom: 35px;
}

.credit-section {
    align-items: center;
    margin-bottom: 42px;
    width: 100%;
}

.credit-role-header {
    color: rgb(255, 209, 102);
    font-size: 28px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    margin-bottom: 14px;
    text-shadow: 0 0 14px rgba(255, 209, 102, 0.6);
}

.credit-person-name {
    color: rgb(240, 248, 255);
    font-size: 30px;
    letter-spacing: 1.5px;
    -unity-text-align: middle-center;
    margin-bottom: 8px;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.9);
}

.credit-group-name {
    color: rgb(255, 255, 255);
    font-size: 38px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    -unity-text-align: middle-center;
    text-shadow: 0 0 18px rgba(255, 255, 255, 0.8);
}

.credit-desc-text {
    color: rgb(185, 210, 230);
    font-size: 24px;
    -unity-text-align: middle-center;
    margin-bottom: 6px;
    white-space: normal;
    max-width: 800px;
    line-height: 36px;
}

.credit-thank-you {
    color: rgb(93, 230, 255);
    font-size: 46px;
    -unity-font-style: bold;
    letter-spacing: 5px;
    -unity-text-align: middle-center;
    margin-top: 30px;
    margin-bottom: 120px;
    text-shadow: 0 0 25px rgba(93, 230, 255, 0.95);
}

/* =========================================================================
   NÚT BỎ QUA THIẾT KẾ KHÉO LÉO, TINH TẾ (REFINED SKIP BUTTON)
   ========================================================================= */
.btn-skip-credits {
    position: absolute;
    top: 32px;
    right: 36px;
    height: 42px;
    padding-left: 14px;
    padding-right: 18px;
    background-color: rgba(8, 20, 34, 0.7);
    border-color: rgba(93, 230, 255, 0.35);
    border-width: 1px;
    border-radius: 21px;
    justify-content: center;
    align-items: center;
    transition: background-color 0.25s, border-color 0.25s, scale 0.2s, box-shadow 0.25s;
}

.btn-skip-credits:hover {
    background-color: rgba(16, 48, 80, 0.9);
    border-color: rgb(93, 230, 255);
    scale: 1.05;
}

.btn-skip-credits:active {
    background-color: rgba(8, 30, 52, 0.95);
    scale: 0.97;
}

.skip-btn-inner {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.skip-key-badge {
    background-color: rgba(93, 230, 255, 0.15);
    border-color: rgba(93, 230, 255, 0.5);
    border-width: 1px;
    border-radius: 5px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 2px;
    padding-bottom: 2px;
    margin-right: 8px;
}

.skip-key-text {
    font-size: 11px;
    color: rgb(93, 230, 255);
    -unity-font-style: bold;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}

.skip-btn-label {
    color: rgb(235, 245, 255);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
}

.skip-arrow-text {
    font-size: 13px;
    color: rgb(93, 230, 255);
    margin-left: 6px;
    -unity-text-align: middle-center;
}

/* =========================================================================
   TIỆN ÍCH HIỂN THỊ
   ========================================================================= */
.hidden-element {
    display: none;
    opacity: 0;
}

.fade-in {
    opacity: 1;
}

.fade-out {
    opacity: 0;
}
