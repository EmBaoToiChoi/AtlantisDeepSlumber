.main-container {
    position: absolute;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.hidden {
    opacity: 0;
    display: none;
}

/* Khung bọc to ngoài cùng Popup 05 */
.qte-popup-container {
    position: relative;
    align-items: center;
    justify-content: center;
    min-width: 640px;
    min-height: 140px;
    padding: 36px 64px;
    overflow: visible;
}

/* Nền tối màu Obsidian sâu thẳm với đổ bóng đen */
.qte-frame-bg {
    position: absolute;
    top: 10px;
    left: 20px;
    right: 20px;
    bottom: 10px;
    background-color: rgba(12, 10, 16, 0.95);
    border-radius: 12px;
    box-shadow: 0px 10px 35px rgba(0, 0, 0, 0.96);
}

/* Khung viền to Fantasy Popup 05 Trái + Phải */
.qte-frame-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
    pointer-events: none;
    overflow: visible;
}

.qte-frame-left {
    width: 50%;
    height: 100%;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Popup_05_Left.png?fileID=1537655665&guid=db7044a4942e14947b357cbc9efddbe7&type=3#SPR_FantasyMenus_Frame_Popup_05_Left");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 280;
    -unity-slice-top: 180;
    -unity-slice-right: 20;
    -unity-slice-bottom: 120;
}

.qte-frame-right {
    width: 50%;
    height: 100%;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Popup_05_Right.png?fileID=1537655665&guid=7ed52ecc77a9b964ea828cd8c32a91e1&type=3#SPR_FantasyMenus_Frame_Popup_05_Right");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 20;
    -unity-slice-top: 180;
    -unity-slice-right: 280;
    -unity-slice-bottom: 120;
}

/* Nội dung thanh QTE bên trong */
.qte-board {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 2;
    background-color: transparent;
    padding: 0;
}

.key-box {
    width: 54px;
    height: 54px;
    background-color: rgba(20, 16, 28, 0.9);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgba(230, 195, 110, 0.85);
    box-shadow: 0px 4px 14px rgba(0, 0, 0, 0.9);
    align-items: center;
    justify-content: center;
    transform-origin: center;
    transition-property: scale, background-color, border-color;
    transition-duration: 0.1s, 0.1s, 0.1s;
}

.key-text {
    font-size: 26px;
    color: rgb(255, 238, 195);
    -unity-font-style: bold;
    text-shadow: 0px 2px 6px rgba(0, 0, 0, 1);
}

.key-box.pressed {
    scale: 1.15 1.15;
    background-color: rgb(255, 200, 70);
    border-color: rgb(255, 255, 255);
}

.key-box.pressed .key-text {
    color: rgb(20, 10, 0);
}

.progress-wrapper {
    width: 360px;
    height: 20px;
    background-color: rgba(8, 6, 12, 0.92);
    border-radius: 10px;
    margin: 0 24px;
    position: relative;
    border-width: 1.5px;
    border-color: rgba(230, 195, 110, 0.6);
    box-shadow: inset 0px 2px 6px rgba(0, 0, 0, 0.9);
}

.progress-fill {
    width: 0%;
    height: 100%;
    background-color: rgb(45, 200, 255);
    border-radius: 8px;
    transition-property: width;
    transition-duration: 0.1s;
    transition-timing-function: linear;
}

.progress-mark {
    position: absolute;
    width: 4px;
    height: 30px;
    top: -6px;
    background-color: rgb(255, 235, 120);
    border-radius: 2px;
    box-shadow: 0px 0px 8px rgba(255, 215, 0, 0.9);
}