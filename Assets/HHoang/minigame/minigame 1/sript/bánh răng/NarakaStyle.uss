/* Main Container for Naraka QTE */
.main-container {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    align-items: center;
    justify-content: flex-start;
    padding-top: 90px;
    background-color: transparent;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.hidden {
    opacity: 0;
    display: none;
}

/* Khung bọc QTE Fantasy Box thu nhỏ gọn gàng, thanh thoát */
.qte-popup-container {
    position: relative;
    align-items: center;
    justify-content: center;
    width: 420px;
    height: 56px;
    padding: 0;
    overflow: visible;
}

/* Nền tối màu Obsidian sâu thẳm với đổ bóng êm ái */
.qte-frame-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(12, 10, 16, 0.95);
    border-radius: 8px;
    box-shadow: 0px 6px 20px rgba(0, 0, 0, 0.92);
}

/* Khung viền hoa văn vàng Fantasy Box Medium 02 ôm khít viền thanh thoát */
.qte-frame {
    position: absolute;
    top: -6px;
    left: -8px;
    right: -8px;
    bottom: -6px;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Box_Medium_02.png?fileID=1537655665&guid=4c83811485b435e4a93a37b73758d514&type=3#SPR_FantasyMenus_Frame_Box_Medium_02");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 50;
    -unity-slice-top: 50;
    -unity-slice-right: 50;
    -unity-slice-bottom: 50;
    pointer-events: none;
}

/* Nội dung thanh QTE bên trong */
.qte-board {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 2;
    background-color: transparent;
    width: 100%;
    height: 100%;
    padding: 0 16px;
}

.key-box {
    width: 36px;
    height: 36px;
    background-color: rgba(22, 18, 30, 0.95);
    border-radius: 6px;
    border-width: 1.5px;
    border-color: rgba(230, 195, 110, 0.85);
    box-shadow: 0px 3px 8px rgba(0, 0, 0, 0.9);
    align-items: center;
    justify-content: center;
    transform-origin: center;
    transition-property: scale, background-color, border-color;
    transition-duration: 0.1s, 0.1s, 0.1s;
}

.key-text {
    font-size: 17px;
    color: rgb(255, 238, 195);
    -unity-font-style: bold;
    text-shadow: 0px 2px 4px rgba(0, 0, 0, 1);
}

.key-box.pressed {
    scale: 1.1 1.1;
    background-color: rgb(255, 200, 70);
    border-color: rgb(255, 255, 255);
}

.key-box.pressed .key-text {
    color: rgb(20, 10, 0);
}

.progress-wrapper {
    width: 250px;
    height: 14px;
    background-color: rgba(8, 6, 12, 0.92);
    border-radius: 7px;
    margin: 0 12px;
    position: relative;
    border-width: 1.5px;
    border-color: rgba(230, 195, 110, 0.6);
    box-shadow: inset 0px 2px 5px rgba(0, 0, 0, 0.9);
}

.progress-fill {
    width: 0%;
    height: 100%;
    background-color: rgb(45, 200, 255);
    border-radius: 5px;
    transition-property: width;
    transition-duration: 0.1s;
    transition-timing-function: linear;
}

.progress-mark {
    position: absolute;
    width: 3px;
    height: 22px;
    top: -4px;
    background-color: rgb(255, 235, 120);
    border-radius: 2px;
    box-shadow: 0px 0px 6px rgba(255, 215, 0, 0.9);
}
