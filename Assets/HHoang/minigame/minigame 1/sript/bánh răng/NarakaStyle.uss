.main-container {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    align-items: center;
    justify-content: flex-start;
    padding-top: 60px;
    background-color: transparent;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.hidden {
    opacity: 0;
    display: none;
}

/* Khung bọc QTE Fantasy Box đều đặn, cân đối 4 phía */
.qte-popup-container {
    position: relative;
    align-items: center;
    justify-content: center;
    width: 580px;
    height: 88px;
    padding: 0;
    overflow: visible;
}

/* Nền tối màu Obsidian sâu thẳm với đổ bóng đen */
.qte-frame-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(12, 10, 16, 0.95);
    border-radius: 10px;
    box-shadow: 0px 8px 32px rgba(0, 0, 0, 0.96);
}

/* Khung viền hoa văn vàng Fantasy Box Medium 02 bọc kín 4 phía */
.qte-frame {
    position: absolute;
    top: -10px;
    left: -14px;
    right: -14px;
    bottom: -10px;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Box_Medium_02.png?fileID=1537655665&guid=4c83811485b435e4a93a37b73758d514&type=3#SPR_FantasyMenus_Frame_Box_Medium_02");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 80;
    -unity-slice-top: 80;
    -unity-slice-right: 80;
    -unity-slice-bottom: 80;
    pointer-events: none;
}

/* Nội dung thanh QTE bên trong */
.qte-board {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 2;
    background-color: transparent;
    width: 100%;
    height: 100%;
    padding: 0 24px;
}

.key-box {
    width: 48px;
    height: 48px;
    background-color: rgba(22, 18, 30, 0.95);
    border-radius: 10px;
    border-width: 2px;
    border-color: rgba(230, 195, 110, 0.85);
    box-shadow: 0px 4px 12px rgba(0, 0, 0, 0.9);
    align-items: center;
    justify-content: center;
    transform-origin: center;
    transition-property: scale, background-color, border-color;
    transition-duration: 0.1s, 0.1s, 0.1s;
}

.key-text {
    font-size: 24px;
    color: rgb(255, 238, 195);
    -unity-font-style: bold;
    text-shadow: 0px 2px 6px rgba(0, 0, 0, 1);
}

.key-box.pressed {
    scale: 1.12 1.12;
    background-color: rgb(255, 200, 70);
    border-color: rgb(255, 255, 255);
}

.key-box.pressed .key-text {
    color: rgb(20, 10, 0);
}

.progress-wrapper {
    width: 340px;
    height: 18px;
    background-color: rgba(8, 6, 12, 0.92);
    border-radius: 9px;
    margin: 0 16px;
    position: relative;
    border-width: 1.5px;
    border-color: rgba(230, 195, 110, 0.6);
    box-shadow: inset 0px 2px 6px rgba(0, 0, 0, 0.9);
}

.progress-fill {
    width: 0%;
    height: 100%;
    background-color: rgb(45, 200, 255);
    border-radius: 7px;
    transition-property: width;
    transition-duration: 0.1s;
    transition-timing-function: linear;
}

.progress-mark {
    position: absolute;
    width: 4px;
    height: 28px;
    top: -5px;
    background-color: rgb(255, 235, 120);
    border-radius: 2px;
    box-shadow: 0px 0px 8px rgba(255, 215, 0, 0.9);
}