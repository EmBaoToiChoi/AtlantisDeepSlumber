/* =========================================================================
   ATLANTIS LOADING SCREEN STYLES (SEAMLESS BOTTOM-CENTERED)
   ========================================================================= */

.loading-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(0, 4, 8);
    justify-content: flex-end;
    align-items: center;
    padding-bottom: 60px;
    opacity: 1;
    transition: opacity 0.5s ease-in-out;
}

/* Lớp phát Video Nền toàn màn hình */
.loading-video-bg {
    position: absolute;
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-and-crop;
    background-color: transparent;
}

/* Lớp màng mờ Gradient tối ở đáy làm nổi bật chữ không cần khung */
.loading-scrim {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(1, 8, 18, 0.45);
}

/* Cụm Nội Dung Loading Đáy Màn Hình (Không Khung Viền) */
.loading-content {
    width: 750px;
    max-width: 85%;
    background-color: transparent;
    border-width: 0;
    align-items: center;
    justify-content: center;
}

/* Tiêu Đề Nạp */
.loading-title {
    color: rgb(255, 255, 255);
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 5px;
    margin-bottom: 16px;
    text-shadow: 0 0 16px rgba(0, 220, 255, 0.8), 0 2px 4px rgba(0, 0, 0, 0.9);
}

/* Khung Thanh Tiến Trình & % */
.progress-section {
    flex-direction: row;
    align-items: center;
    width: 100%;
    margin-bottom: 14px;
}

.progress-container {
    flex-grow: 1;
    height: 8px;
    background-color: rgba(0, 20, 38, 0.85);
    border-radius: 4px;
    overflow: hidden;
    border-width: 1px;
    border-color: rgba(0, 240, 255, 0.45);
}

.progress-fill {
    height: 100%;
    width: 0%;
    background-color: rgb(0, 245, 255);
    border-radius: 4px;
    transition: width 0.1s ease-out;
}

.loading-percent {
    color: rgb(0, 245, 255);
    font-size: 16px;
    -unity-font-style: bold;
    margin-left: 14px;
    min-width: 46px;
    -unity-text-align: middle-right;
    letter-spacing: 1px;
    text-shadow: 0 0 10px rgba(0, 245, 255, 0.9), 0 2px 4px rgba(0, 0, 0, 0.9);
}

/* Hàng Trạng Thái & Pulse */
.status-box {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.pulse-indicator {
    width: 7px;
    height: 7px;
    border-radius: 3.5px;
    background-color: rgb(0, 255, 220);
    margin-right: 9px;
}

.loading-status {
    color: rgba(200, 245, 255, 0.9);
    font-size: 13px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.95);
}

/* Trạng thái ẩn */
.hidden-element {
    display: none;
    opacity: 0;
}


