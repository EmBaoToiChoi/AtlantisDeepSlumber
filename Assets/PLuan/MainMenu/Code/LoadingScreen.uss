.loading-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(0, 4, 8);
    justify-content: center;
    align-items: center;
    opacity: 1;
    transition: opacity 0.5s ease-in-out;
}

.loading-content {
    width: 600px;
    align-items: center;
}

.loading-title {
    color: rgb(0, 190, 255);
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 10px;
    margin-bottom: 20px;
    text-shadow: 0 0 10px rgba(0, 190, 255, 0.5);
}

.progress-container {
    width: 100%;
    height: 8px;
    background-color: rgba(0, 190, 255, 0.1);
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 15px;
    border-width: 1px;
    border-color: rgba(0, 190, 255, 0.3);
}

.progress-fill {
    height: 100%;
    width: 0%;
    background-color: rgb(0, 255, 255);
    box-shadow: 0 0 15px rgba(0, 255, 255, 0.8);
    transition: width 0.1s ease-out;
}

.loading-status {
    color: rgba(160, 230, 255, 0.7);
    font-size: 14px;
    letter-spacing: 2px;
}

.hidden-element {
    display: none;
    opacity: 0;
}
