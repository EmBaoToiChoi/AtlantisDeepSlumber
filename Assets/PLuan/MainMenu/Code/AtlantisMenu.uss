/* --- CẤU TRÚC GỐC & BACKGROUND --- */
.root-screen {
    flex-grow: 1;
    justify-content: center;
    align-items: flex-start;
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-and-crop;
    background-color: rgb(0, 4, 8);
    
    /* Gán Font Asset của bạn vào đây */
    /* -unity-font-definition: url('project://database/Assets/YourPath/Orbitron-Regular.asset'); */
}

/* --- MENU & PANELS --- */
.menu-container {
    margin-left: 4%;
    width: 520px; /* Slightly wider to compensate for thick borders */
    height: 550px; /* Taller height to comfortably fit all form contents */
    padding: 140px 55px 45px 55px; /* Optimised paddings to clear top ornate borders and compensate for hidden title */
    justify-content: center; /* Center content vertically inside the frame */
    background-image: url("project://database/Assets/PLuan/WaittingRoom/Textures/ui_frame_bg.jpg");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
    text-shadow: 0 0 12px rgba(0, 0, 0, 0.8);

    /* Animation Transition */
    transition-property: opacity, scale;
    transition-duration: 0.4s;
    transition-timing-function: ease-out-back;
}

.large-panel {
    margin-left: 1.5%;
    width: 1060px; /* Wider frame to give content more room */
    height: 680px; /* Taller fixed height for spacious content and clean margins */
    padding: 145px 120px 80px 120px; /* Generous padding to completely keep all content inside the safe blue stone background and compensate for hidden title */
}

#create-room-panel {
    height: 700px !important; /* Fixed standard height of the menu-container */
    padding: 135px 55px 45px 55px !important;
}

#main-menu-panel,
#network-menu-panel {
    padding-top: 100px !important;
}

#join-room-panel {
    padding-top: 140px !important; /* Pushed down to prevent ID bar from overlapping top frame */
}

#create-room-panel .menu-btn {
    font-size: 20px !important; /* Slightly smaller button text */
    margin-bottom: 6px !important; /* Bring buttons closer vertically */
    padding: 8px 12px !important; /* Tighter padding for spacing */
}

#create-room-panel .back-btn {
    margin-top: 5px !important; /* Bring back button closer to the host button */
}

#create-room-panel #password-group.hidden-element {
    display: flex !important; /* Force layout space preservation */
    visibility: hidden; /* Hide contents */
    opacity: 0;
    pointer-events: none;
}

.hidden-panel { 
    display: none;
    opacity: 0;
    scale: 0.9;
    pointer-events: none;
}

/* Lớp trung gian để xử lý animation trước khi display: none */
.panel-fade-out {
    opacity: 0;
    scale: 0.9;
    pointer-events: none;
}

.hidden-element { display: none; }

/* --- TIÊU ĐỀ PANELS --- */
.panel-title {
    display: none;
}
.button-group { width: 100%; flex-direction: column; }

/* --- MAIN BUTTONS --- */
.menu-btn {
    background-color: transparent;
    border-width: 0;
    color: rgb(140, 210, 245);
    padding: 16px 20px;
    font-size: 26px; /* Significantly larger text for premium look and readability */
    letter-spacing: 4px;
    -unity-text-align: middle-center;
    margin-bottom: 12px;
    
    /* Tăng thời gian transition để mượt mà hơn */
    transition: all 0.3s ease-in-out;
    
    white-space: nowrap;
    text-overflow: ellipsis;
    -unity-font-style: bold;
    border-radius: 0;
    text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.9);
}

/* Glow Text rực rỡ dải Cyan khi Hover */
.menu-btn:hover {
    color: rgb(255, 255, 255);
    
    /* Hiệu ứng phóng lớn (Scale) */
    scale: 1.08 1.08;
    
    /* Giãn cách chữ tạo hiệu ứng "Scanning" */
    letter-spacing: 6px;
    
    background-color: transparent;
    
    /* Hào quang (Glow) cực mạnh */
    text-shadow: 0 0 20px rgba(0, 255, 255, 1);
}
.menu-btn:active {
    scale: 0.95 0.95;
    background-color: transparent;
    color: rgba(0, 255, 255, 0.8);
    transition: all 0.05s;
}

/* Nút Back - Đổi sang tone Ice Blue dịu mắt */
.back-btn { 
    color: rgb(100, 150, 180); 
    background-color: transparent; 
    margin-top: 8px; 
}
.back-btn:hover { 
    color: rgb(180, 230, 255); 
    background-color: transparent; 
    text-shadow: 0 0 10px rgba(180, 230, 255, 0.6); 
    scale: 1.08 1.08;
}

/* Nút Quit - Giữ sắc đỏ nhưng tinh chỉnh để hợp với nền tối */
.quit-btn { 
    color: rgb(220, 120, 120); 
    background-color: transparent; 
    margin-top: 25px; 
}
.quit-btn:hover { 
    color: rgb(255, 150, 150); 
    background-color: transparent; 
    /* Đổ bóng đỏ rực */
    text-shadow: 0 0 15px rgba(255, 50, 50, 0.8);
    scale: 1.08 1.08;
}

.version-text {
    position: absolute;
    bottom: 25px;
    left: 35px;
    color: rgba(60, 130, 160, 0.85); /* Slightly brighter for readability but still ambient */
    font-size: 14px;
    letter-spacing: 2px;
    text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.85);
}

/* --- FORM INPUTS --- */
.form-group { width: 100%; margin-bottom: 16px; }
.form-label { color: rgb(100, 200, 240); font-size: 12px; letter-spacing: 2px; margin-bottom: 8px; -unity-font-style: bold; text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9); }

.form-input .unity-base-text-field__input {
    background-color: transparent !important;
    border-left-width: 0 !important;
    border-right-width: 0 !important;
    border-top-width: 0 !important;
    border-bottom-width: 2px !important;
    border-color: rgba(0, 190, 255, 0.35) !important;
    color: rgb(255, 255, 255);
    font-size: 14px;
    padding: 8px 4px !important;
    border-radius: 0 !important;
    transition: border-color 0.25s ease-out, text-shadow 0.25s ease-out;
}
.form-input .unity-base-text-field__input:focus {
    border-color: rgb(60, 220, 255) !important;
    background-color: transparent !important;
    text-shadow: 0 0 8px rgba(60, 220, 255, 0.6);
}

/* --- RADIO BUTTONS --- */
.radio-group { flex-direction: row; margin-top: 4px; }
.radio-group .unity-radio-button { margin-right: 25px; align-items: center; }
.radio-group .unity-radio-button__label { color: rgb(140, 210, 245); font-size: 14px; -unity-font-style: bold; margin-left: 8px; text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9); }
.radio-group .unity-radio-button__checkmark-background { background-color: rgba(0, 6, 12, 0.8); border-color: rgba(0, 190, 255, 0.5); border-width: 1px; }
.radio-group .unity-radio-button__indicator { background-color: rgb(60, 220, 255); }
.radio-text-public, .radio-text-private { color: rgb(60, 220, 255); }

/* --- NÚT MINI & LOBBY ACTIONS (TEXT-ONLY GLOW) --- */
.join-mini-btn {
    background-color: transparent !important;
    border-width: 0 !important;
    color: rgb(0, 190, 255) !important;
    padding: 6px 16px !important;
    font-size: 13px !important;
    letter-spacing: 1px;
    -unity-font-style: bold;
    transition: all 0.2s ease-out;
    -unity-text-align: middle-center;
}

/* Light up button text slightly when row is hovered */
.room-item:hover .join-mini-btn {
    color: rgb(160, 230, 255) !important;
}

/* Glow text on direct button hover */
.join-mini-btn:hover {
    background-color: transparent !important;
    color: rgb(255, 255, 255) !important;
    scale: 1.08 1.08;
    text-shadow: 0 0 10px rgba(0, 255, 255, 0.95) !important;
}
.cancel-btn {
    background-color: transparent !important;
    border-width: 0 !important;
    color: rgb(100, 150, 180) !important;
    margin-left: 80px;
    transition: all 0.2s ease-out;
}
.cancel-btn:hover {
    background-color: transparent !important;
    border-width: 0 !important;
    color: rgb(180, 230, 255) !important;
    scale: 1.08 1.08;
    text-shadow: 0 0 10px rgba(180, 230, 255, 0.6) !important;
}

/* --- BROWSER TABLE & LIST --- */
.join-id-bar {
    flex-direction: row;
    width: 100%;
    height: 42px;
    margin-bottom: 25px;
    align-items: center;
    justify-content: space-between;
}
.id-input {
    flex-grow: 1;
    height: 100%;
    margin-right: 15px;
    border-width: 0 !important; /* Remove outer box outline */
    background-color: transparent !important;
}
.id-input,
.id-input .unity-base-text-field,
.id-input .unity-text-field__input,
.id-input .unity-base-text-field__input {
    background-color: transparent !important;
    border-width: 0 !important;
    box-shadow: none !important;
}
.id-input .unity-base-text-field__input {
    height: 100%;
    font-size: 16px;
    letter-spacing: 6px;
    -unity-font-style: bold;
    color: rgb(0, 255, 255);
    -unity-text-align: middle-center;
    padding: 0;
    background-color: transparent !important; /* Completely transparent background, no box */
    border-width: 0 0 1px 0 !important; /* 1px Bottom line underline style only */
    border-bottom-color: rgba(0, 190, 255, 0.35) !important; /* Ambient blue-green line */
    border-radius: 0 !important;
    transition: border-bottom-color 0.25s ease-out, text-shadow 0.25s ease-out;
}
.id-input .unity-base-text-field__input:focus {
    border-bottom-color: rgb(0, 255, 255) !important; /* Lights up bright cyan */
    text-shadow: 0 0 10px rgba(0, 255, 255, 0.75);
}
.id-btn {
    background-color: transparent !important; /* No background */
    border-width: 0 !important; /* No border outline */
    color: rgb(120, 230, 255) !important;
    font-size: 13px !important;
    letter-spacing: 1px;
    -unity-font-style: bold;
    padding: 0 20px !important;
    height: 100% !important;
    transition: all 0.2s ease-out;
}
.id-btn:hover {
    background-color: transparent !important;
    color: rgb(255, 255, 255) !important;
    scale: 1.05 1.05;
    text-shadow: 0 0 12px rgba(0, 255, 255, 0.95) !important;
}

.table-header {
    flex-direction: row;
    width: 100%;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 190, 255, 0.15); /* Soft, ambient divider line */
    padding-bottom: 10px;
    margin-bottom: 12px;
    padding-left: 16px;
    padding-right: 32px; /* 16px padding + 16px scrollbar space offset to align with margin-right of items */
}
.table-header Label {
    color: rgb(0, 190, 255);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.room-list {
    flex-grow: 0;
    height: 205px;
    width: 100%;
    padding-right: 0 !important; /* Clean space, margin handled by child items */
}
.room-list .unity-scroll-view__content-container {
    width: 100%;
    overflow: hidden;
}
.room-list .unity-scroll-view__horizontal-scroller {
    display: none !important;
}

#btn-join-back {
    font-size: 20px !important;
    letter-spacing: 2px !important;
    align-self: center !important;
    white-space: nowrap !important;
    text-overflow: clip !important;
    width: auto !important;
    max-width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
}

.room-item {
    flex-direction: row;
    align-items: center;
    background-color: transparent !important; /* Completely transparent background when idle */
    border-width: 0 !important; /* No box borders/frames */
    padding: 10px 16px;
    margin-bottom: 4px; /* Clean spacing between rows */
    margin-right: 16px !important; /* Spacing for the scrollbar to sit outside on the right */
    border-radius: 6px !important;
    width: auto !important; /* Stretch to fill available width minus margin */
    transition: background-color 0.2s ease-out;
}
.room-item:hover {
    background-color: rgba(0, 190, 255, 0.08) !important; /* Soft ambient highlight on row hover */
}
.room-item Label {
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.9);
    font-size: 13px;
    transition: color 0.25s ease-out, text-shadow 0.25s ease-out;
}

/* Room table column sizes */
.col-id {
    width: 110px;
    flex-shrink: 0;
}
.col-name {
    flex-grow: 1;
}
.col-host {
    width: 140px;
    flex-shrink: 0;
}
.col-players {
    width: 80px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}
.col-action {
    width: 90px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

/* Room item details styling */
.room-item .col-id {
    justify-content: center;
    align-items: flex-start;
}
.room-item #lbl-room-id {
    background-color: transparent !important; /* No tag capsule background */
    border-width: 0 !important; /* No border outline */
    padding: 0;
    color: rgb(0, 210, 255) !important; /* Clean cyan text */
    -unity-font-style: bold;
    font-size: 13px;
}

.room-item .col-name {
    color: rgb(255, 255, 255) !important;
    -unity-font-style: bold;
    font-size: 14px;
    -unity-text-align: middle-left;
    padding-left: 10px;
}

.room-item .col-host {
    justify-content: center;
    align-items: flex-start;
}
.room-item #lbl-host-name {
    color: rgb(160, 210, 230) !important;
    font-size: 13px;
}

.room-item .col-players {
    color: rgb(120, 230, 255) !important;
    -unity-font-style: bold;
    font-size: 13px;
    background-color: transparent !important; /* No background capsule */
    padding: 0;
}

.room-item .col-action {
    justify-content: center;
    align-items: center;
}

/* Text glow transition on row hover */
.room-item:hover #lbl-room-id {
    color: rgb(255, 255, 255) !important;
    text-shadow: 0 0 8px rgba(0, 255, 255, 0.8);
}
.room-item:hover .col-name {
    color: rgb(255, 255, 255) !important;
    text-shadow: 0 0 10px rgba(255, 255, 255, 0.85);
}
.room-item:hover #lbl-host-name {
    color: rgb(200, 240, 255) !important;
    text-shadow: 0 0 6px rgba(180, 230, 255, 0.6);
}
.room-item:hover .col-players {
    color: rgb(255, 255, 255) !important;
    text-shadow: 0 0 8px rgba(0, 255, 255, 0.8);
}

/* Premium custom scrollbar for room list - floats outside the list cards correctly */
.room-list .unity-scroll-view__vertical-scroller,
.room-list .unity-scroller {
    width: 6px !important;
    background-color: transparent !important;
    border-width: 0 !important;
    position: absolute !important;
    right: 0px !important; /* Placed at the far right, outside the card margin */
    top: 0 !important;
    bottom: 0 !important;
    opacity: 0.85;
}

.room-list .unity-scroller__low-button,
.room-list .unity-scroller__high-button,
.room-list #unity-low-button,
.room-list #unity-high-button {
    display: none !important;
    height: 0 !important;
    width: 0 !important;
}

.room-list .unity-scroller .unity-base-slider__tracker {
    background-color: rgba(0, 190, 255, 0.05) !important;
    border-width: 1px !important;
    border-color: rgba(0, 190, 255, 0.15) !important;
    width: 4px !important;
    align-self: center !important;
    border-radius: 2px !important;
}

.room-list .unity-scroller .unity-base-slider__dragger {
    background-color: rgba(0, 190, 255, 0.5) !important;
    border-width: 0 !important;
    border-radius: 3px !important;
    width: 6px !important;
    left: 0px !important;
    transition-property: background-color, scale;
    transition-duration: 0.25s, 0.15s;
    transition-timing-function: ease-out;
}

.room-list .unity-scroller .unity-base-slider__dragger:hover {
    background-color: rgb(0, 255, 255) !important;
    scale: 1.2 1;
}

/* Custom JOIN text-only button with no background */
.join-mini-btn {
    background-color: transparent !important; /* No background */
    border-width: 0 !important; /* No borders */
    color: rgb(0, 190, 255) !important;
    padding: 5px 16px !important;
    font-size: 13px !important;
    -unity-font-style: bold;
    transition: all 0.2s ease-out;
}

/* Light up button slightly when row is hovered */
.room-item:hover .join-mini-btn {
    color: rgb(160, 230, 255) !important;
    background-color: transparent !important;
}

/* Glow text on direct hover */
.join-mini-btn:hover {
    background-color: transparent !important;
    color: rgb(255, 255, 255) !important;
    scale: 1.08 1.08;
    text-shadow: 0 0 10px rgba(0, 255, 255, 0.95) !important;
}

/* --- OPTIONS & CUSTOM SLIDERS --- */
.options-tabs { flex-direction: row; border-bottom-width: 1px; border-bottom-color: rgba(0, 190, 255, 0.3); margin-bottom: 30px; }
.tab-btn { background-color: transparent; border-width: 0; border-bottom-width: 2px; border-bottom-color: transparent; color: rgb(100, 150, 180); font-size: 14px; -unity-font-style: bold; padding: 10px 20px; border-radius: 0; }
.tab-btn:hover { color: rgb(140, 210, 245); }
.tab-btn.active { color: rgb(60, 220, 255); border-bottom-color: rgb(0, 190, 255); }

.slider-header { flex-direction: row; justify-content: space-between; width: 100%; }
.slider-val { color: rgb(60, 220, 255); -unity-font-style: bold; font-size: 13px; }
.options-actions {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    width: 100%;
    margin-top: 35px;
    flex-shrink: 0; /* Prevent action bar from shrinking */
}
.auth-room-label { color: rgb(60, 220, 255); font-size: 14px; -unity-font-style: bold; margin-bottom: 25px; }

.custom-select .unity-base-popup-field__text { color: rgb(60, 220, 255); -unity-font-style: bold; }
.custom-select .unity-base-popup-field__input { background-color: rgba(0, 6, 12, 0.8); border-color: rgba(0, 190, 255, 0.4); padding: 8px; border-radius: 4px; }

.checkbox-label .unity-toggle__label { color: rgb(140, 210, 245); margin-left: 10px; font-size: 13px; -unity-font-style: bold; }
.checkbox-label .unity-toggle__checkmark { background-color: rgba(0, 6, 12, 0.8); border-color: rgb(0, 190, 255); }

.custom-slider .unity-slider__tracker { background-color: rgba(0, 4, 8, 0.9); border-color: rgba(0, 190, 255, 0.3); border-width: 1px; height: 6px; border-radius: 3px; margin-top: -3px; }
.custom-slider .unity-slider__dragger { background-color: rgb(0, 190, 255); border-color: rgb(255, 255, 255); border-width: 1px; width: 16px; height: 16px; border-radius: 8px; margin-top: -8px; transition: scale 0.1s; }
.custom-slider .unity-slider__dragger:hover { background-color: rgb(120, 230, 255); scale: 1.25 1.25; }

/* --- HỆ THỐNG HẠT V3 --- */
.bubble-fx { position: absolute; border-radius: 50%; border-width: 1px; border-color: rgba(255, 255, 255, 0.35); background-color: transparent; picking-mode: ignore; transition: none; }
.bubble-core { position: absolute; border-radius: 50%; background-color: rgba(255, 255, 255, 0.7); picking-mode: ignore; transition: none; }
/* Đốm sáng trôi nổi được chuyển sang dải Cyan phát quang để hòa vào năng lượng của khu di tích */
.ambient-spot { position: absolute; border-radius: 50%; background-color: rgb(120, 230, 255); border-width: 2px; border-color: rgba(120, 230, 255, 0.25); picking-mode: ignore; transition: none; }
/* --- CUSTOM SLIDERS (HIGH-TECH STYLE) --- */
/* Đường ray thanh trượt (Tracker) */
.custom-slider .unity-base-slider__tracker {
    background-color: rgba(0, 4, 8, 0.95);
    border-color: rgba(0, 190, 255, 0.4);
    border-width: 1px;
    height: 6px;
    border-radius: 3px;
    margin-top: -3px; /* Căn giữa hoàn hảo */
    /* Tạo hiệu ứng dải sáng chạy ngầm bên dưới */
    box-shadow: 0 0 4px rgba(0, 190, 255, 0.2);
}

/* Nút kéo (Dragger) */
.custom-slider .unity-base-slider__dragger {
    background-color: rgb(0, 190, 255);
    border-color: rgb(255, 255, 255);
    border-width: 2px;
    width: 18px;
    height: 18px;
    border-radius: 9px; /* Bo tròn tuyệt đối */
    margin-top: -9px; /* Căn giữa tâm nút kéo với tracker */
    transition: scale 0.15s ease-out, background-color 0.15s;
}

/* Hiệu ứng khi di chuột hoặc kéo thanh trượt */
.custom-slider .unity-base-slider__dragger:hover,
.custom-slider .unity-base-slider__dragger:focus {
    background-color: rgb(120, 240, 255);
    border-color: rgb(255, 255, 255);
    scale: 1.3 1.3; /* Phóng to rực rỡ khi chạm vào */
}

/* --- CUSTOM DROPDOWN (HOÀN TOÀN TỰ XÂY) --- */

/* Hàng trigger hiển thị giá trị đang chọn */
.custom-dropdown {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgba(0, 6, 12, 0.9);
    border-width: 1px;
    border-color: rgba(0, 190, 255, 0.5);
    border-radius: 4px;
    padding: 10px 12px;
    transition: border-color 0.2s, background-color 0.2s;
    cursor: link;
}
.custom-dropdown:hover {
    border-color: rgb(0, 220, 255);
    background-color: rgba(0, 12, 22, 0.95);
}

/* Label hiển thị giá trị đang chọn */
.custom-dropdown-value {
    color: rgb(60, 220, 255);
    font-size: 14px;
    -unity-font-style: bold;
    flex-grow: 1;
    background-color: transparent;
}

/* Mũi tên ▼ */
.custom-dropdown-arrow {
    color: rgba(0, 190, 255, 0.7);
    font-size: 12px;
    margin-left: 10px;
    background-color: transparent;
    transition: color 0.2s;
}
.custom-dropdown:hover .custom-dropdown-arrow {
    color: rgb(0, 220, 255);
}

/* --- POPUP DANH SÁCH XỔ XUỐNG --- */
.custom-dropdown-popup {
    position: absolute;
    background-color: rgba(2, 9, 16, 0.97);
    border-width: 1px;
    border-color: rgba(0, 190, 255, 0.7);
    border-radius: 4px;
    min-width: 200px;
    /* Hiệu ứng glow xanh bao quanh */
    /* box-shadow: 0 0 15px rgba(0, 190, 255, 0.3); */
}

/* Từng item trong popup */
.custom-dropdown-item {
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 190, 255, 0.08);
    color: rgb(130, 205, 245);
    font-size: 14px;
    -unity-font-style: bold;
    padding: 10px 14px;
    -unity-text-align: middle-left;
    transition: background-color 0.12s, padding-left 0.12s;
}
.custom-dropdown-item:last-child {
    border-bottom-width: 0;
}
.custom-dropdown-item:hover {
    background-color: rgba(0, 190, 255, 0.18);
    color: rgb(220, 245, 255);
    padding-left: 20px;
    text-shadow: 0 0 10px rgba(0, 220, 255, 0.6);
}

/* Mục đang được chọn */
.custom-dropdown-item--selected {
    color: rgb(0, 230, 255);
    border-left-width: 3px;
    border-left-color: rgb(0, 220, 255);
    padding-left: 11px;
    text-shadow: 0 0 8px rgba(0, 220, 255, 0.5);
}
.custom-dropdown-item--selected:hover {
    padding-left: 17px;
}


/* --- DROPDOWN OVERLAY MENU LIST (BẢNG XỔ XUỐNG) --- */

/* Lớp nền tối phủ toàn màn hình phía sau dropdown */
.unity-base-dropdown {
    background-color: transparent;
}

/* Khung chứa danh sách các lựa chọn */
.unity-base-dropdown__container-outer {
    background-color: rgba(2, 9, 16, 0.97);
    border-width: 1px;
    border-color: rgba(0, 190, 255, 0.7);
    border-radius: 4px;
    box-shadow: 0 0 20px rgba(0, 190, 255, 0.3);
    margin-top: 2px;
    overflow: hidden;
}

.unity-base-dropdown__container {
    background-color: rgba(2, 9, 16, 0.97);
    border-width: 1px;
    border-color: rgba(0, 190, 255, 0.7);
    border-radius: 4px;
    box-shadow: 0 0 20px rgba(0, 190, 255, 0.3);
    overflow: hidden;
}

/* ScrollView bên trong container */
.unity-base-dropdown__container .unity-scroll-view {
    background-color: transparent;
}
.unity-base-dropdown__container .unity-scroll-view__content-viewport {
    background-color: transparent;
}
.unity-base-dropdown__container .unity-scroll-view__content-container {
    background-color: transparent;
}

/* Thanh cuộn dọc bên trong dropdown */
.unity-base-dropdown__container .unity-scroller--vertical {
    width: 5px;
    background-color: rgba(0, 4, 8, 0.8);
}
.unity-base-dropdown__container .unity-base-slider__tracker {
    background-color: rgba(0, 4, 8, 0.95);
    border-width: 0;
}
.unity-base-dropdown__container .unity-base-slider__dragger {
    background-color: rgba(0, 190, 255, 0.5);
    border-radius: 3px;
    border-width: 0;
}
.unity-base-dropdown__container .unity-base-slider__dragger:hover {
    background-color: rgb(0, 190, 255);
}

/* Từng dòng mục chọn bên trong danh sách */
.unity-base-dropdown__item {
    padding: 10px 14px;
    background-color: transparent;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 190, 255, 0.08);
    transition: background-color 0.15s, padding-left 0.15s;
}
.unity-base-dropdown__item:last-child {
    border-bottom-width: 0;
}

/* Hover: nền cyan mờ + đẩy chữ sang phải */
.unity-base-dropdown__item:hover {
    background-color: rgba(0, 190, 255, 0.18);
    padding-left: 20px;
}

/* Mục đang được chọn (checked) */
.unity-base-dropdown__item.unity-base-dropdown__item--is-checked {
    background-color: rgba(0, 190, 255, 0.12);
    border-left-width: 3px;
    border-left-color: rgb(0, 220, 255);
}

/* Chữ hiển thị trong bảng xổ xuống */
.unity-base-dropdown__label {
    color: rgb(130, 205, 245);
    font-size: 14px;
    -unity-font-style: bold;
    background-color: transparent;
}

/* Hover label */
.unity-base-dropdown__item:hover .unity-base-dropdown__label {
    color: rgb(220, 245, 255);
    text-shadow: 0 0 10px rgba(0, 220, 255, 0.75);
}

/* Checked (mục đang chọn) label */
.unity-base-dropdown__item.unity-base-dropdown__item--is-checked .unity-base-dropdown__label {
    color: rgb(0, 230, 255);
    text-shadow: 0 0 8px rgba(0, 220, 255, 0.6);
}

/* Dấu tick / checkmark bên trái mục đang chọn */
.unity-base-dropdown__checkmark {
    width: 14px;
    height: 14px;
    -unity-text-align: middle-center;
    color: rgb(0, 220, 255);
    font-size: 12px;
    margin-right: 8px;
    background-color: transparent;
    border-width: 0;
    -unity-background-image-tint-color: rgb(0, 220, 255);
}

/* =========================================================================
   CONFIRMATION OVERLAY (XÁC NHẬN LƯU)
   ========================================================================= */
.confirm-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 5, 10, 0.85); /* Nền đen mờ bao phủ toàn màn hình */
    justify-content: center;
    align-items: center;
}

.confirm-dialog {
    background-image: url("project://database/Assets/PLuan/WaittingRoom/Textures/ui_frame_bg.jpg");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
    padding: 60px 50px 50px 50px;
    align-items: center;
    box-shadow: 0 0 40px rgba(0, 190, 255, 0.2);
    width: 440px;
}

.confirm-title {
    color: rgb(0, 230, 255);
    font-size: 24px;
    -unity-font-style: bold;
    margin-bottom: 15px;
    text-shadow: 0 0 10px rgba(0, 230, 255, 0.5);
    letter-spacing: 2px;
}

.confirm-subtitle {
    color: rgb(150, 200, 220);
    font-size: 14px;
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 30px;
}

.confirm-buttons {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    width: 100%;
    margin-top: 10px;
}

.confirm-btn {
    background-color: transparent !important;
    border-width: 0 !important;
    border-radius: 0 !important;
    font-size: 20px !important; /* Premium larger text size */
    -unity-font-style: bold;
    padding: 10px 20px !important;
    transition: all 0.25s ease-out;
    cursor: link;
    flex-shrink: 0 !important;
    flex-grow: 0 !important; /* Stop stretching */
    white-space: nowrap !important;
    -unity-text-align: middle-center !important;
}

.confirm-btn-yes {
    color: rgb(0, 230, 255) !important;
}
.confirm-btn-yes:hover {
    background-color: transparent !important;
    color: rgb(255, 255, 255) !important;
    scale: 1.08 1.08;
    text-shadow: 0 0 15px rgba(0, 255, 255, 0.85);
}

.confirm-btn-no {
    color: rgb(255, 120, 120) !important;
    margin-left: 60px !important; /* Premium gap spacing between the two centered buttons */
}
.confirm-btn-no:hover {
    background-color: transparent !important;
    color: rgb(255, 180, 180) !important;
    scale: 1.08 1.08;
    text-shadow: 0 0 15px rgba(255, 80, 80, 0.85);
}

/* =========================================================================
   AUTHENTICATION & USER PROFILE
   ========================================================================= */
.error-text {
    color: rgb(255, 80, 80);
    font-size: 13px;
    -unity-font-style: bold;
    margin-bottom: 15px;
    white-space: normal;
}
.info-text {
    color: rgb(120, 230, 255);
    font-size: 13px;
    margin-bottom: 15px;
    white-space: normal;
}
.otp-input .unity-base-text-field__input {
    letter-spacing: 12px;
    -unity-text-align: middle-center;
    font-size: 20px;
    -unity-font-style: bold;
}
.user-profile-box {
    position: absolute;
    top: 25px;
    right: 35px;
    background-image: url("project://database/Assets/PLuan/menuda.png?fileID=2800000&guid=b71e5fe46dbce4849b9385c26298aaa1&type=3#menuda");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: transparent !important;
    border-width: 0 !important;
    border-left-width: 0 !important;
    border-radius: 0 !important;
    padding: 22px 36px 18px 36px;
    align-items: center;
    box-shadow: none !important;
}
.user-profile-label {
    color: rgba(0, 230, 255, 0.5);
    font-size: 11px;
    letter-spacing: 3px;
    margin-bottom: 2px;
}
.user-profile-name {
    color: rgb(255, 255, 255);
    font-size: 22px;
    -unity-font-style: bold;
    text-shadow: 0 0 12px rgba(0, 230, 255, 0.8);
    letter-spacing: 1px;
}
.logout-btn {
    margin-top: 10px;
    padding: 6px 14px !important;
    font-size: 13px !important;
    background-color: transparent !important;
    border-width: 0 !important;
    color: rgb(255, 100, 100) !important;
    -unity-font-style: bold;
    transition: all 0.2s ease-out;
}
.logout-btn:hover {
    background-color: transparent !important;
    border-width: 0 !important;
    color: rgb(255, 180, 180) !important;
    scale: 1.08 1.08;
    text-shadow: 0 0 10px rgba(255, 50, 50, 0.95) !important;
}

.spam-note {
    color: rgba(0, 200, 255, 0.6);
    font-size: 11px;
    -unity-font-style: italic;
    margin-top: 4px;
    margin-bottom: 4px;
}

#register-panel {
    padding-bottom: 110px !important;
}

#register-panel .form-group {
    margin-bottom: 10px !important;
}

#verify-otp-panel {
    padding-bottom: 75px !important;
}

#login-panel .menu-btn,
#register-panel .menu-btn,
#verify-otp-panel .menu-btn,
#join-auth-panel .menu-btn {
    font-size: 20px !important;
    padding: 10px 16px !important;
    margin-bottom: 6px !important;
}

/* --- WAITING ROOM STYLES --- */
.waiting-info-box {
    margin-top: 15px;
    margin-bottom: 15px;
    padding: 15px;
    background-color: rgba(0, 190, 255, 0.05);
    border-width: 1px;
    border-color: rgba(0, 190, 255, 0.2);
    border-radius: 4px;
}

.waiting-info-text {
    color: rgb(160, 230, 255);
    font-size: 16px;
    margin-bottom: 8px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

#lbl-room-id-display {
    color: rgb(0, 255, 255);
    text-shadow: 0 0 8px rgba(0, 255, 255, 0.6);
}

/* --- OPTIONS SCROLL VIEW (PREMIUM OVERLAYS & SCROLLBARS) --- */
.options-content-scroll {
    flex-grow: 1;
    margin-bottom: 20px;
    padding-right: 18px; /* Safe space to prevent content overlap with scrollbar */
}

.options-content-scroll .unity-scroll-view__horizontal-scroller {
    display: none !important;
}

/* Vertical Scroller container - shifted inside viewport correctly */
.options-content-scroll .unity-scroll-view__vertical-scroller,
.options-content-scroll .unity-scroller {
    width: 6px !important;
    background-color: transparent !important;
    border-width: 0 !important;
    opacity: 0.85;
    position: absolute !important;
    right: 4px !important; /* Positioned inside viewport, safe from clipping */
    top: 0 !important;
    bottom: 0 !important;
}

/* Hide standard ugly arrow buttons */
.options-content-scroll .unity-scroller__low-button,
.options-content-scroll .unity-scroller__high-button,
.options-content-scroll #unity-low-button,
.options-content-scroll #unity-high-button {
    display: none !important;
    height: 0 !important;
    width: 0 !important;
}

/* Scroller Slider */
.options-content-scroll .unity-scroller .unity-slider {
    margin: 0 !important;
}

/* Track behind the scroll bar - SCOPED ONLY TO SCROLLER SLIDER */
.options-content-scroll .unity-scroller .unity-base-slider__tracker {
    background-color: rgba(0, 190, 255, 0.05) !important;
    border-width: 1px !important;
    border-color: rgba(0, 190, 255, 0.15) !important;
    width: 4px !important;
    align-self: center !important;
    border-radius: 2px !important;
}

/* Dragger slider thumb - SCOPED ONLY TO SCROLLER SLIDER */
.options-content-scroll .unity-scroller .unity-base-slider__dragger {
    background-color: rgba(0, 190, 255, 0.5) !important;
    border-width: 0 !important;
    border-radius: 3px !important;
    width: 6px !important;
    left: 0px !important;
    /* Smooth hover and active transitions */
    transition-property: background-color, scale;
    transition-duration: 0.25s, 0.15s;
    transition-timing-function: ease-out;
}

.options-content-scroll .unity-scroller .unity-base-slider__dragger:hover {
    background-color: rgb(0, 255, 255) !important;
    scale: 1.2 1; /* Slightly widen on hover for high-tech interaction feel */
}

/* --- TAB TRANSITION ANIMATIONS --- */
.tab-content {
    /* Highly compatible CSS transitions */
    transition-property: opacity, translate;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
    opacity: 1;
    translate: 0 0;
}

.tab-fade-out {
    opacity: 0 !important;
    translate: 0 15px !important;
}

/* --- OPTIONS BOTTOM BUTTONS (TRANSPARENT TEXT-ONLY GLOW) --- */
#btn-save-options {
    background-color: transparent !important;
    border-width: 0 !important;
    border-radius: 0 !important;
    font-size: 20px !important;
    letter-spacing: 3px;
    padding: 8px 16px !important;
    transition: all 0.25s ease-out;
    flex-shrink: 0 !important; /* Prevent button from compressing */
    -unity-text-align: middle-center !important; /* Perfect center alignment */
    white-space: nowrap !important; /* Stop text wrapping */
    color: rgb(120, 230, 255) !important; /* Base color for Apply */
    
    /* Using relative offset so it moves independently without affecting the Cancel button's position */
    position: relative;
    right: 50px; /* Adjust this value to shift the Apply button left (e.g. 20px, 30px, etc.) */
}

#btn-save-options:hover {
    background-color: transparent !important;
    color: rgb(255, 255, 255) !important;
    scale: 1.08 1.08;
    text-shadow: 0 0 15px rgba(0, 255, 255, 0.85);
}

#btn-cancel-options {
    background-color: transparent !important;
    border-width: 0 !important;
    border-radius: 0 !important;
    font-size: 20px !important;
    letter-spacing: 3px;
    padding: 8px 16px !important;
    transition: all 0.25s ease-out;
    flex-shrink: 0 !important; /* Prevent button from compressing */
    -unity-text-align: middle-center !important; /* Perfect center alignment */
    white-space: nowrap !important; /* Stop text wrapping */
    color: rgb(100, 150, 180) !important; /* Base color for Cancel */
    
    /* Lock the Cancel button in its original place */
    margin-left: 50px !important; 
}

#btn-cancel-options:hover {
    background-color: transparent !important;
    color: rgb(180, 230, 255) !important;
    scale: 1.08 1.08;
    text-shadow: 0 0 15px rgba(180, 230, 255, 0.7);
}
