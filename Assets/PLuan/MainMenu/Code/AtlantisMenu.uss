.root-screen {
    flex-grow: 1;
    justify-content: center;
    align-items: flex-start;
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-and-crop;
    background-color: rgb(0, 4, 8);
    -unity-font-definition: url("project://database/Assets/PLuan/MainMenu/Font/Cinzel-Vietnamese.ttf");
}

/* --- MENU & PANELS --- */
.menu-container {
    margin-left: 4%;
    width: 520px;
    max-width: 90%;
    height: 550px;
    max-height: 85%;
    padding: 135px 55px 45px 55px;
    justify-content: center;
    background-image: url("project://database/Assets/PLuan/WaittingRoom/Textures/ui_frame_bg.jpg");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
    text-shadow: 0 0 12px rgba(0, 0, 0, 0.8);
    flex-shrink: 1;

    /* Animation Transition */
    transition-property: opacity, scale;
    transition-duration: 0.4s;
    transition-timing-function: ease-out-back;
}

.large-panel {
    margin-left: 1.5%;
    width: 1060px;
    max-width: 92%;
    height: 680px;
    max-height: 86%;
    padding: 140px 110px 60px 110px;
    flex-shrink: 1;
}

#create-room-panel,
#login-panel,
#verify-otp-panel,
#join-auth-panel {
    align-self: center;
    margin-left: 0 !important;
    margin-right: 0 !important;
    width: 720px;
    height: 610px !important;
    max-width: 92%;
    max-height: 90% !important;
    padding: 145px 65px 35px 65px !important;
    background-image: url("project://database/Assets/PLuan/Synty_Popup_05_Exact.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 200;
    -unity-slice-right: 200;
    -unity-slice-top: 100;
    -unity-slice-bottom: 100;
    -unity-slice-scale: 0.38;
    background-color: transparent !important;
    border-radius: 0 !important;
    border-width: 0 !important;
    justify-content: flex-start;
    align-items: stretch;
    box-shadow: none !important;
}

#register-panel {
    align-self: center;
    margin-left: 0 !important;
    margin-right: 0 !important;
    width: 720px;
    height: 700px !important;
    max-width: 92%;
    max-height: 92% !important;
    padding: 135px 65px 30px 65px !important;
    background-image: url("project://database/Assets/PLuan/Synty_Popup_05_Exact.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 200;
    -unity-slice-right: 200;
    -unity-slice-top: 100;
    -unity-slice-bottom: 100;
    -unity-slice-scale: 0.38;
    background-color: transparent !important;
    border-radius: 0 !important;
    border-width: 0 !important;
    justify-content: flex-start;
    align-items: stretch;
    box-shadow: none !important;
}

#join-room-panel {
    align-self: center;
    margin-left: 0 !important;
    margin-right: 0 !important;
    width: 1080px;
    height: 700px !important;
    max-width: 94%;
    max-height: 92% !important;
    padding: 135px 70px 30px 70px !important;
    background-image: url("project://database/Assets/PLuan/Synty_Popup_05_Exact.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 200;
    -unity-slice-right: 200;
    -unity-slice-top: 100;
    -unity-slice-bottom: 100;
    -unity-slice-scale: 0.38;
    background-color: transparent !important;
    border-radius: 0 !important;
    border-width: 0 !important;
    justify-content: flex-start;
    align-items: stretch;
    box-shadow: none !important;
}

#main-menu-panel,
#network-menu-panel {
    position: absolute;
    bottom: 50px;
    left: 70;
    right: 0;
    width: 100%;
    height: auto;
    margin-left: 0;
    padding: 0 !important;
    background-image: none !important;
    background-color: transparent !important;
    border-width: 0 !important;
    align-items: center;
    justify-content: center;
    flex-direction: row;
}

#main-menu-panel .button-group,
#network-menu-panel .button-group {
    flex-direction: row;
    width: auto;
    align-items: center;
    justify-content: center;
    padding: 0;
    margin-left: 40px;
}

#main-menu-panel .menu-btn,
#network-menu-panel .menu-btn {
    width: 260px;
    height: 68px;
    margin: 0 14px;
    padding: 0 15px;
    font-size: 26px !important;
    -unity-font-style: bold;
    letter-spacing: 3.5px;
    color: rgb(235, 245, 255) !important;
    background-color: transparent !important;
    background-image: none !important;
    border-width: 0 !important;
    border-radius: 0 !important;
    text-shadow: 0 0 12px rgba(0, 180, 255, 0.7), 2px 2px 5px rgba(0, 0, 0, 0.95);
    -unity-text-align: middle-center;
    justify-content: center;
    align-items: center;
    transition: all 0.3s ease-out;
    cursor: link;
}

#main-menu-panel .menu-btn:hover,
#network-menu-panel .menu-btn:hover {
    scale: 1.06 1.06;
    letter-spacing: 5px;
    color: rgb(255, 255, 255) !important;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Menu_Button_06_Frame.png") !important;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 500;
    -unity-slice-right: 500;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 0.36;
    text-shadow: 0 0 22px rgba(0, 240, 255, 1), 0 0 8px rgba(255, 255, 255, 0.9), 2px 2px 4px rgba(0, 0, 0, 1);
}

#main-menu-panel .quit-btn,
#network-menu-panel .quit-btn {
    color: rgb(255, 160, 160) !important;
    text-shadow: 0 0 12px rgba(255, 60, 60, 0.7), 2px 2px 5px rgba(0, 0, 0, 0.95);
    margin-top: 0 !important;
}

#main-menu-panel .quit-btn:hover,
#network-menu-panel .quit-btn:hover {
    color: rgb(255, 255, 255) !important;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Menu_Button_06_Frame.png") !important;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 500;
    -unity-slice-right: 500;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 0.36;
    text-shadow: 0 0 22px rgba(255, 70, 70, 1), 0 0 8px rgba(255, 255, 255, 0.9), 2px 2px 4px rgba(0, 0, 0, 1);
}

#create-room-panel .panel-title,
#login-panel .panel-title,
#register-panel .panel-title,
#verify-otp-panel .panel-title,
#join-room-panel .panel-title,
#join-auth-panel .panel-title {
    display: flex !important;
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(240, 248, 255);
    letter-spacing: 5px;
    -unity-text-align: middle-center;
    text-shadow: 0 0 16px rgba(0, 200, 255, 0.75), 2px 2px 4px rgba(0, 0, 0, 0.95);
    margin-top: 0;
    margin-bottom: 6px;
    align-self: center;
}

.panel-divider {
    width: 70%;
    height: 8px;
    margin-bottom: 16px;
    align-self: center;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/General/SPR_FantasyMenus_Line_Horizontal_01.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(0, 210, 255, 0.75);
}

#create-room-panel .form-group,
#login-panel .form-group,
#register-panel .form-group,
#verify-otp-panel .form-group,
#join-auth-panel .form-group {
    width: 100%;
    margin-bottom: 10px;
    align-items: center;
}

#create-room-panel .form-label,
#login-panel .form-label,
#register-panel .form-label,
#verify-otp-panel .form-label,
#join-auth-panel .form-label {
    color: rgb(160, 220, 255);
    font-size: 13px;
    letter-spacing: 2px;
    margin-bottom: 6px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    align-self: center;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.9);
}

#create-room-panel .form-input,
#login-panel .form-input,
#register-panel .form-input,
#verify-otp-panel .form-input,
#join-auth-panel .form-input {
    background-image: url("project://database/Assets/PLuan/Synty_Input_01_Exact.png") !important;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 100;
    -unity-slice-right: 100;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 0.35;
    background-color: transparent !important;
    border-width: 0 !important;
    border-radius: 0 !important;
    width: 90%;
    height: 48px;
    padding: 0 32px;
    justify-content: center;
    align-self: center;
    transition: all 0.25s ease-out;
}

#create-room-panel .form-input .unity-base-text-field__input,
#create-room-panel .form-input .unity-text-field__input,
#login-panel .form-input .unity-base-text-field__input,
#login-panel .form-input .unity-text-field__input,
#register-panel .form-input .unity-base-text-field__input,
#register-panel .form-input .unity-text-field__input,
#verify-otp-panel .form-input .unity-base-text-field__input,
#verify-otp-panel .form-input .unity-text-field__input,
#join-auth-panel .form-input .unity-base-text-field__input,
#join-auth-panel .form-input .unity-text-field__input {
    background-color: transparent !important;
    border-width: 0 !important;
    color: rgb(240, 250, 255);
    --unity-cursor-color: rgb(255, 255, 255);
    -unity-cursor-color: rgb(255, 255, 255);
    caret-color: rgb(255, 255, 255);
    --unity-selection-color: rgba(0, 190, 255, 0.6);
    font-size: 15px;
    letter-spacing: 1.5px;
    padding: 0 !important;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.9);
}

#create-room-panel .form-input:focus-within,
#login-panel .form-input:focus-within,
#register-panel .form-input:focus-within,
#verify-otp-panel .form-input:focus-within,
#join-auth-panel .form-input:focus-within {
    text-shadow: 0 0 10px rgba(0, 235, 255, 0.8);
}

#create-room-panel .radio-group {
    flex-direction: row;
    margin-top: 8px;
    justify-content: center;
    align-items: center;
    align-self: center;
}

#create-room-panel .radio-group .unity-radio-button {
    margin: 0 24px;
    flex-direction: row;
    align-items: center;
    cursor: link;
}

#create-room-panel .radio-group .unity-radio-button__input {
    flex-direction: row;
    align-items: center;
    background-color: transparent !important;
    border-width: 0 !important;
}

#create-room-panel .radio-group .unity-radio-button__checkmark-background {
    width: 32px;
    height: 32px;
    min-width: 32px;
    min-height: 32px;
    background-image: url("project://database/Assets/PLuan/Synty_Radio_Unchecked.png");
    -unity-background-scale-mode: scale-to-fit;
    background-color: transparent !important;
    border-width: 0 !important;
    border-radius: 0 !important;
    justify-content: center;
    align-items: center;
}

#create-room-panel .radio-group .unity-radio-button:checked .unity-radio-button__checkmark-background {
    background-image: url("project://database/Assets/PLuan/Synty_Radio_Checked.png") !important;
}

#create-room-panel .radio-group .unity-radio-button__checkmark,
#create-room-panel .radio-group .unity-radio-button__indicator {
    display: none !important;
    opacity: 0 !important;
}

#create-room-panel .radio-group .unity-radio-button__label,
#create-room-panel .radio-group .unity-radio-button__text {
    color: rgb(170, 225, 255);
    font-size: 15px;
    -unity-font-style: bold;
    margin-left: 10px;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.95);
    transition: color 0.2s ease-out, text-shadow 0.2s ease-out;
}

#create-room-panel .radio-group .unity-radio-button:hover .unity-radio-button__label,
#create-room-panel .radio-group .unity-radio-button:hover .unity-radio-button__text {
    color: rgb(255, 255, 255);
    text-shadow: 0 0 10px rgba(0, 230, 255, 0.8), 1px 1px 3px rgba(0, 0, 0, 0.95);
}

#create-room-panel #password-group.hidden-element {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
}

.create-room-btn-group,
.auth-btn-group {
    flex-direction: row !important;
    justify-content: center !important;
    align-items: center !important;
    width: 100% !important;
    margin-top: auto;
    margin-bottom: 10px;
}

.confirm-action-btn,
.back-action-btn {
    width: 220px;
    height: 52px;
    margin: 0 10px;
    padding: 0 10px;
    font-size: 17px !important;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    white-space: nowrap !important;
    text-overflow: clip !important;
    -unity-text-align: middle-center;
    justify-content: center;
    align-items: center;
    transition: all 0.3s ease-out;
    cursor: link;
    background-color: transparent !important;
    border-width: 0 !important;
    border-radius: 0 !important;
}

.confirm-action-btn {
    color: rgb(225, 245, 255) !important;
    background-image: none !important;
    text-shadow: 0 0 12px rgba(0, 190, 255, 0.75), 2px 2px 4px rgba(0, 0, 0, 0.95);
}

.confirm-action-btn:hover {
    scale: 1.05 1.05;
    letter-spacing: 2.5px;
    color: rgb(255, 255, 255) !important;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Menu_Button_06_Frame.png") !important;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 500;
    -unity-slice-right: 500;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 0.34;
    text-shadow: 0 0 22px rgba(0, 240, 255, 1), 0 0 8px rgba(255, 255, 255, 0.9), 2px 2px 4px rgba(0, 0, 0, 1);
}

.back-action-btn {
    color: rgb(255, 160, 160) !important;
    background-image: none !important;
    text-shadow: 0 0 12px rgba(255, 60, 60, 0.75), 2px 2px 4px rgba(0, 0, 0, 0.95);
}

.back-action-btn:hover {
    scale: 1.05 1.05;
    letter-spacing: 2.5px;
    color: rgb(255, 255, 255) !important;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Menu_Button_06_Frame.png") !important;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 500;
    -unity-slice-right: 500;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 0.34;
    -unity-background-image-tint-color: rgba(255, 100, 100, 1);
    text-shadow: 0 0 22px rgba(255, 70, 70, 1), 0 0 8px rgba(255, 255, 255, 0.9), 2px 2px 4px rgba(0, 0, 0, 1);
}

#verify-otp-panel .auth-btn-group .confirm-action-btn,
#verify-otp-panel .auth-btn-group .back-action-btn {
    width: 170px;
    height: 48px;
    margin: 0 5px;
    font-size: 15px !important;
    letter-spacing: 1px;
}

.hidden-panel { 
    display: none;
    opacity: 0;
    scale: 0.9;
    pointer-events: none;
}

/* Lớp trung gian để xử lý animation trước khi display: none */
.panel-fade-out {
    opacity: 0;
    scale: 0.9;
    pointer-events: none;
}

.hidden-element { display: none; }

/* --- TIÊU ĐỀ PANELS --- */
.panel-title {
    display: none;
}
.button-group { width: 100%; flex-direction: column; }

/* --- MAIN BUTTONS --- */
.menu-btn {
    background-color: transparent;
    background-image: none;
    border-width: 0;
    color: rgb(140, 210, 245);
    padding: 16px 20px;
    font-size: 26px; /* Significantly larger text for premium look and readability */
    letter-spacing: 4px;
    -unity-text-align: middle-center;
    margin-bottom: 12px;
    
    /* Tăng thời gian transition để mượt mà hơn */
    transition: all 0.3s ease-in-out;
    
    white-space: nowrap;
    text-overflow: ellipsis;
    -unity-font-style: bold;
    border-radius: 0;
    text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.9);
}

/* Hover: Hiện khung Button_FantasyMenus_Basic_04 */
.menu-btn:hover {
    color: rgb(255, 255, 255);
    
    /* Hiệu ứng phóng lớn (Scale) */
    scale: 1.05 1.05;
    
    /* Giãn cách chữ tạo hiệu ứng "Scanning" */
    letter-spacing: 7px;
    
    background-color: transparent;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Menu_Button_06_Frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 500;
    -unity-slice-right: 500;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 0.36;
    
    /* Hào quang (Glow) cực mạnh */
    text-shadow: 0 0 25px rgba(0, 255, 255, 1), 0 0 10px rgba(255, 255, 255, 0.8);
}
.menu-btn:active {
    scale: 0.96 0.96;
    background-color: transparent;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Menu_Button_06_Frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 500;
    -unity-slice-right: 500;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 0.36;
    color: rgba(0, 255, 255, 0.8);
    transition: all 0.05s;
}

/* Nút Back - Đồng bộ sắc đỏ với nút Thoát */
.back-btn { 
    color: rgb(220, 120, 120); 
    background-color: transparent; 
    background-image: none;
    margin-top: 8px; 
}
.back-btn:hover { 
    color: rgb(255, 150, 150); 
    background-color: transparent; 
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Menu_Button_06_Frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 500;
    -unity-slice-right: 500;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 0.35;
    -unity-background-image-tint-color: rgba(255, 140, 140, 0.95);
    text-shadow: 0 0 15px rgba(255, 50, 50, 0.8); 
    scale: 1.05 1.05;
}

/* Nút Quit - Giữ sắc đỏ nhưng tinh chỉnh để hợp với nền tối */
.quit-btn { 
    color: rgb(220, 120, 120); 
    background-color: transparent; 
    background-image: none;
    margin-top: 25px; 
}
.quit-btn:hover { 
    color: rgb(255, 150, 150); 
    background-color: transparent; 
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Menu_Button_06_Frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 500;
    -unity-slice-right: 500;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 0.35;
    -unity-background-image-tint-color: rgba(255, 140, 140, 0.95);
    /* Đổ bóng đỏ rực */
    text-shadow: 0 0 15px rgba(255, 50, 50, 0.8);
    scale: 1.05 1.05;
}

.version-text {
    position: absolute;
    bottom: 25px;
    left: 35px;
    color: rgba(60, 130, 160, 0.85); /* Slightly brighter for readability but still ambient */
    font-size: 14px;
    letter-spacing: 2px;
    text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.85);
}

/* --- FORM INPUTS --- */
.form-group { width: 100%; margin-bottom: 16px; }
.form-label { color: rgb(100, 200, 240); font-size: 12px; letter-spacing: 2px; margin-bottom: 8px; -unity-font-style: bold; text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9); }

.form-input .unity-base-text-field__input {
    background-color: transparent !important;
    border-left-width: 0 !important;
    border-right-width: 0 !important;
    border-top-width: 0 !important;
    border-bottom-width: 2px !important;
    border-color: rgba(0, 190, 255, 0.35) !important;
    color: rgb(255, 255, 255);
    --unity-cursor-color: rgb(255, 255, 255);
    -unity-cursor-color: rgb(255, 255, 255);
    caret-color: rgb(255, 255, 255);
    --unity-selection-color: rgba(0, 190, 255, 0.6);
    font-size: 14px;
    padding: 8px 4px !important;
    border-radius: 0 !important;
    transition: border-color 0.25s ease-out, text-shadow 0.25s ease-out;
}
.form-input .unity-base-text-field__input:focus {
    border-color: rgb(60, 220, 255) !important;
    background-color: transparent !important;
    text-shadow: 0 0 8px rgba(60, 220, 255, 0.6);
}

/* --- RADIO BUTTONS --- */
.radio-group { flex-direction: row; margin-top: 4px; }
.radio-group .unity-radio-button { margin-right: 25px; align-items: center; }
.radio-group .unity-radio-button__label { color: rgb(140, 210, 245); font-size: 14px; -unity-font-style: bold; margin-left: 8px; text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9); }
.radio-group .unity-radio-button__checkmark-background { background-color: rgba(0, 6, 12, 0.8); border-color: rgba(0, 190, 255, 0.5); border-width: 1px; }
.radio-group .unity-radio-button__indicator { background-color: rgb(60, 220, 255); }
.radio-text-public, .radio-text-private { color: rgb(60, 220, 255); }

/* --- NÚT MINI & LOBBY ACTIONS (TEXT-ONLY GLOW) --- */
.join-mini-btn {
    background-color: transparent !important;
    border-width: 0 !important;
    color: rgb(0, 190, 255) !important;
    padding: 6px 16px !important;
    font-size: 13px !important;
    letter-spacing: 1px;
    -unity-font-style: bold;
    transition: all 0.2s ease-out;
    -unity-text-align: middle-center;
}

/* Light up button text slightly when row is hovered */
.room-item:hover .join-mini-btn {
    color: rgb(160, 230, 255) !important;
}

/* Glow text on direct button hover */
.join-mini-btn:hover {
    background-color: transparent !important;
    color: rgb(255, 255, 255) !important;
    scale: 1.08 1.08;
    text-shadow: 0 0 10px rgba(0, 255, 255, 0.95) !important;
}
.cancel-btn {
    background-color: transparent !important;
    border-width: 0 !important;
    color: rgb(220, 120, 120) !important;
    margin-left: 80px;
    transition: all 0.2s ease-out;
}
.cancel-btn:hover {
    background-color: transparent !important;
    border-width: 0 !important;
    color: rgb(255, 150, 150) !important;
    scale: 1.08 1.08;
    text-shadow: 0 0 15px rgba(255, 50, 50, 0.8) !important;
}

/* --- BROWSER TABLE & LIST --- */
.join-toolbar {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    width: 100%;
    margin-bottom: 12px;
}

.join-id-bar {
    flex-direction: row;
    align-items: center;
    height: 44px;
}

.join-id-bar .id-input {
    width: 200px;
    height: 44px;
    margin-right: 10px;
    background-image: url("project://database/Assets/PLuan/Synty_Input_01_Exact.png") !important;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 100;
    -unity-slice-right: 100;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 0.35;
    background-color: transparent !important;
    border-width: 0 !important;
    border-radius: 0 !important;
    padding: 0 20px;
    justify-content: center;
}

.join-id-bar .id-input .unity-base-text-field__input {
    color: rgb(240, 250, 255);
    --unity-cursor-color: rgb(255, 255, 255);
    -unity-cursor-color: rgb(255, 255, 255);
    caret-color: rgb(255, 255, 255);
    --unity-selection-color: rgba(0, 190, 255, 0.6);
    font-size: 15px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: transparent !important;
    border-width: 0 !important;
    padding: 0 !important;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.9);
}

.join-id-action-btn {
    height: 44px;
    padding: 0 20px;
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    color: rgb(225, 245, 255);
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
    cursor: link;
    transition: all 0.25s ease-out;
    text-shadow: 0 0 10px rgba(0, 190, 255, 0.7);
    justify-content: center;
    align-items: center;
}

.join-id-action-btn:hover {
    scale: 1.05 1.05;
    color: rgb(255, 255, 255);
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Menu_Button_06_Frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 500;
    -unity-slice-right: 500;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 0.3;
    text-shadow: 0 0 18px rgba(0, 240, 255, 1);
}

.table-header {
    flex-direction: row;
    width: 100%;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 200, 255, 0.3);
    padding-bottom: 8px;
    margin-bottom: 8px;
    padding-left: 16px;
    padding-right: 28px;
}

.table-header Label {
    color: rgb(130, 220, 255);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.9);
}

.room-list {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 220px;
    max-height: 330px;
    width: 100%;
    margin-bottom: 8px;
    padding-right: 0 !important;
}

.join-bottom-bar {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    width: 100%;
    margin-top: auto;
    margin-bottom: 5px;
}

.room-item {
    flex-direction: row;
    align-items: center;
    background-color: transparent !important; /* Completely transparent background when idle */
    border-width: 0 !important; /* No box borders/frames */
    padding: 10px 16px;
    margin-bottom: 4px; /* Clean spacing between rows */
    margin-right: 16px !important; /* Spacing for the scrollbar to sit outside on the right */
    border-radius: 6px !important;
    width: auto !important; /* Stretch to fill available width minus margin */
    transition: background-color 0.2s ease-out;
}
.room-item:hover {
    background-color: rgba(0, 190, 255, 0.08) !important; /* Soft ambient highlight on row hover */
}
.room-item Label {
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.9);
    font-size: 13px;
    transition: color 0.25s ease-out, text-shadow 0.25s ease-out;
}

/* Room table column sizes */
.col-id {
    width: 110px;
    flex-shrink: 0;
}
.col-name {
    flex-grow: 1;
}
.col-host {
    width: 140px;
    flex-shrink: 0;
}
.col-players {
    width: 80px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}
.col-action {
    width: 90px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

/* Room item details styling */
.room-item .col-id {
    justify-content: center;
    align-items: flex-start;
}
.room-item #lbl-room-id {
    background-color: transparent !important; /* No tag capsule background */
    border-width: 0 !important; /* No border outline */
    padding: 0;
    color: rgb(0, 210, 255) !important; /* Clean cyan text */
    -unity-font-style: bold;
    font-size: 13px;
}

.room-item .col-name {
    color: rgb(255, 255, 255) !important;
    -unity-font-style: bold;
    font-size: 14px;
    -unity-text-align: middle-left;
    padding-left: 10px;
}

.room-item .col-host {
    justify-content: center;
    align-items: flex-start;
}
.room-item #lbl-host-name {
    color: rgb(160, 210, 230) !important;
    font-size: 13px;
}

.room-item .col-players {
    color: rgb(120, 230, 255) !important;
    -unity-font-style: bold;
    font-size: 13px;
    background-color: transparent !important; /* No background capsule */
    padding: 0;
}

.room-item .col-action {
    justify-content: center;
    align-items: center;
}

/* Text glow transition on row hover */
.room-item:hover #lbl-room-id {
    color: rgb(255, 255, 255) !important;
    text-shadow: 0 0 8px rgba(0, 255, 255, 0.8);
}
.room-item:hover .col-name {
    color: rgb(255, 255, 255) !important;
    text-shadow: 0 0 10px rgba(255, 255, 255, 0.85);
}
.room-item:hover #lbl-host-name {
    color: rgb(200, 240, 255) !important;
    text-shadow: 0 0 6px rgba(180, 230, 255, 0.6);
}
.room-item:hover .col-players {
    color: rgb(255, 255, 255) !important;
    text-shadow: 0 0 8px rgba(0, 255, 255, 0.8);
}

/* Premium custom scrollbar for room list - floats outside the list cards correctly */
.room-list .unity-scroll-view__vertical-scroller,
.room-list .unity-scroller {
    width: 6px !important;
    background-color: transparent !important;
    border-width: 0 !important;
    position: absolute !important;
    right: 0px !important; /* Placed at the far right, outside the card margin */
    top: 0 !important;
    bottom: 0 !important;
    opacity: 0.85;
}

.room-list .unity-scroller__low-button,
.room-list .unity-scroller__high-button,
.room-list #unity-low-button,
.room-list #unity-high-button {
    display: none !important;
    height: 0 !important;
    width: 0 !important;
}

.room-list .unity-scroller .unity-base-slider__tracker {
    background-color: rgba(0, 190, 255, 0.05) !important;
    border-width: 1px !important;
    border-color: rgba(0, 190, 255, 0.15) !important;
    width: 4px !important;
    align-self: center !important;
    border-radius: 2px !important;
}

.room-list .unity-scroller .unity-base-slider__dragger {
    background-color: rgba(0, 190, 255, 0.5) !important;
    border-width: 0 !important;
    border-radius: 3px !important;
    width: 6px !important;
    left: 0px !important;
    transition-property: background-color, scale;
    transition-duration: 0.25s, 0.15s;
    transition-timing-function: ease-out;
}

.room-list .unity-scroller .unity-base-slider__dragger:hover {
    background-color: rgb(0, 255, 255) !important;
    scale: 1.2 1;
}

/* Custom JOIN text-only button with no background */
.join-mini-btn {
    background-color: transparent !important; /* No background */
    border-width: 0 !important; /* No borders */
    color: rgb(0, 190, 255) !important;
    padding: 5px 16px !important;
    font-size: 13px !important;
    -unity-font-style: bold;
    transition: all 0.2s ease-out;
}

/* Light up button slightly when row is hovered */
.room-item:hover .join-mini-btn {
    color: rgb(160, 230, 255) !important;
    background-color: transparent !important;
}

/* Glow text on direct hover */
.join-mini-btn:hover {
    background-color: transparent !important;
    color: rgb(255, 255, 255) !important;
    scale: 1.08 1.08;
    text-shadow: 0 0 10px rgba(0, 255, 255, 0.95) !important;
}

/* --- OPTIONS & CUSTOM SLIDERS --- */
.options-tabs { flex-direction: row; border-bottom-width: 1px; border-bottom-color: rgba(0, 190, 255, 0.3); margin-bottom: 30px; }
.tab-btn { background-color: transparent; border-width: 0; border-bottom-width: 2px; border-bottom-color: transparent; color: rgb(100, 150, 180); font-size: 14px; -unity-font-style: bold; padding: 10px 20px; border-radius: 0; }
.tab-btn:hover { color: rgb(140, 210, 245); }
.tab-btn.active { color: rgb(60, 220, 255); border-bottom-color: rgb(0, 190, 255); }

.slider-header { flex-direction: row; justify-content: space-between; width: 100%; }
.slider-val { color: rgb(60, 220, 255); -unity-font-style: bold; font-size: 13px; }
.options-actions {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    width: 100%;
    margin-top: 35px;
    flex-shrink: 0; /* Prevent action bar from shrinking */
}
.auth-room-label { color: rgb(60, 220, 255); font-size: 14px; -unity-font-style: bold; margin-bottom: 25px; }

.custom-select .unity-base-popup-field__text { color: rgb(60, 220, 255); -unity-font-style: bold; }
.custom-select .unity-base-popup-field__input { background-color: rgba(0, 6, 12, 0.8); border-color: rgba(0, 190, 255, 0.4); padding: 8px; border-radius: 4px; }

.checkbox-label .unity-toggle__label { color: rgb(140, 210, 245); margin-left: 10px; font-size: 13px; -unity-font-style: bold; }
.checkbox-label .unity-toggle__checkmark { background-color: rgba(0, 6, 12, 0.8); border-color: rgb(0, 190, 255); }

.custom-slider .unity-slider__tracker { background-color: rgba(0, 4, 8, 0.9); border-color: rgba(0, 190, 255, 0.3); border-width: 1px; height: 6px; border-radius: 3px; margin-top: -3px; }
.custom-slider .unity-slider__dragger { background-color: rgb(0, 190, 255); border-color: rgb(255, 255, 255); border-width: 1px; width: 16px; height: 16px; border-radius: 8px; margin-top: -8px; transition: scale 0.1s; }
.custom-slider .unity-slider__dragger:hover { background-color: rgb(120, 230, 255); scale: 1.25 1.25; }

/* --- HỆ THỐNG HẠT V3 --- */
.bubble-fx { position: absolute; border-radius: 50%; border-width: 1px; border-color: rgba(255, 255, 255, 0.35); background-color: transparent; picking-mode: ignore; transition: none; }
.bubble-core { position: absolute; border-radius: 50%; background-color: rgba(255, 255, 255, 0.7); picking-mode: ignore; transition: none; }
/* Đốm sáng trôi nổi được chuyển sang dải Cyan phát quang để hòa vào năng lượng của khu di tích */
.ambient-spot { position: absolute; border-radius: 50%; background-color: rgb(120, 230, 255); border-width: 2px; border-color: rgba(120, 230, 255, 0.25); picking-mode: ignore; transition: none; }
/* --- CUSTOM SLIDERS (HIGH-TECH STYLE) --- */
/* Đường ray thanh trượt (Tracker) */
.custom-slider .unity-base-slider__tracker {
    background-color: rgba(0, 4, 8, 0.95);
    border-color: rgba(0, 190, 255, 0.4);
    border-width: 1px;
    height: 6px;
    border-radius: 3px;
    margin-top: -3px; /* Căn giữa hoàn hảo */
    /* Tạo hiệu ứng dải sáng chạy ngầm bên dưới */
    box-shadow: 0 0 4px rgba(0, 190, 255, 0.2);
}

/* Nút kéo (Dragger) */
.custom-slider .unity-base-slider__dragger {
    background-color: rgb(0, 190, 255);
    border-color: rgb(255, 255, 255);
    border-width: 2px;
    width: 18px;
    height: 18px;
    border-radius: 9px; /* Bo tròn tuyệt đối */
    margin-top: -9px; /* Căn giữa tâm nút kéo với tracker */
    transition: scale 0.15s ease-out, background-color 0.15s;
}

/* Hiệu ứng khi di chuột hoặc kéo thanh trượt */
.custom-slider .unity-base-slider__dragger:hover,
.custom-slider .unity-base-slider__dragger:focus {
    background-color: rgb(120, 240, 255);
    border-color: rgb(255, 255, 255);
    scale: 1.3 1.3; /* Phóng to rực rỡ khi chạm vào */
}

/* --- CUSTOM DROPDOWN (HOÀN TOÀN TỰ XÂY) --- */

/* Hàng trigger hiển thị giá trị đang chọn */
.custom-dropdown {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgba(0, 6, 12, 0.9);
    border-width: 1px;
    border-color: rgba(0, 190, 255, 0.5);
    border-radius: 4px;
    padding: 10px 12px;
    transition: border-color 0.2s, background-color 0.2s;
    cursor: link;
}
.custom-dropdown:hover {
    border-color: rgb(0, 220, 255);
    background-color: rgba(0, 12, 22, 0.95);
}

/* Label hiển thị giá trị đang chọn */
.custom-dropdown-value {
    color: rgb(60, 220, 255);
    font-size: 14px;
    -unity-font-style: bold;
    flex-grow: 1;
    background-color: transparent;
}

/* Mũi tên ▼ */
.custom-dropdown-arrow {
    color: rgba(0, 190, 255, 0.7);
    font-size: 12px;
    margin-left: 10px;
    background-color: transparent;
    transition: color 0.2s;
}
.custom-dropdown:hover .custom-dropdown-arrow {
    color: rgb(0, 220, 255);
}

/* --- POPUP DANH SÁCH XỔ XUỐNG --- */
.custom-dropdown-popup {
    position: absolute;
    background-color: rgba(2, 9, 16, 0.97);
    border-width: 1px;
    border-color: rgba(0, 190, 255, 0.7);
    border-radius: 4px;
    min-width: 200px;
    /* Hiệu ứng glow xanh bao quanh */
    /* box-shadow: 0 0 15px rgba(0, 190, 255, 0.3); */
}

/* Từng item trong popup */
.custom-dropdown-item {
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 190, 255, 0.08);
    color: rgb(130, 205, 245);
    font-size: 14px;
    -unity-font-style: bold;
    padding: 10px 14px;
    -unity-text-align: middle-left;
    transition: background-color 0.12s, padding-left 0.12s;
}
.custom-dropdown-item:last-child {
    border-bottom-width: 0;
}
.custom-dropdown-item:hover {
    background-color: rgba(0, 190, 255, 0.18);
    color: rgb(220, 245, 255);
    padding-left: 20px;
    text-shadow: 0 0 10px rgba(0, 220, 255, 0.6);
}

/* Mục đang được chọn */
.custom-dropdown-item--selected {
    color: rgb(0, 230, 255);
    border-left-width: 3px;
    border-left-color: rgb(0, 220, 255);
    padding-left: 11px;
    text-shadow: 0 0 8px rgba(0, 220, 255, 0.5);
}
.custom-dropdown-item--selected:hover {
    padding-left: 17px;
}


/* --- DROPDOWN OVERLAY MENU LIST (BẢNG XỔ XUỐNG) --- */

/* Lớp nền tối phủ toàn màn hình phía sau dropdown */
.unity-base-dropdown {
    background-color: transparent;
}

/* Khung chứa danh sách các lựa chọn */
.unity-base-dropdown__container-outer {
    background-color: rgba(2, 9, 16, 0.97);
    border-width: 1px;
    border-color: rgba(0, 190, 255, 0.7);
    border-radius: 4px;
    box-shadow: 0 0 20px rgba(0, 190, 255, 0.3);
    margin-top: 2px;
    overflow: hidden;
}

.unity-base-dropdown__container {
    background-color: rgba(2, 9, 16, 0.97);
    border-width: 1px;
    border-color: rgba(0, 190, 255, 0.7);
    border-radius: 4px;
    box-shadow: 0 0 20px rgba(0, 190, 255, 0.3);
    overflow: hidden;
}

/* ScrollView bên trong container */
.unity-base-dropdown__container .unity-scroll-view {
    background-color: transparent;
}
.unity-base-dropdown__container .unity-scroll-view__content-viewport {
    background-color: transparent;
}
.unity-base-dropdown__container .unity-scroll-view__content-container {
    background-color: transparent;
}

/* Thanh cuộn dọc bên trong dropdown */
.unity-base-dropdown__container .unity-scroller--vertical {
    width: 5px;
    background-color: rgba(0, 4, 8, 0.8);
}
.unity-base-dropdown__container .unity-base-slider__tracker {
    background-color: rgba(0, 4, 8, 0.95);
    border-width: 0;
}
.unity-base-dropdown__container .unity-base-slider__dragger {
    background-color: rgba(0, 190, 255, 0.5);
    border-radius: 3px;
    border-width: 0;
}
.unity-base-dropdown__container .unity-base-slider__dragger:hover {
    background-color: rgb(0, 190, 255);
}

/* Từng dòng mục chọn bên trong danh sách */
.unity-base-dropdown__item {
    padding: 10px 14px;
    background-color: transparent;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 190, 255, 0.08);
    transition: background-color 0.15s, padding-left 0.15s;
}
.unity-base-dropdown__item:last-child {
    border-bottom-width: 0;
}

/* Hover: nền cyan mờ + đẩy chữ sang phải */
.unity-base-dropdown__item:hover {
    background-color: rgba(0, 190, 255, 0.18);
    padding-left: 20px;
}

/* Mục đang được chọn (checked) */
.unity-base-dropdown__item.unity-base-dropdown__item--is-checked {
    background-color: rgba(0, 190, 255, 0.12);
    border-left-width: 3px;
    border-left-color: rgb(0, 220, 255);
}

/* Chữ hiển thị trong bảng xổ xuống */
.unity-base-dropdown__label {
    color: rgb(130, 205, 245);
    font-size: 14px;
    -unity-font-style: bold;
    background-color: transparent;
}

/* Hover label */
.unity-base-dropdown__item:hover .unity-base-dropdown__label {
    color: rgb(220, 245, 255);
    text-shadow: 0 0 10px rgba(0, 220, 255, 0.75);
}

/* Checked (mục đang chọn) label */
.unity-base-dropdown__item.unity-base-dropdown__item--is-checked .unity-base-dropdown__label {
    color: rgb(0, 230, 255);
    text-shadow: 0 0 8px rgba(0, 220, 255, 0.6);
}

/* Dấu tick / checkmark bên trái mục đang chọn */
.unity-base-dropdown__checkmark {
    width: 14px;
    height: 14px;
    -unity-text-align: middle-center;
    color: rgb(0, 220, 255);
    font-size: 12px;
    margin-right: 8px;
    background-color: transparent;
    border-width: 0;
    -unity-background-image-tint-color: rgb(0, 220, 255);
}

/* =========================================================================
   CONFIRMATION OVERLAY (XÁC NHẬN LƯU) - SYNTY POPUP 02 EXACT
   ========================================================================= */
.confirm-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 5, 10, 0.85); /* Nền đen mờ bao phủ toàn màn hình */
    justify-content: center;
    align-items: center;
}

.confirm-dialog {
    background-image: url("project://database/Assets/PLuan/Synty_Popup_02_Exact.png");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: transparent !important;
    border-width: 0 !important;
    border-radius: 0 !important;
    padding: 175px 60px 0 60px;
    align-items: center;
    justify-content: space-between;
    box-shadow: none;
    width: 780px;
    height: 330px;
}

.confirm-content {
    align-items: center;
    justify-content: center;
    width: 100%;
    margin-top: 0;
}

.confirm-title {
    color: rgb(255, 255, 255); /* Pure crisp white font */
    font-size: 27px;
    -unity-font-style: bold;
    margin-bottom: 8px;
    text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.95), 0 0 15px rgba(0, 200, 255, 0.35);
    letter-spacing: 3px;
    -unity-text-align: middle-center;
}

.confirm-subtitle {
    color: rgb(225, 235, 245);
    font-size: 15px;
    white-space: normal;
    -unity-text-align: middle-center;
    padding: 0 40px;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.95);
    letter-spacing: 1px;
}

.confirm-buttons {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    width: 100%;
    margin-bottom: -48px;
}

.confirm-btn {
    background-color: transparent !important;
    border-width: 0 !important;
    border-radius: 0 !important;
    font-size: 15px !important;
    -unity-font-style: bold;
    width: 270px;
    height: 64px;
    padding: 2px 25px 0 110px !important;
    transition: all 0.2s ease-out;
    cursor: link;
    flex-shrink: 0 !important;
    flex-grow: 0 !important;
    white-space: nowrap !important;
    -unity-text-align: middle-center !important;
    justify-content: center;
    align-items: center;
    letter-spacing: 1.5px;
    margin: 0 35px;
    color: rgb(255, 255, 255) !important;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.95);
}

.confirm-btn-yes {
    background-image: url("project://database/Assets/PLuan/Synty_Btn_Confirm_09.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 150;
    -unity-slice-right: 100;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 0.40;
}
.confirm-btn-yes:hover {
    scale: 1.05 1.05;
    letter-spacing: 3px;
    text-shadow: 0 0 15px rgba(0, 255, 255, 1);
}

.confirm-btn-no {
    background-image: url("project://database/Assets/PLuan/Synty_Btn_Cancel_09.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 150;
    -unity-slice-right: 100;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 0.40;
}
.confirm-btn-no:hover {
    scale: 1.05 1.05;
    letter-spacing: 3px;
    text-shadow: 0 0 15px rgba(255, 100, 100, 1);
}

/* =========================================================================
   AUTHENTICATION & USER PROFILE
   ========================================================================= */
.error-text {
    color: rgb(255, 80, 80);
    font-size: 13px;
    -unity-font-style: bold;
    margin-bottom: 15px;
    white-space: normal;
}
.info-text {
    color: rgb(120, 230, 255);
    font-size: 13px;
    margin-bottom: 15px;
    white-space: normal;
}
.otp-input .unity-base-text-field__input {
    letter-spacing: 12px;
    -unity-text-align: middle-center;
    font-size: 20px;
    -unity-font-style: bold;
}
/* =========================================================================
   TOP-RIGHT PLAYER PROFILE (SYNTY SECTION BREAK 01 TOP & BOTTOM - VERTICAL)
   ========================================================================= */
.user-profile-box {
    position: absolute;
    top: 25px;
    right: 40px;
    width: 250px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: transparent !important;
    background-image: none !important;
    border-width: 0 !important;
    border-radius: 0 !important;
    padding: 0 !important;
    box-shadow: none !important;
    transition: all 0.3s ease-out;
}

.section-break-bar {
    width: 100%;
    height: 16px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.section-break-top {
    margin-bottom: 6px;
}

.section-break-bottom {
    margin-top: 4px;
}

.section-break-top-left {
    flex-grow: 1;
    height: 100%;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Bar_01_Top_Left.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.section-break-top-right {
    flex-grow: 1;
    height: 100%;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Bar_01_Top_Right.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.section-break-bottom-left {
    flex-grow: 1;
    height: 100%;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Bar_01_Bottom_Left.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.section-break-bottom-right {
    flex-grow: 1;
    height: 100%;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Bar_01_Bottom_Right.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.user-profile-label {
    color: rgb(160, 225, 255);
    font-size: 11px !important;
    letter-spacing: 2.5px;
    margin: 0 0 2px 0;
    padding: 0;
    -unity-font-style: bold;
    text-shadow: 0 0 8px rgba(0, 180, 255, 0.7), 2px 2px 4px rgba(0, 0, 0, 1);
    -unity-text-align: middle-center;
}

.user-profile-name {
    color: rgb(255, 225, 120); /* Luminous Imperial Gold */
    font-size: 26px !important;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin: 0 0 6px 0;
    padding: 0;
    text-shadow: 0 0 16px rgba(255, 200, 50, 0.85), 2px 2px 4px rgba(0, 0, 0, 1);
    -unity-text-align: middle-center;
}

.logout-btn {
    width: 140px;
    height: 36px;
    margin: 0;
    padding: 0 5px !important;
    font-size: 13px !important;
    letter-spacing: 2px;
    color: rgb(255, 160, 160) !important;
    background-color: transparent !important;
    background-image: none !important;
    border-width: 0 !important;
    border-radius: 0 !important;
    -unity-font-style: bold;
    text-shadow: 0 0 8px rgba(255, 60, 60, 0.7), 2px 2px 4px rgba(0, 0, 0, 1);
    transition: all 0.25s ease-out;
    cursor: link;
    -unity-text-align: middle-center;
    justify-content: center;
    align-items: center;
}

.logout-btn:hover {
    color: rgb(255, 255, 255) !important;
    scale: 1.08 1.08;
    letter-spacing: 3px;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Menu_Button_06_Frame.png") !important;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 500;
    -unity-slice-right: 500;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 0.24;
    text-shadow: 0 0 14px rgba(255, 80, 80, 1), 2px 2px 4px rgba(0, 0, 0, 1) !important;
}

.version-text {
    position: absolute;
    bottom: 16px;
    left: 25px;
    color: rgba(140, 200, 240, 0.45);
    font-size: 11px;
    letter-spacing: 1.5px;
    -unity-font-style: bold;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.95);
    margin: 0;
    padding: 0;
}

.spam-note {
    color: rgba(0, 200, 255, 0.6);
    font-size: 11px;
    -unity-font-style: italic;
    margin-top: 4px;
    margin-bottom: 4px;
}

#join-auth-panel .menu-btn {
    font-size: 20px !important;
    padding: 10px 16px !important;
    margin-bottom: 6px !important;
}

/* --- WAITING ROOM STYLES --- */
.waiting-info-box {
    margin-top: 15px;
    margin-bottom: 15px;
    padding: 15px;
    background-color: rgba(0, 190, 255, 0.05);
    border-width: 1px;
    border-color: rgba(0, 190, 255, 0.2);
    border-radius: 4px;
}

.waiting-info-text {
    color: rgb(160, 230, 255);
    font-size: 16px;
    margin-bottom: 8px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

#lbl-room-id-display {
    color: rgb(0, 255, 255);
    text-shadow: 0 0 8px rgba(0, 255, 255, 0.6);
}

/* --- OPTIONS SCROLL VIEW (PREMIUM OVERLAYS & SCROLLBARS) --- */
.options-content-scroll {
    flex-grow: 1;
    margin-bottom: 20px;
    padding-right: 18px; /* Safe space to prevent content overlap with scrollbar */
}

.options-content-scroll .unity-scroll-view__horizontal-scroller {
    display: none !important;
}

/* Vertical Scroller container - shifted inside viewport correctly */
.options-content-scroll .unity-scroll-view__vertical-scroller,
.options-content-scroll .unity-scroller {
    width: 6px !important;
    background-color: transparent !important;
    border-width: 0 !important;
    opacity: 0.85;
    position: absolute !important;
    right: 4px !important; /* Positioned inside viewport, safe from clipping */
    top: 0 !important;
    bottom: 0 !important;
}

/* Hide standard ugly arrow buttons */
.options-content-scroll .unity-scroller__low-button,
.options-content-scroll .unity-scroller__high-button,
.options-content-scroll #unity-low-button,
.options-content-scroll #unity-high-button {
    display: none !important;
    height: 0 !important;
    width: 0 !important;
}

/* Scroller Slider */
.options-content-scroll .unity-scroller .unity-slider {
    margin: 0 !important;
}

/* Track behind the scroll bar - SCOPED ONLY TO SCROLLER SLIDER */
.options-content-scroll .unity-scroller .unity-base-slider__tracker {
    background-color: rgba(0, 190, 255, 0.05) !important;
    border-width: 1px !important;
    border-color: rgba(0, 190, 255, 0.15) !important;
    width: 4px !important;
    align-self: center !important;
    border-radius: 2px !important;
}

/* Dragger slider thumb - SCOPED ONLY TO SCROLLER SLIDER */
.options-content-scroll .unity-scroller .unity-base-slider__dragger {
    background-color: rgba(0, 190, 255, 0.5) !important;
    border-width: 0 !important;
    border-radius: 3px !important;
    width: 6px !important;
    left: 0px !important;
    /* Smooth hover and active transitions */
    transition-property: background-color, scale;
    transition-duration: 0.25s, 0.15s;
    transition-timing-function: ease-out;
}

.options-content-scroll .unity-scroller .unity-base-slider__dragger:hover {
    background-color: rgb(0, 255, 255) !important;
    scale: 1.2 1; /* Slightly widen on hover for high-tech interaction feel */
}

/* --- TAB TRANSITION ANIMATIONS --- */
.tab-content {
    /* Highly compatible CSS transitions */
    transition-property: opacity, translate;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
    opacity: 1;
    translate: 0 0;
}

.tab-fade-out {
    opacity: 0 !important;
    translate: 0 15px !important;
}

/* --- OPTIONS BOTTOM BUTTONS (TRANSPARENT TEXT-ONLY GLOW) --- */
#btn-save-options {
    background-color: transparent !important;
    border-width: 0 !important;
    border-radius: 0 !important;
    font-size: 20px !important;
    letter-spacing: 3px;
    padding: 8px 16px !important;
    transition: all 0.25s ease-out;
    flex-shrink: 0 !important; /* Prevent button from compressing */
    -unity-text-align: middle-center !important; /* Perfect center alignment */
    white-space: nowrap !important; /* Stop text wrapping */
    color: rgb(120, 230, 255) !important; /* Base color for Apply */
    
    /* Using relative offset so it moves independently without affecting the Cancel button's position */
    position: relative;
    right: 50px; /* Adjust this value to shift the Apply button left (e.g. 20px, 30px, etc.) */
}

#btn-save-options:hover {
    background-color: transparent !important;
    color: rgb(255, 255, 255) !important;
    scale: 1.08 1.08;
    text-shadow: 0 0 15px rgba(0, 255, 255, 0.85);
}

#btn-cancel-options {
    background-color: transparent !important;
    border-width: 0 !important;
    border-radius: 0 !important;
    font-size: 20px !important;
    letter-spacing: 3px;
    padding: 8px 16px !important;
    transition: all 0.25s ease-out;
    flex-shrink: 0 !important;
    -unity-text-align: middle-center !important;
    white-space: nowrap !important;
    color: rgb(220, 120, 120) !important; /* Đỏ như chữ Thoát */
    margin-left: 50px !important;
}

#btn-cancel-options:hover {
    background-color: transparent !important;
    color: rgb(255, 150, 150) !important;
    scale: 1.08 1.08;
    text-shadow: 0 0 15px rgba(255, 50, 50, 0.8);
}
