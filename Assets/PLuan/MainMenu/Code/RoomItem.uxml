<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="./RoomItem.uss" />
    <ui:VisualElement class="room-item">
        <ui:VisualElement class="room-col col-id">
            <ui:VisualElement name="icon-lock" class="lock-icon" style="display: none;" />
            <ui:Label name="lbl-room-id" text="#XXXXXX" />
        </ui:VisualElement>
        
        <ui:Label name="lbl-room-name" text="ATLANTIS EXPLORER" class="room-col col-name" />
        <ui:Label name="lbl-host-name" text="HOANG" class="room-col col-host" />
        <ui:Label name="lbl-players" text="1/4" class="room-col col-players" />
        
        <ui:VisualElement class="room-col col-action">
            <ui:Label text="JOIN" class="join-mini-btn" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
