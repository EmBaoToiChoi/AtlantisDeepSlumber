<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/PLuan/MainMenu/Code/AtlantisMenu.uss?fileID=7433441132597879392&amp;guid=8fa4b76500634d046bac501785335e61&amp;type=3#AtlantisMenu" />
    <ui:VisualElement class="root-screen" style="-unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Examples%20&amp;%20Extras/Fonts/Electronic%20Highway%20Sign.TTF?fileID=12800000&amp;guid=8a2b9e2a607dd2143b58c44bc32410b4&amp;type=3#Electronic Highway Sign&quot;);">
        
        <!-- USER PROFILE (TOP RIGHT) -->
        <ui:VisualElement name="user-profile-container" class="user-profile-box hidden-element">
            <ui:Label name="lbl-profile-hint" text="LOGGED IN AS:" class="user-profile-label" />
            <ui:Label name="lbl-display-name" text="PLAYER_NAME" class="user-profile-name" />
            <ui:Button name="btn-logout" text="LOGOUT" class="join-mini-btn logout-btn" />
        </ui:VisualElement>

        <!-- 1. LOGIN PANEL -->
        <ui:VisualElement name="login-panel" class="menu-container hidden-panel">
            <ui:Label name="lbl-login-title" text="USER LOGIN" class="panel-title" />
            <ui:Label name="lbl-login-error" text="" class="error-text hidden-element" />
            <ui:VisualElement class="form-group">
                <ui:Label name="lbl-login-email" text="EMAIL" class="form-label" />
                <ui:TextField name="input-login-email" class="form-input" />
            </ui:VisualElement>
            <ui:VisualElement class="form-group">
                <ui:Label name="lbl-login-password" text="PASSWORD" class="form-label" />
                <ui:TextField name="input-login-password" password="true" class="form-input" />
            </ui:VisualElement>
            <ui:VisualElement class="button-group" style="margin-top: 15px;">
                <ui:Button name="btn-login" text="LOGIN" class="menu-btn" />
                <ui:Button name="btn-goto-register" text="CREATE ACCOUNT" class="menu-btn back-btn" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 2. REGISTER PANEL -->
        <ui:VisualElement name="register-panel" class="menu-container large-panel hidden-panel">
            <ui:Label name="lbl-reg-title" text="NEW ACCOUNT" class="panel-title" />
            <ui:Label name="lbl-reg-error" text="" class="error-text hidden-element" />
            <ui:VisualElement class="form-group">
                <ui:Label name="lbl-reg-name" text="DISPLAY NAME" class="form-label" />
                <ui:TextField name="input-reg-name" class="form-input" />
            </ui:VisualElement>
            <ui:VisualElement class="form-group">
                <ui:Label name="lbl-reg-email" text="EMAIL" class="form-label" />
                <ui:TextField name="input-reg-email" class="form-input" />
            </ui:VisualElement>
            <ui:VisualElement class="form-group">
                <ui:Label name="lbl-reg-password" text="PASSWORD" class="form-label" />
                <ui:TextField name="input-reg-password" password="true" class="form-input" />
            </ui:VisualElement>
            <ui:VisualElement class="form-group">
                <ui:Label name="lbl-reg-confirm" text="CONFIRM PASSWORD" class="form-label" />
                <ui:TextField name="input-reg-confirm" password="true" class="form-input" />
            </ui:VisualElement>
            <ui:VisualElement class="button-group" style="margin-top: 15px;">
                <ui:Button name="btn-register" text="CREATE ACCOUNT" class="menu-btn" />
                <ui:Button name="btn-goto-login" text="&lt; BACK TO LOGIN" class="menu-btn back-btn" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 3. VERIFY OTP PANEL -->
        <ui:VisualElement name="verify-otp-panel" class="menu-container hidden-panel">
            <ui:Label name="lbl-otp-title" text="VERIFY EMAIL" class="panel-title" />
            <ui:Label name="lbl-otp-msg" text="We've sent a code to your email." class="info-text" />
            <ui:Label name="lbl-otp-spam-note" text="* Don't see it? Check your Spam/Junk folder." class="spam-note" />
            <ui:Label name="lbl-otp-error" text="" class="error-text hidden-element" />
            <ui:VisualElement class="form-group" style="margin-top: 10px;">
                <ui:Label name="lbl-otp-code" text="OTP CODE" class="form-label" />
                <ui:TextField name="input-otp" class="form-input otp-input" max-length="6" />
            </ui:VisualElement>
            <ui:VisualElement class="button-group" style="margin-top: 15px;">
                <ui:Button name="btn-verify-otp" text="VERIFY" class="menu-btn" />
                <ui:Button name="btn-resend-otp" text="RESEND CODE" class="menu-btn back-btn" />
                <ui:Button name="btn-cancel-otp" text="&lt; CANCEL" class="menu-btn cancel-btn" style="margin-left: 0; margin-top: 10px; border-left-width: 2px;" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 4. MAIN MENU PANEL -->
        <ui:VisualElement name="main-menu-panel" class="menu-container hidden-panel">
            <ui:VisualElement class="button-group">
                <ui:Button name="btn-play" text="PLAY" class="menu-btn" />
                <ui:Button name="btn-options" text="OPTIONS" class="menu-btn" />
                <ui:Button name="btn-quit" text="QUIT" class="menu-btn quit-btn" />
            </ui:VisualElement>
            <ui:Label text="Atlantis: Deep Slumber // Pre-Alpha 0.2" class="version-text" />
        </ui:VisualElement>

        <!-- 5. NETWORK MENU PANEL -->
        <ui:VisualElement name="network-menu-panel" class="menu-container hidden-panel">
            <ui:Label name="lbl-lobby-title" text="SESSION LOBBY" class="panel-title" />
            <ui:VisualElement class="button-group">
                <ui:Button name="btn-create-host" text="CREATE (HOST)" class="menu-btn" />
                <ui:Button name="btn-join-client" text="JOIN (CLIENT)" class="menu-btn" />
                <ui:Button name="btn-lobby-back" text="&lt; BACK" class="menu-btn back-btn" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 6. CREATE ROOM PANEL -->
        <ui:VisualElement name="create-room-panel" class="menu-container hidden-panel">
            <ui:Label name="lbl-host-title" text="HOST SESSION" class="panel-title" />
            <ui:VisualElement class="form-group">
                <ui:Label name="lbl-room-name" text="HOST / ROOM NAME" class="form-label" />
                <ui:TextField name="input-room-name" value="Atlantis Explorer" class="form-input" />
            </ui:VisualElement>
            <ui:VisualElement class="form-group">
                <ui:Label name="lbl-privacy" text="PRIVACY" class="form-label" />
                <ui:RadioButtonGroup name="radio-privacy" value="0" class="radio-group">
                    <ui:RadioButton name="radio-public" text="Public" class="radio-text-public" />
                    <ui:RadioButton name="radio-private" text="Private" class="radio-text-private" />
                </ui:RadioButtonGroup>
            </ui:VisualElement>
            <ui:VisualElement name="password-group" class="form-group hidden-element">
                <ui:Label name="lbl-room-password" text="PASSWORD" class="form-label" />
                <ui:TextField name="input-room-password" password="true" is-delayed="true" class="form-input" />
            </ui:VisualElement>
            <ui:VisualElement class="button-group" style="margin-top: 20px;">
                <ui:Button name="btn-confirm-create" text="START HOSTING" class="menu-btn" />
                <ui:Button name="btn-create-back" text="&lt; BACK" class="menu-btn back-btn" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 7. JOIN ROOM PANEL -->
        <ui:VisualElement name="join-room-panel" class="menu-container large-panel hidden-panel">
            <ui:Label name="lbl-browser-title" text="SESSION BROWSER" class="panel-title" />
            <ui:VisualElement class="join-id-bar">
                <ui:TextField name="input-room-id" max-length="6" class="form-input id-input" />
                <ui:Button name="btn-join-by-id" text="JOIN BY ID" class="join-mini-btn id-btn" />
            </ui:VisualElement>
            <ui:VisualElement class="table-header">
                <ui:Label name="lbl-col-id" text="ROOM ID" class="col-id" />
                <ui:Label name="lbl-col-name" text="ROOM NAME" class="col-name" />
                <ui:Label name="lbl-col-host" text="HOST" class="col-host" />
                <ui:Label name="lbl-col-players" text="PLAYERS" class="col-players" />
                <ui:Label name="lbl-col-action" text="ACTION" class="col-action" />
            </ui:VisualElement>
            <ui:ScrollView mode="Vertical" class="room-list">
                <ui:VisualElement class="room-item">
                    <ui:Label text="[P] #849201" class="room-col col-id" />
                    <ui:Label text="Abyss Crawlers" class="room-col col-name" />
                    <ui:Label text="CaptainNemo" class="room-col col-host" />
                    <ui:Label text="3/4" class="room-col col-players" />
                    <ui:Button name="btn-join-item-1" text="JOIN" class="join-mini-btn room-col col-action" />
                </ui:VisualElement>
                <ui:VisualElement class="room-item">
                    <ui:Label text="[O] #310294" class="room-col col-id" />
                    <ui:Label text="Deep Slumber #1" class="room-col col-name" />
                    <ui:Label text="BaoDev" class="room-col col-host" />
                    <ui:Label text="2/4" class="room-col col-players" />
                    <ui:Button name="btn-join-item-2" text="JOIN" class="join-mini-btn room-col col-action" />
                </ui:VisualElement>
            </ui:ScrollView>
            <ui:VisualElement class="button-group" style="margin-top: 25px; width: 150px;">
                <ui:Button name="btn-join-back" text="&lt; BACK" class="menu-btn back-btn" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 8. JOIN AUTH PANEL -->
        <ui:VisualElement name="join-auth-panel" class="menu-container hidden-panel">
            <ui:Label name="lbl-auth-title" text="ENTER PASSWORD" class="panel-title" />
            <ui:Label name="auth-room-name" text="SESSION: ..." class="auth-room-label" />
            <ui:VisualElement class="form-group">
                <ui:Label name="lbl-auth-password" text="ROOM PASSWORD" class="form-label" />
                <ui:TextField name="input-join-password" password="true" class="form-input" />
            </ui:VisualElement>
            <ui:VisualElement class="button-group" style="margin-top: 20px;">
                <ui:Button name="btn-confirm-join-private" text="CONNECT" class="menu-btn" />
                <ui:Button name="btn-auth-cancel" text="&lt; CANCEL" class="menu-btn back-btn" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 9. OPTIONS MENU PANEL -->
        <ui:VisualElement name="options-menu-panel" class="menu-container large-panel hidden-panel">
            <ui:Label name="lbl-options-title" text="SYSTEM OPTIONS" class="panel-title" />
            <ui:VisualElement class="options-tabs">
                <ui:Button name="tab-general-btn" text="GENERAL" class="tab-btn active" />
                <ui:Button name="tab-audio-btn" text="AUDIO" class="tab-btn" />
                <ui:Button name="tab-graphics-btn" text="GRAPHICS" class="tab-btn" />
                <ui:Button name="tab-controls-btn" text="CONTROLS" class="tab-btn" />
            </ui:VisualElement>

            <!-- GENERAL TAB -->
            <ui:VisualElement name="tab-general" class="tab-content">
                <ui:VisualElement class="form-group">
                    <ui:Label name="lbl-opt-language" text="LANGUAGE" class="form-label" />
                    <ui:VisualElement name="opt-language" class="custom-dropdown">
                        <ui:Label name="opt-language-value" text="English" class="custom-dropdown-value" />
                        <ui:Label text="&#9660;" class="custom-dropdown-arrow" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- AUDIO TAB -->
            <ui:VisualElement name="tab-audio" class="tab-content hidden-element">
                <ui:VisualElement class="form-group">
                    <ui:VisualElement class="slider-header">
                        <ui:Label name="lbl-master-volume" text="MASTER VOLUME" class="form-label" />
                        <ui:Label name="val-master" text="100%" class="slider-val" />
                    </ui:VisualElement>
                    <ui:Slider name="slider-master" low-value="0" high-value="100" value="100" class="custom-slider" />
                </ui:VisualElement>
                <ui:VisualElement class="form-group">
                    <ui:VisualElement class="slider-header">
                        <ui:Label name="lbl-music-bgm" text="MUSIC (BGM)" class="form-label" />
                        <ui:Label name="val-music" text="80%" class="slider-val" />
                    </ui:VisualElement>
                    <ui:Slider name="slider-music" low-value="0" high-value="100" value="80" class="custom-slider" />
                </ui:VisualElement>
                <ui:VisualElement class="form-group">
                    <ui:VisualElement class="slider-header">
                        <ui:Label name="lbl-effects-sfx" text="EFFECTS (SFX)" class="form-label" />
                        <ui:Label name="val-sfx" text="90%" class="slider-val" />
                    </ui:VisualElement>
                    <ui:Slider name="slider-sfx" low-value="0" high-value="100" value="90" class="custom-slider" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- GRAPHICS TAB -->
            <ui:VisualElement name="tab-graphics" class="tab-content hidden-element">
                <ui:VisualElement class="form-group">
                    <ui:Label name="lbl-resolution" text="RESOLUTION" class="form-label" />
                    <ui:VisualElement name="opt-resolution" class="custom-dropdown">
                        <ui:Label name="opt-resolution-value" text="1920x1080 (FHD)" class="custom-dropdown-value" />
                        <ui:Label text="&#9660;" class="custom-dropdown-arrow" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="form-group">
                    <ui:Label name="lbl-graphics-quality" text="GRAPHICS QUALITY" class="form-label" />
                    <ui:VisualElement name="opt-quality" class="custom-dropdown">
                        <ui:Label name="opt-quality-value" text="High" class="custom-dropdown-value" />
                        <ui:Label text="&#9660;" class="custom-dropdown-arrow" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="checkbox-group-wrapper">
                    <ui:Toggle name="opt-fullscreen" label="FULLSCREEN MODE" value="true" class="checkbox-label" />
                    <ui:Toggle name="opt-vsync" label="ENABLE V-SYNC" value="true" class="checkbox-label" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- CONTROLS TAB -->
            <ui:VisualElement name="tab-controls" class="tab-content hidden-element">
                <ui:VisualElement class="form-group">
                    <ui:VisualElement class="slider-header">
                        <ui:Label name="lbl-mouse-sens" text="MOUSE SENSITIVITY" class="form-label" />
                        <ui:Label name="val-sens" text="50" class="slider-val" />
                    </ui:VisualElement>
                    <ui:Slider name="slider-sens" low-value="1" high-value="100" value="50" class="custom-slider" />
                </ui:VisualElement>
                <ui:VisualElement class="checkbox-group-wrapper" style="margin-top: 20px;">
                    <ui:Toggle name="opt-invert-y" label="INVERT Y-AXIS" value="false" class="checkbox-label" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="options-actions">
                <ui:Button name="btn-save-options" text="APPLY" class="join-mini-btn" style="padding: 10px 25px;" />
                <ui:Button name="btn-cancel-options" text="CANCEL" class="join-mini-btn cancel-btn" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- CONFIRMATION OVERLAY -->
    <ui:VisualElement name="confirm-overlay" class="confirm-overlay hidden-element">
        <ui:VisualElement class="confirm-dialog">
            <ui:Label name="lbl-confirm-title" text="APPLY SETTINGS?" class="confirm-title" />
            <ui:Label name="lbl-confirm-msg" text="Changes will be applied immediately." class="confirm-subtitle" />
            <ui:VisualElement class="confirm-buttons">
                <ui:Button name="btn-confirm-yes" text="CONFIRM" class="confirm-btn confirm-btn-yes" />
                <ui:Button name="btn-confirm-no" text="CANCEL" class="confirm-btn confirm-btn-no" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
