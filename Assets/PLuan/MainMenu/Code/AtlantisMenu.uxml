<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/PLuan/MainMenu/Code/AtlantisMenu.uss?fileID=7433441132597879392&amp;guid=8fa4b76500634d046bac501785335e61&amp;type=3#AtlantisMenu" />
    <ui:VisualElement class="root-screen" style="-unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Examples%20&amp;%20Extras/Fonts/Electronic%20Highway%20Sign.TTF?fileID=12800000&amp;guid=8a2b9e2a607dd2143b58c44bc32410b4&amp;type=3#Electronic Highway Sign&quot;);">
        <ui:VisualElement name="main-menu-panel" class="menu-container">
            <ui:VisualElement class="button-group">
                <ui:Button name="btn-play" text="PLAY" class="menu-btn" />
                <ui:Button name="btn-options" text="OPTIONS" class="menu-btn" />
                <ui:Button name="btn-quit" text="QUIT" class="menu-btn quit-btn" />
            </ui:VisualElement>
            <ui:Label text="Atlantis: Deep Slumber // Pre-Alpha 0.2" class="version-text" />
        </ui:VisualElement>
        <ui:VisualElement name="network-menu-panel" class="menu-container hidden-panel">
            <ui:Label text="SESSION LOBBY" class="panel-title" />
            <ui:VisualElement class="button-group">
                <ui:Button name="btn-create-host" text="CREATE (HOST)" class="menu-btn" />
                <ui:Button name="btn-join-client" text="JOIN (CLIENT)" class="menu-btn" />
                <ui:Button name="btn-lobby-back" text="&lt; BACK" class="menu-btn back-btn" />
            </ui:VisualElement>
            <ui:Label text="Network System // Ready" class="version-text" />
        </ui:VisualElement>
        <ui:VisualElement name="create-room-panel" class="menu-container hidden-panel">
            <ui:Label text="HOST SESSION" class="panel-title" />
            <ui:VisualElement class="form-group">
                <ui:Label text="HOST / ROOM NAME" class="form-label" />
                <ui:TextField name="input-room-name" value="Atlantis Explorer" class="form-input" />
            </ui:VisualElement>
            <ui:VisualElement class="form-group">
                <ui:Label text="PRIVACY" class="form-label" />
                <ui:RadioButtonGroup name="radio-privacy" value="0" class="radio-group">
                    <ui:RadioButton name="radio-public" text="Public" class="radio-text-public" />
                    <ui:RadioButton name="radio-private" text="Private" class="radio-text-private" />
                </ui:RadioButtonGroup>
            </ui:VisualElement>
            <ui:VisualElement name="password-group" class="form-group hidden-element">
                <ui:Label text="PASSWORD" class="form-label" />
                <ui:TextField name="input-room-password" password="true" is-delayed="true" class="form-input" />
            </ui:VisualElement>
            <ui:VisualElement class="button-group" style="margin-top: 20px;">
                <ui:Button name="btn-confirm-create" text="START HOSTING" class="menu-btn" />
                <ui:Button name="btn-create-back" text="&lt; BACK" class="menu-btn back-btn" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="join-room-panel" class="menu-container large-panel hidden-panel">
            <ui:Label text="SESSION BROWSER" class="panel-title" />
            <ui:VisualElement class="join-id-bar">
                <ui:TextField name="input-room-id" max-length="6" class="form-input id-input" />
                <ui:Button name="btn-join-by-id" text="JOIN BY ID" class="join-mini-btn id-btn" />
            </ui:VisualElement>
            <ui:VisualElement class="table-header">
                <ui:Label text="ROOM ID" class="col-id" />
                <ui:Label text="ROOM NAME" class="col-name" />
                <ui:Label text="HOST" class="col-host" />
                <ui:Label text="PLAYERS" class="col-players" />
                <ui:Label text="ACTION" class="col-action" />
            </ui:VisualElement>
            <ui:ScrollView mode="Vertical" class="room-list">
                <ui:VisualElement class="room-item">
                    <ui:Label text="[P] #849201" class="room-col col-id" />
                    <ui:Label text="🔒 Abyss Crawlers" class="room-col col-name" />
                    <ui:Label text="CaptainNemo" class="room-col col-host" />
                    <ui:Label text="4/5" class="room-col col-players" />
                    <ui:Button name="btn-join-item-1" text="JOIN" class="join-mini-btn room-col col-action" />
                </ui:VisualElement>
                <ui:VisualElement class="room-item">
                    <ui:Label text="    #310294" class="room-col col-id" />
                    <ui:Label text="Deep Slumber #1" class="room-col col-name" />
                    <ui:Label text="BaoDev" class="room-col col-host" />
                    <ui:Label text="2/5" class="room-col col-players" />
                    <ui:Button name="btn-join-item-2" text="JOIN" class="join-mini-btn room-col col-action" />
                </ui:VisualElement>
            </ui:ScrollView>
            <ui:VisualElement class="button-group" style="margin-top: 25px; width: 150px;">
                <ui:Button name="btn-join-back" text="&lt; BACK" class="menu-btn back-btn" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="join-auth-panel" class="menu-container hidden-panel">
            <ui:Label text="ENTER PASSWORD" class="panel-title" />
            <ui:Label name="auth-room-name" text="SESSION: ..." class="auth-room-label" />
            <ui:VisualElement class="form-group">
                <ui:Label text="ROOM PASSWORD" class="form-label" />
                <ui:TextField name="input-join-password" password="true" class="form-input" />
            </ui:VisualElement>
            <ui:VisualElement class="button-group" style="margin-top: 20px;">
                <ui:Button name="btn-confirm-join-private" text="CONNECT" class="menu-btn" />
                <ui:Button name="btn-auth-cancel" text="&lt; CANCEL" class="menu-btn back-btn" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="options-menu-panel" class="menu-container large-panel hidden-panel">
            <ui:Label text="SYSTEM OPTIONS" class="panel-title" />
            <ui:VisualElement class="options-tabs">
                <ui:Button name="tab-audio-btn" text="AUDIO" class="tab-btn active" />
                <ui:Button name="tab-graphics-btn" text="GRAPHICS" class="tab-btn" />
                <ui:Button name="tab-controls-btn" text="CONTROLS" class="tab-btn" />
            </ui:VisualElement>
            <ui:VisualElement name="tab-audio" class="tab-content">
                <ui:VisualElement class="form-group">
                    <ui:VisualElement class="slider-header">
                        <ui:Label text="MASTER VOLUME" class="form-label" />
                        <ui:Label name="val-master" text="100%" class="slider-val" />
                    </ui:VisualElement>
                    <ui:Slider name="slider-master" low-value="0" high-value="100" value="100" class="custom-slider" />
                </ui:VisualElement>
                <ui:VisualElement class="form-group">
                    <ui:VisualElement class="slider-header">
                        <ui:Label text="MUSIC (BGM)" class="form-label" />
                        <ui:Label name="val-music" text="80%" class="slider-val" />
                    </ui:VisualElement>
                    <ui:Slider name="slider-music" low-value="0" high-value="100" value="80" class="custom-slider" />
                </ui:VisualElement>
                <ui:VisualElement class="form-group">
                    <ui:VisualElement class="slider-header">
                        <ui:Label text="EFFECTS (SFX)" class="form-label" />
                        <ui:Label name="val-sfx" text="90%" class="slider-val" />
                    </ui:VisualElement>
                    <ui:Slider name="slider-sfx" low-value="0" high-value="100" value="90" class="custom-slider" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="tab-graphics" class="tab-content hidden-element">
                <ui:VisualElement class="form-group">
                    <ui:Label text="RESOLUTION" class="form-label" />
                    <ui:DropdownField name="opt-resolution" choices="3840x2160 (4K),2560x1440 (2K),1920x1080 (FHD),1280x720 (HD)" value="1920x1080 (FHD)" class="custom-select" />
                </ui:VisualElement>
                <ui:VisualElement class="form-group">
                    <ui:Label text="GRAPHICS QUALITY" class="form-label" />
                    <ui:DropdownField name="opt-quality" choices="Ultra (Cinematic),High,Medium,Low (Performance)" value="High" class="custom-select" />
                </ui:VisualElement>
                <ui:VisualElement class="checkbox-group-wrapper">
                    <ui:Toggle name="opt-fullscreen" label="FULLSCREEN MODE" value="true" class="checkbox-label" />
                    <ui:Toggle name="opt-vsync" label="ENABLE V-SYNC" value="true" class="checkbox-label" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="tab-controls" class="tab-content hidden-element">
                <ui:VisualElement class="form-group">
                    <ui:VisualElement class="slider-header">
                        <ui:Label text="MOUSE SENSITIVITY" class="form-label" />
                        <ui:Label name="val-sens" text="50" class="slider-val" />
                    </ui:VisualElement>
                    <ui:Slider name="slider-sens" low-value="1" high-value="100" value="50" class="custom-slider" />
                </ui:VisualElement>
                <ui:VisualElement class="checkbox-group-wrapper" style="margin-top: 20px;">
                    <ui:Toggle name="opt-invert-y" label="INVERT Y-AXIS" value="false" class="checkbox-label" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="options-actions">
                <ui:Button name="btn-save-options" text="APPLY CHANGES" class="join-mini-btn" style="padding: 10px 25px;" />
                <ui:Button name="btn-cancel-options" text="CANCEL" class="join-mini-btn cancel-btn" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
