/* Atlantis Deep Slumber - Lobby UI Stylesheet */

.waiting-room-overlay {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    padding: 24px 35px 20px 35px;
    background-color: transparent;
    justify-content: space-between;
    -unity-font-definition: url("project://database/Assets/PLuan/MainMenu/Font/Philosopher-Vietnamese.ttf?fileID=12800000&guid=8a2ed09dfc3a8024fa0bb345576c06bd&type=3#Philosopher-Vietnamese");
}

/* GLASSMORPHISM & SCI-FI CORE */
.glass-panel {
    background-color: rgba(2, 16, 32, 0.65);
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.35);
    border-radius: 8px;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.4);
}

.glow-border {
    border-color: rgba(0, 229, 255, 0.45);
}

/* TOP INFO COMBINED WIDGET (MAIN MENU USER PROFILE STYLE) */
.top-info-panel {
    width: 310px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: transparent !important;
    background-image: none !important;
    border-width: 0 !important;
    border-radius: 0 !important;
    padding: 0 !important;
    box-shadow: none !important;
    transition: all 0.3s ease-out;
}

.section-break-bar {
    width: 100%;
    height: 16px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.section-break-top {
    margin-bottom: 6px;
}

.section-break-bottom {
    margin-top: 4px;
}

.section-break-top-left {
    flex-grow: 1;
    height: 100%;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Bar_01_Top_Left.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.section-break-top-right {
    flex-grow: 1;
    height: 100%;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Bar_01_Top_Right.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.section-break-bottom-left {
    flex-grow: 1;
    height: 100%;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Bar_01_Bottom_Left.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.section-break-bottom-right {
    flex-grow: 1;
    height: 100%;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Bar_01_Bottom_Right.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.user-profile-label {
    color: rgb(160, 225, 255);
    font-size: 11px !important;
    letter-spacing: 2.5px;
    margin: 0 0 2px 0;
    padding: 0;
    -unity-font-style: bold;
    text-shadow: 0 0 8px rgba(0, 180, 255, 0.7), 2px 2px 4px rgba(0, 0, 0, 1);
    -unity-text-align: middle-center;
}

.user-profile-name {
    color: rgb(255, 225, 120); /* Luminous Imperial Gold */
    font-size: 22px !important;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin: 0 0 4px 0;
    padding: 0;
    text-shadow: 0 0 16px rgba(255, 200, 50, 0.85), 2px 2px 4px rgba(0, 0, 0, 1);
    -unity-text-align: middle-center;
}

.room-meta-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin: 0 0 4px 0;
    flex-wrap: nowrap;
}

.room-id-badge {
    background-color: transparent !important;
    border-width: 0 !important;
    color: rgb(0, 240, 255) !important;
    padding: 0 !important;
    font-size: 13px !important;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    text-shadow: 0 0 10px rgba(0, 230, 255, 0.8), 1px 1px 3px rgba(0, 0, 0, 1);
    -unity-text-align: middle-center;
}

.room-meta-separator {
    color: rgba(0, 229, 255, 0.6);
    font-size: 11px !important;
    margin: 0 8px;
    -unity-text-align: middle-center;
}

.player-count-badge {
    background-color: transparent !important;
    border-width: 0 !important;
    color: rgb(160, 255, 200) !important;
    padding: 0 !important;
    font-size: 13px !important;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    text-shadow: 0 0 10px rgba(46, 213, 115, 0.8), 1px 1px 3px rgba(0, 0, 0, 1);
    -unity-text-align: middle-center;
}

/* TOP BAR CONTAINER */
.waiting-top-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 12px 0;
    background-color: transparent;
    border-width: 0;
    box-shadow: none;
}

/* MIDDLE MAIN CONTAINER */
.waiting-middle-container {
    flex-direction: row;
    flex-grow: 1;
    align-items: center;
    margin-top: 10px;
    margin-bottom: 10px;
}

.waiting-viewport-spacer {
    flex-grow: 1;
}

/* CHARACTER SELECTION SIDEBAR */
.char-select-panel {
    width: 460px;
    height: 700px;
    max-height: 100%;
    padding: 50px 35px 30px 35px;
    justify-content: flex-start;
    background-image: url("project://database/Assets/PLuan/chọn player.png");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    flex-shrink: 1;
}

.panel-hidden-state {
    opacity: 0;
    translate: 350px 0;
}

.panel-section-title {
    color: rgb(0, 229, 255);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 2px;
    text-shadow: 0 0 10px rgba(0, 229, 255, 0.5);
    text-align: center;
}

.panel-section-subtitle {
    color: rgba(130, 200, 255, 0.4);
    font-size: 9px;
    letter-spacing: 1.5px;
    -unity-font-style: bold;
    margin-bottom: 16px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 229, 255, 0.15);
    padding-bottom: 8px;
    text-align: center;
}

.char-cards-container {
    flex-grow: 1;
    position: relative; /* Crucial: sets absolute coordinate system for child cards */
}

/* CHARACTER CARDS */
.char-card {
    position: absolute;
    left: 0;
    right: 0px;
    height: 72px; /* Fixed height for clean vertical alignment */
    align-items: center;
    background-color: transparent !important;
    border-width: 0 !important;
    border-radius: 0 !important;
    padding: 0 !important;
    margin: 0 !important;
    box-shadow: none !important;
    transition: all 0.25s cubic-bezier(0.25, 0.8, 0.25, 1);
}

/* Precise vertical coordinates centered exactly on background slot frames */
#char-card-0 {
    top: 12%;
    left: 5%;
}
#char-card-1 {
    top: 28.5%;
    left: 5%;
}
#char-card-2 {
    top: 45.5%;
    left: 5%;
}
#char-card-3 {
    top: 62.5%;
    left: 5%;
}

.char-card:hover {
    background-color: transparent !important;
    border-width: 0 !important;
    scale: 1.05; /* Uniform scale instead of translate to keep avatar aligned in circle */
}

.select-active {
    background-image: none !important; /* Remove legacy background gradient to match clean gold frame */
    border-width: 0 !important;
    box-shadow: none !important;
}

.card-locked {
    opacity: 0.45;
    background-color: transparent !important;
    border-width: 0 !important;
}

.card-locked:hover {
    background-color: transparent !important;
    border-width: 0 !important;
    scale: 1;
    box-shadow: none;
}

.char-card-portrait {
    position: absolute;
    left: 72px; /* Centered precisely inside the gold circle frame */
    top: 12px; /* Centered precisely inside the gold circle frame */
    width: 48px;
    height: 48px;
    border-radius: 24px; /* Perfect round avatar matching the circular background slot frame */
    border-width: 0 !important;
    background-size: cover;
    transition: all 0.2s ease-out;
}

.char-card:hover .char-card-portrait,
.select-active .char-card-portrait {
    scale: 1.1;
}

/* Character text container for vertical Name & Role alignment */
.char-card-text-container {
    position: absolute;
    left: 110px; /* Perfectly centered within the name plaque bounds */
    width: 210px; /* Spans the full width of the gold plaque */
    top: 0;
    bottom: 0;
    flex-direction: column;
    justify-content: center;
    align-items: center; /* Center text inside the container */
    margin: 0 !important;
    padding: 0 !important;
}

.char-card-name {
    color: #EAF7FF;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.8);
    text-shadow: 0px 0px 4px rgba(0, 0, 0, 0.8);
    letter-spacing: 1.2px;
    margin-top: 4px;
    margin-bottom: 2px;
    -unity-text-align: middle-center;
    transition: all 0.2s ease-out;
}

.char-card:hover .char-card-name {
    color: #FFFFFF;
    text-shadow: 0 0 8px rgba(0, 229, 255, 0.7);
}

.select-active .char-card-name {
    color: #00FF88 !important; /* Glowing neon green highlight when selected */
    text-shadow: 0px 0px 10px rgba(0, 255, 136, 0.85) !important;
    -unity-text-outline-color: rgba(0, 50, 20, 0.9) !important;
}

.char-card-role {
    color: #79C9FF;
    font-size: 9.5px;
    -unity-font-style: bold;
    text-shadow: 0px 0px 3px rgba(0, 0, 0, 1);
    letter-spacing: 0.8px;
    margin-top: -3px; /* Reduced vertical gap to make them closer */
    -unity-text-align: middle-center;
    transition: all 0.2s ease-out;
}

.char-card:hover .char-card-role {
    color: #A3DCFF;
}

.select-active .char-card-role {
    color: #EAF7FF !important; /* Highlight class name as well */
    text-shadow: 0px 0px 6px rgba(0, 255, 136, 0.3) !important;
}

.char-card-status {
    display: none !important; /* Discard YOU and FREE text labels entirely */
}

.active-status {
    display: none !important;
}

.char-inspect-tip {
    color: rgba(0, 229, 255, 0.45);
    font-size: 9px;
    -unity-font-style: italic;
    -unity-text-align: middle-center;
    position: absolute;
    bottom: 175px;
    left: 50;
    right: 0;
    margin: 0;
    padding: 0;
}

/* PORTRAIT GRAPHICS */
.leo-img {
    background-image: url("project://database/Assets/Hbao/Image/AvaST.png");
}

.maya-img {
    background-image: url("project://database/Assets/Hbao/Image/AvaHT.png");
}

.elena-img {
    background-image: url("project://database/Assets/Hbao/Image/AvaCung.png");
}

.arthur-img {
    background-image: url("project://database/Assets/Hbao/Image/AvaTank.png");
}

/* LEO SKILLS */
.leo-skill-0 {
    background-image: url("project://database/Assets/Hbao/Image/Skill%201,.png");
}
.leo-skill-1 {
    background-image: url("project://database/Assets/Hbao/Image/Skill%202.png");
}
.leo-skill-2 {
    background-image: url("project://database/Assets/Hbao/Image/ST-Skill3.png");
}

/* MAYA SKILLS */
.maya-skill-0 {
    background-image: url("project://database/Assets/Hbao/Image/HT Skill 3.png");
}
.maya-skill-1 {
    background-image: url("project://database/Assets/Hbao/Image/HT%20skill2.png");
}
.maya-skill-2 {
    background-image: url("project://database/Assets/Hbao/Image/HT_skill1.png");
}

/* ELENA SKILLS */
.elena-skill-0 {
    background-image: url("project://database/Assets/Hbao/Image/CT-Skill1.png");
    background-size: 155% 155%;
    background-position: center;
}
.elena-skill-1 {
    background-image: url("project://database/Assets/Hbao/Image/CT-skill2.png");
}
.elena-skill-2 {
    background-image: url("project://database/Assets/Hbao/Image/CT-Skill3.png");
}

/* ARTHUR SKILLS */
.arthur-skill-0 {
    background-image: url("project://database/Assets/Hbao/Image/tanker-skill1.png");
}
.arthur-skill-1 {
    background-image: url("project://database/Assets/Hbao/Image/tanker-skill2.png");
}
.arthur-skill-2 {
    background-image: url("project://database/Assets/Hbao/Image/HT-Skill3.png");
}

/* CHARACTER DETAILS MODAL */
.details-modal {
    position: absolute;
    width: 100%;
    height: 100%;
    left: 0;
    top: 0;
    background-color: rgba(0, 3, 6, 0.9);
    justify-content: center;
    align-items: center;
    transition: opacity 0.3s ease-out;
}

.swap-modal-container {
    background-image: url("project://database/Assets/PLuan/WaittingRoom/Textures/ui_frame_bg.jpg");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: transparent;
    border-width: 1.5px;
    border-radius: 8px;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8);
}

.details-container {
    width: 600px;
    height: 900px;
    max-width: 92%;
    max-height: 90%;
    position: relative;
    background-image: url("project://database/Assets/PLuan/IMG chi tiết player.png");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.85);
    padding: 0;
    flex-shrink: 1;
}

.details-container .panel-seaweed-top-right,
.details-container .panel-seaweed-bottom-left {
    display: none !important;
}

/* CLOSE BUTTON TEXT AT BOTTOM */
.details-close-btn {
    position: absolute;
    left: 49%;
    translate: -50% 0;
    bottom: 0px;
    height: 40px;
    width: 180px;
    background-color: transparent !important;
    border-width: 0 !important;
    color: #FF5A70;
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    text-shadow: 0px 0px 6px rgba(255, 90, 112, 0.55);
    transition: color 0.2s, scale 0.2s, text-shadow 0.2s;
}

.details-close-btn:hover {
    color: #FF2E4C;
    scale: 1.08;
    text-shadow: 0px 0px 14px rgba(255, 46, 76, 0.95);
}

.details-header {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

.details-large-portrait {
    position: absolute;
    left: 215px;
    top: 252px;
    width: 170px;
    height: 170px;
    border-radius: 100px;
    border-width: 0;
    background-size: cover;
    box-shadow: none;
}

.details-title-container {
    position: absolute;
    left: 176px;
    width: 248px;
    top: 150px;
    height: 48px;
    justify-content: center;
    align-items: center;
}

.details-char-name {
    color: #EAF7FF;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.85);
    text-shadow: 0px 0px 4px rgba(0, 0, 0, 0.8);
    letter-spacing: 2px;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

.details-char-role {
    color: #79C9FF;
    font-size: 10px;
    -unity-font-style: bold;
    text-shadow: 0px 0px 3px rgba(0, 0, 0, 1);
    letter-spacing: 1.2px;
    margin-top: -2px;
    padding: 0;
    -unity-text-align: middle-center;
}

.details-char-desc {
    display: none;
}

.details-section-title {
    display: none;
}

.details-skills-container {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

.details-skill-box {
    position: absolute;
    left: 160px;
    width: 344px;
    height: 65px;
    background-color: transparent !important;
    border-width: 0 !important;
    padding: 0 !important;
    margin: 0 !important;
}

.details-skill-box:hover {
    scale: 1.03;
}

#details-skill-box-0 {
    top: 518px;
}

#details-skill-box-1 {
    top: 608px;
}

#details-skill-box-2 {
    top: 698px;
}

.details-skill-icon {
    position: absolute;
    left: 6px;
    top: -20px;
    width: 56px;
    height: 56px;
    border-radius: 28px;
    border-width: 0 !important;
    background-size: cover;
}

.details-skill-text-container {
    position: absolute;
    left: 90px;
    width: 190px;
    top: -50px;
    bottom: 0;
    justify-content: center;
    margin: 0 !important;
    padding: 0 !important;
}

.details-skill-title {
    color: white;
    font-size: 12px;
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
    transition: color 0.2s;
}

.details-skill-box:hover .details-skill-title {
    color: #79C9FF;
}

.details-skill-desc {
    color: rgb(145, 185, 205);
    font-size: 9px;
    line-height: 12px;
    margin-top: 1px;
    padding: 0;
    white-space: normal;
    -unity-text-wrap: true;
}

/* WARNING TEXT */
.warning-text {
    position: absolute;
    top: -62px;
    color: rgb(255, 75, 95) !important;
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    background-color: transparent !important;
    background-image: none !important;
    border-width: 0 !important;
    padding: 0 !important;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 1);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* BOTTOM AREA (FLOATING & TRANSPARENT) */
.waiting-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    background-color: transparent;
    padding: 10px 0;
    border-width: 0;
    margin-top: 10px;
    box-shadow: none;
    flex-shrink: 0;
}

.left-actions {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

/* ACTION BUTTON SYSTEM (MAIN MENU BUTTON STYLE) */
.action-btn {
    width: 280px;
    min-width: 260px;
    height: 60px;
    padding: 0 15px !important;
    font-size: 18px !important;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin: 0 10px;
    border-radius: 0 !important;
    border-width: 0 !important;
    background-color: transparent !important;
    background-image: none !important;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
    white-space: nowrap !important;
    transition: all 0.3s ease-out;
    cursor: link;
    color: rgb(235, 245, 255) !important;
    text-shadow: 0 0 12px rgba(0, 180, 255, 0.7), 2px 2px 5px rgba(0, 0, 0, 0.95);
}

.action-btn:hover {
    scale: 1.06 1.06;
    letter-spacing: 3.5px;
    color: rgb(255, 255, 255) !important;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Menu_Button_06_Frame.png") !important;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 500;
    -unity-slice-right: 500;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 0.22;
    text-shadow: 0 0 22px rgba(0, 240, 255, 1), 0 0 8px rgba(255, 255, 255, 0.9), 2px 2px 4px rgba(0, 0, 0, 1);
}

.ready-btn {
    color: rgb(215, 245, 255) !important;
    text-shadow: 0 0 12px rgba(0, 180, 255, 0.7), 2px 2px 5px rgba(0, 0, 0, 0.95);
}

.ready-btn:hover {
    color: rgb(255, 255, 255) !important;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Menu_Button_06_Frame.png") !important;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 500;
    -unity-slice-right: 500;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 0.22;
    text-shadow: 0 0 22px rgba(0, 240, 255, 1), 0 0 8px rgba(255, 255, 255, 0.9), 2px 2px 4px rgba(0, 0, 0, 1);
}

.ready-active {
    color: rgb(160, 255, 180) !important;
    text-shadow: 0 0 12px rgba(46, 213, 115, 0.8), 2px 2px 5px rgba(0, 0, 0, 0.95);
}

.ready-active:hover {
    color: rgb(255, 255, 255) !important;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Menu_Button_06_Frame.png") !important;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 500;
    -unity-slice-right: 500;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 0.22;
    text-shadow: 0 0 22px rgba(46, 213, 115, 1), 0 0 8px rgba(255, 255, 255, 0.9), 2px 2px 4px rgba(0, 0, 0, 1);
}

.leave-btn {
    color: rgb(255, 160, 160) !important;
    text-shadow: 0 0 12px rgba(255, 60, 60, 0.7), 2px 2px 5px rgba(0, 0, 0, 0.95);
}

.leave-btn:hover {
    color: rgb(255, 255, 255) !important;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Menu_Button_06_Frame.png") !important;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 500;
    -unity-slice-right: 500;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 0.22;
    text-shadow: 0 0 22px rgba(255, 70, 70, 1), 0 0 8px rgba(255, 255, 255, 0.9), 2px 2px 4px rgba(0, 0, 0, 1);
}

/* TOGGLE CHARACTER PANEL BUTTON */
.toggle-char-panel-btn {
    color: rgb(215, 245, 255) !important;
    text-shadow: 0 0 12px rgba(0, 180, 255, 0.7), 2px 2px 5px rgba(0, 0, 0, 0.95);
}

.toggle-char-panel-btn:hover {
    color: rgb(255, 255, 255) !important;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Menu_Button_06_Frame.png") !important;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 500;
    -unity-slice-right: 500;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 0.22;
    text-shadow: 0 0 22px rgba(0, 240, 255, 1), 0 0 8px rgba(255, 255, 255, 0.9), 2px 2px 4px rgba(0, 0, 0, 1);
}

.start-btn {
    width: 380px !important;
    min-width: 350px !important;
    color: rgb(240, 250, 255) !important;
    text-shadow: 0 0 16px rgba(0, 230, 255, 0.9), 0 0 6px rgba(255, 255, 255, 0.9), 2px 2px 5px rgba(0, 0, 0, 0.95);
}

.start-btn:hover {
    color: rgb(255, 255, 255) !important;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Menu_Button_06_Frame.png") !important;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 500;
    -unity-slice-right: 500;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 0.22;
    text-shadow: 0 0 22px rgba(0, 255, 255, 1), 0 0 8px rgba(255, 255, 255, 0.9), 2px 2px 4px rgba(0, 0, 0, 1);
}

.start-btn:disabled {
    color: rgb(190, 235, 255) !important;
    text-shadow: 0 0 14px rgba(0, 200, 255, 0.85), 2px 2px 5px rgba(0, 0, 0, 0.95);
    background-image: none !important;
    scale: 1 1;
    opacity: 0.95;
}

#btn-swap-character {
    color: rgb(215, 245, 255) !important;
    text-shadow: 0 0 14px rgba(0, 200, 255, 0.9), 2px 2px 5px rgba(0, 0, 0, 0.95);
}

#btn-swap-character:hover {
    color: rgb(255, 255, 255) !important;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Menu_Button_06_Frame.png") !important;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 500;
    -unity-slice-right: 500;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 0.22;
    text-shadow: 0 0 22px rgba(0, 240, 255, 1), 0 0 8px rgba(255, 255, 255, 0.9), 2px 2px 4px rgba(0, 0, 0, 1);
}

/* RIGHT SIDE STATUS (UNIFIED HEIGHT FOR SYMMETRY) */
.player-count-container {
    height: 52px;
    padding: 0 18px;
    margin-left: 6px;
    margin-right: 5px;
    background-color: rgba(2, 10, 22, 0.7);
    border-width: 1.5px;
    border-color: rgba(0, 229, 255, 0.25);
    border-radius: 6px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.status-text {
    color: rgb(0, 229, 255);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    text-shadow: 0 0 8px rgba(0, 229, 255, 0.5);
    white-space: nowrap;
}

.start-game-center {
    position: relative;
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    margin: 0 10px;
    height: 60px;
}

.hidden-element {
    display: none;
}

.swap-status-active {
    color: rgb(255, 165, 0);
    text-shadow: 0 0 8px rgba(255, 165, 0, 0.8);
    border-color: rgba(255, 165, 0, 0.4);
    background-color: rgba(255, 165, 0, 0.12);
}

/* POPUP MODAL PANEL (MATCHING MAIN MENU SYNTH POPUP STYLE) */
.voice-modal-panel {
    align-self: center;
    width: 680px;
    height: 520px;
    max-width: 92%;
    max-height: 90%;
    padding: 120px 65px 35px 65px;
    background-image: url("project://database/Assets/PLuan/Synty_Popup_05_Exact.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 200;
    -unity-slice-right: 200;
    -unity-slice-top: 100;
    -unity-slice-bottom: 100;
    -unity-slice-scale: 0.38;
    background-color: transparent !important;
    border-radius: 0 !important;
    border-width: 0 !important;
    justify-content: flex-start;
    align-items: stretch;
    box-shadow: none !important;
}

.panel-title {
    color: rgb(255, 225, 120); /* Luminous Imperial Gold */
    font-size: 24px !important;
    -unity-font-style: bold;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    text-shadow: 0 0 16px rgba(255, 200, 50, 0.8), 2px 2px 4px rgba(0, 0, 0, 1);
    margin-bottom: 6px;
}

.panel-divider {
    height: 12px;
    width: 100%;
    margin-bottom: 15px;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/General/SPR_FantasyMenus_Line_Horizontal_01.png");
    -unity-background-scale-mode: stretch-to-fill;
    opacity: 0.85;
}

.voice-player-scroll {
    flex-grow: 1;
    width: 100%;
    margin-bottom: 15px;
}

.voice-player-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 8px 14px;
    margin-bottom: 8px;
    background-color: rgba(0, 20, 40, 0.45);
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 190, 255, 0.25);
}

.voice-player-name {
    color: rgb(180, 230, 255);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.9);
    width: 180px;
}

.voice-slider-val {
    width: 50px;
    -unity-text-align: middle-right;
    color: rgb(255, 215, 100);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    text-shadow: 0 0 8px rgba(255, 200, 50, 0.8);
}

.voice-empty-hint {
    color: rgba(160, 210, 240, 0.75);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    -unity-text-align: middle-center;
    text-align: center;
    margin-top: 40px;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.9);
}

.voice-actions {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    width: 100%;
    margin-top: 10px;
}

.voice-close-btn {
    width: 200px !important;
    min-width: 180px !important;
    height: 52px !important;
    font-size: 17px !important;
}

.voice-btn {
    width: 200px !important;
    min-width: 180px !important;
    height: 52px !important;
    font-size: 17px !important;
    margin: 0 10px !important;
}

.swap-request-text {
    color: rgb(215, 240, 255);
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    text-align: center;
    -unity-text-align: middle-center;
    margin-top: 25px;
    margin-bottom: 35px;
    white-space: normal;
    -unity-text-wrap: true;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.9);
}

/* CUSTOM SLIDERS (MATCHING MAIN MENU SETTINGS) */
.custom-slider {
    margin-top: 4px;
    margin-bottom: 6px;
}

.custom-slider .unity-base-slider__tracker {
    background-color: rgba(0, 10, 20, 0.9);
    border-color: rgba(0, 190, 255, 0.4);
    border-width: 1px;
    height: 8px;
    border-radius: 4px;
    margin-top: -4px;
    box-shadow: 0 0 6px rgba(0, 190, 255, 0.3);
}

.custom-slider .unity-base-slider__dragger {
    background-image: url("project://database/Assets/PLuan/Synty_Radio_Checked.png") !important;
    -unity-background-scale-mode: scale-to-fit;
    background-color: transparent !important;
    border-width: 0 !important;
    width: 24px;
    height: 24px;
    margin-top: -12px;
    transition: scale 0.15s ease-out;
    cursor: link;
}

.custom-slider .unity-base-slider__dragger:hover,
.custom-slider .unity-base-slider__dragger:focus {
    scale: 1.25 1.25;
}
