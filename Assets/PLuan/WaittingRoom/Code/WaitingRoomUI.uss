.waiting-room-overlay {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    padding: 40px;
    background-color: rgba(0, 4, 8, 0.4); /* Nền mờ nhẹ để thấy 3D phía sau */
    justify-content: space-between;
}

/* TOP BAR */
.waiting-top-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 190, 255, 0.5);
    padding-bottom: 20px;
    background-color: rgba(2, 9, 16, 0.8);
    padding-left: 30px;
    padding-right: 30px;
    border-radius: 4px;
}

.room-title {
    color: rgb(160, 230, 255);
    font-size: 32px;
    -unity-font-style: bold;
    letter-spacing: 5px;
    text-shadow: 0 0 15px rgba(0, 190, 255, 0.8);
}

.room-id-badge {
    background-color: rgba(0, 190, 255, 0.2);
    border-width: 1px;
    border-color: rgb(0, 190, 255);
    color: rgb(0, 255, 255);
    padding: 8px 20px;
    font-size: 20px;
    border-radius: 4px;
    -unity-font-style: bold;
    letter-spacing: 3px;
}

/* STATUS */
.players-status-container {
    align-self: flex-end;
    margin-right: 20px;
}

.status-text {
    color: rgb(0, 255, 255);
    font-size: 24px;
    -unity-font-style: bold;
    text-shadow: 0 0 10px rgba(0, 255, 255, 0.5);
}

/* BOTTOM BAR */
.waiting-bottom-bar {
    flex-direction: row;
    justify-content: center;
    padding-bottom: 20px;
}

.action-btn {
    padding: 18px 50px;
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    margin: 0 20px;
    border-radius: 4px;
    transition: all 0.3s ease-out;
    border-width: 0;
}

.start-btn {
    background-color: rgba(0, 190, 255, 0.1);
    border-left-width: 4px;
    border-left-color: rgb(0, 255, 255);
    color: rgb(0, 255, 255);
}

.start-btn:hover {
    background-color: rgb(0, 190, 255);
    color: rgb(0, 8, 16);
    scale: 1.05 1.05;
    box-shadow: 0 0 25px rgba(0, 190, 255, 0.6);
}

.leave-btn {
    background-color: rgba(255, 60, 60, 0.05);
    border-left-width: 4px;
    border-left-color: rgb(255, 80, 80);
    color: rgb(255, 120, 120);
}

.leave-btn:hover {
    background-color: rgb(255, 60, 60);
    color: white;
    scale: 1.05 1.05;
    box-shadow: 0 0 25px rgba(255, 60, 60, 0.6);
}

.hidden-element {
    display: none;
}
