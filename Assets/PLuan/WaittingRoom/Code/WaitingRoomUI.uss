.waiting-room-overlay {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    padding: 60px;
    background-color: rgba(0, 4, 8, 0.4); 
    justify-content: space-between;
}

/* TOP BAR */
.waiting-top-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 190, 255, 0.5);
    padding-bottom: 20px;
    background-color: rgba(2, 9, 16, 0.8);
    padding-left: 30px;
    padding-right: 30px;
    border-radius: 4px;
}

.room-title {
    color: rgb(160, 230, 255);
    font-size: 32px;
    -unity-font-style: bold;
    letter-spacing: 5px;
    text-shadow: 0 0 15px rgba(0, 190, 255, 0.8);
}

.room-id-badge {
    background-color: rgba(0, 190, 255, 0.2);
    border-width: 1px;
    border-color: rgb(0, 190, 255);
    color: rgb(0, 255, 255);
    padding: 8px 20px;
    font-size: 20px;
    border-radius: 4px;
    -unity-font-style: bold;
    letter-spacing: 3px;
}

/* BOTTOM AREA */
.waiting-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
}

.left-actions {
    flex-direction: row;
}

.action-btn {
    padding: 15px 40px;
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-right: 20px;
    border-radius: 4px;
    transition: all 0.2s ease-out;
    border-width: 0;
    border-left-width: 4px;
}

.ready-btn {
    background-color: rgba(0, 190, 255, 0.1);
    border-left-color: rgb(0, 255, 255);
    color: rgb(0, 255, 255);
}

.ready-btn:hover {
    background-color: rgb(0, 190, 255);
    color: rgb(0, 8, 16);
}

.ready-active {
    background-color: #32ff7e;
    border-left-color: #ffffff;
    color: #000000;
}

.leave-btn {
    background-color: rgba(255, 60, 60, 0.05);
    border-left-color: rgb(255, 80, 80);
    color: rgb(255, 120, 120);
}

.leave-btn:hover {
    background-color: rgb(255, 60, 60);
    color: white;
}

/* RIGHT SIDE STATUS */
.player-count-container {
    padding: 15px 25px;
    background-color: rgba(2, 9, 16, 0.8);
    border-width: 1px;
    border-color: rgba(0, 190, 255, 0.4);
    border-radius: 4px;
    align-items: center;
}

.status-text {
    color: rgb(0, 255, 255);
    font-size: 26px;
    -unity-font-style: bold;
    text-shadow: 0 0 10px rgba(0, 255, 255, 0.6);
}

.start-game-center {
    position: absolute;
    left: 50%;
    translate: -50% 0;
    bottom: 0;
}

.hidden-element {
    display: none;
}
