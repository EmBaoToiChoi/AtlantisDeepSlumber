/* Atlantis Deep Slumber - Lobby UI Stylesheet */

.waiting-room-overlay {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    padding: 24px 35px 20px 35px;
    background-color: transparent;
    justify-content: space-between;
    -unity-font-definition: url("project://database/Assets/PLuan/MainMenu/Font/Cinzel-Vietnamese.ttf");
}

/* GLASSMORPHISM & SCI-FI CORE */
.glass-panel {
    background-color: rgba(2, 16, 32, 0.65);
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.35);
    border-radius: 8px;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.4);
}

.glow-border {
    border-color: rgba(0, 229, 255, 0.45);
}

/* TOP INFO COMBINED WIDGET (MAIN MENU USER PROFILE STYLE) */
.top-info-panel {
    width: 310px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: transparent !important;
    background-image: none !important;
    border-width: 0 !important;
    border-radius: 0 !important;
    padding: 0 !important;
    box-shadow: none !important;
    transition: all 0.3s ease-out;
}

.section-break-bar {
    width: 100%;
    height: 16px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.section-break-top {
    margin-bottom: 6px;
}

.section-break-bottom {
    margin-top: 4px;
}

.section-break-top-left {
    flex-grow: 1;
    height: 100%;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Bar_01_Top_Left.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.section-break-top-right {
    flex-grow: 1;
    height: 100%;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Bar_01_Top_Right.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.section-break-bottom-left {
    flex-grow: 1;
    height: 100%;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Bar_01_Bottom_Left.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.section-break-bottom-right {
    flex-grow: 1;
    height: 100%;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Bar_01_Bottom_Right.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.user-profile-label {
    color: rgb(160, 225, 255);
    font-size: 11px !important;
    letter-spacing: 2.5px;
    margin: 0 0 2px 0;
    padding: 0;
    -unity-font-style: bold;
    text-shadow: 0 0 8px rgba(0, 180, 255, 0.7);
    -unity-text-align: middle-center;
}

.user-profile-name {
    color: rgb(255, 225, 120); /* Luminous Imperial Gold */
    font-size: 22px !important;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin: 0 0 4px 0;
    padding: 0;
    text-shadow: 0 0 16px rgba(255, 200, 50, 0.85);
    -unity-text-align: middle-center;
}

.room-meta-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin: 0 0 4px 0;
    flex-wrap: nowrap;
}

.room-id-badge {
    background-color: transparent !important;
    border-width: 0 !important;
    color: rgb(0, 240, 255) !important;
    padding: 0 !important;
    font-size: 13px !important;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    text-shadow: 0 0 10px rgba(0, 230, 255, 0.8);
    -unity-text-align: middle-center;
}

.room-meta-separator {
    color: rgba(0, 229, 255, 0.6);
    font-size: 11px !important;
    margin: 0 8px;
    -unity-text-align: middle-center;
}

.player-count-badge {
    background-color: transparent !important;
    border-width: 0 !important;
    color: rgb(160, 255, 200) !important;
    padding: 0 !important;
    font-size: 13px !important;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    text-shadow: 0 0 10px rgba(46, 213, 115, 0.8);
    -unity-text-align: middle-center;
}

/* TOP BAR CONTAINER */
.waiting-top-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 12px 0;
    background-color: transparent;
    border-width: 0;
    box-shadow: none;
}

/* MIDDLE MAIN CONTAINER */
.waiting-middle-container {
    flex-direction: row;
    flex-grow: 1;
    align-items: center;
    margin-top: 10px;
    margin-bottom: 10px;
}

.waiting-viewport-spacer {
    flex-grow: 1;
}

/* =========================================================================
   CHARACTER SELECTION SIDEBAR - SYNTY LAYERED POPUP
   ========================================================================= */
.char-select-panel {
    width: 440px;
    height: 650px;
    max-height: 94%;
    margin-right: -35px;
    padding: 28px 24px 42px 24px;
    background-image: none !important;
    background-color: transparent !important;
    border-width: 0 !important;
    border-radius: 0 !important;
    justify-content: space-between;
    align-items: stretch;
    transition: all 0.3s ease-out;
    flex-shrink: 1;
}

/* Background layer - dark stone fill */
.char-panel-bg-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Popup_03_Background.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 120;
    -unity-slice-right: 120;
    -unity-slice-top: 160;
    -unity-slice-bottom: 160;
    -unity-slice-scale: 0.35;
    -unity-background-image-tint-color: rgba(8, 16, 30, 1);
}

/* Frame overlay layer - gold ornate border */
.char-panel-frame-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Popup_03_Left.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 120;
    -unity-slice-right: 120;
    -unity-slice-top: 160;
    -unity-slice-bottom: 160;
    -unity-slice-scale: 0.35;
}

.panel-hidden-state {
    opacity: 0;
    translate: 350px 0;
}

.char-panel-header {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    margin-top: 4px;
    margin-bottom: 8px;
}

.char-panel-title {
    color: rgb(255, 230, 130); /* Brilliant Luminous Gold */
    font-size: 21px !important;
    -unity-font-style: bold;
    letter-spacing: 3.5px;
    text-shadow: 0 0 16px rgba(255, 200, 50, 0.95);
    -unity-text-align: middle-center;
    margin: 2px 0 6px 0;
}

.char-panel-divider {
    height: 8px;
    width: 92%;
    margin-bottom: 6px;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/General/SPR_FantasyMenus_Line_Horizontal_01.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(255, 215, 80, 0.9);
    opacity: 1;
}

.char-cards-container {
    flex-grow: 1;
    width: 100%;
    flex-direction: column;
    justify-content: space-around;
}

/* MODULAR CHARACTER CARD - SYNTY FRAME BOX */
.char-card {
    position: relative;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
    height: 84px;
    margin: 3px 0;
    padding: 0 16px;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Box_Medium_02.png") !important;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 80;
    -unity-slice-right: 80;
    -unity-slice-top: 80;
    -unity-slice-bottom: 80;
    -unity-slice-scale: 0.16;
    -unity-background-image-tint-color: rgba(210, 185, 120, 0.85);
    background-color: rgba(6, 18, 38, 0.8) !important;
    border-width: 0 !important;
    border-radius: 0 !important;
    cursor: link;
    transition: all 0.2s ease-out;
}

.char-card:hover {
    scale: 1.02 1.02;
    translate: -4px 0;
    background-color: rgba(10, 45, 85, 0.9) !important;
    -unity-background-image-tint-color: rgba(0, 240, 255, 1);
}

.select-active {
    background-color: rgba(14, 40, 72, 0.95) !important;
    scale: 1.03 1.03;
    -unity-background-image-tint-color: rgba(255, 225, 80, 1);
}

.card-locked {
    opacity: 0.45;
    background-color: transparent !important;
    border-width: 0 !important;
}

.card-locked:hover {
    background-color: transparent !important;
    border-width: 0 !important;
    scale: 1;
    box-shadow: none;
}

/* AVATAR SLOT & ORNATE CIRCLE FRAME */
.char-avatar-slot {
    width: 64px;
    height: 64px;
    position: relative;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
    margin-right: 14px;
}

.char-avatar-frame {
    position: absolute;
    left: 0;
    top: 0;
    width: 64px;
    height: 64px;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Circle_01.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.char-card-portrait {
    position: absolute;
    left: 8px;
    top: 8px;
    width: 48px;
    height: 48px;
    border-radius: 24px;
    border-width: 0 !important;
    background-size: cover;
    transition: all 0.2s ease-out;
}

.char-card:hover .char-card-portrait,
.select-active .char-card-portrait {
    scale: 1.08;
}

/* Character text container for Name & Role */
.char-card-text-container {
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    flex-grow: 1;
    margin: 0 !important;
    padding: 0 !important;
}

.char-card-name {
    color: rgb(240, 248, 255);
    font-size: 17px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 1);
    margin: 0 0 2px 0;
    transition: all 0.2s ease-out;
}

.char-card:hover .char-card-name {
    color: rgb(255, 255, 255);
    text-shadow: 0 0 12px rgba(0, 229, 255, 0.9);
}

.select-active .char-card-name {
    color: rgb(255, 230, 130) !important; /* Luminous Imperial Gold highlight */
    text-shadow: 0 0 14px rgba(255, 200, 50, 0.95) !important;
}

.char-card-role {
    color: rgb(0, 220, 255);
    font-size: 11.5px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 1);
    margin: 0;
    transition: all 0.2s ease-out;
}

.char-card:hover .char-card-role {
    color: rgb(180, 245, 255);
}

.select-active .char-card-role {
    color: rgb(255, 255, 255) !important;
}

.char-card-status {
    width: 72px;
    height: 28px;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    color: rgb(148, 175, 205);
    margin-left: 8px;
    background-image: none !important;
    background-color: rgba(15, 25, 45, 0.85) !important;
    border-width: 1px !important;
    border-color: rgba(100, 160, 220, 0.45) !important;
    border-radius: 4px !important;
    -unity-text-align: middle-center;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 1);
}

.active-status {
    color: rgb(255, 255, 255) !important;
    background-image: none !important;
    background-color: rgba(16, 110, 52, 0.9) !important;
    border-width: 1.5px !important;
    border-color: rgb(52, 211, 120) !important;
    border-radius: 4px !important;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8) !important;
}

.char-inspect-tip {
    color: rgb(0, 229, 255);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 1.2px;
    text-shadow: 0 0 8px rgba(0, 229, 255, 0.6);
    margin: 8px 0 2px 0;
    padding: 0;
}

/* PORTRAIT GRAPHICS */
.leo-img {
    background-image: url("project://database/Assets/Hbao/Image/AvaST.png");
}

.maya-img {
    background-image: url("project://database/Assets/Hbao/Image/AvaHT.png");
}

.elena-img {
    background-image: url("project://database/Assets/Hbao/Image/AvaCung.png");
}

.arthur-img {
    background-image: url("project://database/Assets/Hbao/Image/AvaTank.png");
}

/* LEO SKILLS */
.leo-skill-0 {
    background-image: url("project://database/Assets/Hbao/Image/Skill%201,.png");
}
.leo-skill-1 {
    background-image: url("project://database/Assets/Hbao/Image/Skill%202.png");
}
.leo-skill-2 {
    background-image: url("project://database/Assets/Hbao/Image/ST-Skill3.png");
}

/* MAYA SKILLS */
.maya-skill-0 {
    background-image: url("project://database/Assets/Hbao/Image/HT%20Skill%203.png");
}
.maya-skill-1 {
    background-image: url("project://database/Assets/Hbao/Image/HT%20skill2.png");
}
.maya-skill-2 {
    background-image: url("project://database/Assets/Hbao/Image/HT_skill1.png");
}

/* ELENA SKILLS */
.elena-skill-0 {
    background-image: url("project://database/Assets/Hbao/Image/CT-Skill1.png");
    background-size: 155% 155%;
    background-position: center;
}
.elena-skill-1 {
    background-image: url("project://database/Assets/Hbao/Image/CT-skill2.png");
}
.elena-skill-2 {
    background-image: url("project://database/Assets/Hbao/Image/CT-Skill3.png");
}

/* ARTHUR SKILLS */
.arthur-skill-0 {
    background-image: url("project://database/Assets/Hbao/Image/tanker-skill1.png");
}
.arthur-skill-1 {
    background-image: url("project://database/Assets/Hbao/Image/tanker-skill2.png");
}
.arthur-skill-2 {
    background-image: url("project://database/Assets/Hbao/Image/HT-Skill3.png");
}

/* CHARACTER DETAILS MODAL - SYNTY BOX LARGE 02 FILIGREE FRAME */
.details-modal {
    position: absolute;
    width: 100%;
    height: 100%;
    left: 0;
    top: 0;
    background-color: rgba(0, 4, 10, 0.88);
    justify-content: center;
    align-items: center;
    transition: opacity 0.3s ease-out;
}

.details-container {
    width: 530px;
    height: 700px;
    max-width: 92%;
    max-height: 92%;
    position: relative;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Box_Large_02.png") !important;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 200;
    -unity-slice-right: 200;
    -unity-slice-top: 200;
    -unity-slice-bottom: 200;
    -unity-slice-scale: 0.22;
    -unity-background-image-tint-color: rgba(255, 220, 120, 1);
    background-color: rgba(6, 14, 26, 0.96) !important;
    border-width: 0 !important;
    border-radius: 26px !important;
    box-shadow: none !important;
    padding: 36px 32px 24px 32px;
    justify-content: space-between;
    align-items: stretch;
    flex-shrink: 1;
}

/* Top decorative curlicue crest */
.details-top-crest {
    position: absolute;
    top: -24px;
    left: 50%;
    translate: -50% 0;
    width: 240px;
    height: 48px;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Greeble_Curlicue_05_Top.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(255, 220, 110, 1);
}

/* HEADER: AVATAR & TITLE */
.details-header {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
    margin-top: 6px;
    margin-bottom: 2px;
}

.details-avatar-slot {
    width: 84px;
    height: 84px;
    position: relative;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
    margin-right: 18px;
}

.details-avatar-frame {
    position: absolute;
    left: 0;
    top: 0;
    width: 84px;
    height: 84px;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Circle_01.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.details-large-portrait {
    position: absolute;
    left: 11px;
    top: 11px;
    width: 62px;
    height: 62px;
    border-radius: 31px;
    border-width: 0 !important;
    background-size: cover;
}

.details-title-container {
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    flex-grow: 1;
}

.details-char-name {
    color: rgb(255, 230, 130);
    font-size: 25px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    text-shadow: 0 0 16px rgba(255, 200, 50, 0.95);
    margin: 0 0 2px 0;
    padding: 0;
}

.details-char-role {
    color: rgb(0, 220, 255);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    text-shadow: 0 0 8px rgba(0, 200, 255, 0.8);
    margin: 0;
    padding: 0;
}

.details-divider {
    height: 8px;
    width: 100%;
    margin: 6px 0 8px 0;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/General/SPR_FantasyMenus_Line_Horizontal_01.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(255, 215, 80, 0.9);
    opacity: 1;
}

.details-char-desc {
    color: rgb(180, 215, 240);
    font-size: 11.5px;
    line-height: 16px;
    margin-bottom: 6px;
    -unity-text-align: middle-left;
    white-space: normal;
    -unity-text-wrap: true;
    -unity-font-style: italic;
}

.details-section-title {
    color: rgb(255, 225, 120);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin: 4px 0 6px 0;
    -unity-text-align: middle-center;
    text-shadow: 0 0 10px rgba(255, 200, 50, 0.7);
}

/* SKILLS SECTION */
.details-skills-container {
    flex-direction: column;
    flex-grow: 1;
    justify-content: space-around;
    width: 100%;
}

.details-skill-box {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
    height: 72px;
    padding: 0 14px;
    margin: 2px 0;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Box_Medium_02.png") !important;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 80;
    -unity-slice-right: 80;
    -unity-slice-top: 80;
    -unity-slice-bottom: 80;
    -unity-slice-scale: 0.15;
    -unity-background-image-tint-color: rgba(210, 185, 120, 0.8);
    background-color: rgba(6, 18, 38, 0.8) !important;
    border-width: 0 !important;
    border-radius: 0 !important;
    transition: all 0.2s ease-out;
}

.details-skill-box:hover {
    scale: 1.02 1.02;
    -unity-background-image-tint-color: rgba(0, 240, 255, 1);
    background-color: rgba(10, 45, 85, 0.9) !important;
}

.details-skill-avatar-slot {
    width: 48px;
    height: 48px;
    position: relative;
    justify-content: center;
    align-items: center;
    margin-right: 12px;
    flex-shrink: 0;
}

.details-skill-avatar-frame {
    position: absolute;
    left: 0;
    top: 0;
    width: 48px;
    height: 48px;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Circle_01.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.details-skill-icon {
    position: absolute;
    left: 6px;
    top: 6px;
    width: 36px;
    height: 36px;
    border-radius: 18px;
    border-width: 0 !important;
    background-size: cover;
}

.details-skill-text-container {
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    flex-grow: 1;
    margin: 0 !important;
    padding: 0 !important;
}

.details-skill-title {
    color: rgb(255, 235, 140);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    margin: 0 0 2px 0;
    padding: 0;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 1);
    transition: color 0.2s;
}

.details-skill-box:hover .details-skill-title {
    color: rgb(0, 240, 255);
}

.details-skill-desc {
    color: rgb(170, 205, 230);
    font-size: 10.5px;
    line-height: 14px;
    margin: 0;
    padding: 0;
    white-space: normal;
    -unity-text-wrap: true;
}

/* CLOSE BUTTON - MATCHING ACTION BUTTON SYSTEM */
.details-close-btn {
    width: 220px !important;
    min-width: 180px !important;
    height: 48px !important;
    align-self: center;
    margin-top: 8px;
    margin-bottom: 2px;
    font-size: 16px !important;
    letter-spacing: 3px;
    cursor: link;
    background-image: none !important;
    background-color: transparent !important;
    border-width: 0 !important;
    border-radius: 0 !important;
    color: rgb(255, 170, 170) !important;
    text-shadow: 0 0 12px rgba(255, 60, 60, 0.7);
    transition: all 0.3s ease-out;
}

.details-close-btn:hover {
    scale: 1.06 1.06;
    letter-spacing: 4px;
    color: rgb(255, 255, 255) !important;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Menu_Button_06_Frame.png") !important;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 500;
    -unity-slice-right: 500;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 0.2;
    text-shadow: 0 0 22px rgba(255, 70, 70, 1);
}

/* WARNING TEXT */
.warning-text {
    position: absolute;
    top: -62px;
    color: rgb(255, 75, 95) !important;
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    background-color: transparent !important;
    background-image: none !important;
    border-width: 0 !important;
    padding: 0 !important;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 1);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* BOTTOM AREA (FLOATING & TRANSPARENT) */
.waiting-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    background-color: transparent;
    padding: 10px 0;
    border-width: 0;
    margin-top: 10px;
    box-shadow: none;
    flex-shrink: 0;
}

.left-actions {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

/* ACTION BUTTON SYSTEM (MAIN MENU BUTTON STYLE) */
.action-btn {
    width: 280px;
    min-width: 260px;
    height: 60px;
    padding: 0 15px !important;
    font-size: 18px !important;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin: 0 10px;
    border-radius: 0 !important;
    border-width: 0 !important;
    background-color: transparent !important;
    background-image: none !important;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
    white-space: nowrap !important;
    transition: all 0.3s ease-out;
    cursor: link;
    color: rgb(235, 245, 255) !important;
    text-shadow: 0 0 12px rgba(0, 180, 255, 0.7);
}

.action-btn:hover {
    scale: 1.06 1.06;
    letter-spacing: 3.5px;
    color: rgb(255, 255, 255) !important;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Menu_Button_06_Frame.png") !important;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 500;
    -unity-slice-right: 500;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 0.22;
    text-shadow: 0 0 22px rgba(0, 240, 255, 1);
}

.ready-btn {
    color: rgb(215, 245, 255) !important;
    text-shadow: 0 0 12px rgba(0, 180, 255, 0.7);
}

.ready-btn:hover {
    color: rgb(255, 255, 255) !important;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Menu_Button_06_Frame.png") !important;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 500;
    -unity-slice-right: 500;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 0.22;
    text-shadow: 0 0 22px rgba(0, 240, 255, 1);
}

.ready-active {
    color: rgb(160, 255, 180) !important;
    text-shadow: 0 0 12px rgba(46, 213, 115, 0.8);
}

.ready-active:hover {
    color: rgb(255, 255, 255) !important;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Menu_Button_06_Frame.png") !important;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 500;
    -unity-slice-right: 500;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 0.22;
    text-shadow: 0 0 22px rgba(46, 213, 115, 1);
}

.leave-btn {
    color: rgb(255, 160, 160) !important;
    text-shadow: 0 0 12px rgba(255, 60, 60, 0.7);
}

.leave-btn:hover {
    color: rgb(255, 255, 255) !important;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Menu_Button_06_Frame.png") !important;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 500;
    -unity-slice-right: 500;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 0.22;
    text-shadow: 0 0 22px rgba(255, 70, 70, 1);
}

/* TOGGLE CHARACTER PANEL BUTTON */
.toggle-char-panel-btn {
    color: rgb(215, 245, 255) !important;
    text-shadow: 0 0 12px rgba(0, 180, 255, 0.7);
}

.toggle-char-panel-btn:hover {
    color: rgb(255, 255, 255) !important;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Menu_Button_06_Frame.png") !important;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 500;
    -unity-slice-right: 500;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 0.22;
    text-shadow: 0 0 22px rgba(0, 240, 255, 1);
}

.start-btn {
    width: 380px !important;
    min-width: 350px !important;
    color: rgb(240, 250, 255) !important;
    text-shadow: 0 0 16px rgba(0, 230, 255, 0.9);
}

.start-btn:hover {
    color: rgb(255, 255, 255) !important;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Menu_Button_06_Frame.png") !important;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 500;
    -unity-slice-right: 500;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 0.22;
    text-shadow: 0 0 22px rgba(0, 255, 255, 1);
}

.start-btn:disabled {
    color: rgb(190, 235, 255) !important;
    text-shadow: 0 0 14px rgba(0, 200, 255, 0.85);
    background-image: none !important;
    scale: 1 1;
    opacity: 0.95;
}

#btn-swap-character {
    color: rgb(215, 245, 255) !important;
    text-shadow: 0 0 14px rgba(0, 200, 255, 0.9);
}

#btn-swap-character:hover {
    color: rgb(255, 255, 255) !important;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Menu_Button_06_Frame.png") !important;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 500;
    -unity-slice-right: 500;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 0.22;
    text-shadow: 0 0 22px rgba(0, 240, 255, 1);
}

/* RIGHT SIDE STATUS (UNIFIED HEIGHT FOR SYMMETRY) */
.player-count-container {
    height: 52px;
    padding: 0 18px;
    margin-left: 6px;
    margin-right: 5px;
    background-color: rgba(2, 10, 22, 0.7);
    border-width: 1.5px;
    border-color: rgba(0, 229, 255, 0.25);
    border-radius: 6px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.status-text {
    color: rgb(0, 229, 255);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    text-shadow: 0 0 8px rgba(0, 229, 255, 0.5);
    white-space: nowrap;
}

.start-game-center {
    position: relative;
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    margin: 0 10px;
    height: 60px;
}

.hidden-element {
    display: none;
}

.swap-status-active {
    color: rgb(255, 165, 0);
    text-shadow: 0 0 8px rgba(255, 165, 0, 0.8);
    border-color: rgba(255, 165, 0, 0.4);
    background-color: rgba(255, 165, 0, 0.12);
}

/* POPUP MODAL PANEL (MATCHING MAIN MENU SYNTH POPUP STYLE) */
.voice-modal-panel {
    align-self: center;
    width: 680px;
    height: 520px;
    max-width: 92%;
    max-height: 90%;
    padding: 120px 65px 35px 65px;
    background-image: url("project://database/Assets/PLuan/Synty_Popup_05_Exact.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 200;
    -unity-slice-right: 200;
    -unity-slice-top: 100;
    -unity-slice-bottom: 100;
    -unity-slice-scale: 0.38;
    background-color: transparent !important;
    border-radius: 0 !important;
    border-width: 0 !important;
    justify-content: flex-start;
    align-items: stretch;
    box-shadow: none !important;
}

.panel-title {
    color: rgb(255, 225, 120); /* Luminous Imperial Gold */
    font-size: 24px !important;
    -unity-font-style: bold;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    text-shadow: 0 0 16px rgba(255, 200, 50, 0.8);
    margin-bottom: 6px;
}

.panel-divider {
    height: 12px;
    width: 100%;
    margin-bottom: 15px;
    background-image: url("project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/General/SPR_FantasyMenus_Line_Horizontal_01.png");
    -unity-background-scale-mode: stretch-to-fill;
    opacity: 0.85;
}

.voice-player-scroll {
    flex-grow: 1;
    width: 100%;
    margin-bottom: 15px;
}

.voice-player-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 8px 14px;
    margin-bottom: 8px;
    background-color: rgba(0, 20, 40, 0.45);
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 190, 255, 0.25);
}

.voice-player-name {
    color: rgb(180, 230, 255);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.9);
    width: 180px;
}

.voice-slider-val {
    width: 50px;
    -unity-text-align: middle-right;
    color: rgb(255, 215, 100);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    text-shadow: 0 0 8px rgba(255, 200, 50, 0.8);
}

.voice-empty-hint {
    color: rgba(160, 210, 240, 0.75);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    -unity-text-align: middle-center;
    text-align: center;
    margin-top: 40px;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.9);
}

.voice-actions {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    width: 100%;
    margin-top: 10px;
}

.voice-close-btn {
    width: 200px !important;
    min-width: 180px !important;
    height: 52px !important;
    font-size: 17px !important;
}

.voice-btn {
    width: 200px !important;
    min-width: 180px !important;
    height: 52px !important;
    font-size: 17px !important;
    margin: 0 10px !important;
}

.swap-request-text {
    color: rgb(215, 240, 255);
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    text-align: center;
    -unity-text-align: middle-center;
    margin-top: 25px;
    margin-bottom: 35px;
    white-space: normal;
    -unity-text-wrap: true;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.9);
}

/* CUSTOM SLIDERS (MATCHING MAIN MENU SETTINGS) */
.custom-slider {
    margin-top: 4px;
    margin-bottom: 6px;
}

.custom-slider .unity-base-slider__tracker {
    background-color: rgba(0, 10, 20, 0.9);
    border-color: rgba(0, 190, 255, 0.4);
    border-width: 1px;
    height: 8px;
    border-radius: 4px;
    margin-top: -4px;
    box-shadow: 0 0 6px rgba(0, 190, 255, 0.3);
}

.custom-slider .unity-base-slider__dragger {
    background-image: url("project://database/Assets/PLuan/Synty_Radio_Checked.png") !important;
    -unity-background-scale-mode: scale-to-fit;
    background-color: transparent !important;
    border-width: 0 !important;
    width: 24px;
    height: 24px;
    margin-top: -12px;
    transition: scale 0.15s ease-out;
    cursor: link;
}

.custom-slider .unity-base-slider__dragger:hover,
.custom-slider .unity-base-slider__dragger:focus {
    scale: 1.25 1.25;
}

/* =========================================================================
   CONFIRMATION OVERLAY (XÁC NHẬN ĐỔI NHÂN VẬT) - SYNTY POPUP 02 EXACT
   ========================================================================= */
.confirm-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 5, 10, 0.85);
    justify-content: center;
    align-items: center;
}

.confirm-dialog {
    background-image: url("project://database/Assets/PLuan/Synty_Popup_02_Exact.png");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: transparent !important;
    border-width: 0 !important;
    border-radius: 0 !important;
    padding: 175px 60px 0 60px;
    align-items: center;
    justify-content: space-between;
    box-shadow: none;
    width: 780px;
    height: 330px;
}

.confirm-content {
    align-items: center;
    justify-content: center;
    width: 100%;
    margin-top: 0;
}

.confirm-title {
    color: rgb(255, 255, 255);
    font-size: 27px;
    -unity-font-style: bold;
    margin-bottom: 8px;
    text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.95);
    letter-spacing: 3px;
    -unity-text-align: middle-center;
}

.confirm-subtitle {
    color: rgb(225, 235, 245);
    font-size: 15px;
    white-space: normal;
    -unity-text-align: middle-center;
    padding: 0 40px;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.95);
    letter-spacing: 1px;
}

.confirm-buttons {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    width: 100%;
    margin-bottom: -48px;
}

.confirm-btn {
    background-color: transparent !important;
    border-width: 0 !important;
    border-radius: 0 !important;
    font-size: 15px !important;
    -unity-font-style: bold;
    width: 270px;
    height: 64px;
    padding: 2px 25px 0 110px !important;
    transition: all 0.2s ease-out;
    cursor: link;
    flex-shrink: 0 !important;
    flex-grow: 0 !important;
    white-space: nowrap !important;
    -unity-text-align: middle-center !important;
    justify-content: center;
    align-items: center;
    letter-spacing: 1.5px;
    margin: 0 35px;
    color: rgb(255, 255, 255) !important;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.95);
}

.confirm-btn-yes {
    background-image: url("project://database/Assets/PLuan/Synty_Btn_Confirm_09.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 150;
    -unity-slice-right: 100;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 0.40;
}
.confirm-btn-yes:hover {
    scale: 1.05 1.05;
    letter-spacing: 3px;
    text-shadow: 0 0 15px rgba(0, 255, 255, 1);
}

.confirm-btn-no {
    background-image: url("project://database/Assets/PLuan/Synty_Btn_Cancel_09.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 150;
    -unity-slice-right: 100;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 0.40;
}
.confirm-btn-no:hover {
    scale: 1.05 1.05;
    letter-spacing: 3px;
    text-shadow: 0 0 15px rgba(255, 100, 100, 1);
}
