/* Atlantis Deep Slumber - Lobby UI Stylesheet */

.waiting-room-overlay {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    padding: 35px;
    background-color: transparent;
    justify-content: space-between;
}

/* GLASSMORPHISM & SCI-FI CORE */
.glass-panel {
    background-color: rgba(2, 16, 32, 0.65);
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.35);
    border-radius: 8px;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.4);
}

.glow-border {
    border-color: rgba(0, 229, 255, 0.45);
}

/* TOP INFO COMBINED WIDGET */
.top-info-panel {
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    background-color: rgba(2, 16, 32, 0.65); /* Translucent ice-blue glass */
    padding: 12px 20px;
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.35);
    border-left-width: 4px;
    border-left-color: rgb(0, 229, 255);
    /* Cyber diagonal cuts matching sidebar below it */
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-top-left-radius: 2px;
    border-bottom-right-radius: 2px;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.45);
    width: 320px; /* Symmetrical vertical alignment with character selection panel */
}

.top-info-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    align-self: stretch;
}

.top-bar-decor-row {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
    border-top-width: 1px;
    border-top-color: rgba(0, 229, 255, 0.15);
    padding-top: 6px;
    width: 100%;
}

.top-bar-decor-tag {
    color: rgba(0, 190, 255, 0.5);
    font-size: 8.5px;
    letter-spacing: 1.5px;
    -unity-font-style: bold;
}

.top-bar-decor-dot {
    color: rgb(0, 255, 128);
    font-size: 8px;
    margin: 0 6px;
    text-shadow: 0 0 6px rgb(0, 255, 128);
}

.active-dot {
    color: rgb(0, 255, 128);
}

/* TOP BAR CONTAINER */
.waiting-top-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 12px 0;
    background-color: transparent;
    border-width: 0;
    box-shadow: none;
}

.room-title {
    color: rgb(200, 245, 255);
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    text-shadow: 0 0 8px rgba(0, 229, 255, 0.4);
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

.room-id-badge {
    background-color: rgba(0, 229, 255, 0.12);
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.45);
    color: rgb(0, 255, 255);
    padding: 4px 10px;
    font-size: 11px;
    border-radius: 4px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    text-shadow: 0 0 6px rgba(0, 255, 255, 0.4);
    transition: all 0.2s ease-out;
    flex-shrink: 0;
    margin-left: 12px;
}

.room-id-badge:hover {
    scale: 1.05;
    background-color: rgba(0, 229, 255, 0.2);
    border-color: rgb(0, 255, 255);
}

/* MIDDLE MAIN CONTAINER */
.waiting-middle-container {
    flex-direction: row;
    flex-grow: 1;
    margin-top: 20px;
    margin-bottom: 20px;
}

.waiting-viewport-spacer {
    flex-grow: 1;
}

/* CHARACTER SELECTION SIDEBAR */
.char-select-panel {
    width: 320px;
    padding: 22px 18px;
    justify-content: flex-start;
    margin-left: 25px;
    background-color: rgba(2, 16, 32, 0.65);
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.35);
    border-left-width: 4px;
    border-left-color: rgb(0, 229, 255);
    /* Cyber diagonal radius matching Main Menu */
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-top-left-radius: 4px;
    border-bottom-right-radius: 4px;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
}

.panel-hidden-state {
    opacity: 0;
    translate: 350px 0;
}

.panel-section-title {
    color: rgb(0, 229, 255);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 2px;
    text-shadow: 0 0 10px rgba(0, 229, 255, 0.5);
    text-align: center;
}

.panel-section-subtitle {
    color: rgba(130, 200, 255, 0.4);
    font-size: 9px;
    letter-spacing: 1.5px;
    -unity-font-style: bold;
    margin-bottom: 16px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 229, 255, 0.15);
    padding-bottom: 8px;
    text-align: center;
}

.char-cards-container {
    flex-grow: 1;
    justify-content: flex-start;
}

/* CHARACTER CARDS */
.char-card {
    flex-direction: row;
    align-items: center;
    background-color: rgba(2, 16, 32, 0.4);
    border-radius: 6px;
    padding: 10px 14px;
    margin-bottom: 10px;
    border-left-width: 3px;
    border-left-color: rgba(0, 229, 255, 0.2);
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.08);
    transition: all 0.25s cubic-bezier(0.25, 0.8, 0.25, 1);
}

.char-card:hover {
    background-color: rgba(0, 36, 72, 0.55);
    border-left-color: rgb(0, 255, 255);
    border-color: rgba(0, 255, 255, 0.45);
    scale: 1.03;
    /* Slide out slightly to highlight selection focus */
    translate: -4px 0;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.4);
}

.select-active {
    background-color: rgba(0, 229, 255, 0.12);
    border-left-width: 5px;
    border-left-color: rgb(0, 255, 255);
    border-color: rgba(0, 255, 255, 0.5);
    box-shadow: 0 0 15px rgba(0, 229, 255, 0.25);
}

.card-locked {
    opacity: 0.45;
    border-left-color: rgba(255, 71, 87, 0.4);
    border-color: rgba(255, 71, 87, 0.2);
}

.card-locked:hover {
    background-color: rgba(2, 16, 32, 0.4);
    border-left-color: rgba(255, 71, 87, 0.4);
    border-color: rgba(255, 71, 87, 0.2);
    scale: 1;
    translate: 0 0;
    box-shadow: none;
}

.char-card-portrait {
    width: 46px;
    height: 46px;
    border-radius: 6px;
    border-width: 2px;
    border-color: rgba(0, 229, 255, 0.4);
    background-size: cover;
    transition: border-color 0.2s, rotate 0.25s;
}

.char-card:hover .char-card-portrait {
    border-color: rgb(0, 255, 255);
}

/* Character text container for vertical Name & Role alignment */
.char-card-text-container {
    flex-direction: column;
    justify-content: center;
    flex-grow: 1;
    margin-left: 14px;
    margin-right: 95px; /* Crucial: leaves exact space on the right for absolute status badges */
}

.char-card-name {
    color: white;
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    margin-bottom: 2px;
    transition: color 0.2s;
}

.char-card:hover .char-card-name {
    color: rgb(0, 255, 255);
}

.char-card-role {
    color: rgb(130, 195, 235);
    font-size: 9.5px;
    letter-spacing: 0.8px;
    -unity-font-style: bold;
}

.char-card-status {
    position: absolute;
    right: 12px;
    font-size: 8px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.35);
    letter-spacing: 0.8px;
    background-color: rgba(0, 0, 0, 0.6);
    padding: 4px 8px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
    transition: all 0.2s;
}

.active-status {
    color: rgb(0, 255, 128);
    text-shadow: 0 0 8px rgba(0, 255, 128, 0.8);
    border-color: rgba(0, 255, 128, 0.4);
    background-color: rgba(0, 255, 128, 0.12);
}

.char-inspect-tip {
    color: rgba(0, 229, 255, 0.4);
    font-size: 9.5px;
    text-align: center;
    -unity-font-style: italic;
    margin-top: 12px;
}

/* PORTRAIT GRAPHICS */
.atlas-img {
    background-image: url("project://database/Assets/PLuan/WaittingRoom/Textures/atlas.png");
}

.nyx-img {
    background-image: url("project://database/Assets/PLuan/WaittingRoom/Textures/nyx.png");
}

.aurelia-img {
    background-image: url("project://database/Assets/PLuan/WaittingRoom/Textures/aurelia.png");
}

.titan-img {
    background-image: url("project://database/Assets/PLuan/WaittingRoom/Textures/titan.png");
}

.skill-icon-img {
    background-image: url("project://database/Assets/PLuan/WaittingRoom/Textures/skill_icon.png");
}

/* CHARACTER DETAILS MODAL */
.details-modal {
    position: absolute;
    width: 100%;
    height: 100%;
    left: 0;
    top: 0;
    background-color: rgba(0, 3, 6, 0.9);
    justify-content: center;
    align-items: center;
    transition: opacity 0.3s ease-out;
}

.details-container {
    width: 540px;
    padding: 30px;
    border-left-width: 6px;
    border-left-color: rgb(0, 229, 255);
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.25);
    background-color: rgba(2, 16, 32, 0.85);
    /* Diagonal cut style matching panels */
    border-top-right-radius: 24px;
    border-bottom-left-radius: 24px;
    border-top-left-radius: 4px;
    border-bottom-right-radius: 4px;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8);
}

/* CLOSE BUTTON EXPANDED HITBOX SYSTEM */
.close-btn-hitbox {
    position: absolute;
    right: -10px;
    top: -10px;
    width: 76px;
    height: 76px;
    background-color: rgba(0, 0, 0, 0.01);
    border-width: 0;
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
}

.close-btn-visual {
    width: 38px;
    height: 38px;
    border-top-left-radius: 100%;
    border-top-right-radius: 0;
    border-bottom-right-radius: 100%;
    border-bottom-left-radius: 50%;
    border-width: 1px;
    border-color: rgba(0, 255, 128, 0.35);
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s ease-out, border-color 0.2s ease-out, scale 0.2s;
}

.close-btn-text {
    color: rgb(0, 229, 255);
    font-size: 16px;
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
    text-align: center;
    transition: color 0.2s ease-out;
}

/* Hover effects applied to visual child elements through the parent hitbox state */
.close-btn-hitbox:hover .close-btn-visual {
    background-color: rgb(255, 71, 87);
    border-color: rgb(255, 71, 87);
    scale: 1.1;
}

.close-btn-hitbox:hover .close-btn-text {
    color: white;
    text-shadow: 0 0 8px rgba(255, 255, 255, 0.8);
}

.details-header {
    flex-direction: row;
    margin-bottom: 20px;
}

.details-large-portrait {
    width: 96px;
    height: 96px;
    border-radius: 12px;
    border-width: 2.5px;
    border-color: rgb(0, 229, 255);
    background-size: cover;
    margin-right: 25px;
    box-shadow: 0 0 15px rgba(0, 229, 255, 0.3);
}

.details-char-name {
    color: white;
    font-size: 28px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    text-shadow: 0 0 15px rgba(255, 255, 255, 0.4);
}

.details-char-role {
    color: rgb(0, 229, 255);
    font-size: 13px;
    letter-spacing: 2.5px;
    -unity-font-style: bold;
    text-shadow: 0 0 8px rgba(0, 229, 255, 0.4);
}

.details-char-desc {
    color: rgb(180, 215, 235);
    font-size: 13.5px;
    line-height: 22px;
    margin-bottom: 25px;
    white-space: normal;
    -unity-text-wrap: true;
}

.details-section-title {
    color: rgb(0, 229, 255);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 229, 255, 0.15);
    padding-bottom: 4px;
}

.details-skills-container {
    flex-direction: column;
}

.details-skill-box {
    background-color: rgba(0, 229, 255, 0.05);
    border-radius: 6px;
    padding: 12px 18px;
    margin-bottom: 10px;
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.12);
    align-items: center;
    transition: all 0.25s ease-out;
}

.details-skill-box:hover {
    background-color: rgba(0, 229, 255, 0.1);
    border-color: rgba(0, 229, 255, 0.4);
    scale: 1.02;
    translate: 4px 0;
}

.details-skill-icon {
    width: 46px;
    height: 46px;
    border-radius: 6px;
    border-width: 1.5px;
    border-color: rgb(0, 229, 255);
    background-size: cover;
}

.details-skill-title {
    color: white;
    font-size: 14.5px;
    -unity-font-style: bold;
    margin-bottom: 2px;
    transition: color 0.2s;
}

.details-skill-box:hover .details-skill-title {
    color: rgb(0, 229, 255);
}

.details-skill-desc {
    color: rgb(145, 185, 205);
    font-size: 11px;
    line-height: 15px;
    white-space: normal;
    -unity-text-wrap: true;
}

/* WARNING TEXT */
.warning-text {
    color: rgb(255, 71, 87);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    margin-bottom: 12px;
    text-shadow: 0 0 10px rgba(255, 71, 87, 0.7);
    text-align: center;
}

/* BOTTOM AREA (FLOATING & TRANSPARENT) */
.waiting-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: transparent;
    padding: 15px 0;
    border-width: 0;
    margin-top: 15px;
    box-shadow: none;
}

.left-actions {
    flex-direction: row;
    align-items: center;
}

/* ACTION BUTTON SYSTEM */
.action-btn {
    height: 48px;
    padding: 0 32px;
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-right: 15px;
    border-radius: 6px;
    transition: all 0.25s cubic-bezier(0.25, 0.8, 0.25, 1);
    border-width: 1px;
    border-left-width: 4px;
    align-items: center;
    justify-content: center;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.8);
}

.ready-btn {
    background-color: rgba(0, 229, 255, 0.06);
    border-color: rgba(0, 229, 255, 0.25);
    border-left-color: rgb(0, 229, 255);
    color: rgb(0, 229, 255);
}

.ready-btn:hover {
    background-color: rgb(0, 229, 255);
    color: rgb(0, 6, 12);
    border-color: rgb(0, 229, 255);
    scale: 1.05;
    text-shadow: 0 0 10px rgba(0, 229, 255, 0.6);
}

.ready-active {
    background-color: rgba(46, 213, 115, 0.12);
    border-color: rgba(46, 213, 115, 0.35);
    border-left-color: rgb(46, 213, 115);
    color: rgb(46, 213, 115);
    text-shadow: 0 0 8px rgba(46, 213, 115, 0.4);
}

.ready-active:hover {
    background-color: rgb(46, 213, 115);
    color: rgb(0, 6, 12);
    border-color: rgb(46, 213, 115);
    scale: 1.05;
    text-shadow: 0 0 12px rgba(46, 213, 115, 0.8);
}

.leave-btn {
    background-color: rgba(255, 71, 87, 0.06);
    border-color: rgba(255, 71, 87, 0.25);
    border-left-color: rgb(255, 71, 87);
    color: rgb(255, 120, 120);
}

.leave-btn:hover {
    background-color: rgb(255, 71, 87);
    color: white;
    border-color: rgb(255, 71, 87);
    scale: 1.05;
    text-shadow: 0 0 10px rgba(255, 255, 255, 0.8);
}

/* TOGGLE CHARACTER PANEL BUTTON (NOW A STANDARD FOOTER ACTION) */
.toggle-char-panel-btn {
    background-color: rgba(0, 229, 255, 0.06);
    border-color: rgba(0, 229, 255, 0.25);
    border-left-color: rgb(0, 229, 255);
    color: rgb(0, 229, 255);
}

.toggle-char-panel-btn:hover {
    background-color: rgb(0, 229, 255);
    color: rgb(0, 6, 12);
    border-color: rgb(0, 229, 255);
    scale: 1.05;
    text-shadow: 0 0 10px rgba(0, 229, 255, 0.6);
}

.start-btn {
    background-color: rgba(255, 165, 0, 0.12);
    border-color: rgba(255, 165, 0, 0.35);
    border-left-color: rgb(255, 165, 0);
    color: rgb(255, 165, 0);
    text-shadow: 0 0 8px rgba(255, 165, 0, 0.4);
}

.start-btn:hover {
    background-color: rgb(255, 165, 0);
    color: rgb(10, 5, 0);
    border-color: rgb(255, 165, 0);
    scale: 1.05;
    text-shadow: 0 0 12px rgba(255, 165, 0, 0.8);
}

/* RIGHT SIDE STATUS (UNIFIED HEIGHT FOR SYMMETRY) */
.player-count-container {
    height: 48px;
    padding: 0 24px;
    background-color: rgba(2, 10, 22, 0.7);
    border-width: 1.5px;
    border-color: rgba(0, 229, 255, 0.25);
    border-radius: 6px;
    align-items: center;
    justify-content: center;
}

.status-text {
    color: rgb(0, 229, 255);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    text-shadow: 0 0 6px rgba(0, 229, 255, 0.4);
}

.start-game-center {
    position: absolute;
    left: 50%;
    translate: -50% 0;
    bottom: 18px;
    align-items: center;
}

.hidden-element {
    display: none;
}

.swap-status-active {
    color: rgb(255, 165, 0);
    text-shadow: 0 0 8px rgba(255, 165, 0, 0.8);
    border-color: rgba(255, 165, 0, 0.4);
    background-color: rgba(255, 165, 0, 0.12);
}
