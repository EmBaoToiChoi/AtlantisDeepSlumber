/* Atlantis Deep Slumber - Lobby UI Stylesheet */

.waiting-room-overlay {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    padding: 35px;
    background-color: transparent;
    justify-content: space-between;
}

/* GLASSMORPHISM & SCI-FI CORE */
.glass-panel {
    background-color: rgba(2, 16, 32, 0.65);
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.35);
    border-radius: 8px;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.4);
}

.glow-border {
    border-color: rgba(0, 229, 255, 0.45);
}

/* TOP INFO COMBINED WIDGET */
.top-info-panel {
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background-image: url("project://database/Assets/PLuan/WaittingRoom/Textures/ui_frame_bg.jpg");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: transparent;
    padding: 55px 48px 45px 48px;
    border-width: 0;
    border-radius: 0;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.45);
    width: 360px; /* Symmetrical vertical alignment with character selection panel */
}

.top-info-row {
    flex-direction: column;
    justify-content: center;
    align-items: center;
    align-self: stretch;
}

.top-bar-decor-row {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
    border-top-width: 1px;
    border-top-color: rgba(0, 229, 255, 0.15);
    padding-top: 6px;
    width: 100%;
}

.top-bar-decor-tag {
    color: rgba(0, 190, 255, 0.5);
    font-size: 8.5px;
    letter-spacing: 1.5px;
    -unity-font-style: bold;
}

.top-bar-decor-dot {
    color: rgb(0, 255, 128);
    font-size: 8px;
    margin: 0 6px;
    text-shadow: 0 0 6px rgb(0, 255, 128);
}

.active-dot {
    color: rgb(0, 255, 128);
}

/* TOP BAR CONTAINER */
.waiting-top-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 12px 0;
    background-color: transparent;
    border-width: 0;
    box-shadow: none;
}

.room-title {
    color: rgb(200, 245, 255);
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    text-shadow: 0 0 8px rgba(0, 229, 255, 0.4);
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

.room-id-badge {
    background-color: transparent !important;
    border-width: 0 !important;
    color: rgb(0, 255, 255);
    padding: 0 !important;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    text-shadow: 0 0 8px rgba(0, 255, 255, 0.6);
    transition: all 0.2s ease-out;
    flex-shrink: 0;
    margin-left: 0 !important;
    margin-top: 8px;
}

.room-id-badge:hover {
    scale: 1.05;
    background-color: transparent !important;
    border-color: transparent !important;
}

/* MIDDLE MAIN CONTAINER */
.waiting-middle-container {
    flex-direction: row;
    flex-grow: 1;
    margin-top: 20px;
    margin-bottom: 20px;
}

.waiting-viewport-spacer {
    flex-grow: 1;
}

/* CHARACTER SELECTION SIDEBAR */
.char-select-panel {
    width: 500px;
    padding: 60px 48px 50px 48px;
    justify-content: flex-start;
    background-image: url("project://database/Assets/PLuan/WaittingRoom/Textures/ui_frame_bg.jpg");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
}

.panel-hidden-state {
    opacity: 0;
    translate: 350px 0;
}

.panel-section-title {
    color: rgb(0, 229, 255);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 2px;
    text-shadow: 0 0 10px rgba(0, 229, 255, 0.5);
    text-align: center;
}

.panel-section-subtitle {
    color: rgba(130, 200, 255, 0.4);
    font-size: 9px;
    letter-spacing: 1.5px;
    -unity-font-style: bold;
    margin-bottom: 16px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 229, 255, 0.15);
    padding-bottom: 8px;
    text-align: center;
}

.char-cards-container {
    flex-grow: 1;
    position: relative; /* Crucial: sets absolute coordinate system for child cards */
}

/* CHARACTER CARDS */
.char-card {
    position: absolute;
    left: 0;
    right: 0;
    height: 80px; /* Fixed height for clean vertical alignment */
    align-items: center;
    background-color: transparent !important;
    border-width: 0 !important;
    border-radius: 0 !important;
    padding: 0 !important;
    margin: 0 !important;
    box-shadow: none !important;
    transition: all 0.25s cubic-bezier(0.25, 0.8, 0.25, 1);
}

/* Precise vertical coordinates centered exactly on background slot frames */
#char-card-0 {
    top: 15.4%;
}
#char-card-1 {
    top: 32.3%;
}
#char-card-2 {
    top: 49.6%;
}
#char-card-3 {
    top: 67.8%;
}

.char-card:hover {
    background-color: transparent !important;
    border-width: 0 !important;
    scale: 1.05; /* Uniform scale instead of translate to keep avatar aligned in circle */
}

.select-active {
    background-image: none !important; /* Remove legacy background gradient to match clean gold frame */
    border-width: 0 !important;
    box-shadow: none !important;
}

.card-locked {
    opacity: 0.45;
    background-color: transparent !important;
    border-width: 0 !important;
}

.card-locked:hover {
    background-color: transparent !important;
    border-width: 0 !important;
    scale: 1;
    box-shadow: none;
}

.char-card-portrait {
    position: absolute;
    left: 8px; /* Centers the 52px width portrait inside the 78px center circle */
    width: 52px;
    height: 52px;
    border-radius: 26px; /* Perfect round avatar matching the circular background slot frame */
    border-width: 0 !important;
    background-size: cover;
    transition: all 0.2s ease-out;
}

.char-card:hover .char-card-portrait,
.select-active .char-card-portrait {
    scale: 1.1;
}

/* Character text container for vertical Name & Role alignment */
.char-card-text-container {
    position: absolute;
    left: 95px; /* Center aligned within the name plaque bounds (x: 139px to 294px) */
    width: 140px;
    flex-direction: column;
    justify-content: center;
    align-items: center; /* Center text inside the container */
    margin: 0 !important;
    padding: 0 !important;
}

.char-card-name {
    color: rgb(180, 220, 240);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    margin-bottom: 2px;
    -unity-text-align: middle-center;
    transition: all 0.2s ease-out;
}

.char-card:hover .char-card-name {
    color: rgb(255, 255, 255);
    text-shadow: 0 0 8px rgba(0, 229, 255, 0.7);
}

.select-active .char-card-name {
    color: rgb(0, 255, 255) !important;
    text-shadow: 0 0 12px rgba(0, 229, 255, 0.95) !important;
}

.char-card-role {
    color: rgb(110, 160, 190);
    font-size: 9.5px;
    letter-spacing: 0.8px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition: all 0.2s ease-out;
}

.char-card:hover .char-card-role {
    color: rgb(160, 220, 255);
}

.select-active .char-card-role {
    color: rgb(130, 210, 255) !important;
}

.char-card-status {
    position: absolute;
    right: 15px; /* Positioned inside the right edge of the name plaque */
    font-size: 8px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.35);
    letter-spacing: 0.8px;
    background-color: rgba(0, 0, 0, 0.65); /* Dark background for better legibility */
    padding: 4px 8px;
    border-radius: 4px;
    border-width: 0 !important;
    transition: all 0.2s;
}

.active-status {
    color: rgb(0, 255, 128) !important;
    text-shadow: 0 0 8px rgba(0, 255, 128, 0.8) !important;
    background-color: rgba(0, 255, 128, 0.1) !important;
}

.char-inspect-tip {
    color: rgba(0, 229, 255, 0.4);
    font-size: 9.5px;
    text-align: center;
    -unity-font-style: italic;
    margin-top: 12px;
}

/* PORTRAIT GRAPHICS */
.leo-img {
    background-image: url("project://database/Assets/Hbao/Image/AvaST.png");
}

.maya-img {
    background-image: url("project://database/Assets/Hbao/Image/AvaHT.png");
}

.elena-img {
    background-image: url("project://database/Assets/Hbao/Image/AvaCung.png");
}

.arthur-img {
    background-image: url("project://database/Assets/Hbao/Image/AvaTank.png");
}

/* LEO SKILLS */
.leo-skill-0 {
    background-image: url("project://database/Assets/Hbao/Image/Skill%201,.png");
}
.leo-skill-1 {
    background-image: url("project://database/Assets/Hbao/Image/Skill%202.png");
}
.leo-skill-2 {
    background-image: url("project://database/Assets/Hbao/Image/ST-Skill3.png");
}

/* MAYA SKILLS */
.maya-skill-0 {
    background-image: url("project://database/Assets/Hbao/Image/HT Skill 3.png");
}
.maya-skill-1 {
    background-image: url("project://database/Assets/Hbao/Image/HT%20skill2.png");
}
.maya-skill-2 {
    background-image: url("project://database/Assets/Hbao/Image/HT_skill1.png");
}

/* ELENA SKILLS */
.elena-skill-0 {
    background-image: url("project://database/Assets/Hbao/Image/CT-Skill1.png");
    background-size: 155% 155%;
    background-position: center;
}
.elena-skill-1 {
    background-image: url("project://database/Assets/Hbao/Image/CT-skill2.png");
}
.elena-skill-2 {
    background-image: url("project://database/Assets/Hbao/Image/CT-Skill3.png");
}

/* ARTHUR SKILLS */
.arthur-skill-0 {
    background-image: url("project://database/Assets/Hbao/Image/tanker-skill1.png");
}
.arthur-skill-1 {
    background-image: url("project://database/Assets/Hbao/Image/tanker-skill2.png");
}
.arthur-skill-2 {
    background-image: url("project://database/Assets/Hbao/Image/HT-Skill3.png");
}

/* CHARACTER DETAILS MODAL */
.details-modal {
    position: absolute;
    width: 100%;
    height: 100%;
    left: 0;
    top: 0;
    background-color: rgba(0, 3, 6, 0.9);
    justify-content: center;
    align-items: center;
    transition: opacity 0.3s ease-out;
}

.details-container {
    width: 560px;
    padding: 65px 55px 55px 55px;
    background-image: url("project://database/Assets/PLuan/WaittingRoom/Textures/ui_frame_bg.jpg");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8);
}

/* CLOSE BUTTON EXPANDED HITBOX SYSTEM */
.close-btn-hitbox {
    position: absolute;
    right: -10px;
    top: -10px;
    width: 76px;
    height: 76px;
    background-color: rgba(0, 0, 0, 0.01);
    border-width: 0;
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
}

.close-btn-visual {
    width: 38px;
    height: 38px;
    border-top-left-radius: 100%;
    border-top-right-radius: 0;
    border-bottom-right-radius: 100%;
    border-bottom-left-radius: 50%;
    border-width: 1px;
    border-color: rgba(0, 255, 128, 0.35);
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s ease-out, border-color 0.2s ease-out, scale 0.2s;
}

.close-btn-text {
    color: rgb(0, 229, 255);
    font-size: 16px;
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
    text-align: center;
    transition: color 0.2s ease-out;
}

/* Hover effects applied to visual child elements through the parent hitbox state */
.close-btn-hitbox:hover .close-btn-visual {
    background-color: rgb(255, 71, 87);
    border-color: rgb(255, 71, 87);
    scale: 1.1;
}

.close-btn-hitbox:hover .close-btn-text {
    color: white;
    text-shadow: 0 0 8px rgba(255, 255, 255, 0.8);
}

.details-header {
    flex-direction: row;
    margin-bottom: 20px;
}

.details-large-portrait {
    width: 96px;
    height: 96px;
    border-radius: 12px;
    border-width: 2.5px;
    border-color: rgb(0, 229, 255);
    background-size: cover;
    margin-right: 25px;
    box-shadow: 0 0 15px rgba(0, 229, 255, 0.3);
}

.details-char-name {
    color: white;
    font-size: 28px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    text-shadow: 0 0 15px rgba(255, 255, 255, 0.4);
}

.details-char-role {
    color: rgb(0, 229, 255);
    font-size: 13px;
    letter-spacing: 2.5px;
    -unity-font-style: bold;
    text-shadow: 0 0 8px rgba(0, 229, 255, 0.4);
}

.details-char-desc {
    color: rgb(180, 215, 235);
    font-size: 13.5px;
    line-height: 22px;
    margin-bottom: 25px;
    white-space: normal;
    -unity-text-wrap: true;
}

.details-section-title {
    color: rgb(0, 229, 255);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 229, 255, 0.15);
    padding-bottom: 4px;
}

.details-skills-container {
    flex-direction: column;
}

.details-skill-box {
    background-color: rgba(0, 229, 255, 0.05);
    border-radius: 6px;
    padding: 12px 18px;
    margin-bottom: 10px;
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.12);
    align-items: center;
    transition: all 0.25s ease-out;
}

.details-skill-box:hover {
    background-color: rgba(0, 229, 255, 0.1);
    border-color: rgba(0, 229, 255, 0.4);
    scale: 1.02;
    translate: 4px 0;
}

.details-skill-icon {
    width: 46px;
    height: 46px;
    border-radius: 6px;
    border-width: 1.5px;
    border-color: rgb(0, 229, 255);
    background-size: cover;
}

.details-skill-title {
    color: white;
    font-size: 14.5px;
    -unity-font-style: bold;
    margin-bottom: 2px;
    transition: color 0.2s;
}

.details-skill-box:hover .details-skill-title {
    color: rgb(0, 229, 255);
}

.details-skill-desc {
    color: rgb(145, 185, 205);
    font-size: 11px;
    line-height: 15px;
    white-space: normal;
    -unity-text-wrap: true;
}

/* WARNING TEXT */
.warning-text {
    color: rgb(255, 71, 87);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    margin-bottom: 12px;
    text-shadow: 0 0 10px rgba(255, 71, 87, 0.7);
    text-align: center;
}

/* BOTTOM AREA (FLOATING & TRANSPARENT) */
.waiting-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: transparent;
    padding: 15px 0;
    border-width: 0;
    margin-top: 15px;
    box-shadow: none;
}

.left-actions {
    flex-direction: row;
    align-items: center;
}

/* ACTION BUTTON SYSTEM */
.action-btn {
    height: 48px;
    padding: 0 20px !important;
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-right: 15px;
    border-radius: 0 !important;
    transition: all 0.2s ease-out;
    border-width: 0 !important;
    background-color: transparent !important;
    align-items: center;
    justify-content: center;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.8);
}

.ready-btn {
    color: rgb(0, 229, 255) !important;
}

.ready-btn:hover {
    background-color: transparent !important;
    color: rgb(255, 255, 255) !important;
    scale: 1.08 1.08;
    text-shadow: 0 0 12px rgba(0, 229, 255, 0.9) !important;
}

.ready-active {
    color: rgb(46, 213, 115) !important;
    text-shadow: 0 0 8px rgba(46, 213, 115, 0.6) !important;
}

.ready-active:hover {
    background-color: transparent !important;
    color: rgb(255, 255, 255) !important;
    scale: 1.08 1.08;
    text-shadow: 0 0 15px rgba(46, 213, 115, 0.95) !important;
}

.leave-btn {
    color: rgb(255, 100, 100) !important;
}

.leave-btn:hover {
    background-color: transparent !important;
    color: rgb(255, 180, 180) !important;
    scale: 1.08 1.08;
    text-shadow: 0 0 12px rgba(255, 50, 50, 0.9) !important;
}

/* TOGGLE CHARACTER PANEL BUTTON (NOW A STANDARD FOOTER ACTION) */
.toggle-char-panel-btn {
    color: rgb(0, 229, 255) !important;
}

.toggle-char-panel-btn:hover {
    background-color: transparent !important;
    color: rgb(255, 255, 255) !important;
    scale: 1.08 1.08;
    text-shadow: 0 0 12px rgba(0, 229, 255, 0.9) !important;
}

.start-btn {
    color: rgb(255, 165, 0) !important;
}

.start-btn:hover {
    background-color: transparent !important;
    color: rgb(255, 210, 150) !important;
    scale: 1.08 1.08;
    text-shadow: 0 0 15px rgba(255, 165, 0, 0.95) !important;
}

#btn-swap-character {
    color: rgb(255, 165, 0) !important;
}
#btn-swap-character:hover {
    background-color: transparent !important;
    color: rgb(255, 210, 150) !important;
    scale: 1.08 1.08;
    text-shadow: 0 0 15px rgba(255, 165, 0, 0.95) !important;
}

/* RIGHT SIDE STATUS (UNIFIED HEIGHT FOR SYMMETRY) */
.player-count-container {
    height: 48px;
    padding: 0 24px;
    background-color: rgba(2, 10, 22, 0.7);
    border-width: 1.5px;
    border-color: rgba(0, 229, 255, 0.25);
    border-radius: 6px;
    align-items: center;
    justify-content: center;
}

.status-text {
    color: rgb(0, 229, 255);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    text-shadow: 0 0 6px rgba(0, 229, 255, 0.4);
}

.start-game-center {
    position: absolute;
    left: 50%;
    translate: -50% 0;
    bottom: 18px;
    align-items: center;
}

.hidden-element {
    display: none;
}

.swap-status-active {
    color: rgb(255, 165, 0);
    text-shadow: 0 0 8px rgba(255, 165, 0, 0.8);
    border-color: rgba(255, 165, 0, 0.4);
    background-color: rgba(255, 165, 0, 0.12);
}
