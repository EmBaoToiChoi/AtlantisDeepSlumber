/* Atlantis Deep Slumber - Lobby UI Stylesheet */

.waiting-room-overlay {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    padding: 24px 35px 20px 35px;
    background-color: transparent;
    justify-content: space-between;
}

/* GLASSMORPHISM & SCI-FI CORE */
.glass-panel {
    background-color: rgba(2, 16, 32, 0.65);
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.35);
    border-radius: 8px;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.4);
}

.glow-border {
    border-color: rgba(0, 229, 255, 0.45);
}

/* TOP INFO COMBINED WIDGET */
.top-info-panel {
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background-image: url("project://database/Assets/PLuan/WaittingRoom/Textures/ui_frame_bg.jpg");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: transparent;
    padding: 24px 60px 36px 60px;
    border-width: 0;
    border-radius: 0;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.45);
    width: 460px;
    max-width: 90%;
    height: 130px;
    flex-shrink: 1;
}

.top-info-row {
    flex-direction: column;
    justify-content: center;
    align-items: center;
    align-self: stretch;
}

.top-bar-decor-row {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
    border-top-width: 1px;
    border-top-color: rgba(0, 229, 255, 0.15);
    padding-top: 6px;
    width: 100%;
}

.top-bar-decor-tag {
    color: rgba(0, 190, 255, 0.5);
    font-size: 8.5px;
    letter-spacing: 1.5px;
    -unity-font-style: bold;
}

.top-bar-decor-dot {
    color: rgb(0, 255, 128);
    font-size: 8px;
    margin: 0 6px;
    text-shadow: 0 0 6px rgb(0, 255, 128);
}

.active-dot {
    color: rgb(0, 255, 128);
}

/* TOP BAR CONTAINER */
.waiting-top-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 12px 0;
    background-color: transparent;
    border-width: 0;
    box-shadow: none;
}

.room-title {
    color: rgb(200, 245, 255);
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    text-shadow: 0 0 8px rgba(0, 229, 255, 0.4);
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-center;
}

.room-id-badge {
    background-color: transparent !important;
    border-width: 0 !important;
    color: rgb(0, 255, 255);
    padding: 0 !important;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    text-shadow: 0 0 8px rgba(0, 255, 255, 0.6);
    transition: all 0.2s ease-out;
    flex-shrink: 0;
    margin-left: 0 !important;
    margin-top: 8px;
    -unity-text-align: middle-center;
}

.room-id-badge:hover {
    scale: 1.05;
    background-color: transparent !important;
    border-color: transparent !important;
}

/* MIDDLE MAIN CONTAINER */
.waiting-middle-container {
    flex-direction: row;
    flex-grow: 1;
    align-items: center;
    margin-top: 10px;
    margin-bottom: 10px;
}

.waiting-viewport-spacer {
    flex-grow: 1;
}

/* CHARACTER SELECTION SIDEBAR */
.char-select-panel {
    width: 460px;
    height: 580px;
    max-height: 85%;
    padding: 50px 35px 30px 35px;
    justify-content: flex-start;
    background-image: url("project://database/Assets/PLuan/chọn player.png");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    flex-shrink: 1;
}

.panel-hidden-state {
    opacity: 0;
    translate: 350px 0;
}

.panel-section-title {
    color: rgb(0, 229, 255);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 2px;
    text-shadow: 0 0 10px rgba(0, 229, 255, 0.5);
    text-align: center;
}

.panel-section-subtitle {
    color: rgba(130, 200, 255, 0.4);
    font-size: 9px;
    letter-spacing: 1.5px;
    -unity-font-style: bold;
    margin-bottom: 16px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 229, 255, 0.15);
    padding-bottom: 8px;
    text-align: center;
}

.char-cards-container {
    flex-grow: 1;
    position: relative; /* Crucial: sets absolute coordinate system for child cards */
}

/* CHARACTER CARDS */
.char-card {
    position: absolute;
    left: 0;
    right: 0px;
    height: 72px; /* Fixed height for clean vertical alignment */
    align-items: center;
    background-color: transparent !important;
    border-width: 0 !important;
    border-radius: 0 !important;
    padding: 0 !important;
    margin: 0 !important;
    box-shadow: none !important;
    transition: all 0.25s cubic-bezier(0.25, 0.8, 0.25, 1);
}

/* Precise vertical coordinates centered exactly on background slot frames */
#char-card-0 {
    top: 11.0%;
}
#char-card-1 {
    top: 33.5%;
}
#char-card-2 {
    top: 56.0%;
}
#char-card-3 {
    top: 78.5%;
}

.char-card:hover {
    background-color: transparent !important;
    border-width: 0 !important;
    scale: 1.05; /* Uniform scale instead of translate to keep avatar aligned in circle */
}

.select-active {
    background-image: none !important; /* Remove legacy background gradient to match clean gold frame */
    border-width: 0 !important;
    box-shadow: none !important;
}

.card-locked {
    opacity: 0.45;
    background-color: transparent !important;
    border-width: 0 !important;
}

.card-locked:hover {
    background-color: transparent !important;
    border-width: 0 !important;
    scale: 1;
    box-shadow: none;
}

.char-card-portrait {
    position: absolute;
    left: 72px; /* Centered precisely inside the gold circle frame */
    top: 12px; /* Centered precisely inside the gold circle frame */
    width: 48px;
    height: 48px;
    border-radius: 24px; /* Perfect round avatar matching the circular background slot frame */
    border-width: 0 !important;
    background-size: cover;
    transition: all 0.2s ease-out;
}

.char-card:hover .char-card-portrait,
.select-active .char-card-portrait {
    scale: 1.1;
}

/* Character text container for vertical Name & Role alignment */
.char-card-text-container {
    position: absolute;
    left: 110px; /* Perfectly centered within the name plaque bounds */
    width: 210px; /* Spans the full width of the gold plaque */
    top: 0;
    bottom: 0;
    flex-direction: column;
    justify-content: center;
    align-items: center; /* Center text inside the container */
    margin: 0 !important;
    padding: 0 !important;
}

.char-card-name {
    color: #EAF7FF;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.8);
    text-shadow: 0px 0px 4px rgba(0, 0, 0, 0.8);
    letter-spacing: 1.2px;
    margin-top: 4px;
    margin-bottom: 2px;
    -unity-text-align: middle-center;
    transition: all 0.2s ease-out;
}

.char-card:hover .char-card-name {
    color: #FFFFFF;
    text-shadow: 0 0 8px rgba(0, 229, 255, 0.7);
}

.select-active .char-card-name {
    color: #00FF88 !important; /* Glowing neon green highlight when selected */
    text-shadow: 0px 0px 10px rgba(0, 255, 136, 0.85) !important;
    -unity-text-outline-color: rgba(0, 50, 20, 0.9) !important;
}

.char-card-role {
    color: #79C9FF;
    font-size: 9.5px;
    -unity-font-style: bold;
    text-shadow: 0px 0px 3px rgba(0, 0, 0, 1);
    letter-spacing: 0.8px;
    margin-top: -3px; /* Reduced vertical gap to make them closer */
    -unity-text-align: middle-center;
    transition: all 0.2s ease-out;
}

.char-card:hover .char-card-role {
    color: #A3DCFF;
}

.select-active .char-card-role {
    color: #EAF7FF !important; /* Highlight class name as well */
    text-shadow: 0px 0px 6px rgba(0, 255, 136, 0.3) !important;
}

.char-card-status {
    display: none !important; /* Discard YOU and FREE text labels entirely */
}

.active-status {
    display: none !important;
}

.char-inspect-tip {
    color: rgba(0, 229, 255, 0.45);
    font-size: 9px;
    -unity-font-style: italic;
    -unity-text-align: middle-center;
    position: absolute;
    bottom: 10px;
    left: 0;
    right: 0;
    margin: 0;
    padding: 0;
}

/* PORTRAIT GRAPHICS */
.leo-img {
    background-image: url("project://database/Assets/Hbao/Image/AvaST.png");
}

.maya-img {
    background-image: url("project://database/Assets/Hbao/Image/AvaHT.png");
}

.elena-img {
    background-image: url("project://database/Assets/Hbao/Image/AvaCung.png");
}

.arthur-img {
    background-image: url("project://database/Assets/Hbao/Image/AvaTank.png");
}

/* LEO SKILLS */
.leo-skill-0 {
    background-image: url("project://database/Assets/Hbao/Image/Skill%201,.png");
}
.leo-skill-1 {
    background-image: url("project://database/Assets/Hbao/Image/Skill%202.png");
}
.leo-skill-2 {
    background-image: url("project://database/Assets/Hbao/Image/ST-Skill3.png");
}

/* MAYA SKILLS */
.maya-skill-0 {
    background-image: url("project://database/Assets/Hbao/Image/HT Skill 3.png");
}
.maya-skill-1 {
    background-image: url("project://database/Assets/Hbao/Image/HT%20skill2.png");
}
.maya-skill-2 {
    background-image: url("project://database/Assets/Hbao/Image/HT_skill1.png");
}

/* ELENA SKILLS */
.elena-skill-0 {
    background-image: url("project://database/Assets/Hbao/Image/CT-Skill1.png");
    background-size: 155% 155%;
    background-position: center;
}
.elena-skill-1 {
    background-image: url("project://database/Assets/Hbao/Image/CT-skill2.png");
}
.elena-skill-2 {
    background-image: url("project://database/Assets/Hbao/Image/CT-Skill3.png");
}

/* ARTHUR SKILLS */
.arthur-skill-0 {
    background-image: url("project://database/Assets/Hbao/Image/tanker-skill1.png");
}
.arthur-skill-1 {
    background-image: url("project://database/Assets/Hbao/Image/tanker-skill2.png");
}
.arthur-skill-2 {
    background-image: url("project://database/Assets/Hbao/Image/HT-Skill3.png");
}

/* CHARACTER DETAILS MODAL */
.details-modal {
    position: absolute;
    width: 100%;
    height: 100%;
    left: 0;
    top: 0;
    background-color: rgba(0, 3, 6, 0.9);
    justify-content: center;
    align-items: center;
    transition: opacity 0.3s ease-out;
}

.swap-modal-container {
    background-image: url("project://database/Assets/PLuan/WaittingRoom/Textures/ui_frame_bg.jpg");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: transparent;
    border-width: 1.5px;
    border-radius: 8px;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8);
}

.details-container {
    width: 600px;
    height: 900px;
    max-width: 92%;
    max-height: 90%;
    position: relative;
    background-image: url("project://database/Assets/PLuan/IMG chi tiết player.png");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.85);
    padding: 0;
    flex-shrink: 1;
}

.details-container .panel-seaweed-top-right,
.details-container .panel-seaweed-bottom-left {
    display: none !important;
}

/* CLOSE BUTTON TEXT AT BOTTOM */
.details-close-btn {
    position: absolute;
    left: 49%;
    translate: -50% 0;
    bottom: 0px;
    height: 40px;
    width: 180px;
    background-color: transparent !important;
    border-width: 0 !important;
    color: #FF5A70;
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    text-shadow: 0px 0px 6px rgba(255, 90, 112, 0.55);
    transition: color 0.2s, scale 0.2s, text-shadow 0.2s;
}

.details-close-btn:hover {
    color: #FF2E4C;
    scale: 1.08;
    text-shadow: 0px 0px 14px rgba(255, 46, 76, 0.95);
}

.details-header {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

.details-large-portrait {
    position: absolute;
    left: 215px;
    top: 252px;
    width: 170px;
    height: 170px;
    border-radius: 100px;
    border-width: 0;
    background-size: cover;
    box-shadow: none;
}

.details-title-container {
    position: absolute;
    left: 176px;
    width: 248px;
    top: 150px;
    height: 48px;
    justify-content: center;
    align-items: center;
}

.details-char-name {
    color: #EAF7FF;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.85);
    text-shadow: 0px 0px 4px rgba(0, 0, 0, 0.8);
    letter-spacing: 2px;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

.details-char-role {
    color: #79C9FF;
    font-size: 10px;
    -unity-font-style: bold;
    text-shadow: 0px 0px 3px rgba(0, 0, 0, 1);
    letter-spacing: 1.2px;
    margin-top: -2px;
    padding: 0;
    -unity-text-align: middle-center;
}

.details-char-desc {
    display: none;
}

.details-section-title {
    display: none;
}

.details-skills-container {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

.details-skill-box {
    position: absolute;
    left: 160px;
    width: 344px;
    height: 65px;
    background-color: transparent !important;
    border-width: 0 !important;
    padding: 0 !important;
    margin: 0 !important;
}

.details-skill-box:hover {
    scale: 1.03;
}

#details-skill-box-0 {
    top: 518px;
}

#details-skill-box-1 {
    top: 608px;
}

#details-skill-box-2 {
    top: 698px;
}

.details-skill-icon {
    position: absolute;
    left: 6px;
    top: -20px;
    width: 56px;
    height: 56px;
    border-radius: 28px;
    border-width: 0 !important;
    background-size: cover;
}

.details-skill-text-container {
    position: absolute;
    left: 90px;
    width: 190px;
    top: -50px;
    bottom: 0;
    justify-content: center;
    margin: 0 !important;
    padding: 0 !important;
}

.details-skill-title {
    color: white;
    font-size: 12px;
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
    transition: color 0.2s;
}

.details-skill-box:hover .details-skill-title {
    color: #79C9FF;
}

.details-skill-desc {
    color: rgb(145, 185, 205);
    font-size: 9px;
    line-height: 12px;
    margin-top: 1px;
    padding: 0;
    white-space: normal;
    -unity-text-wrap: true;
}

/* WARNING TEXT */
.warning-text {
    color: rgb(255, 71, 87);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    margin-bottom: 12px;
    text-shadow: 0 0 10px rgba(255, 71, 87, 0.7);
    text-align: center;
}

/* BOTTOM AREA (FLOATING & TRANSPARENT) */
.waiting-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    background-color: transparent;
    padding: 10px 0;
    border-width: 0;
    margin-top: 10px;
    box-shadow: none;
    flex-shrink: 0;
}

.left-actions {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

/* ACTION BUTTON SYSTEM */
.action-btn {
    height: 44px;
    padding: 0 14px !important;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    margin-right: 10px;
    border-radius: 0 !important;
    transition: all 0.2s ease-out;
    border-width: 0 !important;
    background-color: transparent !important;
    align-items: center;
    justify-content: center;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.8);
}

.ready-btn {
    color: rgb(0, 229, 255) !important;
}

.ready-btn:hover {
    background-color: transparent !important;
    color: rgb(255, 255, 255) !important;
    scale: 1.08 1.08;
    text-shadow: 0 0 12px rgba(0, 229, 255, 0.9) !important;
}

.ready-active {
    color: rgb(46, 213, 115) !important;
    text-shadow: 0 0 8px rgba(46, 213, 115, 0.6) !important;
}

.ready-active:hover {
    background-color: transparent !important;
    color: rgb(255, 255, 255) !important;
    scale: 1.08 1.08;
    text-shadow: 0 0 15px rgba(46, 213, 115, 0.95) !important;
}

.leave-btn {
    color: rgb(255, 100, 100) !important;
}

.leave-btn:hover {
    background-color: transparent !important;
    color: rgb(255, 180, 180) !important;
    scale: 1.08 1.08;
    text-shadow: 0 0 12px rgba(255, 50, 50, 0.9) !important;
}

/* TOGGLE CHARACTER PANEL BUTTON (NOW A STANDARD FOOTER ACTION) */
.toggle-char-panel-btn {
    color: rgb(0, 229, 255) !important;
}

.toggle-char-panel-btn:hover {
    background-color: transparent !important;
    color: rgb(255, 255, 255) !important;
    scale: 1.08 1.08;
    text-shadow: 0 0 12px rgba(0, 229, 255, 0.9) !important;
}

.start-btn {
    color: rgb(255, 165, 0) !important;
}

.start-btn:hover {
    background-color: transparent !important;
    color: rgb(255, 210, 150) !important;
    scale: 1.08 1.08;
    text-shadow: 0 0 15px rgba(255, 165, 0, 0.95) !important;
}

#btn-swap-character {
    color: rgb(255, 165, 0) !important;
}
#btn-swap-character:hover {
    background-color: transparent !important;
    color: rgb(255, 210, 150) !important;
    scale: 1.08 1.08;
    text-shadow: 0 0 15px rgba(255, 165, 0, 0.95) !important;
}

/* RIGHT SIDE STATUS (UNIFIED HEIGHT FOR SYMMETRY) */
.player-count-container {
    height: 40px;
    padding: 0 14px;
    margin-right: 5px;
    background-color: rgba(2, 10, 22, 0.7);
    border-width: 1.5px;
    border-color: rgba(0, 229, 255, 0.25);
    border-radius: 6px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.status-text {
    color: rgb(0, 229, 255);
    font-size: 12.5px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    text-shadow: 0 0 6px rgba(0, 229, 255, 0.4);
    white-space: nowrap;
}

.start-game-center {
    position: relative;
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    margin: 0 10px;
}

.hidden-element {
    display: none;
}

.swap-status-active {
    color: rgb(255, 165, 0);
    text-shadow: 0 0 8px rgba(255, 165, 0, 0.8);
    border-color: rgba(255, 165, 0, 0.4);
    background-color: rgba(255, 165, 0, 0.12);
}
