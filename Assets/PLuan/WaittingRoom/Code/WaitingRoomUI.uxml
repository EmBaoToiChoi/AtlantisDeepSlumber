<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/PLuan/WaittingRoom/Code/WaitingRoomUI.uss?fileID=7433441132597879392&amp;guid=5a146fb1d82ca174dbcb8a9d485228fd&amp;type=3#WaitingRoomUI" />
    <ui:VisualElement name="waiting-room-root" class="waiting-room-overlay" style="-unity-font-definition: url(&quot;project://database/Assets/PLuan/MainMenu/Font/Philosopher-Vietnamese.ttf?fileID=12800000&amp;guid=8a2ed09dfc3a8024fa0bb345576c06bd&amp;type=3#Philosopher-Vietnamese&quot;);">
        <ui:VisualElement class="waiting-top-bar">
            <ui:VisualElement class="waiting-viewport-spacer" />
            <ui:VisualElement class="top-info-panel">
                <ui:VisualElement class="section-break-bar section-break-top">
                    <ui:VisualElement class="section-break-top-left" />
                    <ui:VisualElement class="section-break-top-right" />
                </ui:VisualElement>
                <ui:Label name="lbl-room-hint" text="THÔNG TIN PHÒNG:" class="user-profile-label" />
                <ui:Label name="lbl-room-name" text="SẢNH CHỜ KHÁM PHÁ" class="user-profile-name" />
                <ui:VisualElement class="room-meta-row">
                    <ui:Label name="lbl-room-id" text="ID: #XXXXXX" class="room-id-badge" />
                    <ui:Label name="lbl-room-separator" text="•" class="room-meta-separator" />
                    <ui:Label name="lbl-player-count" text="NGƯỜI CHƠI: 1/4" class="player-count-badge" />
                </ui:VisualElement>
                <ui:VisualElement class="section-break-bar section-break-bottom">
                    <ui:VisualElement class="section-break-bottom-left" />
                    <ui:VisualElement class="section-break-bottom-right" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="waiting-middle-container">
            <ui:VisualElement class="waiting-viewport-spacer" />
            <ui:VisualElement name="char-select-panel" class="char-select-panel">
                <ui:VisualElement class="char-panel-bg-layer" />
                <ui:VisualElement class="char-panel-frame-layer" />
                <ui:VisualElement class="char-panel-header">
                    <ui:Label text="CHỌN NHÂN VẬT" class="char-panel-title" />
                    <ui:VisualElement class="char-panel-divider" />
                </ui:VisualElement>
                <ui:VisualElement class="char-cards-container">
                    <ui:VisualElement name="char-card-0" class="char-card select-active">
                        <ui:VisualElement class="char-avatar-slot">
                            <ui:VisualElement name="char-img-0" class="char-card-portrait leo-img" />
                            <ui:VisualElement class="char-avatar-frame" />
                        </ui:VisualElement>
                        <ui:VisualElement class="char-card-text-container">
                            <ui:Label text="LEO" class="char-card-name" />
                            <ui:Label text="SÁT THỦ BÓNG ĐÊM" class="char-card-role" />
                        </ui:VisualElement>
                        <ui:Label name="char-status-0" text="BẠN" class="char-card-status active-status" />
                    </ui:VisualElement>
                    <ui:VisualElement name="char-card-1" class="char-card">
                        <ui:VisualElement class="char-avatar-slot">
                            <ui:VisualElement name="char-img-1" class="char-card-portrait maya-img" />
                            <ui:VisualElement class="char-avatar-frame" />
                        </ui:VisualElement>
                        <ui:VisualElement class="char-card-text-container">
                            <ui:Label text="MAYA" class="char-card-name" />
                            <ui:Label text="PHÁP SƯ LỬA" class="char-card-role" />
                        </ui:VisualElement>
                        <ui:Label name="char-status-1" text="TRỐNG" class="char-card-status" />
                    </ui:VisualElement>
                    <ui:VisualElement name="char-card-2" class="char-card">
                        <ui:VisualElement class="char-avatar-slot">
                            <ui:VisualElement name="char-img-2" class="char-card-portrait elena-img" />
                            <ui:VisualElement class="char-avatar-frame" />
                        </ui:VisualElement>
                        <ui:VisualElement class="char-card-text-container">
                            <ui:Label text="ELENA" class="char-card-name" />
                            <ui:Label text="CUNG THỦ TINH LINH" class="char-card-role" />
                        </ui:VisualElement>
                        <ui:Label name="char-status-2" text="TRỐNG" class="char-card-status" />
                    </ui:VisualElement>
                    <ui:VisualElement name="char-card-3" class="char-card">
                        <ui:VisualElement class="char-avatar-slot">
                            <ui:VisualElement name="char-img-3" class="char-card-portrait arthur-img" />
                            <ui:VisualElement class="char-avatar-frame" />
                        </ui:VisualElement>
                        <ui:VisualElement class="char-card-text-container">
                            <ui:Label text="ARTHUR" class="char-card-name" />
                            <ui:Label text="ĐẤU SĨ HOÀNG GIA" class="char-card-role" />
                        </ui:VisualElement>
                        <ui:Label name="char-status-3" text="TRỐNG" class="char-card-status" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label text="Giữ SHIFT + Chuột Trái để Xem Chi Tiết" class="char-inspect-tip" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="waiting-footer">
            <ui:VisualElement class="left-actions">
                <ui:Button name="btn-ready" text="SẴN SÀNG" class="action-btn ready-btn" />
                <ui:Button name="btn-leave" text="RỜI PHÒNG" class="action-btn leave-btn" />
            </ui:VisualElement>
            <ui:VisualElement class="start-game-center">
                <ui:Label name="lbl-warning" text="PHÁT HIỆN TRÙNG NHÂN VẬT!" class="warning-text hidden-element" />
                <ui:Button name="btn-start" text="BẮT ĐẦU THÁM HIỂM" class="action-btn start-btn hidden-element" />
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: row; align-items: center; margin-right: 10px;">
                <ui:Button name="btn-swap-character" text="ĐỔI NHÂN VẬT" class="action-btn ready-btn hidden-element" />
                <ui:Button name="btn-players-voice" text="MIC NGƯỜI CHƠI" class="action-btn toggle-char-panel-btn ready-btn" />
                <ui:Button name="btn-toggle-char-panel" text="CHỌN NHÂN VẬT" class="action-btn toggle-char-panel-btn ready-btn" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="char-details-modal" class="details-modal hidden-element">
            <ui:VisualElement class="details-container">
                <!-- Top Ornate Flourish Crest -->
                <ui:VisualElement class="details-top-crest" />

                <!-- HEADER: CENTERED PORTRAIT & TITLE -->
                <ui:VisualElement class="details-header">
                    <ui:VisualElement class="details-avatar-slot">
                        <ui:VisualElement name="details-portrait" class="details-large-portrait leo-img" />
                        <ui:VisualElement class="details-avatar-frame" />
                    </ui:VisualElement>
                    <ui:VisualElement class="details-title-container">
                        <ui:Label name="details-name" text="LEO" class="details-char-name" />
                        <ui:Label name="details-role" text="SÁT THỦ BÓNG ĐÊM" class="details-char-role" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="details-divider" />

                <!-- DESCRIPTION -->
                <ui:Label name="details-desc" text="Bậc thầy bóng tối và ám sát, Leo có thể hạ gục các mục tiêu quan trọng trước khi chúng kịp nhận ra sự hiện diện của anh." class="details-char-desc" />

                <ui:Label text="KỸ NĂNG ĐẶC BIỆT" class="details-section-title" />

                <!-- SKILLS CONTAINER (3 boxes) -->
                <ui:VisualElement name="skills-container" class="details-skills-container">
                    <ui:VisualElement name="details-skill-box-0" class="details-skill-box">
                        <ui:VisualElement class="details-skill-avatar-slot">
                            <ui:VisualElement name="details-skill-img-0" class="details-skill-icon skill-icon-img" />
                            <ui:VisualElement class="details-skill-avatar-frame" />
                        </ui:VisualElement>
                        <ui:VisualElement class="details-skill-text-container">
                            <ui:Label name="details-skill-name-0" text="Lướt Nhanh" class="details-skill-title" />
                            <ui:Label name="details-skill-desc-0" text="Lướt về phía trước một khoảng ngắn, miễn nhiễm với sát thương áp suất trong 3 giây." class="details-skill-desc" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="details-skill-box-1" class="details-skill-box">
                        <ui:VisualElement class="details-skill-avatar-slot">
                            <ui:VisualElement name="details-skill-img-1" class="details-skill-icon skill-icon-img" />
                            <ui:VisualElement class="details-skill-avatar-frame" />
                        </ui:VisualElement>
                        <ui:VisualElement class="details-skill-text-container">
                            <ui:Label name="details-skill-name-1" text="Quét Sóng Âm" class="details-skill-title" />
                            <ui:Label name="details-skill-desc-1" text="Phát ra xung sóng âm tần số cao để định vị các tài nguyên xung quanh." class="details-skill-desc" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="details-skill-box-2" class="details-skill-box">
                        <ui:VisualElement class="details-skill-avatar-slot">
                            <ui:VisualElement name="details-skill-img-2" class="details-skill-icon skill-icon-img" />
                            <ui:VisualElement class="details-skill-avatar-frame" />
                        </ui:VisualElement>
                        <ui:VisualElement class="details-skill-text-container">
                            <ui:Label name="details-skill-name-2" text="Ổn Định Áp Suất" class="details-skill-title" />
                            <ui:Label name="details-skill-desc-2" text="Tăng cường bộ giáp thám hiểm, giảm sát thương nhận vào từ môi trường." class="details-skill-desc" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- CLOSE BUTTON -->
                <ui:Button name="btn-close-details" text="ĐÓNG" class="action-btn leave-btn details-close-btn" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="swap-request-modal" class="confirm-overlay hidden-element">
            <ui:VisualElement class="confirm-dialog">
                <ui:VisualElement class="confirm-content">
                    <ui:Label text="YÊU CẦU ĐỔI NHÂN VẬT" class="confirm-title" />
                    <ui:Label name="lbl-swap-request-msg" text="Player 2 muốn đổi Atlas lấy Nyx của bạn." class="confirm-subtitle" />
                </ui:VisualElement>
                <ui:VisualElement class="confirm-buttons">
                    <ui:Button name="btn-swap-accept" text="ĐỒNG Ý" class="confirm-btn confirm-btn-yes" />
                    <ui:Button name="btn-swap-decline" text="TỪ CHỐI" class="confirm-btn confirm-btn-no" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="players-voice-modal" class="details-modal hidden-element">
            <ui:VisualElement class="voice-modal-panel">
                <ui:Label text="TRÒ CHUYỆN THOẠI" name="lbl-players-voice-title" class="panel-title" />
                <ui:VisualElement class="panel-divider" style="background-image: url(&quot;project://database/Assets/Synty/InterfaceFantasyMenus/Sprites/General/SPR_FantasyMenus_Line_Horizontal_01.png?fileID=2800000&amp;guid=3a7afa7a5a87b774587fd7d636cc2230&amp;type=3#SPR_FantasyMenus_Line_Horizontal_01&quot;);" />
                <ui:ScrollView name="players-voice-list" class="voice-player-scroll" />
                <ui:VisualElement class="voice-actions">
                    <ui:Button name="btn-close-players-voice" text="ĐÓNG" class="action-btn leave-btn voice-close-btn" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
